{% extends 'base.html.twig' %}

{% block title %}Contactez-nous{% endblock %}

{% block body %}
{# ========================================
   HERO SECTION - Figma Design
   ======================================== #}
<section style="position: relative; height: 400px; display: flex; align-items: center; justify-content: center; text-align: center; background-image: linear-gradient(rgba(139, 0, 0, 0.4), rgba(139, 0, 0, 0.5)), url('https://images.unsplash.com/photo-1661197880053-7d5441e937a8?w=1080'); background-size: cover; background-position: center;">
    <div style="max-width: 64rem; margin: 0 auto; padding: 0 1rem;">
        <h1 style="font-family: var(--font-heading); font-size: clamp(2.25rem, 5vw, 3.75rem); margin-bottom: 1.5rem; color: white; font-weight: 400;">
            Contactez-nous
        </h1>
        <p style="font-size: clamp(1rem, 2vw, 1.25rem); color: white;">
            Notre équipe est à votre écoute pour répondre à toutes vos questions
        </p>
    </div>
</section>

{# ========================================
   CONTACT CONTENT - Figma Design
   ======================================== #}
<section style="background-color: var(--beige); padding: 4rem 0;">
    <div style="max-width: 80rem; margin: 0 auto; padding: 0 1rem;">

        {# Flash Messages #}
        {% for message in app.flashes('success') %}
            <div style="background: #d4edda; border-left: 4px solid #28a745; color: #155724; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                <span data-icon="check-circle" data-icon-width="24" data-icon-height="24" style="color: #28a745;"></span>
                <div>
                    <p style="font-weight: 600; margin: 0;">{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <div style="background: #f8d7da; border-left: 4px solid #dc3545; color: #721c24; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                <span data-icon="alert-circle" data-icon-width="24" data-icon-height="24" style="color: #dc3545;"></span>
                <div>
                    <p style="font-weight: 600; margin: 0;">{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div style="background: #f8d7da; border-left: 4px solid #dc3545; color: #721c24; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                <span data-icon="alert-circle" data-icon-width="24" data-icon-height="24" style="color: #dc3545;"></span>
                <div>
                    <p style="font-weight: 600; margin: 0;">{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {# Layout 2 colonnes - Formulaire 2/3 + Infos 1/3 #}
        <div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 4rem;">
            <style>
                @media (min-width: 1024px) {
                    .contact-grid {
                        grid-template-columns: 2fr 1fr;
                    }
                }
            </style>
        </div>
        <div class="contact-grid" style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 4rem;">

            {# ========== COLONNE GAUCHE - Formulaire ========== #}
            <div>
                <div style="background: white; border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-md);">
                    <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 2rem; margin-bottom: 0.5rem; font-weight: 400;">
                        Envoyez-nous un message
                    </h2>
                    <div style="width: 5rem; height: 4px; background-color: var(--gold); border-radius: var(--radius-sm); margin-bottom: 1.5rem;"></div>

                    {{ form_start(form) }}

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div>
                            {{ form_label(form.name, 'Nom complet *', {'label_attr': {'style': 'display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-family: var(--font-body);'}}) }}
                            {{ form_widget(form.name, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body);', 'placeholder': 'Jean Dupont'}}) }}
                            {{ form_errors(form.name) }}
                        </div>

                        <div>
                            {{ form_label(form.email, 'Email *', {'label_attr': {'style': 'display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-family: var(--font-body);'}}) }}
                            {{ form_widget(form.email, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body);', 'placeholder': 'jean.dupont@email.com'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                    </div>

                    <div style="margin-bottom: 1.5rem;">
                        {{ form_label(form.subject, 'Sujet *', {'label_attr': {'style': 'display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-family: var(--font-body);'}}) }}
                        {{ form_widget(form.subject, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body);'}}) }}
                        {{ form_errors(form.subject) }}
                    </div>

                    <div style="margin-bottom: 1.5rem;">
                        {{ form_label(form.message, 'Message *', {'label_attr': {'style': 'display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-family: var(--font-body);'}}) }}
                        {{ form_widget(form.message, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body); resize: vertical;', 'rows': '6', 'placeholder': 'Décrivez votre demande...'}}) }}
                        {{ form_errors(form.message) }}
                    </div>

                    <button type="submit" style="width: 100%; padding: 1rem 2rem; background: var(--bordeaux); color: white; border: none; border-radius: var(--radius-sm); font-weight: 600; font-size: 1.125rem; cursor: pointer; transition: box-shadow var(--transition-base); display: flex; align-items: center; justify-content: center; gap: 0.75rem;"
                            onmouseover="this.style.boxShadow='var(--shadow-xl)'"
                            onmouseout="this.style.boxShadow='none'">
                        <span data-icon="mail" data-icon-width="20" data-icon-height="20"></span>
                        Envoyer le message
                    </button>

                    {{ form_end(form) }}
                </div>
            </div>

            {# ========== COLONNE DROITE - Infos contact et horaires ========== #}
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                {# Coordonnées #}
                <div style="background: white; border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-md);">
                    <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin-bottom: 1.5rem; font-weight: 400;">
                        Nos coordonnées
                    </h3>

                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <div style="display: flex; align-items: flex-start; gap: 1rem;">
                            <div style="width: 3rem; height: 3rem; border-radius: 50%; background: var(--beige); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <span data-icon="phone" data-icon-width="24" data-icon-height="24" style="color: var(--bordeaux);"></span>
                            </div>
                            <div>
                                <p style="font-size: 0.875rem; margin-bottom: 0.25rem; color: var(--dark-text);">Téléphone</p>
                                <a href="tel:+33556123456" style="font-family: var(--font-heading); font-size: 1.125rem; color: var(--bordeaux); text-decoration: none; transition: opacity var(--transition-base);"
                                   onmouseover="this.style.opacity='0.7'"
                                   onmouseout="this.style.opacity='1'">
                                    05 56 12 34 56
                                </a>
                            </div>
                        </div>

                        <div style="display: flex; align-items: flex-start; gap: 1rem;">
                            <div style="width: 3rem; height: 3rem; border-radius: 50%; background: var(--beige); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <span data-icon="mail" data-icon-width="24" data-icon-height="24" style="color: var(--bordeaux);"></span>
                            </div>
                            <div>
                                <p style="font-size: 0.875rem; margin-bottom: 0.25rem; color: var(--dark-text);">Email</p>
                                <a href="mailto:contact@maxencedupuis.com" style="font-family: var(--font-heading); font-size: 1.125rem; color: var(--bordeaux); text-decoration: none; word-break: break-all; transition: opacity var(--transition-base);"
                                   onmouseover="this.style.opacity='0.7'"
                                   onmouseout="this.style.opacity='1'">
                                    contact@maxencedupuis.com
                                </a>
                            </div>
                        </div>

                        <div style="display: flex; align-items: flex-start; gap: 1rem;">
                            <div style="width: 3rem; height: 3rem; border-radius: 50%; background: var(--beige); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <span data-icon="map-pin" data-icon-width="24" data-icon-height="24" style="color: var(--bordeaux);"></span>
                            </div>
                            <div>
                                <p style="font-size: 0.875rem; margin-bottom: 0.25rem; color: var(--dark-text);">Adresse</p>
                                <p style="font-family: var(--font-heading); font-size: 1.125rem; color: var(--bordeaux); margin: 0;">
                                    25 Rue des Chartrons<br>
                                    33000 Bordeaux
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Horaires d'ouverture #}
                <div style="background: white; border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-md);">
                    <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin-bottom: 1.5rem; font-weight: 400; display: flex; align-items: center; gap: 0.75rem;">
                        <span data-icon="clock" data-icon-width="24" data-icon-height="24"></span>
                        Horaires d'ouverture
                    </h3>

                    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                        {% set days = [
                            {day: 'Lundi', hours: 'Fermé', closed: true},
                            {day: 'Mardi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Mercredi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Jeudi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Vendredi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Samedi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Dimanche', hours: '10:00 - 22:30', closed: false}
                        ] %}
                        {% for item in days %}
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid var(--beige);">
                                <span style="color: var(--dark-text);">{{ item.day }}</span>
                                <span style="font-weight: 600; color: {{ item.closed ? 'var(--bordeaux)' : 'var(--green)' }};">{{ item.hours }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Engagement réponse rapide #}
                <div style="background: var(--bordeaux); border-radius: var(--radius-lg); padding: 1.5rem; text-align: center; color: white;">
                    <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.75rem; font-weight: 400;">
                        Réponse rapide garantie
                    </h3>
                    <p style="font-size: 0.875rem; margin: 0;">
                        Nous nous engageons à répondre à toutes vos demandes sous 24h maximum
                    </p>
                </div>
            </div>
        </div>

        {# ========== SECTION FAQ ========== #}
        <div style="background: white; border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-md);">
            <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 2rem; margin-bottom: 2rem; text-align: center; font-weight: 400;">
                Questions fréquentes
            </h2>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
                <div>
                    <h3 style="font-family: var(--font-heading); color: var(--gold); font-size: 1.25rem; margin-bottom: 0.75rem; font-weight: 400;">
                        Quel est le délai de commande ?
                    </h3>
                    <p style="color: var(--dark-text); line-height: 1.6;">
                        Nous demandons un minimum de 48h à l'avance pour toute commande. Pour les événements importants (mariages, anniversaires), nous recommandons de nous contacter au moins 2 semaines avant.
                    </p>
                </div>

                <div>
                    <h3 style="font-family: var(--font-heading); color: var(--gold); font-size: 1.25rem; margin-bottom: 0.75rem; font-weight: 400;">
                        Livrez-vous partout à Bordeaux ?
                    </h3>
                    <p style="color: var(--dark-text); line-height: 1.6;">
                        Nous livrons dans toute l'agglomération bordelaise. Pour les communes plus éloignées, n'hésitez pas à nous contacter pour vérifier la disponibilité.
                    </p>
                </div>

                <div>
                    <h3 style="font-family: var(--font-heading); color: var(--gold); font-size: 1.25rem; margin-bottom: 0.75rem; font-weight: 400;">
                        Puis-je personnaliser un menu ?
                    </h3>
                    <p style="color: var(--dark-text); line-height: 1.6;">
                        Absolument ! Nos chefs Julie et José seront ravis de créer un menu sur mesure selon vos préférences, allergies alimentaires et budget.
                    </p>
                </div>

                <div>
                    <h3 style="font-family: var(--font-heading); color: var(--gold); font-size: 1.25rem; margin-bottom: 0.75rem; font-weight: 400;">
                        Proposez-vous des dégustations ?
                    </h3>
                    <p style="color: var(--dark-text); line-height: 1.6;">
                        Oui, pour les événements importants, nous proposons des séances de dégustation sur rendez-vous dans notre atelier à Bordeaux.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
