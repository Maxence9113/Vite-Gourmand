{% extends 'base.html.twig' %}

{% block title %}Contactez-nous{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/contact.css') }}">
{% endblock %}

{% block body %}
{# ========================================
   HERO SECTION - Figma Design
   ======================================== #}
<section class="contact-hero">
    <div class="contact-hero-container">
        <h1 class="contact-hero-title">
            Contactez-nous
        </h1>
        <p class="contact-hero-subtitle">
            Notre équipe est à votre écoute pour répondre à toutes vos questions
        </p>
    </div>
</section>

{# ========================================
   CONTACT CONTENT - Figma Design
   ======================================== #}
<section class="contact-section">
    <div class="contact-container">

        {# Flash Messages #}
        {% for message in app.flashes('success') %}
            <div class="flash-success">
                <span data-icon="check-circle" data-icon-width="24" data-icon-height="24" class="icon"></span>
                <div>
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <div class="flash-danger">
                <span data-icon="alert-circle" data-icon-width="24" data-icon-height="24" class="icon"></span>
                <div>
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-error">
                <span data-icon="alert-circle" data-icon-width="24" data-icon-height="24" class="icon"></span>
                <div>
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {# Layout 2 colonnes - Formulaire 2/3 + Infos 1/3 #}
        <div class="contact-grid">

            {# ========== COLONNE GAUCHE - Formulaire ========== #}
            <div>
                <div class="contact-form-card">
                    <h2 class="contact-form-title">
                        Envoyez-nous un message
                    </h2>
                    <div class="contact-form-divider"></div>

                    {{ form_start(form) }}

                    <div class="contact-form-fields-grid">
                        <div>
                            {{ form_label(form.name, 'Nom complet *', {'label_attr': {'class': 'contact-form-label'}}) }}
                            {{ form_widget(form.name, {'attr': {'class': 'contact-form-input', 'placeholder': 'Jean Dupont'}}) }}
                            {{ form_errors(form.name) }}
                        </div>

                        <div>
                            {{ form_label(form.email, 'Email *', {'label_attr': {'class': 'contact-form-label'}}) }}
                            {{ form_widget(form.email, {'attr': {'class': 'contact-form-input', 'placeholder': 'jean.dupont@email.com'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                    </div>

                    <div class="contact-form-field">
                        {{ form_label(form.subject, 'Sujet *', {'label_attr': {'class': 'contact-form-label'}}) }}
                        {{ form_widget(form.subject, {'attr': {'class': 'contact-form-input'}}) }}
                        {{ form_errors(form.subject) }}
                    </div>

                    <div class="contact-form-field">
                        {{ form_label(form.message, 'Message *', {'label_attr': {'class': 'contact-form-label'}}) }}
                        {{ form_widget(form.message, {'attr': {'class': 'contact-form-textarea', 'rows': '6', 'placeholder': 'Décrivez votre demande...'}}) }}
                        {{ form_errors(form.message) }}
                    </div>

                    <button type="submit" class="contact-form-submit">
                        <span data-icon="mail" data-icon-width="20" data-icon-height="20"></span>
                        Envoyer le message
                    </button>

                    {{ form_end(form) }}
                </div>
            </div>

            {# ========== COLONNE DROITE - Infos contact et horaires ========== #}
            <div class="contact-info-column">

                {# Coordonnées #}
                <div class="contact-info-card">
                    <h3 class="contact-info-title">
                        Nos coordonnées
                    </h3>

                    <div class="contact-info-list">
                        <div class="contact-info-item">
                            <div class="contact-info-icon-circle">
                                <span data-icon="phone" data-icon-width="24" data-icon-height="24" class="icon"></span>
                            </div>
                            <div>
                                <p class="contact-info-label">Téléphone</p>
                                <a href="tel:+33556123456" class="contact-info-value">
                                    05 56 12 34 56
                                </a>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-info-icon-circle">
                                <span data-icon="mail" data-icon-width="24" data-icon-height="24" class="icon"></span>
                            </div>
                            <div>
                                <p class="contact-info-label">Email</p>
                                <a href="mailto:contact@maxencedupuis.com" class="contact-info-value email">
                                    contact@maxencedupuis.com
                                </a>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-info-icon-circle">
                                <span data-icon="map-pin" data-icon-width="24" data-icon-height="24" class="icon"></span>
                            </div>
                            <div>
                                <p class="contact-info-label">Adresse</p>
                                <p class="contact-info-value address">
                                    25 Rue des Chartrons<br>
                                    33000 Bordeaux
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Horaires d'ouverture #}
                <div class="contact-info-card">
                    <h3 class="contact-hours-title">
                        <span data-icon="clock" data-icon-width="24" data-icon-height="24"></span>
                        Horaires d'ouverture
                    </h3>

                    <div class="contact-hours-list">
                        {% set days = [
                            {day: 'Lundi', hours: 'Fermé', closed: true},
                            {day: 'Mardi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Mercredi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Jeudi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Vendredi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Samedi', hours: '10:00 - 22:30', closed: false},
                            {day: 'Dimanche', hours: '10:00 - 22:30', closed: false}
                        ] %}
                        {% for item in days %}
                            <div class="contact-hours-item">
                                <span class="contact-hours-day">{{ item.day }}</span>
                                <span class="contact-hours-time {{ item.closed ? 'closed' : 'open' }}">{{ item.hours }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Engagement réponse rapide #}
                <div class="contact-engagement-card">
                    <h3 class="contact-engagement-title">
                        Réponse rapide garantie
                    </h3>
                    <p class="contact-engagement-text">
                        Nous nous engageons à répondre à toutes vos demandes sous 24h maximum
                    </p>
                </div>
            </div>
        </div>

        {# ========== SECTION FAQ ========== #}
        <div class="contact-faq-card">
            <h2 class="contact-faq-title">
                Questions fréquentes
            </h2>

            <div class="contact-faq-grid">
                <div>
                    <h3 class="contact-faq-item-title">
                        Quel est le délai de commande ?
                    </h3>
                    <p class="contact-faq-item-text">
                        Nous demandons un minimum de 48h à l'avance pour toute commande. Pour les événements importants (mariages, anniversaires), nous recommandons de nous contacter au moins 2 semaines avant.
                    </p>
                </div>

                <div>
                    <h3 class="contact-faq-item-title">
                        Livrez-vous partout à Bordeaux ?
                    </h3>
                    <p class="contact-faq-item-text">
                        Nous livrons dans toute l'agglomération bordelaise. Pour les communes plus éloignées, n'hésitez pas à nous contacter pour vérifier la disponibilité.
                    </p>
                </div>

                <div>
                    <h3 class="contact-faq-item-title">
                        Puis-je personnaliser un menu ?
                    </h3>
                    <p class="contact-faq-item-text">
                        Absolument ! Nos chefs Julie et José seront ravis de créer un menu sur mesure selon vos préférences, allergies alimentaires et budget.
                    </p>
                </div>

                <div>
                    <h3 class="contact-faq-item-title">
                        Proposez-vous des dégustations ?
                    </h3>
                    <p class="contact-faq-item-text">
                        Oui, pour les événements importants, nous proposons des séances de dégustation sur rendez-vous dans notre atelier à Bordeaux.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
