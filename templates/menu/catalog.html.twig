{% extends 'base.html.twig' %}

{% block title %}Nos Menus - Vite & Gourmand{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/menu.css') }}">
{% endblock %}

{% block body %}

{# ========================================
   PAGE TITLE - Figma Design
   ======================================== #}
<section class="menu-catalog-title-section">
    <div class="container">
        <div class="menu-catalog-title-wrapper">
            <h1 class="page-title">
                Nos Menus Gastronomiques
            </h1>
            <div class="menu-catalog-divider"></div>
            <p class="page-subtitle">
                Découvrez notre sélection de menus conçus avec passion pour sublimer vos événements
            </p>
        </div>
    </div>
</section>

{# ========================================
   CATALOG SECTION - Figma Design
   ======================================== #}
<section class="menu-catalog-section">
    <div class="menu-catalog-container">
        {# ========== Filtres Horizontaux - Figma Design ========== #}
        <div class="menu-filters">
            <div class="menu-filters-header">
                <span data-icon="sliders" data-icon-width="20" data-icon-height="20"></span>
                <h2 class="menu-filters-title">
                    Filtrer les menus
                </h2>
            </div>

            <form id="filterForm" method="get" action="{{ path('app_menu_catalog') }}" class="filters-grid">
                {# Filtre Prix maximum #}
                <div class="filter-item">
                    <label>
                        Prix maximum : <span class="price-display" id="priceValue">{{ currentFilters.price_max ? (currentFilters.price_max / 100)|number_format(0, ',', ' ') : '3000' }}€</span>
                    </label>
                    <input
                        type="range"
                        class="price-slider"
                        name="price_max"
                        min="100"
                        max="3000"
                        step="50"
                        value="{{ currentFilters.price_max ? (currentFilters.price_max / 100) : 3000 }}"
                        oninput="document.getElementById('priceValue').textContent = this.value + '€'"
                    >
                    <div class="price-range-labels">
                        <span>100€</span>
                        <span>3000€</span>
                    </div>
                </div>

                {# Filtre Thème #}
                <div class="filter-item">
                    <label>
                        Thème
                    </label>
                    <select name="theme" class="filter-select" id="themeFilter">
                        <option value="">Tous</option>
                        {% for theme in themes %}
                            <option value="{{ theme.id }}" {% if currentFilters.theme == theme.id %}selected{% endif %}>
                                {{ theme.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Filtre Régimes alimentaires #}
                <div class="filter-item">
                    <label>
                        Régime alimentaire
                    </label>
                    <div class="regime-filter-buttons">
                        <button
                            type="button"
                            class="regime-filter-btn {% if currentFilters.dietetary is empty %}active{% endif %}"
                            onclick="clearDietetaryFilters(this)"
                        >
                            Tous
                        </button>
                        {% for dietetary in dietetaries %}
                            <button
                                type="button"
                                class="regime-filter-btn {% if dietetary.id in currentFilters.dietetary %}active{% endif %}"
                                data-dietetary="{{ dietetary.id }}"
                            >
                                {{ dietetary.name }}
                            </button>
                            <input
                                type="checkbox"
                                name="dietetary[]"
                                value="{{ dietetary.id }}"
                                {% if dietetary.id in currentFilters.dietetary %}checked{% endif %}
                                style="display: none;"
                                id="dietetary_{{ dietetary.id }}"
                            >
                        {% endfor %}
                    </div>
                </div>

                {# Filtre Nombre de personnes #}
                <div class="filter-item">
                    <label>
                        Nombre de personnes minimum
                    </label>
                    <input
                        type="number"
                        class="filter-input"
                        name="nb_person_min"
                        min="1"
                        placeholder="Nombre de convives"
                        value="{{ currentFilters.nb_person_min }}"
                    >
                </div>
            </form>
        </div>

        {# ========== Grille de menus ========== #}
        <div id="menuGrid" class="menu-grid">
            {% if menus is empty %}
                <div class="no-menu-message">
                    <span data-icon="info" data-icon-width="24" data-icon-height="24"></span>
                    <h5>Aucun menu trouvé</h5>
                    <p>Essayez de modifier vos critères de recherche</p>
                </div>
            {% else %}
                {% for menu in menus %}
                    <div class="menu-card">
                        {# Image avec gradient overlay #}
                        <div class="menu-card-image">
                            <img src="{{ menu.illustration }}"
                                 alt="{{ menu.textAlt ?: menu.name }}">
                            <div class="menu-card-badges">
                                <span class="badge badge-theme">{{ menu.theme.name }}</span>
                                {% if menu.dietetary|length > 0 %}
                                    {% for dietetary in menu.dietetary %}
                                        <span class="badge {% if dietetary.name in ['Végétarien', 'Vegan'] %}badge-vegetarian{% else %}badge-classic{% endif %}">
                                            {{ dietetary.name }}
                                        </span>
                                    {% endfor %}
                                {% else %}
                                    <span class="badge badge-classic">Classique</span>
                                {% endif %}
                            </div>
                        </div>

                        {# Contenu #}
                        <div class="menu-card-content">
                            <h3 class="menu-card-title">{{ menu.name }}</h3>
                            <p class="menu-card-description">
                                {{ menu.description }}
                            </p>

                            {# Infos pratiques #}
                            <div class="menu-card-info">
                                <span>
                                    <span data-icon="users" data-icon-width="16" data-icon-height="16" style="color: var(--gold);"></span>
                                    À partir de {{ menu.nbPersonMin }} pers.
                                </span>
                            </div>

                            {# Prix et CTA #}
                            <div class="menu-card-footer">
                                <div class="menu-card-price">
                                    <small>À partir de</small>
                                    <span class="price-value">{{ (menu.pricePerPerson / 100)|number_format(0, ',', ' ') }}€</span>
                                </div>
                                <a href="{{ path('app_menu_show', {id: menu.id}) }}" class="btn-view-details">
                                    <span data-icon="eye" data-icon-width="16" data-icon-height="16"></span>
                                    <span class="btn-text-full">Voir détails</span>
                                    <span class="btn-text-short">Voir</span>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        {# Résultats count - Figma Design #}
        <div class="menu-results-count">
            <p>
                {{ menus|length }} menu{{ menus|length > 1 ? 's' : '' }} disponible{{ menus|length > 1 ? 's' : '' }}
            </p>
        </div>
    </div>
</section>

{% endblock %}
