{% extends 'base.html.twig' %}

{% block title %}{{ menu.name }} - Vite & Gourmand{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/menu.css') }}">
{% endblock %}

{% block body %}

{# ========================================
   MENU DETAIL PAGE - Figma Design
   ======================================== #}
<section class="menu-detail-section">
    <div class="menu-detail-container">

        {# Bouton retour #}
        <a href="{{ path('app_menu_catalog') }}" class="menu-back-link">
            <span data-icon="arrow-left" data-icon-width="20" data-icon-height="20"></span>
            Retour aux menus
        </a>

        {# Layout 2 colonnes #}
        <div class="menu-detail-grid">
            {# ========== COLONNE GAUCHE - Images et Composition ========== #}
            <div>
                {# Image principale avec badges #}
                <div class="menu-main-image-wrapper">
                    <img src="{{ menu.illustration ?? 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=800&h=600&fit=crop' }}"
                         alt="{{ menu.textAlt ?? menu.name }}"
                         class="menu-main-image"
                         id="mainMenuImage">

                    {# Badges en overlay #}
                    <div class="menu-image-badges">
                        <span class="menu-badge menu-badge-theme">
                            {{ menu.theme.name }}
                        </span>
                        {% if menu.dietetary|length > 0 %}
                            {% for dietetary in menu.dietetary %}
                                <span class="menu-badge {% if dietetary.name in ['Végétarien', 'Vegan'] %}menu-badge-vegetarian{% else %}menu-badge-classic{% endif %}">
                                    {{ dietetary.name }}
                                </span>
                            {% endfor %}
                        {% else %}
                            <span class="menu-badge menu-badge-classic">
                                Classique
                            </span>
                        {% endif %}
                    </div>
                </div>

                {# Images secondaires - cliquables #}
                <div class="menu-secondary-images">
                    {# Image principale en première position #}
                    <div class="menu-secondary-image-wrapper">
                        <img src="{{ menu.illustration ?? 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=800&h=600&fit=crop' }}"
                             alt="{{ menu.textAlt ?? menu.name }}"
                             class="menu-secondary-image"
                             style="cursor: pointer;"
                             onclick="changeMainImage('{{ menu.illustration ?? 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=800&h=600&fit=crop' }}', '{{ menu.textAlt ?? menu.name }}')">
                    </div>

                    {% set imageCount = 0 %}
                    {% for recipe in menu.recipes %}
                        {% if imageCount < 2 and recipe.recipeIllustrations|length > 0 %}
                            {% set firstIllustration = recipe.recipeIllustrations|first %}
                            <div class="menu-secondary-image-wrapper">
                                <img src="{{ firstIllustration.url }}"
                                     alt="{{ firstIllustration.altText ?? recipe.title }}"
                                     class="menu-secondary-image"
                                     style="cursor: pointer;"
                                     onclick="changeMainImage('{{ firstIllustration.url }}', '{{ firstIllustration.altText ?? recipe.title }}')">
                            </div>
                            {% set imageCount = imageCount + 1 %}
                        {% endif %}
                    {% endfor %}

                    {# Images par défaut si pas assez de recettes avec images #}
                    {% for i in 1..(2 - imageCount) %}
                        <div class="menu-secondary-image-wrapper">
                            <img src="https://images.unsplash.com/photo-{{ ['1758384077164-c00b53cf718f', '1741965134280-9094486efd82'][loop.index0] }}?w=400&h=300&fit=crop"
                                 alt="Plat gastronomique"
                                 class="menu-secondary-image"
                                 style="cursor: pointer;"
                                 onclick="changeMainImage('https://images.unsplash.com/photo-{{ ['1758384077164-c00b53cf718f', '1741965134280-9094486efd82'][loop.index0] }}?w=800&h=600&fit=crop', 'Plat gastronomique')">
                        </div>
                    {% endfor %}
                </div>

                {# Composition du menu #}
                <div class="menu-composition-box">
                    <h2 class="menu-composition-title">
                        Composition du menu
                    </h2>

                    {# Regrouper les recettes par catégorie #}
                    {% set recipesByCategory = {} %}
                    {% for recipe in menu.recipes %}
                        {% set categoryName = recipe.category.name %}
                        {% if categoryName not in recipesByCategory|keys %}
                            {% set recipesByCategory = recipesByCategory|merge({(categoryName): []}) %}
                        {% endif %}
                        {% set recipesByCategory = recipesByCategory|merge({
                            (categoryName): recipesByCategory[categoryName]|merge([recipe])
                        }) %}
                    {% endfor %}

                    {# Afficher par catégorie #}
                    {% set orderedCategories = ['Entrée', 'Plat', 'Fromage', 'Dessert'] %}
                    {% for categoryName in orderedCategories %}
                        {% if categoryName in recipesByCategory|keys %}
                            {% set recipes = recipesByCategory[categoryName] %}
                            <div class="menu-category-section">
                                <h3 class="menu-category-title">
                                    {{ categoryName }}
                                </h3>
                                <ul class="menu-recipe-list">
                                    {% for recipe in recipes %}
                                        <li class="menu-recipe-item">
                                            <span data-icon="check" data-icon-width="20" data-icon-height="20"></span>
                                            <div>
                                                <div class="menu-recipe-title">{{ recipe.title }}</div>
                                                {% if recipe.description %}
                                                    <div class="menu-recipe-description">{{ recipe.description }}</div>
                                                {% endif %}
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {# ========== COLONNE DROITE - Détails et Commande ========== #}
            <div>
                {# Titre #}
                <h1 class="menu-detail-title">
                    {{ menu.name }}
                </h1>

                {# Ligne dorée #}
                <div class="menu-detail-divider"></div>

                {# Description #}
                <p class="menu-detail-description">
                    {{ menu.description }}
                </p>

                {# Box de commande - Call to Action #}
                <div class="menu-order-box">
                    <div class="menu-price-wrapper">
                        <div class="menu-price-display">
                            <span class="menu-price-label">À partir de</span>
                            <span class="menu-price-value">
                                {{ (menu.pricePerPerson / 100)|number_format(0, ',', ' ') }}€
                            </span>
                            <span class="menu-price-unit">/personne</span>
                        </div>
                        <p class="menu-min-persons">
                            Minimum {{ menu.nbPersonMin }} personnes
                        </p>
                        <p class="menu-stock-info">
                            {% if menu.stock is null %}
                                Stock : <strong>Illimité</strong>
                            {% elseif menu.stock >= menu.nbPersonMin %}
                                Stock disponible : <strong>{{ menu.stock }} portion{{ menu.stock > 1 ? 's' : '' }}</strong>
                            {% else %}
                                <span style="color: var(--error-color, #dc3545);">
                                    Stock insuffisant ({{ menu.stock }} portions restantes, minimum {{ menu.nbPersonMin }} requis)
                                </span>
                            {% endif %}
                        </p>
                    </div>

                    {% if app.user %}
                        {% if menu.isAvailable %}
                            <a href="{{ path('app_order_new', {id: menu.id}) }}" class="menu-order-btn">
                                <span data-icon="shopping-cart" data-icon-width="24" data-icon-height="24"></span>
                                Commander ce menu
                            </a>
                        {% else %}
                            <button disabled class="menu-order-btn menu-order-btn-disabled">
                                <span data-icon="x-circle" data-icon-width="24" data-icon-height="24"></span>
                                Menu indisponible
                            </button>
                        {% endif %}
                    {% else %}
                        <button type="button"
                                onclick="document.getElementById('authRequiredModal').style.display='flex'"
                                class="menu-order-btn">
                            <span data-icon="shopping-cart" data-icon-width="24" data-icon-height="24"></span>
                            Commander ce menu
                        </button>
                    {% endif %}

                    <p class="menu-order-info">
                        Livraison disponible • Réponse sous 24h
                    </p>
                </div>

                {# Allergènes #}
                {% set menuAllergens = [] %}
                {% for recipe in menu.recipes %}
                    {% for allergen in recipe.allergen %}
                        {% if allergen.id not in menuAllergens|column('id') %}
                            {% set menuAllergens = menuAllergens|merge([allergen]) %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}

                {% if menuAllergens|length > 0 %}
                    <div class="menu-allergens-alert">
                        <div class="menu-allergens-content">
                            <span data-icon="alert-triangle" data-icon-width="20" data-icon-height="20"></span>
                            <div>
                                <strong class="menu-allergens-title">Allergènes présents</strong>
                                <small>
                                    {% for allergen in menuAllergens %}
                                        {{ allergen.name }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </small>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# Services #}
                <div class="menu-info-box">
                    <h2 class="menu-info-title">
                        Informations pratiques
                    </h2>

                    <div class="menu-info-list">
                        <div class="menu-info-item">
                            <span data-icon="check" data-icon-width="20" data-icon-height="20"></span>
                            <span>Vaisselle en prêt</span>
                        </div>
                        <div class="menu-info-item">
                            <span data-icon="check" data-icon-width="20" data-icon-height="20"></span>
                            <span>Délai de commande : 48h avant prestation</span>
                        </div>
                    </div>
                </div>

                {# Cartes informatives #}
                <div class="menu-stats-grid">
                    <div class="menu-stat-card">
                        <span data-icon="users" data-icon-width="32" data-icon-height="32" class="menu-stat-icon bordeaux"></span>
                        <p class="menu-stat-label">Nombre de convives</p>
                        <p class="menu-stat-value">
                            À partir de {{ menu.nbPersonMin }}
                        </p>
                    </div>
                    <div class="menu-stat-card">
                        <span data-icon="chef-hat" data-icon-width="32" data-icon-height="32" class="menu-stat-icon gold"></span>
                        <p class="menu-stat-label">Préparé par</p>
                        <p class="menu-stat-value">
                            Julie & José
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ========================================
   MODAL D'AUTHENTIFICATION
   ======================================== #}
{% if not app.user %}
<div class="auth-modal" id="authRequiredModal">
    <div class="auth-modal-backdrop" onclick="document.getElementById('authRequiredModal').style.display='none'"></div>
    <div class="auth-modal-content">
        <div class="auth-modal-header">
            <h5 class="auth-modal-title">
                <span data-icon="lock" data-icon-width="20" data-icon-height="20"></span>
                Connexion requise
            </h5>
            <button type="button"
                    onclick="document.getElementById('authRequiredModal').style.display='none'"
                    class="auth-modal-close">
                <span data-icon="x" data-icon-width="24" data-icon-height="24"></span>
            </button>
        </div>
        <div class="auth-modal-body">
            <span data-icon="user" data-icon-width="64" data-icon-height="64" class="auth-modal-icon"></span>
            <p class="auth-modal-text">
                Pour commander ce menu, vous devez être connecté à votre compte.
            </p>
            <p class="auth-modal-subtext">
                Vous n'avez pas encore de compte ? C'est rapide et gratuit !
            </p>
        </div>
        <div class="auth-modal-actions">
            <a href="{{ path('app_login') }}?redirect={{ path('app_menu_show', {id: menu.id}) }}"
               class="btn btn-primary">
                <span data-icon="log-in" data-icon-width="18" data-icon-height="18"></span>
                Se connecter
            </a>
            <a href="{{ path('app_register') }}?redirect={{ path('app_menu_show', {id: menu.id}) }}"
               class="btn btn-outline">
                <span data-icon="user-plus" data-icon-width="18" data-icon-height="18"></span>
                Créer un compte
            </a>
        </div>
    </div>
</div>
{% endif %}

<script>
/**
 * Change l'image principale du menu quand on clique sur une image secondaire
 */
function changeMainImage(imageUrl, imageAlt) {
    const mainImage = document.getElementById('mainMenuImage');
    if (mainImage) {
        mainImage.src = imageUrl;
        mainImage.alt = imageAlt;
    }
}
</script>

{% endblock %}
