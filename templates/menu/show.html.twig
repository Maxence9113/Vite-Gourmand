{% extends 'base.html.twig' %}

{% block title %}{{ menu.name }} - Vite & Gourmand{% endblock %}

{% block body %}

{# ========================================
   BREADCRUMB
   ======================================== #}
<section class="breadcrumb-section">
    <div class="container">
        <nav class="breadcrumb-nav">
            <a href="{{ path('app_home') }}" class="breadcrumb-link">
                <span data-icon="home" data-icon-width="14" data-icon-height="14"></span>
                Accueil
            </a>
            <span class="breadcrumb-separator">/</span>
            <a href="{{ path('app_menu_catalog') }}" class="breadcrumb-link">Nos menus</a>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-active">{{ menu.name }}</span>
        </nav>
    </div>
</section>

{# ========================================
   MENU DETAILS
   ======================================== #}
<section class="menu-detail-section">
    <div class="container">
        <div class="menu-detail-layout">
            {# ========== Galerie d'images - Gauche ========== #}
            <div class="menu-gallery">
                {# Image principale #}
                <div class="gallery-main" id="galleryMain">
                    <img src="{{ menu.illustration ?? 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=800&h=600&fit=crop' }}"
                         alt="{{ menu.textAlt ?? menu.name }}"
                         id="mainImage">
                </div>

                {# Miniatures #}
                <div class="gallery-thumbnails">
                    {# Miniature de l'image principale #}
                    <div class="thumbnail active" data-image="{{ menu.illustration ?? 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=800&h=600&fit=crop' }}">
                        <img src="{{ menu.illustration ?? 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=200&h=150&fit=crop' }}"
                             alt="{{ menu.textAlt ?? menu.name }}">
                    </div>

                    {# Miniatures des recettes (max 5) #}
                    {% set imageCount = 0 %}
                    {% for recipe in menu.recipes %}
                        {% if imageCount < 5 and recipe.recipeIllustrations|length > 0 %}
                            {% set firstIllustration = recipe.recipeIllustrations|first %}
                            <div class="thumbnail" data-image="{{ firstIllustration.url }}">
                                <img src="{{ firstIllustration.url }}"
                                     alt="{{ firstIllustration.altText ?? recipe.title }}">
                            </div>
                            {% set imageCount = imageCount + 1 %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {# ========== Informations du menu - Droite ========== #}
            <div class="menu-info">
                {# Titre #}
                <h1 class="menu-detail-title">{{ menu.name }}</h1>

                {# Badges thème et régimes alimentaires #}
                <div class="menu-badges">
                    <span class="badge badge-theme">{{ menu.theme.name }}</span>
                    {% if menu.dietetary|length > 0 %}
                        {% for dietetary in menu.dietetary %}
                            <span class="badge {% if dietetary.name in ['Végétarien', 'Vegan'] %}badge-vegetarian{% else %}badge-classic{% endif %}">{{ dietetary.name }}</span>
                        {% endfor %}
                    {% else %}
                        <span class="badge badge-classic">Classique</span>
                    {% endif %}
                </div>

                {# Prix #}
                <div class="menu-price-box">
                    <span class="price-large">{{ (menu.pricePerPerson / 100)|number_format(2, ',', ' ') }}€</span>
                    <small>par personne</small>
                </div>

                {# Description #}
                <div class="menu-description">
                    <p>{{ menu.description }}</p>
                </div>

                {# Allergènes #}
                {% set menuAllergens = [] %}
                {% for recipe in menu.recipes %}
                    {% for allergen in recipe.allergen %}
                        {% if allergen.id not in menuAllergens|column('id') %}
                            {% set menuAllergens = menuAllergens|merge([allergen]) %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}

                {% if menuAllergens|length > 0 %}
                    <div class="alert alert-warning">
                        <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                            <span data-icon="alert-triangle" data-icon-width="20" data-icon-height="20" style="flex-shrink: 0; margin-top: 2px;"></span>
                            <div>
                                <strong style="display: block; margin-bottom: 0.25rem;">Allergènes présents</strong>
                                <small>
                                    {% for allergen in menuAllergens %}
                                        {{ allergen.name }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </small>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <hr style="margin: var(--spacing-lg) 0; border: none; border-top: 1px solid var(--beige);">

                {# Informations pratiques #}
                <div class="menu-practical-info">
                    <h6 style="font-family: var(--font-heading); font-weight: 600; margin-bottom: var(--spacing-md); color: var(--dark-text);">
                        Informations pratiques
                    </h6>

                    <div class="info-grid">
                        <div class="info-item">
                            <small class="info-label">Nombre de personnes</small>
                            <strong class="info-value">Minimum {{ menu.nbPersonMin }}</strong>
                        </div>
                        <div class="info-item">
                            <small class="info-label">Nombre de plats</small>
                            <strong class="info-value">{{ menu.recipes|length }} recettes</strong>
                        </div>
                        <div class="info-item">
                            <small class="info-label">Disponibilité</small>
                            <strong class="info-value">
                                {% if menu.stock is defined and menu.stock is not null %}
                                    {% if menu.stock > 0 %}
                                        <span style="color: var(--green);">En stock ({{ menu.stock }} disponible{{ menu.stock > 1 ? 's' : '' }})</span>
                                    {% else %}
                                        <span style="color: #D97076;">Stock épuisé</span>
                                    {% endif %}
                                {% else %}
                                    <span style="color: var(--gold);">Sur commande</span>
                                {% endif %}
                            </strong>
                        </div>
                        <div class="info-item">
                            <small class="info-label">Délai de commande</small>
                            <strong class="info-value">48h avant la prestation</strong>
                        </div>
                    </div>
                </div>

                <hr style="margin: var(--spacing-lg) 0; border: none; border-top: 1px solid var(--beige);">

                {# Conditions #}
                {% if menu.conditions is defined and menu.conditions is not null %}
                    <div class="menu-conditions">
                        <h6 style="font-family: var(--font-heading); font-weight: 600; margin-bottom: var(--spacing-sm); color: var(--dark-text);">
                            Conditions particulières
                        </h6>
                        <p style="font-size: 0.875rem; color: var(--muted); margin: 0;">{{ menu.conditions|nl2br }}</p>
                    </div>
                    <hr style="margin: var(--spacing-lg) 0; border: none; border-top: 1px solid var(--beige);">
                {% endif %}

                {# Boutons d'action #}
                <div class="menu-actions">
                    {% if app.user %}
                        {% if menu.isAvailable %}
                            <a href="{{ path('app_order_new', {id: menu.id}) }}" class="btn btn-primary btn-lg" data-turbo="false" style="width: 100%;">
                                <span data-icon="shopping-cart" data-icon-width="20" data-icon-height="20"></span>
                                Commander ce menu
                            </a>
                        {% else %}
                            <button class="btn btn-outline btn-lg" disabled style="width: 100%;">
                                <span data-icon="x-circle" data-icon-width="20" data-icon-height="20"></span>
                                Menu indisponible
                            </button>
                        {% endif %}
                    {% else %}
                        <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#authRequiredModal" style="width: 100%;">
                            <span data-icon="shopping-cart" data-icon-width="20" data-icon-height="20"></span>
                            Commander ce menu
                        </button>
                    {% endif %}
                    <a href="{{ path('app_menu_catalog') }}" style="width: 100%;">
                        Retour au catalogue
                    </a>
                </div>
            </div>
        </div>

        {# ========================================
           RECETTES DU MENU - Groupées par catégorie
           ======================================== #}
        <div class="menu-recipes-section">
            <h3 style="font-family: var(--font-heading); font-weight: 700; margin-bottom: var(--spacing-xl); text-align: center; color: var(--dark-text);">
                Composition du menu
            </h3>

            {# Regrouper les recettes par catégorie #}
            {% set recipesByCategory = {} %}
            {% for recipe in menu.recipes %}
                {% set categoryName = recipe.category.name %}
                {% if categoryName not in recipesByCategory|keys %}
                    {% set recipesByCategory = recipesByCategory|merge({(categoryName): []}) %}
                {% endif %}
                {% set recipesByCategory = recipesByCategory|merge({
                    (categoryName): recipesByCategory[categoryName]|merge([recipe])
                }) %}
            {% endfor %}

            {# Afficher par catégorie dans l'ordre : Entrée, Plat, Fromage, Dessert #}
            {% set orderedCategories = ['Entrée', 'Plat', 'Fromage', 'Dessert'] %}
            {% for categoryName in orderedCategories %}
                {% if categoryName in recipesByCategory|keys %}
                    {% set recipes = recipesByCategory[categoryName] %}
                    <div class="recipe-category">
                        <h5 class="category-title">{{ categoryName }}</h5>
                        <div class="recipe-grid">
                            {% for recipe in recipes %}
                                <div class="recipe-item">
                                    <h6 class="recipe-title">{{ recipe.title }}</h6>
                                    <p class="recipe-description">{{ recipe.description }}</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {# ========================================
           CALL TO ACTION
           ======================================== #}
        <div class="menu-cta-section">
            <div class="cta-box">
                <h3 style="font-family: var(--font-heading); font-weight: 700; margin-bottom: var(--spacing-md); color: var(--dark-text);">
                    Intéressé par ce menu ?
                </h3>
                <p style="font-size: 1.125rem; margin-bottom: var(--spacing-xl); color: var(--muted);">
                    Contactez-nous pour personnaliser votre menu selon vos besoins et contraintes
                </p>
                <div style="display: flex; gap: var(--spacing-md); justify-content: center; flex-wrap: wrap;">
                    <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">
                        <span data-icon="phone" data-icon-width="20" data-icon-height="20"></span>
                        Nous contacter
                    </a>
                    <a href="{{ path('app_contact') }}" class="btn btn-outline btn-lg">
                        <span data-icon="mail" data-icon-width="20" data-icon-height="20"></span>
                        Demander un devis
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

{# ========================================
   MODAL D'AUTHENTIFICATION
   ======================================== #}
{% if not app.user %}
<div class="modal" id="authRequiredModal">
    <div class="modal-overlay" onclick="closeAuthModal()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h5 style="display: flex; align-items: center; gap: 0.5rem; margin: 0; font-family: var(--font-heading); font-weight: 700;">
                <span data-icon="lock" data-icon-width="20" data-icon-height="20"></span>
                Connexion requise
            </h5>
            <button type="button" class="modal-close" onclick="closeAuthModal()">
                <span data-icon="x" data-icon-width="24" data-icon-height="24"></span>
            </button>
        </div>
        <div style="text-align: center; padding: var(--spacing-xl);">
            <span data-icon="user-check" data-icon-width="64" data-icon-height="64" style="display: block; margin: 0 auto var(--spacing-md); color: var(--bordeaux);"></span>
            <p style="font-size: 1.125rem; margin-bottom: var(--spacing-md); color: var(--dark-text);">
                Pour commander ce menu, vous devez être connecté à votre compte.
            </p>
            <p style="color: var(--muted); margin: 0;">
                Vous n'avez pas encore de compte ? C'est rapide et gratuit !
            </p>
        </div>
        <div style="justify-content: center; padding-bottom: var(--spacing-xl);">
            <a href="{{ path('app_login') }}?redirect={{ path('app_menu_show', {id: menu.id}) }}" class="btn btn-primary btn-lg">
                <span data-icon="log-in" data-icon-width="18" data-icon-height="18"></span>
                Se connecter
            </a>
            <a href="{{ path('app_register') }}?redirect={{ path('app_menu_show', {id: menu.id}) }}" class="btn btn-outline btn-lg">
                <span data-icon="user-plus" data-icon-width="18" data-icon-height="18"></span>
                Créer un compte
            </a>
        </div>
    </div>
</div>

<script>
    // Modal management
    function closeAuthModal() {
        document.getElementById('authRequiredModal').style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('authRequiredModal');
        const trigger = document.querySelector('[data-bs-toggle="modal"]');

        if (trigger && modal) {
            trigger.addEventListener('click', function(e) {
                e.preventDefault();
                modal.style.display = 'flex';
            });
        }
    });
</script>
{% endif %}

<script>
    // Gallery thumbnail navigation
    document.addEventListener('DOMContentLoaded', function() {
        const thumbnails = document.querySelectorAll('.thumbnail');
        const mainImage = document.getElementById('mainImage');

        thumbnails.forEach(thumbnail => {
            thumbnail.addEventListener('click', function() {
                // Remove active class from all thumbnails
                thumbnails.forEach(t => t.classList.remove('active'));
                // Add active class to clicked thumbnail
                this.classList.add('active');
                // Change main image
                const newImageSrc = this.getAttribute('data-image');
                mainImage.src = newImageSrc;
            });
        });
    });
</script>

{% endblock %}
