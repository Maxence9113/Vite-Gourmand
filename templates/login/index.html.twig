{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/auth.css') }}">
{% endblock %}

{% block body %}
{# ========================================
   LOGIN SECTION - Figma Design
   ======================================== #}
<section class="auth-section">
    <div class="auth-container">

        {# Card de connexion #}
        <div class="auth-card">

            {# En-tête avec logo #}
            <div class="auth-header">
                <div class="auth-icon-wrapper">
                    <span data-icon="user-check" data-icon-width="28" data-icon-height="28"></span>
                </div>
                <h1 class="auth-title">Bienvenue</h1>
                <p class="auth-subtitle">Connectez-vous à votre compte</p>
            </div>

            {# Affichage des erreurs #}
            {% if error %}
                <div class="auth-error">
                    <span data-icon="alert-circle" data-icon-width="20" data-icon-height="20"></span>
                    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                </div>
            {% endif %}

            {# Formulaire de connexion #}
            <form action="{{ path('app_login') }}" method="post" class="auth-form">

                <div class="auth-form-group">
                    <label for="username" class="auth-label">
                        <span data-icon="mail" data-icon-width="16" data-icon-height="16"></span>
                        Adresse email
                    </label>
                    <input type="email"
                           id="username"
                           name="_username"
                           value="{{ last_username }}"
                           placeholder="nom@exemple.com"
                           required
                           autofocus
                           class="auth-input">
                </div>

                <div class="auth-form-group">
                    <label for="password" class="auth-label">
                        <span data-icon="lock" data-icon-width="16" data-icon-height="16"></span>
                        Mot de passe
                    </label>
                    <input type="password"
                           id="password"
                           name="_password"
                           placeholder="Mot de passe"
                           required
                           class="auth-input">
                </div>

                {# Mot de passe oublié #}
                <div class="auth-forgot-password">
                    <a href="{{ path('app_password_reset_request') }}">Mot de passe oublié ?</a>
                </div>

                <input type="hidden" name="_target_path" value="{{ path('app_account') }}">

                <button type="submit" class="auth-submit-btn">
                    <span data-icon="log-in" data-icon-width="18" data-icon-height="18"></span>
                    Se connecter
                </button>
            </form>

            {# Divider #}
            <div class="auth-divider">
                <span>ou</span>
            </div>

            {# Lien inscription #}
            <div class="auth-footer">
                <p>
                    Vous n'avez pas de compte ?
                    <a href="{{ path('app_register') }}">Créer un compte</a>
                </p>
            </div>

        </div>

    </div>
</section>
{% endblock %}
