{% extends 'base.html.twig' %}

{% block title %}Connexion - Vite & Gourmand{% endblock %}

{% block body %}

<div style="padding: 3rem 0;">
    <div style="display: flex; justify-content: center;">
        <div style="max-width: 500px; width: 100%;">

            {# Card de connexion #}
            <div class="login-card">

                {# En-tête avec logo #}
                <div style="text-align: center; margin-bottom: 2rem;">
                    <div style="margin-bottom: 1rem;">
                        <i data-feather="user-check" width="48" height="48"></i>
                    </div>
                    <h1 style="color: var(--primary); font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem;">Bienvenue</h1>
                    <p style="color: #6c757d;">Connectez-vous à votre compte</p>
                </div>

                {# Affichage des erreurs #}
                {% if error %}
                    <div class="alert alert-danger" role="alert" style="display: flex; align-items: center; margin-bottom: 1.5rem;">
                        <i data-feather="alert-circle" width="20" style="margin-right: 0.5rem;"></i>
                        <div>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    </div>
                {% endif %}

                {# Formulaire de connexion #}
                <form action="{{ path('app_login') }}" method="post">

                    <div class="form-group">
                        <input class="form-control"
                               type="email"
                               id="username"
                               name="_username"
                               value="{{ last_username }}"
                               placeholder="nom@exemple.com"
                               required
                               autofocus>
                        <label for="username" class="form-label">
                            <i data-feather="mail" width="16" style="margin-right: 0.25rem;"></i>
                            Adresse email
                        </label>
                    </div>

                    <div class="form-group">
                        <input class="form-control"
                               type="password"
                               id="password"
                               name="_password"
                               placeholder="Mot de passe"
                               required>
                        <label for="password" class="form-label">
                            <i data-feather="lock" width="16" style="margin-right: 0.25rem;"></i>
                            Mot de passe
                        </label>
                    </div>

                    {# Mot de passe oublié #}
                    <div style="display: flex; justify-content: flex-end; margin-bottom: 1.5rem;">
                        <a href="{{ path('app_password_reset_request') }}" style="color: var(--primary); text-decoration: none; font-size: 0.875rem;">
                            Mot de passe oublié ?
                        </a>
                    </div>

                    <input type="hidden" name="_target_path" value="{{ path('app_account') }}">

                    <button class="btn btn-primary" type="submit" style="width: 100%; padding: 12px 0;">
                        <i data-feather="log-in" width="18" style="margin-right: 0.5rem;"></i>
                        Se connecter
                    </button>
                </form>

                {# Divider #}
                <div style="margin: 1.5rem 0;">
                    <span class="divider-text">ou</span>
                </div>

                {# Lien inscription #}
                <div style="text-align: center;">
                    <p style="margin-bottom: 0; color: #6c757d;">
                        Vous n'avez pas de compte ?
                        <a href="{{ path('app_register') }}" style="color: var(--secondary); text-decoration: none; font-weight: 600;">
                            Créer un compte
                        </a>
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>

{% endblock %}
