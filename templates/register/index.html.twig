{% extends 'base.html.twig' %}

{% block title %}Inscription - Vite & Gourmand{% endblock %}

{% block body %}

<div style="padding: 3rem 0;">
    <div style="display: flex; justify-content: center;">
        <div style="max-width: 650px; width: 100%;">

            {# Card d'inscription #}
            <div class="register-card">

                {# En-tête avec logo #}
                <div style="text-align: center; margin-bottom: 2rem;">
                    <div style="margin-bottom: 1rem;">
                        <i data-feather="user-plus" width="48" height="48"></i>
                    </div>
                    <h1 style="color: var(--primary); font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem;">Créer un compte</h1>
                    <p style="color: #6c757d;">Rejoignez Vite & Gourmand</p>
                </div>

                {# Formulaire d'inscription #}
                {{ form_start(registerForm, {'attr': {'class': 'register-form'}}) }}

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        {# Prénom #}
                        <div class="form-group">
                            {{ form_widget(registerForm.firstname, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Prénom'
                                }
                            }) }}
                            <label for="{{ registerForm.firstname.vars.id }}" class="form-label">
                                <i data-feather="user" width="16" style="margin-right: 0.25rem;"></i>
                                Prénom
                            </label>
                            {{ form_errors(registerForm.firstname) }}
                        </div>

                        {# Nom #}
                        <div class="form-group">
                            {{ form_widget(registerForm.lastname, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Nom'
                                }
                            }) }}
                            <label for="{{ registerForm.lastname.vars.id }}" class="form-label">
                                <i data-feather="user" width="16" style="margin-right: 0.25rem;"></i>
                                Nom
                            </label>
                            {{ form_errors(registerForm.lastname) }}
                        </div>
                    </div>

                    {# Email #}
                    <div class="form-group">
                        {{ form_widget(registerForm.email, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'nom@exemple.com'
                            }
                        }) }}
                        <label for="{{ registerForm.email.vars.id }}" class="form-label">
                            <i data-feather="mail" width="16" style="margin-right: 0.25rem;"></i>
                            Adresse email
                        </label>
                        {{ form_errors(registerForm.email) }}
                    </div>

                    {# Mot de passe #}
                    <div style="position: relative;">
                        {{ form_widget(registerForm.plainPassword.first, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Mot de passe'
                            }
                        }) }}
                        <label for="{{ registerForm.plainPassword.first.vars.id }}" class="form-label">
                            <i data-feather="lock" width="16" style="margin-right: 0.25rem;"></i>
                            Mot de passe
                        </label>
                        <button type="button"
                                style="border: none; background: none; z-index: 10; position: absolute; right: 0; top: 50%; transform: translateY(-50%); margin-right: 0.5rem;"
                                onclick="togglePasswordVisibility('{{ registerForm.plainPassword.first.vars.id }}', this)">
                            <i data-feather="eye" width="20"></i>
                        </button>
                        {{ form_errors(registerForm.plainPassword.first) }}
                    </div>

                    {# Confirmation mot de passe #}
                    <div style="position: relative;">
                        {{ form_widget(registerForm.plainPassword.second, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Confirmer le mot de passe'
                            }
                        }) }}
                        <label for="{{ registerForm.plainPassword.second.vars.id }}" class="form-label">
                            <i data-feather="check-circle" width="16" style="margin-right: 0.25rem;"></i>
                            Confirmer le mot de passe
                        </label>
                        <button type="button"
                                style="border: none; background: none; z-index: 10; position: absolute; right: 0; top: 50%; transform: translateY(-50%); margin-right: 0.5rem;"
                                onclick="togglePasswordVisibility('{{ registerForm.plainPassword.second.vars.id }}', this)">
                            <i data-feather="eye" width="20"></i>
                        </button>
                        {{ form_errors(registerForm.plainPassword.second) }}
                    </div>

                    {# Exigences mot de passe #}
                    <div class="alert alert-info" role="alert" style="display: flex; align-items: flex-start; margin-bottom: 1.5rem;">
                        <i data-feather="info" width="20" style="margin-right: 0.5rem; margin-top: 0.25rem;"></i>
                        <div>
                            <small>
                                <strong>Exigences du mot de passe :</strong><br>
                                Minimum 10 caractères avec au moins 1 majuscule, 1 minuscule, 1 chiffre et 1 caractère spécial.
                            </small>
                        </div>
                    </div>

                    {# Bouton de soumission personnalisé #}
                    <button type="submit" style="width: 100%; padding: 12px 0; margin-bottom: 1rem;">
                        <i data-feather="user-plus" width="18" style="margin-right: 0.5rem;"></i>
                        Créer mon compte
                    </button>

                {{ form_end(registerForm) }}

                {# Divider #}
                <div style="margin: 1.5rem 0;">
                    <span class="divider-text">ou</span>
                </div>

                {# Lien connexion #}
                <div style="text-align: center;">
                    <p style="margin-bottom: 0; color: #6c757d;">
                        Vous avez déjà un compte ?
                        <a href="{{ path('app_login') }}" style="color: var(--secondary); text-decoration: none; font-weight: 600;">
                            Se connecter
                        </a>
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>

<script>
function togglePasswordVisibility(inputId, button) {
    const input = document.getElementById(inputId);
    const icon = button.querySelector('i');

    if (input.type === 'password') {
        input.type = 'text';
        icon.setAttribute('data-feather', 'eye-off');
    } else {
        input.type = 'password';
        icon.setAttribute('data-feather', 'eye');
    }

    // Réinitialiser les icônes Feather
    if (typeof feather !== 'undefined') {
        feather.replace();
    }
}
</script>

{% endblock %}
