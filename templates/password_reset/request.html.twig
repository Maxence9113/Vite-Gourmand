{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Vite & Gourmand{% endblock %}

{% block body %}

<div style="padding: 3rem 0;">
    <div style="display: flex; justify-content: center;">
        <div style="max-width: 500px; width: 100%;">

            {# Card de réinitialisation #}
            <div class="login-card">

                {# En-tête avec logo #}
                <div style="margin-bottom: 25px;">
                    <div style="margin-bottom: 20px;">
                        <i data-feather="key" width="48" height="48"></i>
                    </div>
                    <h1 style="margin-bottom: 10px;; color: var(--primary);">Mot de passe oublié</h1>
                    <p style="color: #95a5a6;">Entrez votre email pour réinitialiser votre mot de passe</p>
                </div>

                {# Affichage des messages #}
                {% for message in app.flashes('success') %}
                    <div style="margin-bottom: 25px;" role="alert">
                        <i data-feather="check-circle" width="20" style="margin-right: 0.5rem;"></i>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div style="margin-bottom: 25px;" role="alert">
                        <i data-feather="alert-circle" width="20" style="margin-right: 0.5rem;"></i>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}

                {# Information #}
                <div style="margin-bottom: 25px;" role="alert">
                    <i data-feather="info" width="20" style="margin-right: 0.5rem; margin-top: 0.25rem;"></i>
                    <div>
                        <small>
                            Un lien de réinitialisation vous sera envoyé par email.
                            Ce lien sera valable pendant 1 heure.
                        </small>
                    </div>
                </div>

                {# Formulaire #}
                <form method="post">
                    <div style="margin-bottom: 20px;">
                        <input class="form-control"
                               type="email"
                               id="email"
                               name="email"
                               placeholder="nom@exemple.com"
                               required
                               autofocus>
                        <label for="email">
                            <i data-feather="mail" width="16" style="margin-right: 0.25rem;"></i>
                            Adresse email
                        </label>
                    </div>

                    <button style="margin-bottom: 20px;" type="submit">
                        <i data-feather="send" width="18" style="margin-right: 0.5rem;"></i>
                        Envoyer le lien de réinitialisation
                    </button>
                </form>

                {# Divider #}
                <div style="margin: 1.5rem 0;">
                    <span class="divider-text">ou</span>
                </div>

                {# Lien retour à la connexion #}
                <div style="text-align: center;">
                    <a href="{{ path('app_login') }}" style="color: var(--primary); text-decoration: none;">
                        <i data-feather="arrow-left" width="16" style="margin-right: 0.25rem;"></i>
                        Retour à la connexion
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>

{% endblock %}