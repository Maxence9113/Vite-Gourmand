{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
{# ========================================
   PASSWORD RESET REQUEST - Figma Design
   ======================================== #}
<section class="auth-section">
    <div class="auth-container">

        {# Card de réinitialisation #}
        <div class="auth-card">

            {# En-tête avec logo #}
            <div class="auth-header">
                <div class="auth-icon-circle">
                    <span data-icon="key" data-icon-width="28" data-icon-height="28" class="text-white"></span>
                </div>
                <h1 class="auth-title">Mot de passe oublié</h1>
                <p class="auth-header-subtitle">Entrez votre email pour réinitialiser votre mot de passe</p>
            </div>

            {# Affichage des messages #}
            {% for message in app.flashes('success') %}
                <div class="flash-success">
                    <span data-icon="check-circle" data-icon-width="20" data-icon-height="20"></span>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="flash-error">
                    <span data-icon="alert-circle" data-icon-width="20" data-icon-height="20"></span>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            {# Information #}
            <div class="info-box">
                <span data-icon="info" data-icon-width="20" data-icon-height="20"></span>
                <div class="info-box-content">
                    Un lien de réinitialisation vous sera envoyé par email.
                    Ce lien sera valable pendant 1 heure.
                </div>
            </div>

            {# Formulaire #}
            <form method="post">
                <div class="form-field">
                    <label for="email" class="form-label-with-icon">
                        <span data-icon="mail" data-icon-width="16" data-icon-height="16"></span>
                        Adresse email
                    </label>
                    <input type="email"
                           id="email"
                           name="email"
                           placeholder="nom@exemple.com"
                           required
                           autofocus
                           class="form-input">
                </div>

                <button type="submit" class="submit-btn">
                    <span data-icon="send" data-icon-width="18" data-icon-height="18"></span>
                    Envoyer le lien de réinitialisation
                </button>
            </form>

            {# Divider #}
            <div class="divider-with-text">
                <div class="divider-line"></div>
                <span class="divider-text">ou</span>
            </div>

            {# Lien retour à la connexion #}
            <div class="text-center">
                <a href="{{ path('app_login') }}" class="back-link">
                    <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
                    Retour à la connexion
                </a>
            </div>

        </div>

    </div>
</section>
{% endblock %}
