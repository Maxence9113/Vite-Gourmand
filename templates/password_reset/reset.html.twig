{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
{# ========================================
   PASSWORD RESET - Figma Design
   ======================================== #}
<section class="auth-section">
    <div class="auth-container">

        {# Card de réinitialisation #}
        <div class="auth-card">

            {# En-tête avec logo #}
            <div class="auth-header">
                <div class="auth-icon-circle">
                    <span data-icon="lock" data-icon-width="28" data-icon-height="28" class="text-white"></span>
                </div>
                <h1 class="auth-title">Nouveau mot de passe</h1>
                <p class="auth-header-subtitle">Choisissez un nouveau mot de passe sécurisé</p>
            </div>

            {# Affichage des messages #}
            {% for message in app.flashes('error') %}
                <div class="flash-error">
                    <span data-icon="alert-circle" data-icon-width="20" data-icon-height="20"></span>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            {# Exigences mot de passe #}
            <div class="password-requirements">
                <span data-icon="info" data-icon-width="20" data-icon-height="20"></span>
                <div class="password-requirements-content">
                    <p class="password-requirements-title">Exigences du mot de passe</p>
                    <p class="password-requirements-text">
                        Minimum 10 caractères avec au moins 1 majuscule, 1 minuscule, 1 chiffre et 1 caractère spécial.
                    </p>
                </div>
            </div>

            {# Formulaire #}
            <form method="post" id="resetPasswordForm">
                <div class="form-field-with-button">
                    <label for="password" class="form-label-with-icon">
                        <span data-icon="lock" data-icon-width="16" data-icon-height="16"></span>
                        Nouveau mot de passe
                    </label>
                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="Nouveau mot de passe"
                           required
                           minlength="10"
                           autofocus
                           class="form-input">
                    <button type="button"
                            class="toggle-visibility-btn"
                            onclick="togglePasswordVisibility('password', this)">
                        <span data-icon="eye" data-icon-width="20" data-icon-height="20"></span>
                    </button>
                </div>

                <div class="form-field-with-button">
                    <label for="confirm_password" class="form-label-with-icon">
                        <span data-icon="check-circle" data-icon-width="16" data-icon-height="16"></span>
                        Confirmer le mot de passe
                    </label>
                    <input type="password"
                           id="confirm_password"
                           name="confirm_password"
                           placeholder="Confirmer le mot de passe"
                           required
                           minlength="10"
                           class="form-input">
                    <button type="button"
                            class="toggle-visibility-btn"
                            onclick="togglePasswordVisibility('confirm_password', this)">
                        <span data-icon="eye" data-icon-width="20" data-icon-height="20"></span>
                    </button>
                </div>

                <button type="submit" class="submit-btn">
                    <span data-icon="save" data-icon-width="18" data-icon-height="18"></span>
                    Réinitialiser mon mot de passe
                </button>
            </form>

            {# Divider #}
            <div class="divider-with-text">
                <div class="divider-line"></div>
                <span class="divider-text">ou</span>
            </div>

            {# Lien retour à la connexion #}
            <div class="text-center">
                <a href="{{ path('app_login') }}" class="back-link">
                    <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
                    Retour à la connexion
                </a>
            </div>

        </div>

    </div>
</section>

<script>
function togglePasswordVisibility(inputId, button) {
    const input = document.getElementById(inputId);
    const icon = button.querySelector('span[data-icon]');

    if (input.type === 'password') {
        input.type = 'text';
        icon.setAttribute('data-icon', 'eye-off');
    } else {
        input.type = 'password';
        icon.setAttribute('data-icon', 'eye');
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('resetPasswordForm');
    const passwordInput = document.getElementById('password');
    const confirmPasswordInput = document.getElementById('confirm_password');

    form.addEventListener('submit', function(e) {
        const password = passwordInput.value;
        const confirmPassword = confirmPasswordInput.value;

        // Vérifier que les mots de passe correspondent
        if (password !== confirmPassword) {
            e.preventDefault();
            alert('Les mots de passe ne correspondent pas.');
            return;
        }

        // Validation de la complexité du mot de passe
        const hasUpperCase = /[A-Z]/.test(password);
        const hasLowerCase = /[a-z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSpecialChar = /[!@#$%^&*(),.?":{}|<>]/.test(password);

        if (!hasUpperCase || !hasLowerCase || !hasNumber || !hasSpecialChar) {
            e.preventDefault();
            alert('Le mot de passe doit contenir au moins une majuscule, une minuscule, un chiffre et un caractère spécial.');
        }
    });
});
</script>

{% endblock %}
