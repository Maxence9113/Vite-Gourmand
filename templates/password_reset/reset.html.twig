{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - Vite & Gourmand{% endblock %}

{% block body %}

<div style="padding: 3rem 0;">
    <div style="display: flex; justify-content: center;">
        <div style="max-width: 500px; width: 100%;">

            {# Card de réinitialisation #}
            <div class="login-card">

                {# En-tête avec logo #}
                <div style="margin-bottom: 25px;">
                    <div style="margin-bottom: 20px;">
                        <i data-feather="lock" width="48" height="48"></i>
                    </div>
                    <h1 style="margin-bottom: 10px;; color: var(--primary);">Nouveau mot de passe</h1>
                    <p style="color: #95a5a6;">Choisissez un nouveau mot de passe sécurisé</p>
                </div>

                {# Affichage des messages #}
                {% for message in app.flashes('error') %}
                    <div style="margin-bottom: 25px;" role="alert">
                        <i data-feather="alert-circle" width="20" style="margin-right: 0.5rem;"></i>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}

                {# Exigences mot de passe #}
                <div style="margin-bottom: 25px;" role="alert">
                    <i data-feather="info" width="20" style="margin-right: 0.5rem; margin-top: 0.25rem;"></i>
                    <div>
                        <small>
                            <strong>Exigences du mot de passe :</strong><br>
                            Minimum 10 caractères avec au moins 1 majuscule, 1 minuscule, 1 chiffre et 1 caractère spécial.
                        </small>
                    </div>
                </div>

                {# Formulaire #}
                <form method="post" id="resetPasswordForm">
                    <div style="margin-bottom: 1rem; position: relative;">
                        <input class="form-control"
                               type="password"
                               id="password"
                               name="password"
                               placeholder="Nouveau mot de passe"
                               required
                               minlength="10"
                               autofocus>
                        <label for="password">
                            <i data-feather="lock" width="16" style="margin-right: 0.25rem;"></i>
                            Nouveau mot de passe
                        </label>
                        <button type="button"
                                class="btn btn-sm"
                                style="border: none; background: none; z-index: 10; position: absolute; right: 0; top: 50%; transform: translateY(-50%); margin-right: 0.5rem;"
                                onclick="togglePasswordVisibility('password', this)">
                            <i data-feather="eye" width="20"></i>
                        </button>
                    </div>

                    <div style="margin-bottom: 1rem; position: relative;">
                        <input class="form-control"
                               type="password"
                               id="confirm_password"
                               name="confirm_password"
                               placeholder="Confirmer le mot de passe"
                               required
                               minlength="10">
                        <label for="confirm_password">
                            <i data-feather="check-circle" width="16" style="margin-right: 0.25rem;"></i>
                            Confirmer le mot de passe
                        </label>
                        <button type="button"
                                class="btn btn-sm"
                                style="border: none; background: none; z-index: 10; position: absolute; right: 0; top: 50%; transform: translateY(-50%); margin-right: 0.5rem;"
                                onclick="togglePasswordVisibility('confirm_password', this)">
                            <i data-feather="eye" width="20"></i>
                        </button>
                    </div>

                    <button style="margin-bottom: 20px;" type="submit">
                        <i data-feather="save" width="18" style="margin-right: 0.5rem;"></i>
                        Réinitialiser mon mot de passe
                    </button>
                </form>

                {# Divider #}
                <div style="margin: 1.5rem 0;">
                    <span class="divider-text">ou</span>
                </div>

                {# Lien retour à la connexion #}
                <div style="text-align: center;">
                    <a href="{{ path('app_login') }}" style="color: var(--primary); text-decoration: none;">
                        <i data-feather="arrow-left" width="16" style="margin-right: 0.25rem;"></i>
                        Retour à la connexion
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>

<script>
function togglePasswordVisibility(inputId, button) {
    const input = document.getElementById(inputId);
    const icon = button.querySelector('i');

    if (input.type === 'password') {
        input.type = 'text';
        icon.setAttribute('data-feather', 'eye-off');
    } else {
        input.type = 'password';
        icon.setAttribute('data-feather', 'eye');
    }

    // Réinitialiser les icônes Feather
    if (typeof feather !== 'undefined') {
        feather.replace();
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('resetPasswordForm');
    const passwordInput = document.getElementById('password');
    const confirmPasswordInput = document.getElementById('confirm_password');

    form.addEventListener('submit', function(e) {
        const password = passwordInput.value;
        const confirmPassword = confirmPasswordInput.value;

        // Vérifier que les mots de passe correspondent
        if (password !== confirmPassword) {
            e.preventDefault();
            alert('Les mots de passe ne correspondent pas.');
            return;
        }

        // Validation de la complexité du mot de passe
        const hasUpperCase = /[A-Z]/.test(password);
        const hasLowerCase = /[a-z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSpecialChar = /[!@#$%^&*(),.?":{}|<>]/.test(password);

        if (!hasUpperCase || !hasLowerCase || !hasNumber || !hasSpecialChar) {
            e.preventDefault();
            alert('Le mot de passe doit contenir au moins une majuscule, une minuscule, un chiffre et un caractère spécial.');
        }
    });
});
</script>

{% endblock %}