{# FOOTER - Copié depuis la maquette Figma #}
<footer class="footer">
    <div class="container footer-container">
        <div class="footer-grid">
            {# Contact #}
            <div class="footer-section">
                <h3 class="footer-title">Contact</h3>
                <div class="footer-content">
                    <div class="footer-item">
                        <span data-icon="map-pin" data-icon-width="20" data-icon-height="20" class="footer-icon"></span>
                        <span>25 Rue des Chartrons<br>33000 Bordeaux</span>
                    </div>
                    <div class="footer-item">
                        <span data-icon="phone" data-icon-width="20" data-icon-height="20" class="footer-icon"></span>
                        <a href="tel:+33556123456" class="footer-link">05 56 12 34 56</a>
                    </div>
                    <div class="footer-item">
                        <span data-icon="mail" data-icon-width="20" data-icon-height="20" class="footer-icon"></span>
                        <a href="mailto:contact@vite-gourmand.fr" class="footer-link">contact@vite-gourmand.fr</a>
                    </div>
                </div>
                <a href="{{ path('app_contact') }}" class="btn btn-footer">
                    Nous contacter
                </a>
            </div>

            {# Horaires #}
            <div class="footer-section">
                <h3 class="footer-title">Horaires</h3>
                <div class="footer-content">
                    <div class="footer-item">
                        <span data-icon="clock" data-icon-width="20" data-icon-height="20" class="footer-icon"></span>
                        <div class="footer-schedule">
                            {% if opening_schedules is defined and opening_schedules is not empty %}
                                {% for schedule in opening_schedules %}
                                    <p>
                                        {{ schedule.label }} :
                                        {% if schedule.isOpen and schedule.openingTime and schedule.closingTime %}
                                            {{ schedule.openingTime }} - {{ schedule.closingTime }}
                                        {% else %}
                                            <span class="text-closed">Fermé</span>
                                        {% endif %}
                                    </p>
                                {% endfor %}
                            {% else %}
                                <p>Lundi - Vendredi : 9h - 18h</p>
                                <p>Samedi : 10h - 16h</p>
                                <p>Dimanche : Sur commande</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# Informations légales #}
            <div class="footer-section">
                <h3 class="footer-title">Informations légales</h3>
                <div class="footer-content">
                    <div class="footer-legal">
                        <a href="{{ path('app_legal_mentions') }}" class="footer-legal-link">Mentions légales</a>
                        <a href="{{ path('app_legal_cgv') }}" class="footer-legal-link">Conditions générales de vente</a>
                        <a href="{{ path('app_legal_privacy') }}" class="footer-legal-link">Politique de confidentialité</a>
                    </div>
                </div>
            </div>
        </div>

        {# Copyright bar #}
        <div class="footer-copyright">
            <p>&copy; {{ 'now'|date('Y') }} Vite & Gourmand - Traiteur gastronomique à Bordeaux depuis 1999</p>
        </div>
    </div>
</footer>
