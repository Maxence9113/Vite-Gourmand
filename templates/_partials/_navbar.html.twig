{# HEADER - Copié depuis la maquette Figma #}
<header class="header">
    <div class="container header-container">
        {# Logo #}
        <a href="{{ path('app_home') }}" class="header-logo">
            <div class="logo-icon">
                <span data-icon="chef-hat" data-icon-width="28" data-icon-height="28"></span>
            </div>
            <div class="logo-text">
                <h1>Vite & Gourmand</h1>
                <p class="logo-subtitle">Traiteur gastronomique depuis 1999</p>
            </div>
        </a>

        {# Desktop Navigation #}
        <nav class="header-nav">
            <a href="{{ path('app_home') }}"
               class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}">
                Accueil
            </a>
            <a href="{{ path('app_menu_catalog') }}"
               class="nav-link {% if app.request.attributes.get('_route') starts with 'app_menu' %}active{% endif %}">
                Menus
            </a>
            <a href="{{ path('app_contact') }}"
               class="nav-link {% if app.request.attributes.get('_route') == 'app_contact' %}active{% endif %}">
                Contact
            </a>
        </nav>

        {# User Actions - Desktop #}
        <div class="header-actions">
            {% if app.user %}
                <a href="{{ path('app_account') }}" class="btn-account">
                    <div class="account-avatar">
                        <span data-icon="user" data-icon-width="16" data-icon-height="16"></span>
                    </div>
                    <span class="account-name">{{ app.user.firstname }} {{ app.user.lastname }}</span>
                </a>
                {% if is_granted('ROLE_EMPLOYEE') %}
                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-admin">
                        <span data-icon="shield" data-icon-width="16" data-icon-height="16"></span>
                        Admin
                    </a>
                {% endif %}
                <a href="{{ path('app_logout') }}" class="btn btn-outline">
                    <span data-icon="log-out" data-icon-width="16" data-icon-height="16"></span>
                    Déconnexion
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-user">
                    <span data-icon="log-in" data-icon-width="20" data-icon-height="20"></span>
                    Connexion
                </a>
                <a href="{{ path('app_register') }}" class="btn btn-outline">
                    <span data-icon="user-plus" data-icon-width="20" data-icon-height="20"></span>
                    S'inscrire
                </a>
            {% endif %}
        </div>

        {# Mobile Menu Button #}
        <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle">
            <span data-icon="menu" data-icon-width="24" data-icon-height="24"></span>
        </button>
    </div>

    {# Mobile Menu #}
    <div class="mobile-menu" id="mobileMenu">
        <nav class="mobile-nav">
            <a href="{{ path('app_home') }}"
               class="mobile-nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}">
                Accueil
            </a>
            <a href="{{ path('app_menu_catalog') }}"
               class="mobile-nav-link {% if app.request.attributes.get('_route') starts with 'app_menu' %}active{% endif %}">
                Menus
            </a>
            <a href="{{ path('app_contact') }}"
               class="mobile-nav-link {% if app.request.attributes.get('_route') == 'app_contact' %}active{% endif %}">
                Contact
            </a>
            {% if app.user %}
                <a href="{{ path('app_account') }}" style="width: 100%; margin-top: 1rem;">
                    <span data-icon="user" data-icon-width="20" data-icon-height="20"></span>
                    Mon compte
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" style="width: 100%; margin-top: 1rem;">
                    <span data-icon="log-in" data-icon-width="20" data-icon-height="20"></span>
                    Connexion
                </a>
                <a href="{{ path('app_register') }}" style="width: 100%; margin-top: 0.5rem;">
                    <span data-icon="user-plus" data-icon-width="20" data-icon-height="20"></span>
                    S'inscrire
                </a>
            {% endif %}
        </nav>
    </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Mobile menu
    const mobileToggle = document.getElementById('mobileMenuToggle');
    const mobileMenu = document.getElementById('mobileMenu');

    if (mobileToggle && mobileMenu) {
        mobileToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            mobileMenu.classList.toggle('show');

            // Change icon
            const icon = this.querySelector('[data-icon]');
            const currentIcon = icon.getAttribute('data-icon');
            icon.setAttribute('data-icon', currentIcon === 'menu' ? 'x' : 'menu');

            // Reinit icons
            window.ViteGourmand?.initIcons?.();
        });

        // Close on link click
        const mobileLinks = mobileMenu.querySelectorAll('a');
        mobileLinks.forEach(link => {
            link.addEventListener('click', function() {
                mobileMenu.classList.remove('show');
                const icon = mobileToggle.querySelector('[data-icon]');
                icon.setAttribute('data-icon', 'menu');
                window.ViteGourmand?.initIcons?.();
            });
        });
    }
});
</script>
