{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Allergènes - Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/admin-lists.css') }}">
{% endblock %}

{% block content %}
<div class="list-header">
    <h1>
        ⚠️ Gestion des allergènes
    </h1>
    <a href="{{ path('app_admin_allergens_new') }}" class="btn-add">
        <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
        Ajouter un allergène
    </a>
</div>

{# Afficher les messages flash #}
{% for message in app.flashes('success') %}
    <div class="flash-success-list">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="flash-error-list">
        {{ message }}
    </div>
{% endfor %}

<!-- Liste des allergènes -->
<div class="list-container">
    <div class="list-search-bar">
        <div class="list-search-wrapper">
            <span data-icon="search" data-icon-width="20" data-icon-height="20" class="list-search-icon"></span>
            <input type="text" id="searchInput" placeholder="Rechercher un allergène..." class="list-search-input">
        </div>
    </div>

    {% if allergens is empty %}
        <div class="list-empty-state">
            <span data-icon="inbox" data-icon-width="48" data-icon-height="48" class="list-empty-icon"></span>
            <p class="list-empty-text">Aucun allergène trouvé.</p>
        </div>
    {% else %}
        <div class="list-table-wrapper">
            <table class="list-table small-list">
                <colgroup>
                    <col>
                    <col>
                    <col>
                </colgroup>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for allergen in allergens %}
                    <tr class="allergen-row">
                        <td>{{ allergen.id }}</td>
                        <td><strong>{{ allergen.name }}</strong></td>
                        <td>
                            <div class="crud-actions">
                                <a href="{{ path('app_admin_allergens_edit', {id: allergen.id}) }}" class="btn-crud btn-crud-edit">
                                    <span data-icon="edit" data-icon-width="16" data-icon-height="16"></span>
                                    <span class="btn-crud-text">Modifier</span>
                                </a>
                                <form method="post" action="{{ path('app_admin_allergens_delete', {id: allergen.id}) }}" class="delete-form">
                                    <button type="submit" class="btn-crud btn-crud-delete">
                                        <span data-icon="trash-2" data-icon-width="16" data-icon-height="16"></span>
                                        <span class="btn-crud-text">Supprimer</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Script pour la recherche en temps réel et le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure la dernière colonne "Actions")
    initTableSort('allergensTable', {
        excludeColumns: [2]
    });

    // Recherche en temps réel
    document.getElementById('searchInput')?.addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('.allergen-row');

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.classList.toggle('hidden', !text.includes(searchTerm));
            if (text.includes(searchTerm)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Confirmation de suppression
    document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const allergenName = this.closest('tr').querySelector('strong').textContent;
            if (!confirm(`Êtes-vous sûr de vouloir supprimer l'allergène « ${allergenName} » ?`)) {
                e.preventDefault();
            }
        });
    });
</script>
{% endblock %}
