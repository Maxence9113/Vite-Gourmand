{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Menus{% endblock %}
{% block page_title %}Gestion des Menus{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ importmap('admin-menus-list-styles') }}
{% endblock %}

{% block content %}

<div class="action-bar">
    <div class="search-box">
        <input type="text" placeholder="🔍 Rechercher un menu..." id="searchInput">
    </div>
    <a href="{{ path('app_admin_menus_new') }}" class="btn-add">+ Ajouter un menu</a>
</div>

<div class="table-container">
    <table class="table table-sortable" id="menusTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Thème</th>
                <th>Régimes</th>
                <th>Prix/pers</th>
                <th>Min. pers.</th>
                <th>Recettes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for menu in menus %}
            <tr class="menu-row">
                <td><strong>#{{ menu.id }}</strong></td>
                <td>{{ menu.name }}</td>
                <td data-sort="{{ menu.theme.name }}"><span class="badge badge-primary">{{ menu.theme.name }}</span></td>
                <td data-sort="{% if menu.dietetary|length > 0 %}{% for diet in menu.dietetary %}{{ diet.name }} {% endfor %}{% else %}-{% endif %}">
                    {% if menu.dietetary|length > 0 %}
                        {% for diet in menu.dietetary %}
                            <span class="badge badge-success">{{ diet.name }}</span>
                        {% endfor %}
                    {% else %}
                        <span style="color: #95a5a6;">-</span>
                    {% endif %}
                </td>
                <td data-sort="{{ menu.pricePerPerson }}">{{ menu.pricePerPerson|number_format(2, ',', ' ') }} €</td>
                <td>{{ menu.nbPersonMin }}</td>
                <td data-sort="{{ menu.recipes|length }}">{{ menu.recipes|length }}</td>
                <td>
                    <a href="{{ path('app_admin_menus_edit', {id: menu.id}) }}" class="btn btn-warning">
                        Modifier
                    </a>
                    <form method="post"
                          action="{{ path('app_admin_menus_delete', {id: menu.id}) }}"
                          style="display: inline;"
                          data-confirm="Êtes-vous sûr de vouloir supprimer le menu « {{ menu.name }} » ?">
                        <button type="submit" class="btn btn-danger">
                            Supprimer
                        </button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="8" class="empty-state">
                    Aucun menu trouvé. <a href="{{ path('app_admin_menus_new') }}" style="color: #3498db;">Créer un nouveau menu</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="margin-top: 20px; color: #7f8c8d; font-size: 0.9rem;">
        Total : <strong>{{ menus|length }}</strong> menu(s)
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('table-search') }}
    {{ importmap('confirmation-dialog') }}
    <script src="{{ asset('table-sort.js') }}"></script>
    <script>
        // Initialiser le tri du tableau
        initTableSort('menusTable', {
            excludeColumns: [7]
        });

        // Initialiser la recherche en temps réel
        initTableSearch('searchInput', '.menu-row');
    </script>
{% endblock %}