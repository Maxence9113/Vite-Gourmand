{% extends 'admin/base_admin.html.twig' %}
{% block title %}Gestion des Menus{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/pages/admin-lists.css') }}">{% endblock %}
{% block content %}
<div class="list-header"><h1>📋 Gestion des menus</h1><a href="{{ path('app_admin_menus_new') }}" class="btn-add"><span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>Ajouter un menu</a></div>
{% for message in app.flashes('success') %}<div class="flash-success-list">{{ message }}</div>{% endfor %}
<div class="list-container">
    <div class="list-search-bar"><div class="list-search-wrapper"><span data-icon="search" data-icon-width="20" data-icon-height="20" class="list-search-icon"></span><input type="text" id="searchInput" placeholder="Rechercher..." class="list-search-input"></div></div>
    {% if menus is empty %}<div class="list-empty-state"><span data-icon="inbox" data-icon-width="48" data-icon-height="48" class="list-empty-icon"></span><p class="list-empty-text">Aucun menu trouvé.</p></div>
    {% else %}<div class="list-table-wrapper"><table class="list-table"><thead><tr><th>ID</th><th>Nom</th><th>Thème</th><th>Prix</th><th>Actions</th></tr></thead><tbody>
    {% for menu in menus %}<tr class="menu-row"><td>{{ menu.id }}</td><td><strong>{{ menu.name }}</strong></td><td>{{ menu.theme.name }}</td><td>{{ (menu.pricePerPerson / 100)|number_format(2) }}€</td><td><div class="crud-actions"><a href="{{ path('app_admin_menus_edit', {id: menu.id}) }}" class="btn-crud btn-crud-edit"><span data-icon="edit" data-icon-width="16" data-icon-height="16"></span><span class="btn-crud-text">Modifier</span></a><form method="post" action="{{ path('app_admin_menus_delete', {id: menu.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce menu ?');"><button type="submit" class="btn-crud btn-crud-delete"><span data-icon="trash-2" data-icon-width="16" data-icon-height="16"></span><span class="btn-crud-text">Supprimer</span></button></form></div></td></tr>{% endfor %}
    </tbody></table></div>{% endif %}
</div>
<script>document.getElementById('searchInput')?.addEventListener('input', function(e) {const s = e.target.value.toLowerCase();document.querySelectorAll('.menu-row').forEach(r => r.style.display = r.textContent.toLowerCase().includes(s) ? '' : 'none');});</script>
{% endblock %}
