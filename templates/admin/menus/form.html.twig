{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ isEdit ? 'Modifier' : 'Nouveau' }} menu{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/pages/admin-forms.css') }}">{% endblock %}
{% block content %}
<div class="form-header">
    <h1><span data-icon="file-text" data-icon-width="32" data-icon-height="32" class="form-header-icon"></span>{{ isEdit ? 'Modifier le menu' : 'Nouveau menu' }}</h1>
    <a href="{{ path('app_admin_menus') }}" class="btn-back"><span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>Retour</a>
</div>
{% for message in app.flashes('success') %}<div class="flash-success-inline">{{ message }}</div>{% endfor %}
<div class="form-card">
    {{ form_start(form) }}
    <div class="form-section">
        <div class="section-header">
            <span data-icon="info" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Informations générales</h3>
        </div>
        <div class="section-body">
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}
            <div class="form-grid two-cols">
                {{ form_row(form.theme) }}
                {{ form_row(form.price_per_person) }}
            </div>
            <div class="form-grid two-cols">
                {{ form_row(form.nb_person_min) }}
                {{ form_row(form.stock) }}
            </div>
        </div>
    </div>
    <div class="form-section">
        <div class="section-header">
            <span data-icon="image" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Illustration</h3>
        </div>
        <div class="section-body">
            {{ form_row(form.imageFile) }}
            {{ form_row(form.textAlt) }}
        </div>
    </div>
    <div class="form-section">
        <div class="section-header">
            <span data-icon="utensils-crossed" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Recettes du menu</h3>
        </div>
        <div class="section-body">
            {# Entrées #}
            <div class="recipe-accordion">
                <div class="accordion-header" data-accordion="entrees">
                    <div class="accordion-title">
                        <span data-icon="salad" data-icon-width="20" data-icon-height="20" class="accordion-icon"></span>
                        <span>Entrées</span>
                        <span class="accordion-badge" data-count="entrees">0</span>
                    </div>
                    <span data-icon="chevron-down" data-icon-width="20" data-icon-height="20" class="accordion-chevron"></span>
                </div>
                <div class="accordion-content" id="accordion-entrees">
                    <div class="accordion-body">
                        {{ form_widget(form.entrees) }}
                    </div>
                </div>
            </div>

            {# Plats #}
            <div class="recipe-accordion">
                <div class="accordion-header" data-accordion="plats">
                    <div class="accordion-title">
                        <span data-icon="utensils" data-icon-width="20" data-icon-height="20" class="accordion-icon"></span>
                        <span>Plats</span>
                        <span class="accordion-badge" data-count="plats">0</span>
                    </div>
                    <span data-icon="chevron-down" data-icon-width="20" data-icon-height="20" class="accordion-chevron"></span>
                </div>
                <div class="accordion-content" id="accordion-plats">
                    <div class="accordion-body">
                        {{ form_widget(form.plats) }}
                    </div>
                </div>
            </div>

            {# Fromages #}
            <div class="recipe-accordion">
                <div class="accordion-header" data-accordion="fromages">
                    <div class="accordion-title">
                        <span data-icon="cookie" data-icon-width="20" data-icon-height="20" class="accordion-icon"></span>
                        <span>Fromages</span>
                        <span class="accordion-badge" data-count="fromages">0</span>
                    </div>
                    <span data-icon="chevron-down" data-icon-width="20" data-icon-height="20" class="accordion-chevron"></span>
                </div>
                <div class="accordion-content" id="accordion-fromages">
                    <div class="accordion-body">
                        {{ form_widget(form.fromages) }}
                    </div>
                </div>
            </div>

            {# Desserts #}
            <div class="recipe-accordion">
                <div class="accordion-header" data-accordion="desserts">
                    <div class="accordion-title">
                        <span data-icon="cake" data-icon-width="20" data-icon-height="20" class="accordion-icon"></span>
                        <span>Desserts</span>
                        <span class="accordion-badge" data-count="desserts">0</span>
                    </div>
                    <span data-icon="chevron-down" data-icon-width="20" data-icon-height="20" class="accordion-chevron"></span>
                </div>
                <div class="accordion-content" id="accordion-desserts">
                    <div class="accordion-body">
                        {{ form_widget(form.desserts) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-section">
        <div class="section-header">
            <span data-icon="leaf" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Régimes alimentaires</h3>
        </div>
        <div class="section-body">
            {{ form_row(form.dietetary) }}
        </div>
    </div>
    <div class="form-actions">
        <div class="form-actions-left">
            <a href="{{ path('app_admin_menus') }}" class="btn-cancel">
                <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>Annuler
            </a>
            {% if isEdit %}
                <button type="button" class="btn-delete" onclick="if(confirm('Êtes-vous sûr de vouloir supprimer ce menu ?')) document.getElementById('delete-form').submit();">
                    <span data-icon="trash-2" data-icon-width="16" data-icon-height="16"></span>Supprimer
                </button>
            {% endif %}
        </div>
        <button type="submit" class="btn-submit">
            <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>{{ isEdit ? 'Enregistrer' : 'Créer' }}
        </button>
    </div>
    {{ form_end(form) }}
</div>
{% if isEdit %}
<div class="info-box"><strong>ID:</strong> {{ menu.id }}</div>

{# Formulaire caché pour la suppression #}
<form id="delete-form" method="post" action="{{ path('app_admin_menus_delete', {id: menu.id}) }}" class="hidden-form"></form>
{% endif %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion de l'accordéon
    document.querySelectorAll('.accordion-header').forEach(header => {
        header.addEventListener('click', function(e) {
            // Ne pas toggle l'accordéon si on clique sur un checkbox ou un label
            if (e.target.closest('input') || e.target.closest('label')) {
                return;
            }

            const accordionId = this.dataset.accordion;
            const content = document.getElementById('accordion-' + accordionId);

            // Toggle l'accordéon actuel
            this.classList.toggle('active');
            content.classList.toggle('active');
        });
    });

    // Empêcher la propagation des clics sur les checkboxes vers l'accordéon
    document.querySelectorAll('.accordion-body').forEach(body => {
        body.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    });

    // Fonction pour compter les checkboxes cochées
    function updateCounts() {
        ['entrees', 'plats', 'fromages', 'desserts'].forEach(category => {
            const container = document.getElementById('accordion-' + category);
            if (container) {
                const checkboxes = container.querySelectorAll('input[type="checkbox"]');
                const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
                const badge = document.querySelector(`[data-count="${category}"]`);
                if (badge) {
                    badge.textContent = checkedCount;
                    // Changer la couleur du badge si des items sont sélectionnés
                    if (checkedCount > 0) {
                        badge.style.background = 'var(--gold)';
                    } else {
                        badge.style.background = 'var(--bordeaux)';
                    }
                }
            }
        });
    }

    // Initialiser les compteurs
    updateCounts();

    // Écouter les changements sur les checkboxes
    document.querySelectorAll('.accordion-body input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', updateCounts);
    });

    // Ouvrir automatiquement les accordéons qui ont des items sélectionnés
    ['entrees', 'plats', 'fromages', 'desserts'].forEach(category => {
        const container = document.getElementById('accordion-' + category);
        if (container) {
            const checkboxes = container.querySelectorAll('input[type="checkbox"]');
            const hasChecked = Array.from(checkboxes).some(cb => cb.checked);
            if (hasChecked) {
                const header = document.querySelector(`[data-accordion="${category}"]`);
                header.classList.add('active');
                container.classList.add('active');
            }
        }
    });
});
</script>
{% endblock %}
