{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Catégories{% endblock %}

{% block content %}
<div style="margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1>Gestion des Catégories</h1>
        <div>
            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">Retour au Dashboard</a>
            <a href="{{ path('app_admin_categories_new') }}" class="btn btn-success">Ajouter une catégorie</a>
        </div>
    </div>

    {# Afficher les messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Barre de recherche #}
    <div style="margin-bottom: 20px;">
        <div style="max-width: 500px;">
            <input type="text" class="form-control" placeholder="Rechercher une catégorie..." id="searchInput">
        </div>
    </div>

    {# Table des catégories #}
    <div class="card">
        <div class="card-body">
            <table class="table table-sortable" id="categoriesTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Nombre de recettes</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                    <tr class="category-row">
                        <td>{{ category.id }}</td>
                        <td style="font-weight: 600;">{{ category.name }}</td>
                        <td data-sort="{{ category.recipes|length }}">
                            <span class="badge badge-info">{{ category.recipes|length }} recette(s)</span>
                        </td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 5px;" role="group">
                                <a href="{{ path('app_admin_categories_edit', {id: category.id}) }}"
                                   style="font-size: 0.85rem; padding: 5px 10px;">
                                    Modifier
                                </a>
                                <form method="post"
                                      action="{{ path('app_admin_categories_delete', {id: category.id}) }}"
                                      style="display: inline;"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer la catégorie « {{ category.name }} » ?')">
                                    <button type="submit" style="font-size: 0.85rem; padding: 5px 10px;">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" style="text-align: center;">
                            <div style="margin: 0;">
                                Aucune catégorie trouvée. <a href="{{ path('app_admin_categories_new') }}" class="alert-link">Créer une nouvelle catégorie</a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Informations sur le nombre de catégories #}
    <div style="margin-top: 20px;">
        <p style="color: #95a5a6;">
            Total : <strong>{{ categories|length }}</strong> catégorie(s)
        </p>
    </div>
</div>

{# Script pour la recherche en temps réel et le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure la dernière colonne "Actions")
    initTableSort('categoriesTable', {
        excludeColumns: [3]
    });

    // Recherche en temps réel
    document.getElementById('searchInput')?.addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('.category-row');

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });
</script>
{% endblock %}