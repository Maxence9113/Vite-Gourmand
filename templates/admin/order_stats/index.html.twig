{% extends 'admin/base_admin.html.twig' %}

{% block title %}Statistiques des commandes{% endblock %}
{% block page_title %}Statistiques{% endblock %}


{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/admin/order-stats.css') }}">
{% endblock %}

{% block content %}

<div class="stats-header">
    <div>
        <h1>
            <span data-icon="trending-up" data-icon-width="32" data-icon-height="32" class="icon-inline"></span>
            Statistiques des commandes
        </h1>
        <p class="stats-description">Analyse des performances par thème et par menu</p>
    </div>
</div>

{# KPI Cards #}
<div class="kpi-grid">
    <div class="kpi-card bordeaux">
        <div class="kpi-label">Total commandes</div>
        <h2 class="kpi-value">{{ globalStats.totalOrders }}</h2>
    </div>
    <div class="kpi-card green">
        <div class="kpi-label">Chiffre d'affaires</div>
        <h2 class="kpi-value">{{ globalStats.totalRevenue|number_format(0, ',', ' ') }} €</h2>
    </div>
    <div class="kpi-card blue">
        <div class="kpi-label">Moyenne personnes</div>
        <h2 class="kpi-value">{{ globalStats.avgPeoplePerOrder|number_format(1, ',', ' ') }}</h2>
    </div>
    <div class="kpi-card gold">
        <div class="kpi-label">
            {% if viewType == 'theme' %}Top thème{% else %}Top menu{% endif %}
        </div>
        {% if viewType == 'theme' and topTheme %}
            <h2 class="kpi-value kpi-value-large">{{ topTheme.themeName }}</h2>
            <p class="kpi-subtext">{{ topTheme.count }} commandes</p>
        {% elseif viewType == 'menu' and topMenu %}
            <h2 class="kpi-value kpi-value-large">{{ topMenu.menuName }}</h2>
            <p class="kpi-subtext">{{ topMenu.count }} commandes</p>
        {% else %}
            <h2 class="kpi-value">-</h2>
        {% endif %}
    </div>
</div>

{# Filters #}
<div class="filter-card">
    <div class="filter-header">
        <h3>
            <span data-icon="sliders" data-icon-width="20" data-icon-height="20"></span>
            Filtres et options d'affichage
        </h3>
    </div>
    <div class="filter-body">
        <form method="get" action="{{ path('app_admin_order_stats') }}" id="filterForm">
            {# View Toggle #}
            <div class="view-toggle">
                <div>
                    <label class="filter-label">Vue</label>
                    <div class="btn-group">
                        <input type="radio" class="btn-radio" name="view" value="theme" id="viewTheme"
                               {{ viewType == 'theme' ? 'checked' : '' }} onchange="this.form.submit()">
                        <label class="btn-radio-label" for="viewTheme">
                            <span data-icon="palette" data-icon-width="16" data-icon-height="16" class="icon-vertical-middle"></span>
                            Par thème
                        </label>

                        <input type="radio" class="btn-radio" name="view" value="menu" id="viewMenu"
                               {{ viewType == 'menu' ? 'checked' : '' }} onchange="this.form.submit()">
                        <label class="btn-radio-label" for="viewMenu">
                            <span data-icon="file-text" data-icon-width="16" data-icon-height="16" class="icon-vertical-middle"></span>
                            Par menu
                        </label>
                    </div>
                </div>
            </div>

            {# Filter Row #}
            <div class="filter-row">
                {# Period Filter #}
                <div class="filter-group">
                    <label for="period" class="filter-label">Période</label>
                    <select name="period" id="period" class="form-select" onchange="toggleCustomDates()">
                        <option value="all" {{ currentPeriod == 'all' ? 'selected' : '' }}>Toutes les données</option>
                        <option value="week" {{ currentPeriod == 'week' ? 'selected' : '' }}>7 derniers jours</option>
                        <option value="month" {{ currentPeriod == 'month' ? 'selected' : '' }}>30 derniers jours</option>
                        <option value="3months" {{ currentPeriod == '3months' ? 'selected' : '' }}>3 derniers mois</option>
                        <option value="6months" {{ currentPeriod == '6months' ? 'selected' : '' }}>6 derniers mois</option>
                        <option value="custom" {{ currentPeriod == 'custom' ? 'selected' : '' }}>Personnalisé</option>
                    </select>
                </div>

                {# Custom Dates #}
                <div class="filter-group" id="customDatesStart" style="display: {{ currentPeriod == 'custom' ? 'block' : 'none' }}">
                    <label for="start_date" class="filter-label">Date de début</label>
                    <input type="date" name="start_date" id="start_date" class="form-control" value="{{ currentStartDate }}">
                </div>
                <div class="filter-group" id="customDatesEnd" style="display: {{ currentPeriod == 'custom' ? 'block' : 'none' }}">
                    <label for="end_date" class="filter-label">Date de fin</label>
                    <input type="date" name="end_date" id="end_date" class="form-control" value="{{ currentEndDate }}">
                </div>

                {# Theme Filter #}
                <div class="filter-group">
                    <label for="theme" class="filter-label">Thème</label>
                    <select name="theme" id="theme" class="form-select">
                        <option value="">Tous</option>
                        {% for themeName in availableThemes %}
                            <option value="{{ themeName }}" {{ currentTheme == themeName ? 'selected' : '' }}>
                                {{ themeName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            {# Actions #}
            <div class="filter-actions">
                <button type="submit" class="btn-primary">
                    <span data-icon="filter" data-icon-width="16" data-icon-height="16"></span>
                    Appliquer les filtres
                </button>
                <a href="{{ path('app_admin_order_stats') }}" class="btn-secondary">
                    <span data-icon="rotate-ccw" data-icon-width="16" data-icon-height="16"></span>
                    Réinitialiser
                </a>
            </div>
        </form>
    </div>
</div>

{# Chart #}
<div class="content-card">
    <div class="content-header">
        <h3>
            <span data-icon="bar-chart-2" data-icon-width="20" data-icon-height="20"></span>
            {% if viewType == 'theme' %}
                Nombre de commandes par thème
            {% else %}
                Nombre de commandes par menu
            {% endif %}
        </h3>
    </div>
    <div class="content-body">
        {% if orderCountData is not empty %}
            <div class="chart-container">
                <canvas id="orderCountChart"></canvas>
            </div>
        {% else %}
            <div class="alert-info-custom">
                <span data-icon="info" data-icon-width="20" data-icon-height="20"></span>
                Aucune donnée à afficher pour les filtres sélectionnés.
            </div>
        {% endif %}
    </div>
</div>

{# Detailed Table #}
<div class="content-card">
    <div class="content-header">
        <h3>
            <span data-icon="table" data-icon-width="20" data-icon-height="20"></span>
            Détail du chiffre d'affaires
        </h3>
    </div>
    <div class="content-body">
        {% if revenueData is not empty %}
            <div class="table-overflow">
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: {% if viewType == 'menu' %}30{% else %}45{% endif %}%;">
                                {% if viewType == 'theme' %}Thème{% else %}Menu{% endif %}
                            </th>
                            {% if viewType == 'menu' %}
                                <th style="width: 20%;">Thème</th>
                            {% endif %}
                            <th style="width: 15%;" class="text-center">Commandes</th>
                            <th style="width: 15%;" class="text-right">Chiffre d'affaires</th>
                            <th style="width: 15%;" class="text-right">CA moyen / cmd</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for key, item in revenueData %}
                            {% set orderCount = orderCountData[key] %}
                            <tr>
                                <td>{{ key + 1 }}</td>
                                <td>
                                    {% if viewType == 'theme' %}
                                        <strong>{{ item.themeName }}</strong>
                                    {% else %}
                                        {{ item.menuName }}
                                    {% endif %}
                                </td>
                                {% if viewType == 'menu' %}
                                    <td>
                                        <span class="theme-badge" style="background-color: {{ chartBorderColorsArray[key] }};">
                                            {{ item.themeName }}
                                        </span>
                                    </td>
                                {% endif %}
                                <td class="text-center">
                                    <span class="count-badge">{{ orderCount.count }}</span>
                                </td>
                                <td class="text-right"><strong>{{ item.totalRevenue|number_format(2, ',', ' ') }} €</strong></td>
                                <td class="text-right text-muted">
                                    {{ (item.totalRevenue / orderCount.count)|number_format(2, ',', ' ') }} €
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="{% if viewType == 'menu' %}3{% else %}2{% endif %}">TOTAL</td>
                            <td class="text-center"><span class="count-badge">{{ globalStats.totalOrders }}</span></td>
                            <td class="text-right"><strong>{{ globalStats.totalRevenue|number_format(2, ',', ' ') }} €</strong></td>
                            <td class="text-right">{{ (globalStats.totalRevenue / globalStats.totalOrders)|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        {% else %}
            <div class="alert-info-custom">
                <span data-icon="info" data-icon-width="20" data-icon-height="20"></span>
                Aucune donnée à afficher pour les filtres sélectionnés.
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {# Chart.js depuis CDN #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        // Fonction pour afficher/masquer les dates personnalisées
        function toggleCustomDates() {
            const period = document.getElementById('period').value;
            const customStart = document.getElementById('customDatesStart');
            const customEnd = document.getElementById('customDatesEnd');

            if (period === 'custom') {
                customStart.style.display = 'block';
                customEnd.style.display = 'block';
            } else {
                customStart.style.display = 'none';
                customEnd.style.display = 'none';
            }
        }
    </script>

    {% if orderCountData is not empty %}
    <script>
        // Données du graphique
        const chartLabels = {{ chartLabels|raw }};
        const chartData = {{ chartData|raw }};

        // Couleurs générées dynamiquement par thème
        const chartBackgroundColors = {{ chartBackgroundColors|raw }};
        const chartBorderColors = {{ chartBorderColors|raw }};

        // Configuration du graphique (horizontal)
        const ctx = document.getElementById('orderCountChart').getContext('2d');
        const orderCountChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Nombre de commandes',
                    data: chartData,
                    backgroundColor: chartBackgroundColors,
                    borderColor: chartBorderColors,
                    borderWidth: 2,
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y', // Horizontal bar chart
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1,
                            font: {
                                size: 12
                            }
                        },
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    },
                    y: {
                        ticks: {
                            font: {
                                size: 12,
                                weight: 500
                            }
                        },
                        grid: {
                            display: false
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        titleFont: {
                            size: 14,
                            weight: 600
                        },
                        bodyFont: {
                            size: 13
                        },
                        callbacks: {
                            label: function(context) {
                                return 'Commandes : ' + context.parsed.x;
                            }
                        }
                    }
                }
            }
        });
    </script>
    {% endif %}
{% endblock %}
