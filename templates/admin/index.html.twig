{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard Administration{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ importmap('admin-dashboard-styles') }}
{% endblock %}

{% block content %}

<!-- Section de bienvenue -->
<div class="welcome-section">
    <h2>Bienvenue, {{ app.user.firstname }} 👋</h2>
    <p>Voici un aperçu rapide de votre restaurant</p>
</div>

<!-- Statistiques rapides -->
<div class="quick-stats">
    <div class="quick-stat warning">
        <div class="label">⚡ Commandes en attente</div>
        <div class="value">{{ stats.pendingOrders }}</div>
    </div>
    <div class="quick-stat">
        <div class="label">📋 Menus disponibles</div>
        <div class="value">{{ stats.totalMenus }}</div>
    </div>
    <div class="quick-stat">
        <div class="label">🍳 Recettes</div>
        <div class="value">{{ stats.totalRecipes }}</div>
    </div>
    <div class="quick-stat">
        <div class="label">👥 Utilisateurs</div>
        <div class="value">{{ stats.totalUsers }}</div>
    </div>
</div>

<!-- Dernières recettes -->
<h2 class="section-title">📝 Dernières recettes ajoutées</h2>
<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Titre</th>
                <th>Catégorie</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for recipe in latestRecipes %}
            <tr>
                <td><strong>#{{ recipe.id }}</strong></td>
                <td>{{ recipe.title }}</td>
                <td>{{ recipe.category ? recipe.category.name : 'N/A' }}</td>
                <td>
                    <a href="#" class="btn btn-info">Voir</a>
                    <a href="#" class="btn btn-warning">Modifier</a>
                    <a href="#" class="btn btn-danger">Supprimer</a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" style="text-align: center; padding: 40px; color: #95a5a6;">
                    Aucune recette pour le moment
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
