{% extends 'admin/base_admin.html.twig' %}

{% block title %}Éditer l'utilisateur - {{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block content %}
<style>
    .form-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .form-header h1 {
        font-family: var(--font-heading);
        color: var(--bordeaux);
        font-size: 2.5rem;
        font-weight: 400;
        margin: 0;
    }

    .btn-back {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: 2px solid var(--bordeaux);
        background: transparent;
        color: var(--bordeaux);
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all var(--transition-base);
        font-family: var(--font-body);
    }

    .btn-back:hover {
        background: var(--bordeaux);
        color: white;
    }

    .form-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        max-width: 700px;
        margin: 0 auto 1.5rem;
    }

    .form-section {
        border-bottom: 1px solid var(--beige);
    }

    .section-header {
        background: var(--beige);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .section-title {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--dark-text);
        margin: 0;
    }

    .section-body {
        padding: 1.5rem;
    }

    .form-control, .form-select {
        width: 100%;
        border: 1px solid var(--bordeaux);
        border-radius: var(--radius-sm);
        padding: 0.75rem;
        font-size: 0.95rem;
        font-family: var(--font-body);
        transition: all var(--transition-base);
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--bordeaux);
        box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1);
        outline: none;
    }

    .form-label {
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.875rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-text {
        font-size: 0.875rem;
        color: #6c757d;
        margin-top: 0.25rem;
        display: block;
    }

    .required {
        color: #e74c3c;
    }

    .name-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .status-wrapper {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }

    .badge-active {
        padding: 0.5rem 1rem;
        background: var(--green);
        color: white;
        border-radius: var(--radius-lg);
        font-weight: 600;
        font-size: 0.875rem;
    }

    .badge-inactive {
        padding: 0.5rem 1rem;
        background: #6c757d;
        color: white;
        border-radius: var(--radius-lg);
        font-weight: 600;
        font-size: 0.875rem;
    }

    .btn-toggle-status {
        padding: 0.5rem 1rem;
        border-radius: var(--radius-lg);
        border: 2px solid;
        background: transparent;
        font-weight: 500;
        transition: all var(--transition-base);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .btn-toggle-deactivate {
        border-color: #ffc107;
        color: #856404;
    }

    .btn-toggle-deactivate:hover {
        background: #ffc107;
        color: white;
    }

    .btn-toggle-activate {
        border-color: var(--green);
        color: var(--green);
    }

    .btn-toggle-activate:hover {
        background: var(--green);
        color: white;
    }

    .alert-info-custom {
        background: #e7f1ff;
        border: 2px solid #004085;
        border-radius: var(--radius-lg);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .alert-danger-custom {
        background: #f8d7da;
        border: 2px solid #dc3545;
        border-radius: var(--radius-lg);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .form-actions {
        padding: 1.5rem;
        background: var(--beige);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .btn-cancel {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: 2px solid #95a5a6;
        background: transparent;
        color: #95a5a6;
        text-decoration: none;
        font-weight: 500;
        transition: all var(--transition-base);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-cancel:hover {
        background: #95a5a6;
        color: white;
    }

    .btn-submit {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: none;
        background: var(--bordeaux);
        color: white;
        font-weight: 600;
        transition: all var(--transition-base);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-submit:hover {
        opacity: 0.9;
        box-shadow: var(--shadow-md);
    }

    .addresses-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        max-width: 700px;
        margin: 0 auto;
    }

    .addresses-header {
        background: var(--beige);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .addresses-body {
        padding: 1.5rem;
    }

    .addresses-table {
        width: 100%;
        border-collapse: collapse;
    }

    .addresses-table thead {
        background: var(--beige);
    }

    .addresses-table th {
        padding: 0.75rem;
        text-align: left;
        color: var(--dark-text);
        font-weight: 600;
        font-size: 0.875rem;
    }

    .addresses-table td {
        padding: 0.75rem;
        border-bottom: 1px solid var(--beige);
        color: var(--dark-text);
    }

    .addresses-table tr:last-child td {
        border-bottom: none;
    }

    .badge-label {
        padding: 0.25rem 0.75rem;
        background: #6c757d;
        color: white;
        border-radius: var(--radius-lg);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-default {
        padding: 0.25rem 0.75rem;
        background: var(--gold);
        color: white;
        border-radius: var(--radius-lg);
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #6c757d;
    }
</style>

<div class="form-header">
    <h1>
        <span data-icon="user-cog" data-icon-width="32" data-icon-height="32" style="display: inline-block; vertical-align: middle;"></span>
        Éditer l'utilisateur
    </h1>
    <a href="{{ path('admin_users_index') }}" class="btn-back">
        <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
        Retour
    </a>
</div>

{% for message in app.flashes('error') %}
    <div class="alert-danger-custom">
        <span data-icon="alert-circle" data-icon-width="20" data-icon-height="20" style="color: #721c24; flex-shrink: 0;"></span>
        <div>{{ message }}</div>
    </div>
{% endfor %}

<div class="form-card">
    <form method="post">
        <div class="form-section">
            <div class="section-header">
                <span data-icon="user" data-icon-width="20" data-icon-height="20" style="color: var(--bordeaux);"></span>
                <h3 class="section-title">Informations de l'utilisateur</h3>
            </div>
            <div class="section-body">
                <div class="name-grid">
                    <div class="form-group">
                        <label for="firstname" class="form-label">Prénom <span class="required">*</span></label>
                        <input type="text" class="form-control" id="firstname" name="firstname" value="{{ user.firstname }}" required>
                    </div>
                    <div class="form-group">
                        <label for="lastname" class="form-label">Nom <span class="required">*</span></label>
                        <input type="text" class="form-control" id="lastname" name="lastname" value="{{ user.lastname }}" required>
                    </div>
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">Email <span class="required">*</span></label>
                    <input type="email" class="form-control" id="email" name="email" value="{{ user.email }}" required>
                    <span class="form-text">L'email sert d'identifiant de connexion</span>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Statut du compte</label>
                    <div class="status-wrapper">
                        {% if user.isEnabled %}
                            <span class="badge-active">
                                <span data-icon="check-circle" data-icon-width="16" data-icon-height="16" style="display: inline-block; vertical-align: middle;"></span>
                                Actif
                            </span>
                        {% else %}
                            <span class="badge-inactive">
                                <span data-icon="x-circle" data-icon-width="16" data-icon-height="16" style="display: inline-block; vertical-align: middle;"></span>
                                Désactivé
                            </span>
                        {% endif %}
                        <a href="{{ path('admin_users_toggle_status', {id: user.id}) }}"
                           class="btn-toggle-status btn-toggle-{{ user.isEnabled ? 'deactivate' : 'activate' }}"
                           onclick="event.preventDefault(); document.getElementById('toggle-status-form').submit();">
                            <span data-icon="power" data-icon-width="16" data-icon-height="16"></span>
                            {{ user.isEnabled ? 'Désactiver le compte' : 'Activer le compte' }}
                        </a>
                    </div>
                    <span class="form-text">
                        {% if user.isEnabled %}
                            Un compte désactivé ne peut plus se connecter à l'application.
                        {% else %}
                            Activez le compte pour permettre à l'utilisateur de se connecter.
                        {% endif %}
                    </span>
                </div>
            </div>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
        <div class="form-section">
            <div class="section-header">
                <span data-icon="shield" data-icon-width="20" data-icon-height="20" style="color: var(--gold);"></span>
                <h3 class="section-title">Gestion du rôle</h3>
            </div>
            <div class="section-body">
                <div class="form-group" style="margin-bottom: 0;">
                    <label for="role" class="form-label">Rôle de l'utilisateur <span class="required">*</span></label>
                    <select class="form-select" id="role" name="role" required>
                        <option value="ROLE_USER" {% if 'ROLE_EMPLOYEE' not in user.roles %}selected{% endif %}>
                            Utilisateur
                        </option>
                        <option value="ROLE_EMPLOYEE" {% if 'ROLE_EMPLOYEE' in user.roles %}selected{% endif %}>
                            Employé
                        </option>
                    </select>
                    <span class="form-text">
                        <strong>Utilisateur :</strong> Peut consulter les menus et passer des commandes.<br>
                        <strong>Employé :</strong> Peut gérer les menus, recettes, et commandes en plus des droits utilisateur.
                    </span>
                </div>
            </div>
        </div>
        {% endif %}

        <div class="form-actions">
            <a href="{{ path('admin_users_index') }}" class="btn-cancel">
                <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
                Annuler
            </a>
            <button type="submit" class="btn-submit">
                <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>
                Enregistrer les modifications
            </button>
        </div>
    </form>
</div>

<div class="addresses-card">
    <div class="addresses-header">
        <span data-icon="map-pin" data-icon-width="20" data-icon-height="20" style="color: var(--bordeaux);"></span>
        <h3 class="section-title">Adresses de livraison</h3>
    </div>
    <div class="addresses-body">
        {% if user.addresses is empty %}
            <div class="empty-state">
                <span data-icon="inbox" data-icon-width="48" data-icon-height="48" style="opacity: 0.3; margin-bottom: 0.75rem; display: inline-block;"></span>
                <p style="margin: 0; opacity: 0.7;">Cet utilisateur n'a pas encore enregistré d'adresse.</p>
            </div>
        {% else %}
            <table class="addresses-table">
                <thead>
                    <tr>
                        <th>Libellé</th>
                        <th>Adresse</th>
                        <th>Ville</th>
                        <th>Téléphone</th>
                        <th>Par défaut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for address in user.addresses %}
                        <tr>
                            <td>
                                {% if address.label %}
                                    <span class="badge-label">{{ address.label }}</span>
                                {% else %}
                                    <span style="color: #95a5a6;">-</span>
                                {% endif %}
                            </td>
                            <td>{{ address.street }}</td>
                            <td>{{ address.postalCode }} {{ address.city }}</td>
                            <td>{{ address.phone }}</td>
                            <td>
                                {% if address.isDefault %}
                                    <span class="badge-default">
                                        <span data-icon="star" data-icon-width="12" data-icon-height="12"></span>
                                        Oui
                                    </span>
                                {% else %}
                                    <span style="color: #95a5a6;">Non</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>

{# Formulaire caché pour la désactivation/activation #}
<form id="toggle-status-form" method="post" action="{{ path('admin_users_toggle_status', {id: user.id}) }}" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('toggle-status' ~ user.id) }}">
</form>
{% endblock %}
