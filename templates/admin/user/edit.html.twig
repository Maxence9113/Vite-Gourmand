{% extends 'admin/base_admin.html.twig' %}

{% block title %}Éditer l'utilisateur - {{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block content %}
<div style="margin: 30px 0;">
    <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem; justify-content: center;">
        <div style="flex: 0 0 66.666%; max-width: 66.666%; padding: 0 0.75rem;">
            <h1 style="margin-bottom: 1.5rem;">Éditer l'utilisateur</h1>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <div style="margin-bottom: 1.5rem;">
                            <h5 style="margin-bottom: 1rem; color: #95a5a6;">Informations de l'utilisateur</h5>

                            <div style="margin-bottom: 20px;">
                                <div style="flex: 0 0 50%; max-width: 50%; padding: 0 0.75rem;">
                                    <label for="firstname" style="font-weight: 600;">Prénom <span style="color: #e74c3c;">*</span></label>
                                    <input type="text" class="form-control" id="firstname" name="firstname" value="{{ user.firstname }}" required>
                                </div>
                                <div style="flex: 0 0 50%; max-width: 50%; padding: 0 0.75rem;">
                                    <label for="lastname" style="font-weight: 600;">Nom <span style="color: #e74c3c;">*</span></label>
                                    <input type="text" class="form-control" id="lastname" name="lastname" value="{{ user.lastname }}" required>
                                </div>
                            </div>

                            <div style="margin-bottom: 1rem;">
                                <label for="email" style="font-weight: 600;">Email <span style="color: #e74c3c;">*</span></label>
                                <input type="email" class="form-control" id="email" name="email" value="{{ user.email }}" required>
                                <div class="form-text">L'email sert d'identifiant de connexion</div>
                            </div>

                            <div style="margin-bottom: 1rem;">
                                <label style="font-weight: 600;">Statut du compte</label>
                                <div style="display: flex; align-items: center; gap: 1rem;">
                                    {% if user.isEnabled %}
                                        <span class="badge badge-success">Actif</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Désactivé</span>
                                    {% endif %}
                                    <a href="{{ path('admin_users_toggle_status', {id: user.id}) }}"
                                       class="btn btn-sm btn-{{ user.isEnabled ? 'warning' : 'success' }}"
                                       onclick="event.preventDefault(); document.getElementById('toggle-status-form').submit();">
                                        <i class="bi bi-power"></i> {{ user.isEnabled ? 'Désactiver le compte' : 'Activer le compte' }}
                                    </a>
                                </div>
                                <div class="form-text">
                                    {% if user.isEnabled %}
                                        Un compte désactivé ne peut plus se connecter à l'application.
                                    {% else %}
                                        Activez le compte pour permettre à l'utilisateur de se connecter.
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {% if is_granted('ROLE_ADMIN') %}
                        <hr style="margin: 1.5rem 0;">

                        <div style="margin-bottom: 1.5rem;">
                            <h5 style="margin-bottom: 1rem; color: #95a5a6;">Gestion du rôle</h5>

                            <div style="margin-bottom: 1rem;">
                                <label for="role" style="font-weight: 600;">Rôle de l'utilisateur <span style="color: #e74c3c;">*</span></label>
                                <select class="form-select" id="role" name="role" required>
                                    <option value="ROLE_USER" {% if 'ROLE_EMPLOYEE' not in user.roles %}selected{% endif %}>
                                        Utilisateur
                                    </option>
                                    <option value="ROLE_EMPLOYEE" {% if 'ROLE_EMPLOYEE' in user.roles %}selected{% endif %}>
                                        Employé
                                    </option>
                                </select>
                                <div class="form-text">
                                    <strong>Utilisateur :</strong> Peut consulter les menus et passer des commandes.<br>
                                    <strong>Employé :</strong> Peut gérer les menus, recettes, et commandes en plus des droits utilisateur.
                                </div>
                            </div>
                        </div>
                        {% endif %}

                        <div style="display: flex; justify-content: space-between;">
                            <a href="{{ path('admin_users_index') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Enregistrer les modifications
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            {# Section Adresses de l'utilisateur #}
            <div style="margin-top: 25px;">
                <div class="card-body">
                    <h5 style="margin-bottom: 1rem; color: #95a5a6;">
                        <i class="bi bi-geo-alt"></i> Adresses de livraison
                    </h5>

                    {% if user.addresses is empty %}
                        <div class="alert alert-info" role="alert">
                            <i style="margin-right: 0.5rem;"></i>
                            Cet utilisateur n'a pas encore enregistré d'adresse.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Libellé</th>
                                        <th>Adresse</th>
                                        <th>Ville</th>
                                        <th>Téléphone</th>
                                        <th>Par défaut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for address in user.addresses %}
                                        <tr>
                                            <td>
                                                {% if address.label %}
                                                    <span class="badge bg-secondary">{{ address.label }}</span>
                                                {% else %}
                                                    <span style="color: #95a5a6;">-</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ address.street }}</td>
                                            <td>{{ address.postalCode }} {{ address.city }}</td>
                                            <td>{{ address.phone }}</td>
                                            <td>
                                                {% if address.isDefault %}
                                                    <span class="badge badge-primary">
                                                        <i class="bi bi-star-fill"></i> Oui
                                                    </span>
                                                {% else %}
                                                    <span style="color: #95a5a6;">Non</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Formulaire caché pour la désactivation/activation #}
<form id="toggle-status-form" method="post" action="{{ path('admin_users_toggle_status', {id: user.id}) }}" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('toggle-status' ~ user.id) }}">
</form>
{% endblock %}