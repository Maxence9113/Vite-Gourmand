{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer un compte employé{% endblock %}

{% block content %}
<div style="margin: 30px 0;">
    <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem; justify-content: center;">
        <div style="flex: 0 0 66.666%; max-width: 66.666%; padding: 0 0.75rem;">
            <h1 style="margin-bottom: 1.5rem;">Créer un compte employé</h1>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <div style="margin-bottom: 1rem;">
                            <label for="email" class="form-label">Email (identifiant)</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                            <div class="form-text">Cet email sera utilisé comme identifiant de connexion.</div>
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <label for="firstname" class="form-label">Prénom</label>
                            <input type="text" class="form-control" id="firstname" name="firstname" required>
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <label for="lastname" class="form-label">Nom</label>
                            <input type="text" class="form-control" id="lastname" name="lastname" required>
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <label for="password" class="form-label">Mot de passe</label>
                            <div style="position: relative;">
                                <input type="password" class="form-control" id="password" name="password" required minlength="10">
                                <button type="button"
                                        class="btn btn-sm" style="position: absolute; right: 0; margin-right: 0.5rem;"
                                        style="border: none; background: none; z-index: 10;"
                                        onclick="togglePasswordVisibility('password', this)">
                                    <i data-feather="eye" width="20"></i>
                                </button>
                            </div>
                            <div class="form-text">
                                Le mot de passe doit contenir au minimum 10 caractères avec au moins :
                                <ul style="margin-bottom: 0; margin-top: 0.25rem;">
                                    <li>Une majuscule</li>
                                    <li>Une minuscule</li>
                                    <li>Un chiffre</li>
                                    <li>Un caractère spécial</li>
                                </ul>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <strong>Important :</strong> Un email sera automatiquement envoyé à l'employé pour l'informer
                            de la création de son compte, mais sans communiquer le mot de passe. Vous devrez le lui transmettre
                            séparément.
                        </div>

                        <div style="display: flex; justify-content: space-between;">
                            <a href="{{ path('admin_users_index') }}" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn btn-primary">Créer le compte employé</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function togglePasswordVisibility(inputId, button) {
    const input = document.getElementById(inputId);
    const icon = button.querySelector('i');

    if (input.type === 'password') {
        input.type = 'text';
        icon.setAttribute('data-feather', 'eye-off');
    } else {
        input.type = 'password';
        icon.setAttribute('data-feather', 'eye');
    }

    // Réinitialiser les icônes Feather
    if (typeof feather !== 'undefined') {
        feather.replace();
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const passwordInput = document.getElementById('password');
    const form = passwordInput.closest('form');

    form.addEventListener('submit', function(e) {
        const password = passwordInput.value;
        const hasUpperCase = /[A-Z]/.test(password);
        const hasLowerCase = /[a-z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSpecialChar = /[!@#$%^&*(),.?":{}|<>]/.test(password);

        if (!hasUpperCase || !hasLowerCase || !hasNumber || !hasSpecialChar) {
            e.preventDefault();
            alert('Le mot de passe doit contenir au moins une majuscule, une minuscule, un chiffre et un caractère spécial.');
        }
    });
});
</script>
{% endblock %}