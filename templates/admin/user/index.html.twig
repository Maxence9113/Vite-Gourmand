{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Utilisateurs - Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/admin-lists.css') }}">
{% endblock %}

{% block content %}
<div class="list-header">
    <h1>
        👥 Gestion des utilisateurs
    </h1>
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('admin_users_create_employee') }}" class="btn-add">
            <span data-icon="user-plus" data-icon-width="16" data-icon-height="16"></span>
            Créer un employé
        </a>
    {% endif %}
</div>

{# Messages flash #}
{% for message in app.flashes('success') %}
    <div class="flash-success-list">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="flash-error-list">
        {{ message }}
    </div>
{% endfor %}

{# Filtres de recherche #}
<div class="list-filters">
    <form method="get" action="{{ path('admin_users_index') }}">
        <div class="filters-grid {% if is_granted('ROLE_ADMIN') %}four-col{% else %}three-col{% endif %}">
            <div class="filter-group">
                <label for="search">Recherche</label>
                <input type="text" id="search" name="search" placeholder="Email, nom ou prénom" value="{{ app.request.query.get('search') }}">
            </div>
            {% if is_granted('ROLE_ADMIN') %}
            <div class="filter-group">
                <label for="role">Rôle</label>
                <select id="role" name="role">
                    <option value="">Tous les rôles</option>
                    <option value="ROLE_ADMIN" {% if app.request.query.get('role') == 'ROLE_ADMIN' %}selected{% endif %}>Administrateur</option>
                    <option value="ROLE_EMPLOYEE" {% if app.request.query.get('role') == 'ROLE_EMPLOYEE' %}selected{% endif %}>Employé</option>
                    <option value="ROLE_USER" {% if app.request.query.get('role') == 'ROLE_USER' %}selected{% endif %}>Utilisateur</option>
                </select>
            </div>
            {% endif %}
            <div class="filter-group">
                <label for="status">Statut</label>
                <select id="status" name="status">
                    <option value="">Tous les statuts</option>
                    <option value="1" {% if app.request.query.get('status') == '1' %}selected{% endif %}>Actif</option>
                    <option value="0" {% if app.request.query.get('status') == '0' %}selected{% endif %}>Désactivé</option>
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn-filter">
                    <span data-icon="search" data-icon-width="16" data-icon-height="16"></span>
                    Rechercher
                </button>
                <a href="{{ path('admin_users_index') }}" class="btn-filter-reset">
                    <span data-icon="x-circle" data-icon-width="16" data-icon-height="16"></span>
                    Réinitialiser
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Liste des utilisateurs -->
<div class="list-container">
    {% if users is empty %}
        <div class="list-empty-state">
            <span data-icon="inbox" data-icon-width="48" data-icon-height="48" class="list-empty-icon"></span>
            <p class="list-empty-text">Aucun utilisateur trouvé.</p>
        </div>
    {% else %}
        <div class="list-table-wrapper">
            <table id="usersTable" class="list-table">
                <colgroup>
                    <col style="width: 5%;">
                    <col style="width: 28%;">
                    <col style="width: 13%;">
                    <col style="width: 13%;">
                    <col style="width: 11%;">
                    <col style="width: 9%;">
                    <col style="width: 21%;">
                </colgroup>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr class="user-row">
                        <td><strong>{{ user.id }}</strong></td>
                        <td class="text-ellipsis" title="{{ user.email }}">{{ user.email }}</td>
                        <td>{{ user.lastname }}</td>
                        <td>{{ user.firstname }}</td>
                        <td data-sort="{% if 'ROLE_ADMIN' in user.roles %}Administrateur{% elseif 'ROLE_EMPLOYEE' in user.roles %}Employé{% else %}Utilisateur{% endif %}">
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge badge-admin">Admin</span>
                            {% elseif 'ROLE_EMPLOYEE' in user.roles %}
                                <span class="badge badge-employee">Employé</span>
                            {% else %}
                                <span class="badge badge-user">Utilisateur</span>
                            {% endif %}
                        </td>
                        <td data-sort="{% if user.isEnabled %}Actif{% else %}Désactivé{% endif %}">
                            {% if user.isEnabled %}
                                <span class="badge badge-active">Actif</span>
                            {% else %}
                                <span class="badge badge-inactive">Désactivé</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if 'ROLE_ADMIN' not in user.roles %}
                                <div class="crud-actions">
                                    <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="btn-crud btn-crud-edit">
                                        <span data-icon="edit" data-icon-width="16" data-icon-height="16"></span>
                                        <span class="btn-crud-text">Éditer</span>
                                    </a>
                                    <form method="post" action="{{ path('admin_users_toggle_status', {id: user.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-status' ~ user.id) }}">
                                        <button type="submit" class="btn-crud btn-toggle-status {% if user.isEnabled %}disable{% else %}enable{% endif %}">
                                            <span data-icon="{% if user.isEnabled %}ban{% else %}check{% endif %}" data-icon-width="16" data-icon-height="16"></span>
                                            <span class="btn-crud-text">{% if user.isEnabled %}Désactiver{% else %}Activer{% endif %}</span>
                                        </button>
                                    </form>
                                </div>
                            {% else %}
                                <span class="text-protected">Protégé</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Script pour le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure la dernière colonne "Actions")
    initTableSort('usersTable', {
        excludeColumns: [6]
    });
</script>
{% endblock %}
