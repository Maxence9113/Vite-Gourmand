{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block content %}
<div style="margin: 30px 0;">
    <div style="margin-bottom: 25px;">
        <div style="flex: 0 0 66.666%; max-width: 66.666%; padding: 0 0.75rem;">
            <h1>Gestion des utilisateurs</h1>
        </div>
        <div style="flex: 0 0 33.333%; max-width: 33.333%; padding: 0 0.75rem; text-align: right;">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_users_create_employee') }}" class="btn btn-primary">
                    <i class="bi bi-person-plus"></i> Créer un employé
                </a>
            {% endif %}
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {# Filtres de recherche #}
    <div style="margin-bottom: 25px;">
        <div class="card-body">
            <h5 style="margin-bottom: 20px;">
                <i class="bi bi-funnel"></i> Filtres de recherche
            </h5>
            <form method="get" action="{{ path('admin_users_index') }}">
                <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem; gap: 1rem;">
                    <div style="flex: 0 0 {% if is_granted('ROLE_ADMIN') %}25%{% else %}33.333%{% endif %}; max-width: {% if is_granted('ROLE_ADMIN') %}25%{% else %}33.333%{% endif %}; padding: 0 0.75rem;">
                        <label for="search" class="form-label">Recherche</label>
                        <input type="text"
                               class="form-control"
                               id="search"
                               name="search"
                               placeholder="Email, nom ou prénom"
                               value="{{ app.request.query.get('search') }}">
                    </div>
                    {% if is_granted('ROLE_ADMIN') %}
                    <div style="flex: 0 0 25%; max-width: 25%; padding: 0 0.75rem;">
                        <label for="role" class="form-label">Rôle</label>
                        <select class="form-select" id="role" name="role">
                            <option value="">Tous les rôles</option>
                            <option value="ROLE_ADMIN" {% if app.request.query.get('role') == 'ROLE_ADMIN' %}selected{% endif %}>Administrateur</option>
                            <option value="ROLE_EMPLOYEE" {% if app.request.query.get('role') == 'ROLE_EMPLOYEE' %}selected{% endif %}>Employé</option>
                            <option value="ROLE_USER" {% if app.request.query.get('role') == 'ROLE_USER' %}selected{% endif %}>Utilisateur</option>
                        </select>
                    </div>
                    {% endif %}
                    <div style="flex: 0 0 {% if is_granted('ROLE_ADMIN') %}25%{% else %}33.333%{% endif %}; max-width: {% if is_granted('ROLE_ADMIN') %}25%{% else %}33.333%{% endif %}; padding: 0 0.75rem;">
                        <label for="status" class="form-label">Statut</label>
                        <select class="form-select" id="status" name="status">
                            <option value="">Tous les statuts</option>
                            <option value="1" {% if app.request.query.get('status') == '1' %}selected{% endif %}>Actif</option>
                            <option value="0" {% if app.request.query.get('status') == '0' %}selected{% endif %}>Désactivé</option>
                        </select>
                    </div>
                    <div style="flex: 0 0 25%; max-width: 25%; padding: 0 0.75rem; display: flex; align-items: flex-end; gap: 0.5rem;">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Rechercher
                        </button>
                        <a href="{{ path('admin_users_index') }}" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Réinitialiser
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-sortable" id="usersTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Rôles</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="user-row">
                            <td>{{ user.id }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.lastname }}</td>
                            <td>{{ user.firstname }}</td>
                            <td data-sort="{% if 'ROLE_ADMIN' in user.roles %}Administrateur{% elseif 'ROLE_EMPLOYEE' in user.roles %}Employé{% else %}Utilisateur{% endif %}">
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge badge-danger">Administrateur</span>
                                {% elseif 'ROLE_EMPLOYEE' in user.roles %}
                                    <span class="badge badge-warning">Employé</span>
                                {% else %}
                                    <span class="badge badge-info">Utilisateur</span>
                                {% endif %}
                            </td>
                            <td data-sort="{% if user.isEnabled %}Actif{% else %}Désactivé{% endif %}">
                                {% if user.isEnabled %}
                                    <span class="badge badge-success">Actif</span>
                                {% else %}
                                    <span class="badge bg-secondary">Désactivé</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if 'ROLE_ADMIN' not in user.roles %}
                                    <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil"></i> Éditer
                                    </a>
                                    <form method="post" action="{{ path('admin_users_toggle_status', {id: user.id}) }}" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-status' ~ user.id) }}">
                                        <button type="submit" class="btn btn-sm btn-{{ user.isEnabled ? 'warning' : 'success' }}">
                                            {{ user.isEnabled ? 'Désactiver' : 'Activer' }}
                                        </button>
                                    </form>
                                {% else %}
                                    <span style="color: #95a5a6;">Compte admin protégé</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align: center;">Aucun utilisateur trouvé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-top: 1rem;">
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">Retour à l'administration</a>
    </div>
</div>

{# Script pour le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure la dernière colonne "Actions")
    initTableSort('usersTable', {
        excludeColumns: [6]
    });
</script>
{% endblock %}