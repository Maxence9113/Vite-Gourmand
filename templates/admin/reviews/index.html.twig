{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Avis{% endblock %}

{% block content %}
<div style="margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1>Gestion des Avis Clients</h1>
        <div>
            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">Retour au Dashboard</a>
        </div>
    </div>

    {# Afficher les messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Statistiques rapides #}
    <div style="margin-bottom: 25px;">
        <div style="flex: 0 0 33.333%; max-width: 33.333%; padding: 0 0.75rem;">
            <div style="text-align: center;">
                <div class="card-body">
                    <h3 style="color: var(--primary);">{{ reviews|filter(r => r.isValidated)|length }}</h3>
                    <p style="margin-bottom: 0; color: #95a5a6;">Avis validés</p>
                </div>
            </div>
        </div>
        <div style="flex: 0 0 33.333%; max-width: 33.333%; padding: 0 0.75rem;">
            <div style="text-align: center;">
                <div class="card-body">
                    <h3 style="color: #f39c12;">{{ reviews|filter(r => not r.isValidated)|length }}</h3>
                    <p style="margin-bottom: 0; color: #95a5a6;">En attente de validation</p>
                </div>
            </div>
        </div>
        <div style="flex: 0 0 33.333%; max-width: 33.333%; padding: 0 0.75rem;">
            <div style="text-align: center;">
                <div class="card-body">
                    <h3 style="color: #3498db;">{{ reviews|length }}</h3>
                    <p style="margin-bottom: 0; color: #95a5a6;">Total des avis</p>
                </div>
            </div>
        </div>
    </div>

    {# Filtres #}
    <div style="margin-bottom: 20px;">
        <div style="max-width: 500px;">
            <input type="text" class="form-control" placeholder="Rechercher par nom ou commentaire..." id="searchInput">
        </div>
        <div style="max-width: 500px;">
            <select class="form-select" id="filterStatus">
                <option value="all">Tous les avis</option>
                <option value="pending">En attente de validation</option>
                <option value="validated">Validés</option>
            </select>
        </div>
    </div>

    {# Table des avis #}
    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-sortable" id="reviewsTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Note</th>
                        <th>Commentaire</th>
                        <th>Statut</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for review in reviews %}
                    <tr class="review-row" data-status="{{ review.isValidated ? 'validated' : 'pending' }}">
                        <td data-sort="{{ review.createdAt|date('Y-m-d H:i:s') }}">{{ review.createdAt|date('d/m/Y H:i') }}</td>
                        <td style="font-weight: 600;">{{ review.customerName }}</td>
                        <td data-sort="{{ review.rating }}">
                            <div class="rating-stars">
                                {% for i in 1..5 %}
                                    {% if i <= review.rating %}
                                        <i data-feather="star" width="16" class="star-filled"></i>
                                    {% else %}
                                        <i data-feather="star" width="16" class="star-empty"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </td>
                        <td>
                            {% if review.comment %}
                                {% if review.comment|length > 100 %}
                                    <div class="comment-container">
                                        <div class="comment-preview" id="preview-{{ review.id }}">
                                            {{ review.comment|slice(0, 100) }}...
                                            <button class="btn btn-link btn-sm p-0" onclick="toggleComment({{ review.id }})" id="btn-{{ review.id }}" style="margin-left: 0.25rem;">
                                                <small>Voir plus</small>
                                            </button>
                                        </div>
                                        <div class="comment-full d-none" id="full-{{ review.id }}">
                                            {{ review.comment }}
                                            <button class="btn btn-link btn-sm p-0" onclick="toggleComment({{ review.id }})" style="margin-left: 0.25rem;">
                                                <small>Voir moins</small>
                                            </button>
                                        </div>
                                    </div>
                                {% else %}
                                    {{ review.comment }}
                                {% endif %}
                            {% else %}
                                <span style="color: #95a5a6; font-style: italic;">Aucun commentaire</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if review.isValidated %}
                                <span class="badge badge-success">Validé</span>
                            {% else %}
                                <span class="badge badge-warning text-dark">En attente</span>
                            {% endif %}
                        </td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 5px;" role="group">
                                {% if not review.isValidated %}
                                    <form method="post"
                                          action="{{ path('app_admin_reviews_validate', {id: review.id}) }}"
                                          style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-success" title="Valider">
                                            <i data-feather="check" width="16"></i>
                                        </button>
                                    </form>
                                {% else %}
                                    <form method="post"
                                          action="{{ path('app_admin_reviews_reject', {id: review.id}) }}"
                                          style="display: inline;">
                                        <button type="submit" style="font-size: 0.85rem; padding: 5px 10px;" title="Rejeter">
                                            <i data-feather="x" width="16"></i>
                                        </button>
                                    </form>
                                {% endif %}

                                <form method="post"
                                      action="{{ path('app_admin_reviews_delete', {id: review.id}) }}"
                                      style="display: inline;"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet avis ?')">
                                    <button type="submit" style="font-size: 0.85rem; padding: 5px 10px;" title="Supprimer">
                                        <i data-feather="trash-2" width="16"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <div style="margin: 0;">
                                Aucun avis pour le moment.
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Informations sur le nombre d'avis #}
    <div style="margin-top: 20px;">
        <p style="color: #95a5a6;">
            Total : <strong>{{ reviews|length }}</strong> avis
        </p>
    </div>
</div>

{# Script pour la recherche, le filtrage et le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure les colonnes Commentaire et Actions)
    initTableSort('reviewsTable', {
        excludeColumns: [3, 5]
    });

    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const filterStatus = document.getElementById('filterStatus');
        const rows = document.querySelectorAll('.review-row');

        function filterRows() {
            const searchTerm = searchInput?.value.toLowerCase() || '';
            const statusFilter = filterStatus?.value || 'all';

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const status = row.dataset.status;

                const matchesSearch = text.includes(searchTerm);
                const matchesStatus = statusFilter === 'all' || status === statusFilter;

                row.style.display = matchesSearch && matchesStatus ? '' : 'none';
            });
        }

        searchInput?.addEventListener('input', filterRows);
        filterStatus?.addEventListener('change', filterRows);
    });

    function toggleComment(id) {
        const preview = document.getElementById('preview-' + id);
        const full = document.getElementById('full-' + id);

        preview.classList.toggle('d-none');
        full.classList.toggle('d-none');
    }
</script>

<style>
    .rating-stars {
        display: flex;
        gap: 0.125rem;
    }

    .rating-stars .star-filled {
        color: #ffc107;
        fill: #ffc107;
        stroke: #f59e0b;
        stroke-width: 1.5;
    }

    .rating-stars .star-empty {
        color: #e5e7eb;
        fill: #f3f4f6;
        stroke: #d1d5db;
        stroke-width: 1.5;
    }

    .comment-preview {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>
{% endblock %}