{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Avis - Admin{% endblock %}

{% block content %}
<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
    <h1 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 2.5rem; font-weight: 400;">
        ⭐ Gestion des avis clients
    </h1>
</div>

{# Afficher les messages flash #}
{% for message in app.flashes('success') %}
    <div style="background: #d4edda; color: #155724; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border: 1px solid #c3e6cb;">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('warning') %}
    <div style="background: #fff3cd; color: #856404; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border: 1px solid #ffeeba;">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div style="background: #f8d7da; color: #721c24; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border: 1px solid #f5c6cb;">
        {{ message }}
    </div>
{% endfor %}

<!-- Stats Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.25rem; text-align: center; border-left: 4px solid #27ae60;">
        <h6 style="color: var(--dark-text); font-size: 0.875rem; margin-bottom: 0.5rem; font-weight: 400;">Validés</h6>
        <h3 style="font-family: var(--font-heading); font-size: 1.8rem; margin: 0; color: #27ae60;">{{ reviews|filter(r => r.isValidated)|length }}</h3>
    </div>
    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.25rem; text-align: center; border-left: 4px solid #f39c12;">
        <h6 style="color: var(--dark-text); font-size: 0.875rem; margin-bottom: 0.5rem; font-weight: 400;">En attente</h6>
        <h3 style="font-family: var(--font-heading); font-size: 1.8rem; margin: 0; color: #f39c12;">{{ reviews|filter(r => not r.isValidated)|length }}</h3>
    </div>
    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.25rem; text-align: center;">
        <h6 style="color: var(--dark-text); font-size: 0.875rem; margin-bottom: 0.5rem; font-weight: 400;">Total</h6>
        <h3 style="font-family: var(--font-heading); font-size: 1.8rem; margin: 0; color: var(--dark-text);">{{ reviews|length }}</h3>
    </div>
</div>

<!-- Filtres -->
<div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1rem; margin-bottom: 1.5rem;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
            <label for="searchInput" style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; color: var(--dark-text); font-weight: 600;">Recherche</label>
            <input type="text" id="searchInput" placeholder="Rechercher par nom ou commentaire..." style="width: 100%; padding: 0.5rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body);">
        </div>
        <div>
            <label for="filterStatus" style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; color: var(--dark-text); font-weight: 600;">Statut</label>
            <select id="filterStatus" style="width: 100%; padding: 0.5rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body);">
                <option value="all">Tous les avis</option>
                <option value="pending">En attente de validation</option>
                <option value="validated">Validés</option>
            </select>
        </div>
    </div>
</div>

<!-- Liste des avis -->
<div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden;">
    {% if reviews is empty %}
        <div style="text-align: center; padding: 3rem 1.25rem;">
            <span data-icon="inbox" data-icon-width="48" data-icon-height="48" style="color: var(--dark-text); opacity: 0.3; margin-bottom: 1rem; display: inline-block;"></span>
            <p style="color: var(--dark-text); opacity: 0.6; margin: 0;">Aucun avis pour le moment.</p>
        </div>
    {% else %}
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                <colgroup>
                    <col style="width: 12%;">
                    <col style="width: 15%;">
                    <col style="width: 12%;">
                    <col style="width: 35%;">
                    <col style="width: 13%;">
                    <col style="width: 13%;">
                </colgroup>
                <thead style="background: var(--beige);">
                    <tr>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">Date</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">Client</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">Note</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">Commentaire</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">Statut</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for review in reviews %}
                    <tr class="review-row" data-status="{{ review.isValidated ? 'validated' : 'pending' }}" style="border-bottom: 1px solid var(--beige);" onmouseover="this.style.backgroundColor='#f8f9fa'" onmouseout="this.style.backgroundColor=''">
                        <td style="padding: 1rem 1.5rem; color: var(--dark-text);" data-sort="{{ review.createdAt|date('Y-m-d H:i:s') }}">
                            <small>{{ review.createdAt|date('d/m/Y H:i') }}</small>
                        </td>
                        <td style="padding: 1rem 1.5rem; color: var(--dark-text);"><strong>{{ review.customerName }}</strong></td>
                        <td style="padding: 1rem 1.5rem; color: var(--dark-text);" data-sort="{{ review.rating }}">
                            <div style="display: flex; gap: 0.125rem;">
                                {% for i in 1..5 %}
                                    {% if i <= review.rating %}
                                        <span data-icon="star" data-icon-width="16" data-icon-height="16" style="color: #ffc107; fill: #ffc107;"></span>
                                    {% else %}
                                        <span data-icon="star" data-icon-width="16" data-icon-height="16" style="color: #e5e7eb;"></span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </td>
                        <td style="padding: 1rem 1.5rem; color: var(--dark-text); max-width: 400px; word-wrap: break-word; white-space: normal; line-height: 1.5;">
                            {% if review.comment %}
                                {{ review.comment }}
                            {% else %}
                                <span style="color: #95a5a6; font-style: italic;">Aucun commentaire</span>
                            {% endif %}
                        </td>
                        <td style="padding: 1rem 1.5rem;">
                            {% if review.isValidated %}
                                <span style="padding: 0.25rem 0.75rem; border-radius: var(--radius-sm); background: #27ae60; color: white; font-size: 0.875rem;">Validé</span>
                            {% else %}
                                <span style="padding: 0.25rem 0.75rem; border-radius: var(--radius-sm); background: #f39c12; color: white; font-size: 0.875rem;">En attente</span>
                            {% endif %}
                        </td>
                        <td style="padding: 1rem 1.5rem;">
                            <div style="display: flex; gap: 0.5rem;">
                                {% if not review.isValidated %}
                                    <form method="post" action="{{ path('app_admin_reviews_validate', {id: review.id}) }}" style="display: inline;">
                                        <button type="submit" style="padding: 0.5rem; border-radius: var(--radius-sm); border: none; background: none; cursor: pointer;" onmouseover="this.style.backgroundColor='#e9ecef'" onmouseout="this.style.backgroundColor=''" title="Valider">
                                            <span data-icon="check" data-icon-width="16" data-icon-height="16" style="color: #27ae60;"></span>
                                        </button>
                                    </form>
                                {% else %}
                                    <form method="post" action="{{ path('app_admin_reviews_reject', {id: review.id}) }}" style="display: inline;">
                                        <button type="submit" style="padding: 0.5rem; border-radius: var(--radius-sm); border: none; background: none; cursor: pointer;" onmouseover="this.style.backgroundColor='#e9ecef'" onmouseout="this.style.backgroundColor=''" title="Rejeter">
                                            <span data-icon="x" data-icon-width="16" data-icon-height="16" style="color: #f39c12;"></span>
                                        </button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('app_admin_reviews_delete', {id: review.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet avis ?')">
                                    <button type="submit" style="padding: 0.5rem; border-radius: var(--radius-sm); border: none; background: none; cursor: pointer;" onmouseover="this.style.backgroundColor='#e9ecef'" onmouseout="this.style.backgroundColor=''" title="Supprimer">
                                        <span data-icon="trash-2" data-icon-width="16" data-icon-height="16" style="color: #d4183d;"></span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Script pour la recherche, le filtrage et le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure les colonnes Commentaire et Actions)
    initTableSort('reviewsTable', {
        excludeColumns: [3, 5]
    });

    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const filterStatus = document.getElementById('filterStatus');
        const rows = document.querySelectorAll('.review-row');

        function filterRows() {
            const searchTerm = searchInput?.value.toLowerCase() || '';
            const statusFilter = filterStatus?.value || 'all';

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const status = row.dataset.status;

                const matchesSearch = text.includes(searchTerm);
                const matchesStatus = statusFilter === 'all' || status === statusFilter;

                row.style.display = matchesSearch && matchesStatus ? '' : 'none';
            });
        }

        searchInput?.addEventListener('input', filterRows);
        filterStatus?.addEventListener('change', filterRows);
    });
</script>
{% endblock %}