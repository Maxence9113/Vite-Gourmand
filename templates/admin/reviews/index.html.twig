{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Avis - Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/admin-lists.css') }}">
{% endblock %}

{% block content %}
<div class="list-header">
    <h1>
        ⭐ Gestion des avis clients
    </h1>
</div>

{# Afficher les messages flash #}
{% for message in app.flashes('success') %}
    <div class="flash-success-list">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('warning') %}
    <div class="flash-warning-list">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="flash-error-list">
        {{ message }}
    </div>
{% endfor %}

<!-- Stats Grid -->
<div class="stats-grid">
    <div class="stat-card stat-success">
        <h6>Validés</h6>
        <h3>{{ reviews|filter(r => r.isValidated)|length }}</h3>
    </div>
    <div class="stat-card stat-warning">
        <h6>En attente</h6>
        <h3>{{ reviews|filter(r => not r.isValidated)|length }}</h3>
    </div>
    <div class="stat-card">
        <h6>Total</h6>
        <h3>{{ reviews|length }}</h3>
    </div>
</div>

<!-- Filtres -->
<div class="list-filters">
    <div class="filters-grid filters-grid-2col">
        <div class="filter-group">
            <label for="searchInput">Recherche</label>
            <input type="text" id="searchInput" placeholder="Rechercher par nom ou commentaire...">
        </div>
        <div class="filter-group">
            <label for="filterStatus">Statut</label>
            <select id="filterStatus">
                <option value="all">Tous les avis</option>
                <option value="pending">En attente de validation</option>
                <option value="validated">Validés</option>
            </select>
        </div>
    </div>
</div>

<!-- Liste des avis -->
<div class="list-container">
    {% if reviews is empty %}
        <div class="list-empty-state">
            <span data-icon="inbox" data-icon-width="48" data-icon-height="48" class="list-empty-icon"></span>
            <p class="list-empty-text">Aucun avis pour le moment.</p>
        </div>
    {% else %}
        <div class="list-table-wrapper">
            <table class="list-table">
                <colgroup>
                    <col style="width: 12%;">
                    <col style="width: 15%;">
                    <col style="width: 12%;">
                    <col style="width: 35%;">
                    <col style="width: 13%;">
                    <col style="width: 13%;">
                </colgroup>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Note</th>
                        <th>Commentaire</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for review in reviews %}
                    <tr class="review-row" data-status="{{ review.isValidated ? 'validated' : 'pending' }}">
                        <td data-sort="{{ review.createdAt|date('Y-m-d H:i:s') }}">
                            <small class="text-small">{{ review.createdAt|date('d/m/Y H:i') }}</small>
                        </td>
                        <td><strong>{{ review.customerName }}</strong></td>
                        <td data-sort="{{ review.rating }}">
                            <div class="rating-stars">
                                {% for i in 1..5 %}
                                    {% if i <= review.rating %}
                                        <span data-icon="star" data-icon-width="16" data-icon-height="16" class="icon-star-filled"></span>
                                    {% else %}
                                        <span data-icon="star" data-icon-width="16" data-icon-height="16" class="icon-star-empty"></span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </td>
                        <td class="comment-cell">
                            {% if review.comment %}
                                {{ review.comment }}
                            {% else %}
                                <span class="text-muted">Aucun commentaire</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if review.isValidated %}
                                <span class="badge badge-active">Validé</span>
                            {% else %}
                                <span class="badge badge-employee">En attente</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="crud-actions">
                                {% if not review.isValidated %}
                                    <form method="post" action="{{ path('app_admin_reviews_validate', {id: review.id}) }}">
                                        <button type="submit" class="btn-crud btn-crud-validate" title="Valider">
                                            <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>
                                        </button>
                                    </form>
                                {% else %}
                                    <form method="post" action="{{ path('app_admin_reviews_reject', {id: review.id}) }}">
                                        <button type="submit" class="btn-crud btn-crud-reject" title="Rejeter">
                                            <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
                                        </button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('app_admin_reviews_delete', {id: review.id}) }}" class="delete-form">
                                    <button type="submit" class="btn-crud btn-crud-delete" title="Supprimer">
                                        <span data-icon="trash-2" data-icon-width="16" data-icon-height="16"></span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Script pour la recherche, le filtrage et le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure les colonnes Commentaire et Actions)
    initTableSort('reviewsTable', {
        excludeColumns: [3, 5]
    });

    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const filterStatus = document.getElementById('filterStatus');
        const rows = document.querySelectorAll('.review-row');

        function filterRows() {
            const searchTerm = searchInput?.value.toLowerCase() || '';
            const statusFilter = filterStatus?.value || 'all';

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const status = row.dataset.status;

                const matchesSearch = text.includes(searchTerm);
                const matchesStatus = statusFilter === 'all' || status === statusFilter;

                row.style.display = matchesSearch && matchesStatus ? '' : 'none';
            });
        }

        searchInput?.addEventListener('input', filterRows);
        filterStatus?.addEventListener('change', filterRows);

        // Confirmation de suppression
        document.querySelectorAll('.delete-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                if (!confirm('Êtes-vous sûr de vouloir supprimer cet avis ?')) {
                    e.preventDefault();
                }
            });
        });
    });
</script>
{% endblock %}
