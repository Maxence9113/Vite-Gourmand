{# Composant réutilisable pour afficher un badge de statut de commande #}
{% set badgeSize = large|default(false) ? 'font-size: 1.1rem; padding: 8px 12px;' : '' %}

<span style="{{ badgeSize }}">
    <i data-feather="{{ status.icon }}" style="width: {{ large|default(false) ? '18' : '14' }}px; height: {{ large|default(false) ? '18' : '14' }}px;"></i>
    {{ status.label }}
</span>
