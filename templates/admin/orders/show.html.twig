{% extends 'admin/base_admin.html.twig' %}

{% block title %}Commande {{ order.orderNumber }} - Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/admin/orders.css') }}">
{% endblock %}

{% block content %}
<div class="order-show-header">
    <h1 class="order-show-title">
        📦 Commande {{ order.orderNumber }}
    </h1>
    <a href="{{ path('app_admin_orders') }}" class="btn-back-order">
        <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
        Retour à la liste
    </a>
</div>

{# Flash messages #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash-message-{{ label == 'success' ? 'success' : (label == 'error' ? 'error' : 'warning') }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<div class="order-show-layout">
    {# Colonne principale #}
    <div>
        {# Informations client #}
        <div class="order-card">
            <div class="order-card-header">
                <h5 class="order-card-title">
                    <span data-icon="user" data-icon-width="20" data-icon-height="20"></span>
                    Informations Client
                </h5>
            </div>
            <div class="order-card-body">
                <div class="grid-2col">
                    <div>
                        <p><strong>Nom complet :</strong><br><span>{{ order.customerFirstname }} {{ order.customerLastname }}</span></p>
                        <p><strong>Email :</strong><br><span>{{ order.customerEmail }}</span></p>
                        <p><strong>Téléphone :</strong><br><span>{{ order.customerPhone }}</span></p>
                    </div>
                    <div>
                        <p><strong>Compte utilisateur :</strong><br>
                            {% if order.user %}
                                <span>{{ order.user.firstname }} {{ order.user.lastname }}</span><br>
                                <small class="order-show-user-info-text">{{ order.user.email }}</small>
                            {% else %}
                                <span class="order-show-user-info-empty">Non associé</span>
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        {# Informations de livraison #}
        <div class="order-card">
            <div class="order-card-header">
                <h5 class="order-card-title">
                    <span data-icon="map-pin" data-icon-width="20" data-icon-height="20"></span>
                    Livraison
                </h5>
            </div>
            <div class="order-card-body">
                <div class="grid-2col">
                    <div>
                        <p><strong>Adresse :</strong><br><span>{{ order.deliveryAddress }}</span></p>
                        {% if order.deliveryDistanceKm %}
                            <p><strong>Distance :</strong><br><span>{{ order.deliveryDistanceKm }} km</span></p>
                        {% endif %}
                    </div>
                    <div>
                        <p><strong>Date et heure :</strong><br>
                            <span class="order-delivery-datetime">
                                <span data-icon="calendar" data-icon-width="16" data-icon-height="16"></span>
                                {{ order.deliveryDateTime|date('d/m/Y à H:i') }}
                            </span>
                        </p>
                        <p><strong>Coût de livraison :</strong><br><span class="order-delivery-cost">{{ (order.deliveryCost / 100)|number_format(2, ',', ' ') }} €</span></p>
                    </div>
                </div>
            </div>
        </div>

        {# Détails de la commande #}
        <div class="order-card">
            <div class="order-card-header">
                <h5 class="order-card-title">
                    <span data-icon="shopping-cart" data-icon-width="20" data-icon-height="20"></span>
                    Détails de la commande
                </h5>
            </div>
            <div class="order-card-body">
                <table class="order-details-table">
                    <tbody>
                        <tr>
                            <td><strong>Menu :</strong></td>
                            <td>{{ order.menuName }}</td>
                        </tr>
                        <tr>
                            <td><strong>Nombre de personnes :</strong></td>
                            <td>{{ order.numberOfPersons }}</td>
                        </tr>
                        <tr>
                            <td><strong>Prix par personne :</strong></td>
                            <td>{{ (order.menuPricePerPerson / 100)|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    </tbody>
                </table>

                <hr class="order-summary-separator">

                <table class="order-summary-table">
                    <tbody>
                        <tr>
                            <td><strong>Sous-total menu :</strong></td>
                            <td>{{ (order.menuSubtotal / 100)|number_format(2, ',', ' ') }} €</td>
                        </tr>
                        <tr>
                            <td><strong>Livraison :</strong></td>
                            <td>{{ (order.deliveryCost / 100)|number_format(2, ',', ' ') }} €</td>
                        </tr>
                        {% if order.discountAmount %}
                        <tr class="order-discount-row">
                            <td><strong>Réduction (10%) :</strong></td>
                            <td>- {{ (order.discountAmount / 100)|number_format(2, ',', ' ') }} €</td>
                        </tr>
                        {% endif %}
                        <tr class="order-total-row">
                            <td><strong class="order-total-label">TOTAL :</strong></td>
                            <td><strong class="order-total-amount">{{ (order.totalPrice / 100)|number_format(2, ',', ' ') }} €</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        {# Matériel prêté #}
        {% if order.hasMaterialLoan %}
        <div class="material-loan-card">
            <div class="material-loan-header">
                <h5 class="material-loan-title">
                    <span data-icon="package" data-icon-width="20" data-icon-height="20"></span>
                    Prêt de matériel
                </h5>
            </div>
            <div class="order-card-body">
                <div class="grid-2col">
                    <div>
                        <p><strong>Matériel prêté :</strong><br>
                            <span class="material-loan-badge">Oui</span>
                        </p>
                    </div>
                    <div>
                        <p><strong>Date limite de retour :</strong><br>
                            <span>
                            {% if order.materialReturnDeadline %}
                                {{ order.materialReturnDeadline|date('d/m/Y') }}
                            {% else %}
                                <span class="material-return-deadline-empty">Non définie</span>
                            {% endif %}
                            </span>
                        </p>
                    </div>
                    <div class="material-full-width">
                        <p><strong>Statut du retour :</strong><br>
                            {% if order.materialReturned %}
                                <span class="material-status-returned">
                                    <span data-icon="check-circle" data-icon-width="14" data-icon-height="14"></span>
                                    Retourné
                                </span>
                            {% else %}
                                <span class="material-status-waiting">
                                    <span data-icon="clock" data-icon-width="14" data-icon-height="14"></span>
                                    En attente
                                </span>
                            {% endif %}
                        </p>

                        {% if not order.materialReturned and order.status.value == 'waiting_material_return' %}
                            <form method="post" action="{{ path('app_admin_orders_material_returned', {id: order.id}) }}" onsubmit="return confirm('Confirmer que le matériel a bien été retourné ?');">
                                <button type="submit" class="material-returned-button">
                                    <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>
                                    Marquer comme retourné
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        {# Annulation #}
        {% if order.status.value == 'cancelled' %}
        <div class="cancellation-card">
            <div class="cancellation-header">
                <h5 class="cancellation-title">
                    <span data-icon="x-circle" data-icon-width="20" data-icon-height="20"></span>
                    Annulation
                </h5>
            </div>
            <div class="order-card-body">
                <p><strong>Date d'annulation :</strong><br><span>{{ order.cancelledAt|date('d/m/Y à H:i') }}</span></p>
                <p><strong>Détails de l'annulation :</strong><br>
                    <span class="cancellation-reason">{{ order.cancellationReason }}</span>
                </p>
            </div>
        </div>
        {% endif %}
    </div>

    {# Colonne latérale #}
    <div>
        {# Statut actuel #}
        <div class="order-card">
            <div class="order-card-header">
                <h5 class="order-card-title">
                    <span data-icon="activity" data-icon-width="20" data-icon-height="20"></span>
                    Statut
                </h5>
            </div>
            <div class="order-card-body">
                <div class="order-status-display">
                    {% include 'admin/orders/_status_badge.html.twig' with {'status': order.status, 'large': true} %}
                </div>

                {# Actions de changement de statut #}
                {% if not order.status.isFinal %}
                    <hr class="order-status-change-separator">
                    <form method="post" action="{{ path('app_admin_orders_change_status', {id: order.id}) }}">
                        <label for="new_status" class="order-status-label">Changer le statut :</label>
                        <select name="status" id="new_status" class="order-status-select">
                            {% for nextStatus in order.status.getNextStatuses %}
                                <option value="{{ nextStatus.value }}">{{ nextStatus.label }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="order-status-update-button">
                            <span data-icon="refresh-cw" data-icon-width="16" data-icon-height="16"></span>
                            Mettre à jour
                        </button>
                    </form>
                {% endif %}

                {# Bouton d'annulation #}
                {% if order.canBeCancelled %}
                    <button type="button" onclick="document.getElementById('cancelModal').style.display='flex'" class="order-cancel-button">
                        <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
                        Annuler la commande
                    </button>
                {% endif %}
            </div>
        </div>

        {# Historique des statuts #}
        <div class="order-card">
            <div class="order-card-header">
                <h5 class="order-card-title">
                    <span data-icon="clock" data-icon-width="20" data-icon-height="20"></span>
                    Historique
                </h5>
            </div>
            <div class="order-card-body">
                {% if order.statusHistory is not empty %}
                    <div>
                        {% for history in order.statusHistory|reverse %}
                            <div class="status-history-item{% if loop.last %} status-history-item:last-child{% endif %}">
                                <div class="status-history-content">
                                    <div class="status-history-badge">
                                        {% include 'admin/orders/_status_badge.html.twig' with {'status': constant('App\\Enum\\OrderStatus::' ~ history.status|upper)} %}
                                    </div>
                                    <div class="status-history-details">
                                        <div class="status-history-label">{{ history.label }}</div>
                                        <small class="status-history-date">{{ history.changed_at }}</small>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="status-history-empty">Aucun historique disponible.</p>
                {% endif %}
            </div>
        </div>

        {# Dates importantes #}
        <div class="dates-card">
            <div class="order-card-header">
                <h5 class="order-card-title">
                    <span data-icon="calendar" data-icon-width="20" data-icon-height="20"></span>
                    Dates
                </h5>
            </div>
            <div class="order-card-body">
                <p><strong>Créée le :</strong><br>
                    <small class="dates-text-muted">{{ order.createdAt|date('d/m/Y à H:i') }}</small>
                </p>
                {% if order.acceptedAt %}
                    <p><strong>Acceptée le :</strong><br>
                        <small class="dates-text-muted">{{ order.acceptedAt|date('d/m/Y à H:i') }}</small>
                    </p>
                {% endif %}
                {% if order.completedAt %}
                    <p><strong>Terminée le :</strong><br>
                        <small class="dates-text-muted">{{ order.completedAt|date('d/m/Y à H:i') }}</small>
                    </p>
                {% endif %}
                <p><strong>Dernière mise à jour :</strong><br>
                    <small class="dates-text-muted">{{ order.updatedAt|date('d/m/Y à H:i') }}</small>
                </p>
            </div>
        </div>
    </div>
</div>

{# Modal d'annulation #}
<div id="cancelModal" class="cancel-modal">
    <div class="cancel-modal-content">
        <form method="post" action="{{ path('app_admin_orders_cancel', {id: order.id}) }}">
            <div class="cancel-modal-header">
                <h5 class="cancel-modal-title">Annuler la commande</h5>
                <button type="button" onclick="document.getElementById('cancelModal').style.display='none'" class="cancel-modal-close">&times;</button>
            </div>
            <div class="order-card-body">
                <div class="cancel-modal-warning">
                    <div class="cancel-modal-warning-content">
                        <span data-icon="alert-triangle" data-icon-width="20" data-icon-height="20"></span>
                        <span>Vous êtes sur le point d'annuler la commande <strong>{{ order.orderNumber }}</strong>.</span>
                    </div>
                </div>

                <div class="cancel-modal-field">
                    <label for="contact_method" class="cancel-modal-label">Mode de contact client <span class="cancel-modal-required">*</span></label>
                    <select name="contact_method" id="contact_method" required class="cancel-modal-select">
                        <option value="">-- Sélectionnez --</option>
                        <option value="phone">Appel téléphonique (GSM)</option>
                        <option value="email">Email</option>
                    </select>
                    <small class="cancel-modal-help">Vous devez avoir contacté le client avant d'annuler la commande</small>
                </div>

                <div class="cancel-modal-field">
                    <label for="reason" class="cancel-modal-label">Motif de l'annulation <span class="cancel-modal-required">*</span></label>
                    <textarea name="reason" id="reason" rows="4" required placeholder="Expliquez le motif de l'annulation et le résultat du contact avec le client..." class="cancel-modal-textarea"></textarea>
                </div>
            </div>
            <div class="cancel-modal-footer">
                <button type="button" onclick="document.getElementById('cancelModal').style.display='none'" class="cancel-modal-button-secondary">Fermer</button>
                <button type="submit" class="cancel-modal-button-danger">Confirmer l'annulation</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
