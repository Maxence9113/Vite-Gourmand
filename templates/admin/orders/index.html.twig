{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Commandes - Admin{% endblock %}
{% block page_title %}Gestion des Commandes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/admin/orders.css') }}">
{% endblock %}

{% block content %}
<div class="mb-md">
    <h1 class="order-show-title">
        🛒 Gestion des commandes
    </h1>
</div>

<!-- Stats Grid -->
<div class="grid-stats mb-md">
    <div class="stat-card text-center">
        <h6 class="stat-card-title">Total</h6>
        <h3 class="stat-card-value">{{ stats.total }}</h3>
    </div>
    <div class="stat-card text-center border-left-orange">
        <h6 class="stat-card-title">En attente</h6>
        <h3 class="orders-stat-number pending">{{ stats.pending }}</h3>
    </div>
    <div class="stat-card text-center border-left-gold">
        <h6 class="stat-card-title">Validées</h6>
        <h3 class="orders-stat-number validated">{{ stats.validated }}</h3>
    </div>
    <div class="orders-stat-card preparing">
        <h6 class="stat-card-title">En préparation</h6>
        <h3 class="orders-stat-number preparing">{{ stats.preparing }}</h3>
    </div>
    <div class="orders-stat-card delivering">
        <h6 class="stat-card-title">En livraison</h6>
        <h3 class="orders-stat-number delivering">{{ stats.delivering }}</h3>
    </div>
    <div class="orders-stat-card waiting-material">
        <h6 class="stat-card-title">Attente matériel</h6>
        <h3 class="orders-stat-number waiting-material">{{ stats.waitingMaterial }}</h3>
    </div>
</div>

<!-- Filtres -->
<div class="orders-filter-card">
    <form method="get" class="orders-filter-form">
        <div>
            <label for="status" class="orders-filter-label">Statut</label>
            <select name="status" id="status" class="orders-filter-select">
                <option value="all" {% if currentStatus == 'all' or not currentStatus %}selected{% endif %}>Tous les statuts</option>
                <option value="pending" {% if currentStatus == 'pending' %}selected{% endif %}>En attente</option>
                <option value="validated" {% if currentStatus == 'validated' %}selected{% endif %}>Validée</option>
                <option value="preparing" {% if currentStatus == 'preparing' %}selected{% endif %}>En préparation</option>
                <option value="ready" {% if currentStatus == 'ready' %}selected{% endif %}>Prête à livrer</option>
                <option value="delivering" {% if currentStatus == 'delivering' %}selected{% endif %}>En livraison</option>
                <option value="delivered" {% if currentStatus == 'delivered' %}selected{% endif %}>Livrée</option>
                <option value="waiting_material_return" {% if currentStatus == 'waiting_material_return' %}selected{% endif %}>Attente retour matériel</option>
                <option value="completed" {% if currentStatus == 'completed' %}selected{% endif %}>Terminée</option>
                <option value="cancelled" {% if currentStatus == 'cancelled' %}selected{% endif %}>Annulée</option>
            </select>
        </div>
        <div>
            <label for="date" class="orders-filter-label">Période</label>
            <select name="date" id="date" class="orders-filter-select">
                <option value="" {% if not currentDate %}selected{% endif %}>Toutes les dates</option>
                <option value="today" {% if currentDate == 'today' %}selected{% endif %}>Aujourd'hui</option>
                <option value="week" {% if currentDate == 'week' %}selected{% endif %}>7 derniers jours</option>
                <option value="month" {% if currentDate == 'month' %}selected{% endif %}>30 derniers jours</option>
            </select>
        </div>
        <div>
            <label for="search" class="orders-filter-label">Recherche</label>
            <input type="text" name="search" id="search" placeholder="N° commande, nom, email..." value="{{ currentSearch }}" class="orders-search-input">
        </div>
        <div class="orders-filter-align-end">
            <button type="submit" class="orders-filter-submit-button">
                <span data-icon="filter" data-icon-width="16" data-icon-height="16"></span>
                Filtrer
            </button>
            <a href="{{ path('app_admin_orders') }}" class="orders-filter-reset">
                <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
            </a>
        </div>
    </form>
</div>

<!-- Liste des commandes -->
<div class="orders-list-card">
    <div class="orders-search-header">
        <div class="orders-search-wrapper">
            <span data-icon="search" data-icon-width="20" data-icon-height="20" class="orders-search-icon"></span>
            <input type="text" placeholder="Rechercher une commande..." class="orders-search-field">
        </div>
    </div>

    {% if orders is empty %}
        <div class="orders-empty-state">
            <span data-icon="inbox" data-icon-width="48" data-icon-height="48" class="orders-empty-icon"></span>
            <p class="orders-empty-text">Aucune commande trouvée avec ces filtres.</p>
        </div>
    {% else %}
        <div class="orders-table-wrapper">
            <table class="orders-table">
                <colgroup>
                    <col>
                    <col>
                    <col>
                    <col>
                    <col>
                    <col>
                    <col>
                    <col>
                </colgroup>
                <thead>
                    <tr>
                        <th>N° Commande</th>
                        <th>Client</th>
                        <th>Menu</th>
                        <th>Livraison</th>
                        <th>Montant</th>
                        <th>Statut</th>
                        <th class="text-center">Mat.</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                    <tr>
                        <td>
                            <strong class="orders-table-order-number">{{ order.orderNumber }}</strong><br>
                            <small class="orders-table-order-date">{{ order.createdAt|date('d/m/Y') }}</small>
                        </td>
                        <td class="orders-table-customer" title="{{ order.customerFirstname }} {{ order.customerLastname }} - {{ order.customerEmail }}">
                            {{ order.customerFirstname }} {{ order.customerLastname }}<br>
                            <small class="orders-table-customer-email">{{ order.customerEmail }}</small>
                        </td>
                        <td class="orders-table-menu" title="{{ order.menuName }}">
                            {{ order.menuName }}<br>
                            <small class="orders-table-menu-persons">{{ order.numberOfPersons }} pers.</small>
                        </td>
                        <td>
                            {{ order.deliveryDateTime|date('d/m/Y') }}<br>
                            <small class="orders-table-order-date">{{ order.deliveryDateTime|date('H:i') }}</small>
                        </td>
                        <td>
                            <strong class="orders-table-price">{{ (order.totalPrice / 100)|number_format(2, ',', ' ') }} €</strong>
                        </td>
                        <td>
                            {% include 'admin/orders/_status_badge.html.twig' with {'status': order.status} %}
                        </td>
                        <td class="text-center">
                            {% if order.hasMaterialLoan %}
                                {% if order.materialReturned %}
                                    <span class="orders-table-material-icon" title="Matériel retourné">
                                        <span data-icon="check-circle" data-icon-width="20" data-icon-height="20"></span>
                                    </span>
                                {% elseif order.status.value == 'waiting_material_return' %}
                                    <span class="orders-table-material-waiting" title="En attente de retour">
                                        <span data-icon="alert-circle" data-icon-width="20" data-icon-height="20"></span>
                                    </span>
                                {% else %}
                                    <span class="orders-table-material-with" title="Avec matériel">
                                        <span data-icon="package" data-icon-width="20" data-icon-height="20"></span>
                                    </span>
                                {% endif %}
                            {% else %}
                                <span class="orders-table-material-none">-</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_admin_orders_show', {id: order.id}) }}" class="btn-crud btn-crud-view">
                                <span data-icon="eye" data-icon-width="16" data-icon-height="16"></span>
                                <span class="btn-crud-text">Voir</span>
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
