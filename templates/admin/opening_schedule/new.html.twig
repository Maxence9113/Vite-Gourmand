{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer un horaire{% endblock %}

{% block content %}
<div style="margin: 30px 0;">
    <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem;">
        <div style="flex: 0 0 50%; max-width: 50%; padding: 0 0.75rem; margin: 0 auto;">
            <div style="margin-bottom: 1.5rem;">
                <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn btn-sm btn-outline-secondary">
                    <i data-feather="arrow-left"></i>
                    Retour à la liste
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header badge-primary text-white">
                    <h1 style="margin: 0;">Créer un horaire d'ouverture</h1>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div style="margin-bottom: 1rem;">
                            {{ form_label(form.dayOfWeek) }}
                            {{ form_widget(form.dayOfWeek) }}
                            {{ form_errors(form.dayOfWeek) }}
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <div class="form-check">
                                {{ form_widget(form.isOpen) }}
                                {{ form_label(form.isOpen) }}
                            </div>
                            {{ form_errors(form.isOpen) }}
                        </div>

                        <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem;">
                            <div style="margin-bottom: 20px;">
                                {{ form_label(form.openingTime) }}
                                {{ form_widget(form.openingTime) }}
                                {{ form_errors(form.openingTime) }}
                            </div>

                            <div style="margin-bottom: 20px;">
                                {{ form_label(form.closingTime) }}
                                {{ form_widget(form.closingTime) }}
                                {{ form_errors(form.closingTime) }}
                            </div>
                        </div>

                        <div style="margin-top: 25px;">
                            <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn btn-secondary">
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i data-feather="save"></i>
                                Créer l'horaire
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
