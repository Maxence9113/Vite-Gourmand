{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer un horaire{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-forms') }}
{% endblock %}

{% block content %}
<style>
    /* Styles spécifiques pour new */
    .time-inputs {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .form-check-wrapper {
        padding: 1rem 1.25rem;
        background: #f0fdf4;
        border: 2px solid var(--green);
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        gap: 0.875rem;
    }

    .form-check-wrapper input[type="checkbox"] {
        appearance: none;
        width: 1.5rem;
        height: 1.5rem;
        min-width: 1.5rem;
        border: 2.5px solid #d1d5db;
        border-radius: 50%;
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
        flex-shrink: 0;
        background: white;
        margin: 0;
    }

    .form-check-wrapper input[type="checkbox"]:hover {
        border-color: var(--green);
    }

    .form-check-wrapper input[type="checkbox"]:checked {
        background: var(--green);
        border-color: var(--green);
    }

    .form-check-wrapper input[type="checkbox"]:checked::after {
        content: '';
        position: absolute;
        left: 4.5px;
        top: 1px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2.5px 2.5px 0;
        transform: rotate(45deg);
    }

    .form-check-wrapper label {
        cursor: pointer;
        font-weight: 600;
        color: var(--green);
        flex: 1;
        margin: 0;
        font-size: 0.9375rem;
    }
</style>

<div class="form-header">
    <h1>
        <span data-icon="plus-circle" data-icon-width="32" data-icon-height="32" class="form-header-icon"></span>
        Créer un horaire d'ouverture
    </h1>
    <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn-back">
        <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
        Retour
    </a>
</div>

<div class="form-card" style="max-width: 600px; margin: 0 auto;">
    {{ form_start(form) }}

    <div class="form-section">
        <div class="section-header">
            <span data-icon="calendar" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Informations de l'horaire</h3>
        </div>
        <div class="section-body">
            <div style="margin-bottom: 1.5rem;">
                {{ form_row(form.dayOfWeek) }}
            </div>

            <div class="form-check-wrapper">
                {{ form_widget(form.isOpen) }}
                {{ form_label(form.isOpen) }}
            </div>
            {{ form_errors(form.isOpen) }}
        </div>
    </div>

    <div class="form-section">
        <div class="section-header">
            <span data-icon="clock" data-icon-width="20" data-icon-height="20" style="color: var(--gold);"></span>
            <h3 class="section-title">Horaires</h3>
        </div>
        <div class="section-body">
            <div class="time-inputs">
                <div>
                    {{ form_label(form.openingTime, 'Heure d\'ouverture') }}
                    {{ form_widget(form.openingTime, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.openingTime) }}
                </div>
                <div>
                    {{ form_label(form.closingTime, 'Heure de fermeture') }}
                    {{ form_widget(form.closingTime, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.closingTime) }}
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn-cancel">
            <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>
            Créer l'horaire
        </button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
