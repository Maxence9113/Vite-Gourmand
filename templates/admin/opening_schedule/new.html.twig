{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer un horaire{% endblock %}

{% block content %}
<style>
    .form-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .form-header h1 {
        font-family: var(--font-heading);
        color: var(--bordeaux);
        font-size: 2.5rem;
        font-weight: 400;
        margin: 0;
    }

    .btn-back {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: 2px solid var(--bordeaux);
        background: transparent;
        color: var(--bordeaux);
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all var(--transition-base);
        font-family: var(--font-body);
    }

    .btn-back:hover {
        background: var(--bordeaux);
        color: white;
    }

    .form-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-section {
        border-bottom: 1px solid var(--beige);
    }

    .section-header {
        background: var(--beige);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .section-title {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--dark-text);
        margin: 0;
    }

    .section-body {
        padding: 1.5rem;
    }

    .form-control, .form-select {
        width: 100%;
        border: 1px solid var(--bordeaux);
        border-radius: var(--radius-sm);
        padding: 0.75rem;
        font-size: 0.95rem;
        font-family: var(--font-body);
        transition: all var(--transition-base);
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--bordeaux);
        box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1);
        outline: none;
    }

    .form-label {
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.875rem;
    }

    .time-inputs {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .form-check-wrapper {
        padding: 1rem 1.25rem;
        background: #f0fdf4;
        border: 2px solid var(--green);
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        gap: 0.875rem;
    }

    .form-check-wrapper input[type="checkbox"] {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        width: 1.5rem;
        height: 1.5rem;
        min-width: 1.5rem;
        border: 2.5px solid #d1d5db;
        border-radius: 50%;
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
        flex-shrink: 0;
        background: white;
        margin: 0;
    }

    .form-check-wrapper input[type="checkbox"]:hover {
        border-color: var(--green);
    }

    .form-check-wrapper input[type="checkbox"]:checked {
        background: var(--green);
        border-color: var(--green);
    }

    .form-check-wrapper input[type="checkbox"]:checked::after {
        content: '';
        position: absolute;
        left: 4.5px;
        top: 1px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2.5px 2.5px 0;
        transform: rotate(45deg);
    }

    .form-check-wrapper label {
        cursor: pointer;
        font-weight: 600;
        color: var(--green);
        flex: 1;
        margin: 0;
        font-size: 0.9375rem;
    }

    .form-actions {
        padding: 1.5rem;
        background: var(--beige);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .btn-cancel {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: 2px solid #95a5a6;
        background: transparent;
        color: #95a5a6;
        text-decoration: none;
        font-weight: 500;
        transition: all var(--transition-base);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-cancel:hover {
        background: #95a5a6;
        color: white;
    }

    .btn-submit {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: none;
        background: var(--bordeaux);
        color: white;
        font-weight: 600;
        transition: all var(--transition-base);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-submit:hover {
        opacity: 0.9;
        box-shadow: var(--shadow-md);
    }
</style>

<div class="form-header">
    <h1>
        <span data-icon="plus-circle" data-icon-width="32" data-icon-height="32" style="display: inline-block; vertical-align: middle;"></span>
        Créer un horaire d'ouverture
    </h1>
    <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn-back">
        <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
        Retour
    </a>
</div>

<div class="form-card">
    {{ form_start(form) }}

    <div class="form-section">
        <div class="section-header">
            <span data-icon="calendar" data-icon-width="20" data-icon-height="20" style="color: var(--bordeaux);"></span>
            <h3 class="section-title">Informations de l'horaire</h3>
        </div>
        <div class="section-body">
            <div style="margin-bottom: 1.5rem;">
                {{ form_row(form.dayOfWeek) }}
            </div>

            <div class="form-check-wrapper">
                {{ form_widget(form.isOpen) }}
                {{ form_label(form.isOpen) }}
            </div>
            {{ form_errors(form.isOpen) }}
        </div>
    </div>

    <div class="form-section">
        <div class="section-header">
            <span data-icon="clock" data-icon-width="20" data-icon-height="20" style="color: var(--gold);"></span>
            <h3 class="section-title">Horaires</h3>
        </div>
        <div class="section-body">
            <div class="time-inputs">
                <div>
                    {{ form_label(form.openingTime, 'Heure d\'ouverture') }}
                    {{ form_widget(form.openingTime, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.openingTime) }}
                </div>
                <div>
                    {{ form_label(form.closingTime, 'Heure de fermeture') }}
                    {{ form_widget(form.closingTime, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.closingTime) }}
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn-cancel">
            <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>
            Créer l'horaire
        </button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
