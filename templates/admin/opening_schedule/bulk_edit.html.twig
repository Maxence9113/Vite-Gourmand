{% extends 'admin/base_admin.html.twig' %}

{% block title %}Édition en masse des horaires{% endblock %}

{% block content %}
<div style="margin: 30px 0;">
    <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem;">
        <div style="flex: 0 0 66.666%; max-width: 66.666%; padding: 0 0.75rem; margin: 0 auto;">
            <div style="margin-bottom: 1.5rem;">
                <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn btn-sm btn-outline-secondary">
                    <i data-feather="arrow-left"></i>
                    Retour à la liste
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header badge-primary text-white">
                    <h1 style="margin: 0;">Édition en masse des horaires</h1>
                </div>
                <div class="card-body">
                    <div style="margin-bottom: 25px;">
                        <i data-feather="info"></i>
                        <strong>Astuce :</strong> Sélectionnez plusieurs jours et définissez les mêmes horaires pour tous en une seule fois.
                    </div>

                    {{ form_start(form) }}
                        <div style="margin-bottom: 1.5rem;">
                            <label class="form-label style="font-weight: 600;">{{ form_label(form.days) }}</label>
                            <div class="border rounded p-3 bg-light">
                                <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem;">
                                    {% for day in form.days %}
                                        <div style="margin-bottom: 10px;">
                                            <div class="form-check">
                                                {{ form_widget(day, {'attr': {'class': 'form-check-input'}}) }}
                                                {{ form_label(day, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            {{ form_errors(form.days) }}
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <div class="form-check">
                                {{ form_widget(form.isOpen) }}
                                {{ form_label(form.isOpen, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                            {{ form_errors(form.isOpen) }}
                        </div>

                        <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem;">
                            <div style="margin-bottom: 20px;">
                                {{ form_label(form.openingTime) }}
                                {{ form_widget(form.openingTime, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.openingTime) }}
                            </div>

                            <div style="margin-bottom: 20px;">
                                {{ form_label(form.closingTime) }}
                                {{ form_widget(form.closingTime, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.closingTime) }}
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <i data-feather="alert-triangle"></i>
                            <strong>Attention :</strong> Les horaires définis ici remplaceront les horaires existants pour les jours sélectionnés.
                        </div>

                        <div style="margin-top: 25px;">
                            <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn btn-secondary">
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i data-feather="save"></i>
                                Appliquer aux jours sélectionnés
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

            <div style="margin-top: 25px;">
                <div class="card-header bg-light">
                    <h5 style="margin-bottom: 0;">Exemples d'utilisation</h5>
                </div>
                <div class="card-body">
                    <ul style="margin-bottom: 0;">
                        <li style="margin-bottom: 0.5rem;"><strong>Semaine :</strong> Cochez Lundi à Vendredi, définissez 09:00 - 18:00</li>
                        <li style="margin-bottom: 0.5rem;"><strong>Week-end :</strong> Cochez Samedi et Dimanche, définissez 10:00 - 16:00</li>
                        <li style="margin-bottom: 0.5rem;"><strong>Fermeture :</strong> Cochez les jours, décochez "Restaurant ouvert"</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}