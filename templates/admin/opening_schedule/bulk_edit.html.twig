{% extends 'admin/base_admin.html.twig' %}

{% block title %}Édition en masse des horaires{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-forms') }}
    <link rel="stylesheet" href="{{ asset('styles/admin/opening-schedule.css') }}">
{% endblock %}

{% block content %}

<div class="form-header">
    <h1>
        <span data-icon="calendar-clock" data-icon-width="32" data-icon-height="32" class="form-header-icon"></span>
        Édition en masse des horaires
    </h1>
    <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn-back">
        <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
        Retour
    </a>
</div>

<div class="alert-info-custom">
    <span data-icon="lightbulb" data-icon-width="20" data-icon-height="20" class="alert-info-custom-icon"></span>
    <div>
        <strong>Astuce :</strong> Sélectionnez plusieurs jours et définissez les mêmes horaires pour tous en une seule fois.
    </div>
</div>

<div class="form-card form-card-centered">
    {{ form_start(form) }}

    <div class="form-section">
        <div class="section-header">
            <span data-icon="calendar-days" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Sélection des jours</h3>
        </div>
        <div class="section-body">
            <label class="form-label">{{ form.days.vars.label }}</label>
            <div class="days-grid">
                {% for day in form.days %}
                    <div class="day-checkbox">
                        {{ form_widget(day) }}
                        {{ form_label(day) }}
                    </div>
                {% endfor %}
            </div>
            {{ form_errors(form.days) }}
        </div>
    </div>

    <div class="form-section">
        <div class="section-header">
            <span data-icon="info" data-icon-width="20" data-icon-height="20" class="icon-green"></span>
            <h3 class="section-title">État d'ouverture</h3>
        </div>
        <div class="section-body">
            <div class="form-check-wrapper">
                {{ form_widget(form.isOpen) }}
                {{ form_label(form.isOpen) }}
            </div>
            {{ form_errors(form.isOpen) }}
        </div>
    </div>

    <div class="form-section">
        <div class="section-header">
            <span data-icon="clock" data-icon-width="20" data-icon-height="20" class="icon-gold"></span>
            <h3 class="section-title">Horaires</h3>
        </div>
        <div class="section-body">
            <div class="time-inputs">
                <div>
                    {{ form_label(form.openingTime, 'Heure d\'ouverture') }}
                    {{ form_widget(form.openingTime, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.openingTime) }}
                </div>
                <div>
                    {{ form_label(form.closingTime, 'Heure de fermeture') }}
                    {{ form_widget(form.closingTime, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.closingTime) }}
                </div>
            </div>

            <div class="alert-warning-custom">
                <span data-icon="alert-triangle" data-icon-width="20" data-icon-height="20" class="icon-warning"></span>
                <div>
                    <strong>Attention :</strong> Les horaires définis ici remplaceront les horaires existants pour les jours sélectionnés.
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn-cancel">
            <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            <span data-icon="save" data-icon-width="16" data-icon-height="16"></span>
            Appliquer aux jours sélectionnés
        </button>
    </div>

    {{ form_end(form) }}
</div>

<div class="examples-card">
    <div class="section-header">
        <span data-icon="book-open" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
        <h3 class="section-title">Exemples d'utilisation</h3>
    </div>
    <div class="examples-body">
        <ul class="examples-list">
            <li>
                <strong>Semaine :</strong>
                <span>Cochez Lundi à Vendredi, définissez 09:00 - 18:00</span>
            </li>
            <li>
                <strong>Week-end :</strong>
                <span>Cochez Samedi et Dimanche, définissez 10:00 - 16:00</span>
            </li>
            <li>
                <strong>Fermeture :</strong>
                <span>Cochez les jours, décochez "Restaurant ouvert"</span>
            </li>
        </ul>
    </div>
</div>
{% endblock %}
