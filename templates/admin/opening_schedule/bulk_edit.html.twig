{% extends 'admin/base_admin.html.twig' %}

{% block title %}Édition en masse des horaires{% endblock %}

{% block content %}
<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="mb-4">
                <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn btn-sm btn-outline-secondary">
                    <i data-feather="arrow-left"></i>
                    Retour à la liste
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h1 class="h4 mb-0">Édition en masse des horaires</h1>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <i data-feather="info"></i>
                        <strong>Astuce :</strong> Sélectionnez plusieurs jours et définissez les mêmes horaires pour tous en une seule fois.
                    </div>

                    {{ form_start(form) }}
                        <div class="mb-4">
                            <label class="form-label fw-bold">{{ form_label(form.days) }}</label>
                            <div class="border rounded p-3 bg-light">
                                <div class="row">
                                    {% for day in form.days %}
                                        <div class="col-md-6 mb-2">
                                            <div class="form-check">
                                                {{ form_widget(day, {'attr': {'class': 'form-check-input'}}) }}
                                                {{ form_label(day, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            {{ form_errors(form.days) }}
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                {{ form_widget(form.isOpen) }}
                                {{ form_label(form.isOpen, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                            {{ form_errors(form.isOpen) }}
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.openingTime) }}
                                {{ form_widget(form.openingTime, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.openingTime) }}
                            </div>

                            <div class="col-md-6 mb-3">
                                {{ form_label(form.closingTime) }}
                                {{ form_widget(form.closingTime, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.closingTime) }}
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <i data-feather="alert-triangle"></i>
                            <strong>Attention :</strong> Les horaires définis ici remplaceront les horaires existants pour les jours sélectionnés.
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn btn-secondary">
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i data-feather="save"></i>
                                Appliquer aux jours sélectionnés
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Exemples d'utilisation</h5>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li class="mb-2"><strong>Semaine :</strong> Cochez Lundi à Vendredi, définissez 09:00 - 18:00</li>
                        <li class="mb-2"><strong>Week-end :</strong> Cochez Samedi et Dimanche, définissez 10:00 - 16:00</li>
                        <li class="mb-2"><strong>Fermeture :</strong> Cochez les jours, décochez "Restaurant ouvert"</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}