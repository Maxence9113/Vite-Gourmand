{% extends 'admin/base_admin.html.twig' %}

{% block title %}Édition en masse des horaires{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-forms') }}
{% endblock %}

{% block content %}
<style>
    /* Styles spécifiques pour bulk_edit */
    .days-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 0.75rem;
        padding: 1.25rem;
        background: #f8f9fa;
        border-radius: var(--radius-lg);
        border: 2px solid var(--beige);
    }

    .day-checkbox {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.625rem 0.875rem;
        background: white;
        border-radius: var(--radius-sm);
        border: 2px solid #e9ecef;
        transition: all var(--transition-base);
        cursor: pointer;
    }

    .day-checkbox:hover {
        border-color: var(--bordeaux);
        box-shadow: var(--shadow-sm);
    }

    .day-checkbox input[type="checkbox"] {
        appearance: none;
        width: 1.375rem;
        height: 1.375rem;
        min-width: 1.375rem;
        border: 2.5px solid #d1d5db;
        border-radius: var(--radius-sm);
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
        flex-shrink: 0;
        background: white;
        margin: 0;
    }

    .day-checkbox input[type="checkbox"]:hover {
        border-color: var(--bordeaux);
    }

    .day-checkbox input[type="checkbox"]:checked {
        background: var(--bordeaux);
        border-color: var(--bordeaux);
    }

    .day-checkbox input[type="checkbox"]:checked::after {
        content: '';
        position: absolute;
        left: 4px;
        top: 0px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2.5px 2.5px 0;
        transform: rotate(45deg);
    }

    .day-checkbox label {
        cursor: pointer;
        margin: 0;
        font-weight: 500;
        color: var(--dark-text);
        font-size: 0.9375rem;
        flex: 1;
    }

    .time-inputs {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .form-check-wrapper {
        padding: 1rem 1.25rem;
        background: #f0fdf4;
        border: 2px solid var(--green);
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        gap: 0.875rem;
    }

    .form-check-wrapper input[type="checkbox"] {
        appearance: none;
        width: 1.5rem;
        height: 1.5rem;
        min-width: 1.5rem;
        border: 2.5px solid #d1d5db;
        border-radius: 50%;
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
        flex-shrink: 0;
        background: white;
        margin: 0;
    }

    .form-check-wrapper input[type="checkbox"]:hover {
        border-color: var(--green);
    }

    .form-check-wrapper input[type="checkbox"]:checked {
        background: var(--green);
        border-color: var(--green);
    }

    .form-check-wrapper input[type="checkbox"]:checked::after {
        content: '';
        position: absolute;
        left: 4.5px;
        top: 1px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2.5px 2.5px 0;
        transform: rotate(45deg);
    }

    .form-check-wrapper label {
        cursor: pointer;
        font-weight: 600;
        color: var(--green);
        flex: 1;
        margin: 0;
        font-size: 0.9375rem;
    }

    .alert-warning-custom {
        background: #fff3cd;
        border: 2px solid #ffc107;
        border-radius: var(--radius-lg);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .alert-warning-custom strong {
        color: #856404;
    }

    .examples-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
        max-width: 700px;
        margin: 2rem auto 0;
    }

    .examples-body {
        padding: 1.5rem;
    }

    .examples-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .examples-list li {
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--beige);
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .examples-list li:last-child {
        border-bottom: none;
    }

    .examples-list strong {
        color: var(--bordeaux);
        min-width: 80px;
    }
</style>

<div class="form-header">
    <h1>
        <span data-icon="calendar-clock" data-icon-width="32" data-icon-height="32" class="form-header-icon"></span>
        Édition en masse des horaires
    </h1>
    <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn-back">
        <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
        Retour
    </a>
</div>

<div class="alert-info-custom">
    <span data-icon="lightbulb" data-icon-width="20" data-icon-height="20" class="alert-info-custom-icon"></span>
    <div>
        <strong>Astuce :</strong> Sélectionnez plusieurs jours et définissez les mêmes horaires pour tous en une seule fois.
    </div>
</div>

<div class="form-card" style="max-width: 700px; margin: 0 auto 1.5rem;">
    {{ form_start(form) }}

    <div class="form-section">
        <div class="section-header">
            <span data-icon="calendar-days" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Sélection des jours</h3>
        </div>
        <div class="section-body">
            <label class="form-label">{{ form.days.vars.label }}</label>
            <div class="days-grid">
                {% for day in form.days %}
                    <div class="day-checkbox">
                        {{ form_widget(day) }}
                        {{ form_label(day) }}
                    </div>
                {% endfor %}
            </div>
            {{ form_errors(form.days) }}
        </div>
    </div>

    <div class="form-section">
        <div class="section-header">
            <span data-icon="info" data-icon-width="20" data-icon-height="20" style="color: var(--green);"></span>
            <h3 class="section-title">État d'ouverture</h3>
        </div>
        <div class="section-body">
            <div class="form-check-wrapper">
                {{ form_widget(form.isOpen) }}
                {{ form_label(form.isOpen) }}
            </div>
            {{ form_errors(form.isOpen) }}
        </div>
    </div>

    <div class="form-section">
        <div class="section-header">
            <span data-icon="clock" data-icon-width="20" data-icon-height="20" style="color: var(--gold);"></span>
            <h3 class="section-title">Horaires</h3>
        </div>
        <div class="section-body">
            <div class="time-inputs">
                <div>
                    {{ form_label(form.openingTime, 'Heure d\'ouverture') }}
                    {{ form_widget(form.openingTime, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.openingTime) }}
                </div>
                <div>
                    {{ form_label(form.closingTime, 'Heure de fermeture') }}
                    {{ form_widget(form.closingTime, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.closingTime) }}
                </div>
            </div>

            <div class="alert-warning-custom">
                <span data-icon="alert-triangle" data-icon-width="20" data-icon-height="20" style="color: #856404; flex-shrink: 0;"></span>
                <div>
                    <strong>Attention :</strong> Les horaires définis ici remplaceront les horaires existants pour les jours sélectionnés.
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a href="{{ path('app_admin_opening_schedule_index') }}" class="btn-cancel">
            <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            <span data-icon="save" data-icon-width="16" data-icon-height="16"></span>
            Appliquer aux jours sélectionnés
        </button>
    </div>

    {{ form_end(form) }}
</div>

<div class="examples-card">
    <div class="section-header">
        <span data-icon="book-open" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
        <h3 class="section-title">Exemples d'utilisation</h3>
    </div>
    <div class="examples-body">
        <ul class="examples-list">
            <li>
                <strong>Semaine :</strong>
                <span>Cochez Lundi à Vendredi, définissez 09:00 - 18:00</span>
            </li>
            <li>
                <strong>Week-end :</strong>
                <span>Cochez Samedi et Dimanche, définissez 10:00 - 16:00</span>
            </li>
            <li>
                <strong>Fermeture :</strong>
                <span>Cochez les jours, décochez "Restaurant ouvert"</span>
            </li>
        </ul>
    </div>
</div>
{% endblock %}
