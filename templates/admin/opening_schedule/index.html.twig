{% extends 'admin/base_admin.html.twig' %}

{% block title %}Horaires d'ouverture{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ importmap('admin-opening-schedule-styles') }}
{% endblock %}

{% block content %}

<div class="schedule-form">
    <h1 class="section-title">⏰ Horaires d'ouverture</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if schedules|length == 0 %}
        <div class="alert alert-info">
            Aucun horaire configuré. Utilisez le formulaire ci-dessous pour définir vos horaires.
        </div>
    {% endif %}

    {{ form_start(form) }}
        <div class="form-section">
            <h3 class="section-title">📅 Sélectionnez les jours</h3>
            <div class="days-grid">
                {% for day in form.days %}
                    <div class="day-checkbox">
                        {{ form_widget(day, {'attr': {'class': 'form-check-input me-2'}}) }}
                        {{ form_label(day) }}
                    </div>
                {% endfor %}
            </div>
            {{ form_errors(form.days) }}
        </div>

        <div class="form-section">
            <h3 class="section-title">🕐 Définissez les horaires</h3>
            <p style="font-size: 0.9rem; color: #7f8c8d; margin-bottom: 15px;">
                Si vous remplissez les horaires, le restaurant sera automatiquement marqué comme ouvert.<br>
                Laissez vide pour marquer les jours comme fermés.
            </p>

            <div class="time-inputs">
                <div>
                    {{ form_label(form.openingTime, 'Heure d\'ouverture') }}
                    {{ form_widget(form.openingTime, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 09:00'}}) }}
                    {{ form_errors(form.openingTime) }}
                </div>
                <div>
                    {{ form_label(form.closingTime, 'Heure de fermeture') }}
                    {{ form_widget(form.closingTime, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 18:00'}}) }}
                    {{ form_errors(form.closingTime) }}
                </div>
            </div>

            <div style="display: none;">
                {{ form_widget(form.isOpen) }}
            </div>
        </div>

        <button type="submit" class="btn-save">
            💾 Enregistrer les horaires
        </button>
    {{ form_end(form) }}

    {% if schedules|length > 0 %}
        <div class="current-schedule">
            <h3 class="section-title">📋 Horaires actuels</h3>
            {% for item in schedules %}
                <div class="schedule-item">
                    <strong>{{ item.label }}</strong>
                    <div>
                        {% if item.isOpen %}
                            <span class="badge badge-success">Ouvert</span>
                            {% if item.openingTime and item.closingTime %}
                                <span class="ms-2">{{ item.openingTime }} - {{ item.closingTime }}</span>
                            {% endif %}
                        {% else %}
                            <span class="badge badge-secondary">Fermé</span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}