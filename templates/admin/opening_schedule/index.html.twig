{% extends 'admin/base_admin.html.twig' %}

{% block title %}Horaires d'ouverture{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-lists') }}
{% endblock %}

{% block content %}
<style>
    /* Styles spécifiques pour les jours */
    .days-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .day-checkbox {
        padding: 1rem 1.25rem;
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: var(--radius-lg);
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.875rem;
    }

    .day-checkbox:hover {
        background: #fff8f0;
        border-color: var(--gold);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .day-checkbox.checked {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border-color: var(--green);
        box-shadow: 0 2px 12px rgba(39, 174, 96, 0.15);
    }

    .day-checkbox input[type="checkbox"] {
        appearance: none;
        width: 1.375rem;
        height: 1.375rem;
        min-width: 1.375rem;
        border: 2.5px solid #d1d5db;
        border-radius: var(--radius-sm);
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
        flex-shrink: 0;
        background: white;
        margin: 0;
    }

    .day-checkbox input[type="checkbox"]:hover {
        border-color: var(--green);
    }

    .day-checkbox input[type="checkbox"]:checked {
        background: var(--green);
        border-color: var(--green);
    }

    .day-checkbox input[type="checkbox"]:checked::after {
        content: '';
        position: absolute;
        left: 4px;
        top: 0px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2.5px 2.5px 0;
        transform: rotate(45deg);
    }

    .day-checkbox label {
        cursor: pointer;
        font-weight: 500;
        color: var(--dark-text);
        flex: 1;
        margin: 0;
        font-size: 0.9375rem;
    }

    .day-checkbox.checked label {
        color: var(--green);
        font-weight: 600;
    }

    .time-inputs {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .section-description {
        font-size: 0.875rem;
        color: #95a5a6;
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    .btn-save {
        width: 100%;
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: none;
        background: var(--bordeaux);
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--transition-base);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-save:hover {
        opacity: 0.9;
        box-shadow: var(--shadow-md);
    }

    .schedule-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--beige);
        transition: background var(--transition-base);
    }

    .schedule-item:last-child {
        border-bottom: none;
    }

    .schedule-item:hover {
        background: #f8f9fa;
    }

    .schedule-day {
        font-weight: 600;
        color: var(--dark-text);
        font-size: 0.95rem;
    }

    .schedule-time {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .badge-open {
        background: var(--green);
        color: white;
    }

    .badge-closed {
        background: #95a5a6;
        color: white;
    }

    .time-range {
        color: var(--dark-text);
        font-size: 0.9rem;
        font-weight: 500;
    }
</style>

<div class="list-header">
    <h1>
        <span data-icon="clock" data-icon-width="32" data-icon-height="32" style="display: inline-block; vertical-align: middle;"></span>
        Horaires d'ouverture
    </h1>
</div>

<div class="list-container">
    {% for message in app.flashes('success') %}
        <div class="flash-success-list">
            <span data-icon="check-circle" data-icon-width="20" data-icon-height="20" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></span>
            {{ message }}
        </div>
    {% endfor %}

    {% if schedules|length == 0 %}
        <div style="padding: 1.5rem;">
            <div class="alert-info-custom">
                <span data-icon="info" data-icon-width="20" data-icon-height="20" style="flex-shrink: 0;"></span>
                <div>Aucun horaire configuré. Utilisez le formulaire ci-dessous pour définir vos horaires.</div>
            </div>
        </div>
    {% endif %}

    {{ form_start(form) }}
        <div class="form-section">
            <div class="section-header">
                <span data-icon="calendar" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
                <h3 class="section-title">Sélectionnez les jours</h3>
            </div>
            <div class="section-body">
                <div class="days-grid" id="days-container">
                    {% for day in form.days %}
                        {{ form_widget(day) }}
                        {{ form_label(day) }}
                    {% endfor %}
                </div>
                {{ form_errors(form.days) }}
            </div>
        </div>

        <div class="form-section">
            <div class="section-header">
                <span data-icon="clock" data-icon-width="20" data-icon-height="20" style="color: var(--gold);"></span>
                <h3 class="section-title">Définissez les horaires</h3>
            </div>
            <div class="section-body">
                <p class="section-description">
                    Si vous remplissez les horaires, le restaurant sera automatiquement marqué comme ouvert.<br>
                    Laissez vide pour marquer les jours comme fermés.
                </p>

                <div class="time-inputs">
                    <div>
                        {{ form_label(form.openingTime, 'Heure d\'ouverture') }}
                        {{ form_widget(form.openingTime, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 09:00'}}) }}
                        {{ form_errors(form.openingTime) }}
                    </div>
                    <div>
                        {{ form_label(form.closingTime, 'Heure de fermeture') }}
                        {{ form_widget(form.closingTime, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 18:00'}}) }}
                        {{ form_errors(form.closingTime) }}
                    </div>
                </div>

                <div style="display: none;">
                    {{ form_widget(form.isOpen) }}
                </div>
            </div>
        </div>

        <div style="padding: 1.5rem; background: var(--beige);">
            <button type="submit" class="btn-save">
                <span data-icon="save" data-icon-width="16" data-icon-height="16"></span>
                Enregistrer les horaires
            </button>
        </div>
    {{ form_end(form) }}
</div>

{% if schedules|length > 0 %}
    <div class="list-container" style="margin-top: 2rem;">
        <div class="section-header">
            <span data-icon="list" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Horaires actuels</h3>
        </div>
        <div>
            {% for schedule in schedules %}
                <div class="schedule-item">
                    <span class="schedule-day">{{ schedule.dayOfWeek.label }}</span>
                    <div class="schedule-time">
                        {% if schedule.isOpen %}
                            <span class="badge badge-open">
                                <span data-icon="check" data-icon-width="12" data-icon-height="12"></span>
                                Ouvert
                            </span>
                            {% if schedule.openingTime and schedule.closingTime %}
                                <span class="time-range">{{ schedule.openingTime|date('H:i') }} - {{ schedule.closingTime|date('H:i') }}</span>
                            {% endif %}
                        {% else %}
                            <span class="badge badge-closed">
                                <span data-icon="x" data-icon-width="12" data-icon-height="12"></span>
                                Fermé
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}

<script>
    function styleDayCheckboxes() {
        const container = document.getElementById('days-container');
        if (!container) return;

        const checkboxes = Array.from(container.querySelectorAll('input[type="checkbox"]'));

        checkboxes.forEach(checkbox => {
            const label = container.querySelector(`label[for="${checkbox.id}"]`);
            if (label) {
                const wrapper = document.createElement('div');
                wrapper.classList.add('day-checkbox');
                if (checkbox.checked) {
                    wrapper.classList.add('checked');
                }

                checkbox.parentNode.insertBefore(wrapper, checkbox);
                wrapper.appendChild(checkbox);
                wrapper.appendChild(label);

                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        wrapper.classList.add('checked');
                    } else {
                        wrapper.classList.remove('checked');
                    }
                });
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            styleDayCheckboxes();
        }, 100);
    });
</script>
{% endblock %}
