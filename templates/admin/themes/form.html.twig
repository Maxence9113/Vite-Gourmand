{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Ajouter' }} un thème{% endblock %}

{% block content %}
<div style="margin-top: 30px;">
    <div style="display: flex; flex-wrap: wrap; margin: 0 -0.75rem;">
        <div style="flex: 0 0 66.666%; max-width: 66.666%; padding: 0 0.75rem; margin-left: 16.666%;">
            <div style="margin-bottom: 25px;">
                <h1>{{ isEdit ? 'Modifier le thème' : 'Ajouter un nouveau thème' }}</h1>
                <a href="{{ path('app_admin_themes') }}" class="btn btn-secondary">
                    Retour à la liste
                </a>
            </div>

            {# Afficher les messages flash #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}

                    <div style="margin-bottom: 1rem;">
                        {{ form_row(form.name) }}
                    </div>

                    <div style="margin-bottom: 1rem;">
                        {{ form_row(form.description) }}
                    </div>

                    <div style="margin-top: 25px;">
                        <a href="{{ path('app_admin_themes') }}" class="btn btn-secondary">
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            {{ isEdit ? 'Modifier' : 'Créer' }} le thème
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            {% if isEdit %}
            <div style="margin-top: 1rem; text-align: right;">
                <small style="color: #95a5a6;">
                    ID du thème : {{ theme.id }}
                </small>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}