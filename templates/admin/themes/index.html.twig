{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Thèmes - Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/admin-lists.css') }}">
{% endblock %}

{% block content %}
<div class="list-header">
    <h1>🎨 Gestion des thèmes</h1>
    <a href="{{ path('app_admin_themes_new') }}" class="btn-add">
        <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
        Ajouter un thème
    </a>
</div>

{% for message in app.flashes('success') %}
    <div class="flash-success-list">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="flash-error-list">{{ message }}</div>
{% endfor %}

<div class="list-container">
    <div class="list-search-bar">
        <div class="list-search-wrapper">
            <span data-icon="search" data-icon-width="20" data-icon-height="20" class="list-search-icon"></span>
            <input type="text" id="searchInput" placeholder="Rechercher un thème..." class="list-search-input">
        </div>
    </div>

    {% if themes is empty %}
        <div class="list-empty-state">
            <span data-icon="inbox" data-icon-width="48" data-icon-height="48" class="list-empty-icon"></span>
            <p class="list-empty-text">Aucun thème trouvé.</p>
        </div>
    {% else %}
        <div class="list-table-wrapper">
            <table class="list-table small-list">
                <colgroup><col><col><col></colgroup>
                <thead>
                    <tr><th>ID</th><th>Nom</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    {% for theme in themes %}
                    <tr class="theme-row">
                        <td>{{ theme.id }}</td>
                        <td><strong>{{ theme.name }}</strong></td>
                        <td>
                            <div class="crud-actions">
                                <a href="{{ path('app_admin_themes_edit', {id: theme.id}) }}" class="btn-crud btn-crud-edit">
                                    <span data-icon="edit" data-icon-width="16" data-icon-height="16"></span>
                                    <span class="btn-crud-text">Modifier</span>
                                </a>
                                <form method="post" action="{{ path('app_admin_themes_delete', {id: theme.id}) }}" class="delete-form">
                                    <button type="submit" class="btn-crud btn-crud-delete">
                                        <span data-icon="trash-2" data-icon-width="16" data-icon-height="16"></span>
                                        <span class="btn-crud-text">Supprimer</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<script src="{{ asset('table-sort.js') }}"></script>
<script>
initTableSort('themesTable', {excludeColumns: [2]});
document.getElementById('searchInput')?.addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    document.querySelectorAll('.theme-row').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(searchTerm) ? '' : 'none';
    });
});
document.querySelectorAll('.delete-form').forEach(form => {
    form.addEventListener('submit', function(e) {
        const name = this.closest('tr').querySelector('strong').textContent;
        if (!confirm(`Êtes-vous sûr de vouloir supprimer le thème « ${name} » ?`)) e.preventDefault();
    });
});
</script>
{% endblock %}
