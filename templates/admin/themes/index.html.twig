{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Thèmes{% endblock %}
{% block page_title %}Gestion des Thèmes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ importmap('admin-themes-list-styles') }}
{% endblock %}

{% block content %}

<div class="action-bar">
    <div class="search-box">
        <input type="text" placeholder="🔍 Rechercher un thème..." id="searchInput">
    </div>
    <a href="{{ path('app_admin_themes_new') }}" class="btn-add">+ Ajouter un thème</a>
</div>

<div class="table-container">
    <table class="table table-sortable" id="themesTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for theme in themes %}
            <tr class="theme-row">
                <td><strong>#{{ theme.id }}</strong></td>
                <td>{{ theme.name }}</td>
                <td class="description-cell" title="{{ theme.description }}">
                    {{ theme.description }}
                </td>
                <td>
                    <a href="{{ path('app_admin_themes_edit', {id: theme.id}) }}" class="btn btn-warning">
                        Modifier
                    </a>
                    <form method="post"
                          action="{{ path('app_admin_themes_delete', {id: theme.id}) }}"
                          style="display: inline;"
                          data-confirm="Êtes-vous sûr de vouloir supprimer le thème « {{ theme.name }} » ?">
                        <button type="submit" class="btn btn-danger">
                            Supprimer
                        </button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" class="empty-state">
                    Aucun thème trouvé. <a href="{{ path('app_admin_themes_new') }}" style="color: #3498db;">Créer un nouveau thème</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="margin-top: 20px; color: #7f8c8d; font-size: 0.9rem;">
        Total : <strong>{{ themes|length }}</strong> thème(s)
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('table-search') }}
    {{ importmap('confirmation-dialog') }}
    <script src="{{ asset('table-sort.js') }}"></script>
    <script>
        // Initialiser le tri du tableau
        initTableSort('themesTable', {
            excludeColumns: [3]
        });

        // Initialiser la recherche en temps réel
        initTableSearch('searchInput', '.theme-row');
    </script>
{% endblock %}
