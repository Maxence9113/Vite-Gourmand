<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Administration{% endblock %} - Vite & Gourmand</title>

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('table-sort.css') }}">
        <link rel="stylesheet" href="{{ asset('admin-crud.css') }}">
    {% endblock %}

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--beige);
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar - Figma Design */
        .sidebar {
            width: 16rem;
            background: white;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            box-shadow: var(--shadow-lg);
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--beige);
        }

        .sidebar-header h2 {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            font-weight: 400;
            color: var(--bordeaux);
            margin-bottom: 0.5rem;
        }

        .sidebar-header p {
            font-size: 0.875rem;
            color: var(--dark-text);
        }

        .sidebar-menu {
            padding: 1rem;
        }

        .menu-section {
            margin-bottom: 0.5rem;
        }

        .menu-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            color: var(--dark-text);
            text-decoration: none;
            transition: all var(--transition-base);
            border-radius: var(--radius-lg);
            margin-bottom: 0.5rem;
        }

        .menu-item:hover {
            background: #f8f9fa;
            color: var(--dark-text);
        }

        .menu-item.active {
            background: var(--bordeaux);
            color: white;
            box-shadow: var(--shadow-md);
        }

        .menu-item-content {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .menu-item i {
            width: 1.25rem;
            height: 1.25rem;
        }

        .menu-badge {
            background: white;
            color: var(--bordeaux);
            padding: 0.25rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .menu-item.active .menu-badge {
            background: white;
            color: var(--bordeaux);
        }

        .menu-item:not(.active) .menu-badge {
            background: var(--bordeaux);
            color: white;
        }

        .menu-divider {
            margin: 1.5rem 0;
        }

        .menu-link-home {
            padding: 0.75rem 1rem;
            border-radius: var(--radius-lg);
            margin-top: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border: 2px solid var(--gold);
            color: var(--gold);
            text-decoration: none;
            transition: all var(--transition-base);
        }

        .menu-link-home:hover {
            box-shadow: var(--shadow-md);
            color: var(--gold);
        }

        /* Main content */
        .main-content {
            margin-left: 16rem;
            flex: 1;
            min-height: 100vh;
        }

        .content-wrapper {
            padding: 2rem;
        }

        /* Flash messages - Figma Style */
        .alert {
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            border-radius: var(--radius-sm);
            border-left: 4px solid;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .alert-success {
            background: #d4edda;
            border-left-color: var(--green);
            color: #155724;
        }

        .alert-danger {
            background: #f8d7da;
            border-left-color: #dc3545;
            color: #721c24;
        }

        .alert-warning {
            background: #fff3cd;
            border-left-color: #ffc107;
            color: #856404;
        }

        .alert-info {
            background: #e7f1ff;
            border-left-color: #004085;
            color: #004085;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                position: relative;
                height: auto;
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar-menu {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 0.5rem;
            }

            .menu-link-home {
                grid-column: span 2;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2>🍽️ Vite & Gourmand</h2>
                <p>Panneau d'administration</p>
            </div>

            <nav class="sidebar-menu">
                <a href="{{ path('app_admin_dashboard') }}" class="menu-item {{ app.request.attributes.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="layout-dashboard" data-icon-width="20" data-icon-height="20"></span>
                        <span>Dashboard</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_orders') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'app_admin_orders' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="shopping-cart" data-icon-width="20" data-icon-height="20"></span>
                        <span>Commandes</span>
                    </div>
                    {% if stats is defined and stats.pendingOrders is defined and stats.pendingOrders > 0 %}
                        <span class="menu-badge">{{ stats.pendingOrders }}</span>
                    {% endif %}
                </a>

                <a href="{{ path('app_admin_reviews') }}" class="menu-item {{ app.request.attributes.get('_route') == 'app_admin_reviews' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="star" data-icon-width="20" data-icon-height="20"></span>
                        <span>Avis clients</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_menus') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'app_admin_menu' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="file-text" data-icon-width="20" data-icon-height="20"></span>
                        <span>Menus</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_recipes') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'app_admin_recipe' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="utensils-crossed" data-icon-width="20" data-icon-height="20"></span>
                        <span>Recettes</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_themes') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'app_admin_theme' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="palette" data-icon-width="20" data-icon-height="20"></span>
                        <span>Thèmes</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_categories') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'app_admin_categor' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="folder-open" data-icon-width="20" data-icon-height="20"></span>
                        <span>Catégories</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_allergens') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'app_admin_allergen' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="alert-triangle" data-icon-width="20" data-icon-height="20"></span>
                        <span>Allergènes</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_dietetaries') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'app_admin_dietetar' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="salad" data-icon-width="20" data-icon-height="20"></span>
                        <span>Régimes</span>
                    </div>
                </a>

                <a href="{{ path('app_admin_opening_schedule_index') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'app_admin_opening' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="clock" data-icon-width="20" data-icon-height="20"></span>
                        <span>Horaires</span>
                    </div>
                </a>

                {% if is_granted('ROLE_EMPLOYEE') %}
                <a href="{{ path('admin_users_index') }}" class="menu-item {{ app.request.attributes.get('_route') starts with 'admin_users' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="users" data-icon-width="20" data-icon-height="20"></span>
                        <span>Utilisateurs</span>
                    </div>
                </a>
                {% endif %}

                <a href="{{ path('app_admin_order_stats') }}" class="menu-item {{ app.request.attributes.get('_route') == 'app_admin_order_stats' ? 'active' : '' }}">
                    <div class="menu-item-content">
                        <span data-icon="trending-up" data-icon-width="20" data-icon-height="20"></span>
                        <span>Statistiques</span>
                    </div>
                </a>

                <a href="{{ path('app_home') }}" class="menu-link-home">
                    <span data-icon="home" data-icon-width="20" data-icon-height="20"></span>
                    <span>Retour au site</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="content-wrapper">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <!-- Page Content -->
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</body>
</html>