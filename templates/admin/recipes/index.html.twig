{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Recettes{% endblock %}

{% block content %}
<div style="margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1>Gestion des Recettes</h1>
        <div>
            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">Retour au Dashboard</a>
            <a href="{{ path('app_admin_recipes_new') }}" class="btn btn-success">Ajouter une recette</a>
        </div>
    </div>

    {# Afficher les messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Barre de recherche (pour plus tard) #}
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 15px; margin-bottom: 20px;">
        <div style="grid-column: span 1;">
            <input type="text" class="form-control" placeholder="Rechercher une recette..." id="searchInput">
        </div>
        <div style="grid-column: span 1;">
            <select class="form-control" id="categoryFilter">
                <option value="">Toutes les catégories</option>
                {# On ajoutera les catégories dynamiquement plus tard #}
            </select>
        </div>
    </div>

    {# Tableau des recettes #}
    <div class="card">
        <div class="card-body">
            <table class="table table-sortable" id="recipesTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Catégorie</th>
                        <th>Allergènes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for recipe in recipes %}
                    <tr class="recipe-row">
                        <td>{{ recipe.id }}</td>
                        <td>{{ recipe.title }}</td>
                        <td>{{ recipe.description|length > 50 ? recipe.description|slice(0, 50) ~ '...' : recipe.description }}</td>
                        <td data-sort="{% if recipe.category %}{{ recipe.category.name }}{% else %}Non défini{% endif %}">
                            {% if recipe.category %}
                                <span class="badge badge-info">{{ recipe.category.name }}</span>
                            {% else %}
                                <span style="background: #95a5a6;">Non défini</span>
                            {% endif %}
                        </td>
                        <td data-sort="{% if recipe.allergen|length > 0 %}{% for allergen in recipe.allergen %}{{ allergen.name }} {% endfor %}{% else %}Aucun{% endif %}">
                            {% if recipe.allergen|length > 0 %}
                                {% for allergen in recipe.allergen %}
                                    <span class="badge badge-warning">{{ allergen.name }}</span>
                                {% endfor %}
                            {% else %}
                                <span style="color: #95a5a6;">Aucun</span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="display: inline-flex; gap: 5px;" role="group">
                                <a href="#" style="font-size: 0.85rem; padding: 5px 10px;" title="Voir les détails">
                                    Voir
                                </a>
                                <a href="{{ path('app_admin_recipes_edit', {id: recipe.id}) }}" style="font-size: 0.85rem; padding: 5px 10px;" title="Modifier">
                                    Modifier
                                </a>
                                <form method="post" action="{{ path('app_admin_recipes_delete', {id: recipe.id}) }}" style="display: inline;"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer la recette « {{ recipe.title }} » ?')">
                                    <button type="submit" style="font-size: 0.85rem; padding: 5px 10px;" title="Supprimer">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; color: #95a5a6; padding: 30px 0;">
                            Aucune recette trouvée. <a href="#">Créer une nouvelle recette</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Informations sur le nombre de recettes #}
    <div style="margin-top: 20px;">
        <p style="color: #95a5a6;">
            Total : <strong>{{ recipes|length }}</strong> recette(s)
        </p>
    </div>
</div>

{# Script pour la recherche en temps réel et le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure la dernière colonne "Actions")
    initTableSort('recipesTable', {
        excludeColumns: [5]
    });

    // Recherche en temps réel
    document.getElementById('searchInput')?.addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('.recipe-row');

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });
</script>
{% endblock %}