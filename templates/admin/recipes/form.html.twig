{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ isEdit ? 'Modifier' : 'Nouvelle' }} recette{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/pages/admin-forms.css') }}">{% endblock %}
{% block content %}
<div class="form-header">
    <h1><span data-icon="utensils-crossed" data-icon-width="32" data-icon-height="32" class="form-header-icon"></span>{{ isEdit ? 'Modifier la recette' : 'Nouvelle recette' }}</h1>
    <a href="{{ path('app_admin_recipes') }}" class="btn-back"><span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>Retour</a>
</div>
{% for message in app.flashes('success') %}<div class="flash-success-inline">{{ message }}</div>{% endfor %}
<div class="form-card">
    {{ form_start(form) }}
    <div class="form-section">
        <div class="section-header">
            <span data-icon="info" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Informations de la recette</h3>
        </div>
        <div class="section-body">
            {{ form_row(form.title) }}
            {{ form_row(form.description) }}
            {{ form_row(form.category) }}
        </div>
    </div>
    <div class="form-section">
        <div class="section-header">
            <span data-icon="alert-triangle" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Allergènes</h3>
        </div>
        <div class="section-body">
            {{ form_row(form.allergen) }}
        </div>
    </div>
    <div class="form-section">
        <div class="section-header">
            <span data-icon="image" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Illustrations</h3>
        </div>
        <div class="section-body">
            {{ form_row(form.recipeIllustrations) }}
        </div>
    </div>
    <div class="form-actions">
        <a href="{{ path('app_admin_recipes') }}" class="btn-cancel">
            <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>Annuler
        </a>
        <button type="submit" class="btn-submit">
            <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>{{ isEdit ? 'Enregistrer' : 'Créer' }}
        </button>
    </div>
    {{ form_end(form) }}
</div>
{% if isEdit %}<div class="info-box"><strong>ID:</strong> {{ recipe.id }}</div>{% endif %}
{% endblock %}
