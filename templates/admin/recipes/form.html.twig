{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Ajouter' }} une recette{% endblock %}
{% block page_title %}{{ isEdit ? 'Modifier la recette' : 'Nouvelle recette' }}{% endblock %}

{% block content %}
<style>
    .form-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .form-header h1 {
        font-family: var(--font-heading);
        color: var(--bordeaux);
        font-size: 2.5rem;
        font-weight: 400;
        margin: 0;
    }

    .btn-back {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: 2px solid var(--bordeaux);
        background: transparent;
        color: var(--bordeaux);
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all var(--transition-base);
        font-family: var(--font-body);
    }

    .btn-back:hover {
        background: var(--bordeaux);
        color: white;
    }

    .form-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    .form-section {
        border-bottom: 1px solid var(--beige);
    }

    .section-header {
        background: var(--beige);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .section-title {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--dark-text);
        margin: 0;
    }

    .section-body {
        padding: 1.5rem;
    }

    .section-description {
        font-size: 0.875rem;
        color: #95a5a6;
        margin-bottom: 0.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .form-control, .form-select {
        width: 100%;
        border: 1px solid var(--bordeaux);
        border-radius: var(--radius-sm);
        padding: 0.75rem;
        font-size: 0.95rem;
        font-family: var(--font-body);
        transition: all var(--transition-base);
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--bordeaux);
        box-shadow: 0 0 0 3px rgba(139, 0, 0, 0.1);
        outline: none;
    }

    .form-label {
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.875rem;
    }

    /* Checkboxes des allergènes */
    .allergen-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
    }

    .allergen-item {
        padding: 1rem 1.25rem;
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: var(--radius-lg);
        transition: all 0.2s ease;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.875rem;
        position: relative;
    }

    .allergen-item:hover {
        background: #fff8f0;
        border-color: var(--gold);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .allergen-item.checked {
        background: linear-gradient(135deg, #fff8f0 0%, #fef5eb 100%);
        border-color: var(--bordeaux);
        box-shadow: 0 2px 12px rgba(139, 0, 0, 0.15);
    }

    .allergen-item input[type="checkbox"] {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        width: 1.375rem;
        height: 1.375rem;
        min-width: 1.375rem;
        border: 2.5px solid #d1d5db;
        border-radius: var(--radius-sm);
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
        flex-shrink: 0;
        background: white;
        margin: 0;
    }

    .allergen-item input[type="checkbox"]:hover {
        border-color: var(--bordeaux);
    }

    .allergen-item input[type="checkbox"]:checked {
        background: var(--bordeaux);
        border-color: var(--bordeaux);
    }

    .allergen-item input[type="checkbox"]:checked::after {
        content: '';
        position: absolute;
        left: 4px;
        top: 0px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2.5px 2.5px 0;
        transform: rotate(45deg);
    }

    .allergen-item label {
        cursor: pointer;
        font-weight: 500;
        color: var(--dark-text);
        flex: 1;
        margin: 0;
        font-size: 0.9375rem;
    }

    .allergen-item.checked label {
        color: var(--bordeaux);
        font-weight: 600;
    }

    .form-actions {
        padding: 1.5rem;
        background: var(--beige);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .btn-cancel {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: 2px solid #95a5a6;
        background: transparent;
        color: #95a5a6;
        text-decoration: none;
        font-weight: 500;
        transition: all var(--transition-base);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-cancel:hover {
        background: #95a5a6;
        color: white;
    }

    .btn-submit {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: none;
        background: var(--bordeaux);
        color: white;
        font-weight: 600;
        transition: all var(--transition-base);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-submit:hover {
        opacity: 0.9;
        box-shadow: var(--shadow-md);
    }

    .illustration-item {
        background: white;
        border: 2px solid var(--beige);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all var(--transition-base);
    }

    .illustration-item:hover {
        border-color: var(--gold);
        box-shadow: var(--shadow-sm);
    }

    .btn-add-illustration {
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-lg);
        border: 2px dashed var(--gold);
        background: transparent;
        color: var(--gold);
        cursor: pointer;
        font-weight: 500;
        transition: all var(--transition-base);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-add-illustration:hover {
        background: var(--gold);
        color: white;
        border-style: solid;
    }

    .btn-remove-illustration {
        padding: 0.5rem 1rem;
        border-radius: var(--radius-sm);
        border: 2px solid #e74c3c;
        background: transparent;
        color: #e74c3c;
        cursor: pointer;
        font-size: 0.875rem;
        transition: all var(--transition-base);
    }

    .btn-remove-illustration:hover {
        background: #e74c3c;
        color: white;
    }

    .info-box {
        background: #e7f1ff;
        border-left: 4px solid var(--bordeaux);
        padding: 1rem 1.5rem;
        border-radius: var(--radius-sm);
        margin-top: 1.5rem;
    }

    .info-box strong {
        color: var(--bordeaux);
    }

    /* Override des styles Symfony par défaut */
    .form-check {
        padding-left: 0;
        margin-bottom: 0;
    }

    .form-check-input {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        float: none;
        margin-left: 0;
        margin-top: 0;
    }

    .form-check-input:focus {
        border-color: var(--bordeaux);
        box-shadow: none;
    }

    .form-check-label {
        padding-left: 0;
    }
</style>

<div class="form-header">
    <h1>
        <span data-icon="utensils" data-icon-width="32" data-icon-height="32" style="display: inline-block; vertical-align: middle;"></span>
        {{ isEdit ? 'Modifier la recette' : 'Nouvelle recette' }}
    </h1>
    <a href="{{ path('app_admin_recipes') }}" class="btn-back">
        <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
        Retour à la liste
    </a>
</div>

{# Afficher les messages flash #}
{% for message in app.flashes('success') %}
    <div style="background: #d4edda; color: #155724; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border: 1px solid #c3e6cb;">
        {{ message }}
    </div>
{% endfor %}

<div class="form-card">
    {{ form_start(form) }}

    {# Section 1: Informations de base #}
    <div class="form-section">
        <div class="section-header">
            <span data-icon="info" data-icon-width="20" data-icon-height="20" style="color: var(--bordeaux);"></span>
            <h3 class="section-title">Informations de base</h3>
        </div>
        <div class="section-body">
            <div style="margin-bottom: 1.5rem;">
                {{ form_row(form.title) }}
            </div>
            <div style="margin-bottom: 1.5rem;">
                {{ form_row(form.description) }}
            </div>
            <div>
                {{ form_row(form.category) }}
            </div>
        </div>
    </div>

    {# Section 2: Allergènes #}
    <div class="form-section">
        <div class="section-header">
            <span data-icon="shield" data-icon-width="20" data-icon-height="20" style="color: var(--bordeaux);"></span>
            <h3 class="section-title">Allergènes</h3>
        </div>
        <div class="section-body">
            <p class="section-description">
                Sélectionnez les allergènes présents dans cette recette (optionnel).
            </p>
            <div class="allergen-grid" id="allergen-container">
                {% for allergen in form.allergen %}
                    {{ form_widget(allergen) }}
                    {{ form_label(allergen) }}
                {% endfor %}
            </div>
            {{ form_errors(form.allergen) }}
        </div>
    </div>

    {# Section 3: Illustrations #}
    <div class="form-section">
        <div class="section-header">
            <span data-icon="image" data-icon-width="20" data-icon-height="20" style="color: var(--gold);"></span>
            <h3 class="section-title">Illustrations du plat</h3>
        </div>
        <div class="section-body">
            <p class="section-description">
                Ajoutez des photos de votre recette pour la rendre plus attractive.
            </p>

            <div id="illustrations-list"
                 data-prototype="{{ form_widget(form.recipeIllustrations.vars.prototype)|e('html_attr') }}"
                 data-index="{{ form.recipeIllustrations|length }}">

                {% for illustration in form.recipeIllustrations %}
                    <div class="illustration-item">
                        <div class="form-grid">
                            <div>
                                {{ form_row(illustration.imageFile) }}
                            </div>
                            <div>
                                {{ form_row(illustration.alt_text) }}
                            </div>
                        </div>

                        {% if isEdit and illustration.vars.data.url %}
                            <div style="margin-top: 1rem;">
                                <img src="{{ illustration.vars.data.url }}"
                                     alt="{{ illustration.vars.data.altText }}"
                                     style="max-width: 200px; border-radius: var(--radius-lg); border: 2px solid var(--beige);">
                            </div>
                        {% endif %}

                        <button type="button" class="btn-remove-illustration" style="margin-top: 1rem;">
                            <span data-icon="trash-2" data-icon-width="16" data-icon-height="16"></span>
                            Supprimer cette illustration
                        </button>
                    </div>
                {% endfor %}
            </div>

            <button type="button" class="btn-add-illustration" id="add-illustration">
                <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
                Ajouter une illustration
            </button>
        </div>
    </div>

    {# Actions du formulaire #}
    <div class="form-actions">
        <a href="{{ path('app_admin_recipes') }}" class="btn-cancel">
            <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>
            {{ isEdit ? 'Enregistrer les modifications' : 'Créer la recette' }}
        </button>
    </div>

    {{ form_end(form) }}
</div>

{% if isEdit %}
    <div class="info-box">
        <strong>ID de la recette :</strong> {{ recipe.id }}
    </div>
{% endif %}

<script>
    // Styliser les checkboxes des allergènes
    function styleAllergenCheckboxes() {
        const container = document.getElementById('allergen-container');
        if (!container) return;

        const checkboxes = Array.from(container.querySelectorAll('input[type="checkbox"]'));

        checkboxes.forEach(checkbox => {
            const label = container.querySelector(`label[for="${checkbox.id}"]`);
            if (label) {
                // Créer un wrapper
                const wrapper = document.createElement('div');
                wrapper.classList.add('allergen-item');
                if (checkbox.checked) {
                    wrapper.classList.add('checked');
                }

                // Déplacer checkbox et label dans le wrapper
                checkbox.parentNode.insertBefore(wrapper, checkbox);
                wrapper.appendChild(checkbox);
                wrapper.appendChild(label);

                // Ajouter l'événement
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        wrapper.classList.add('checked');
                    } else {
                        wrapper.classList.remove('checked');
                    }
                });
            }
        });
    }

    // Initialisation
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            styleAllergenCheckboxes();
        }, 100);
    });
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Inclure le fichier JavaScript pour la gestion des illustrations #}
    {{ importmap('admin-recipe-illustrations') }}
{% endblock %}