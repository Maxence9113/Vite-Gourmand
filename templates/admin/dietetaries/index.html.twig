{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Régimes Alimentaires - Admin{% endblock %}

{% block content %}
<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
    <h1 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 2.5rem; font-weight: 400;">
        🥗 Gestion des régimes alimentaires
    </h1>
    <a href="{{ path('app_admin_dietetaries_new') }}" style="padding: 0.75rem 1.5rem; border-radius: var(--radius-lg); border: none; background: var(--gold); color: var(--dark-text); cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; transition: all var(--transition-base);" onmouseover="this.style.boxShadow='var(--shadow-md)'" onmouseout="this.style.boxShadow='none'">
        <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
        Ajouter un régime alimentaire
    </a>
</div>

{# Afficher les messages flash #}
{% for message in app.flashes('success') %}
    <div style="background: #d4edda; color: #155724; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border: 1px solid #c3e6cb;">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div style="background: #f8d7da; color: #721c24; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border: 1px solid #f5c6cb;">
        {{ message }}
    </div>
{% endfor %}

<!-- Liste des régimes alimentaires -->
<div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden;">
    <div style="padding: 1rem 1.5rem; border-bottom: 1px solid var(--beige);">
        <div style="position: relative;">
            <span data-icon="search" data-icon-width="20" data-icon-height="20" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--dark-text);"></span>
            <input type="text" id="searchInput" placeholder="Rechercher un régime alimentaire..." style="width: 100%; padding: 0.5rem 1rem 0.5rem 2.5rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-lg); font-family: var(--font-body);">
        </div>
    </div>

    {% if dietetaries is empty %}
        <div style="text-align: center; padding: 3rem 1.25rem;">
            <span data-icon="inbox" data-icon-width="48" data-icon-height="48" style="color: var(--dark-text); opacity: 0.3; margin-bottom: 1rem; display: inline-block;"></span>
            <p style="color: var(--dark-text); opacity: 0.6; margin: 0;">Aucun régime alimentaire trouvé.</p>
        </div>
    {% else %}
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                <colgroup>
                    <col style="width: 8%;">
                    <col style="width: 70%;">
                    <col style="width: 22%;">
                </colgroup>
                <thead style="background: var(--beige);">
                    <tr>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">ID</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">Nom</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; color: var(--dark-text); font-weight: 600;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for dietetary in dietetaries %}
                    <tr class="dietetary-row" style="border-bottom: 1px solid var(--beige);" onmouseover="this.style.backgroundColor='#f8f9fa'" onmouseout="this.style.backgroundColor=''">
                        <td style="padding: 1rem 1.5rem; color: var(--dark-text);">{{ dietetary.id }}</td>
                        <td style="padding: 1rem 1.5rem; color: var(--dark-text);"><strong>{{ dietetary.name }}</strong></td>
                        <td style="padding: 1rem 1.5rem;">
                            <div class="crud-actions">
                                <a href="{{ path('app_admin_dietetaries_edit', {id: dietetary.id}) }}" class="btn-crud btn-crud-edit">
                                    <span data-icon="edit" data-icon-width="16" data-icon-height="16"></span>
                                    <span class="btn-crud-text">Modifier</span>
                                </a>
                                <form method="post" action="{{ path('app_admin_dietetaries_delete', {id: dietetary.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le régime alimentaire « {{ dietetary.name }} » ?')">
                                    <button type="submit" class="btn-crud btn-crud-delete">
                                        <span data-icon="trash-2" data-icon-width="16" data-icon-height="16"></span>
                                        <span class="btn-crud-text">Supprimer</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Script pour la recherche en temps réel et le tri #}
<script src="{{ asset('table-sort.js') }}"></script>
<script>
    // Initialiser le tri du tableau (exclure la dernière colonne "Actions")
    initTableSort('dietetariesTable', {
        excludeColumns: [2]
    });

    // Recherche en temps réel
    document.getElementById('searchInput')?.addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('.dietetary-row');

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });
</script>
{% endblock %}
