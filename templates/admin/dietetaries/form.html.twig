{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Ajouter' }} un régime{% endblock %}
{% block page_title %}{{ isEdit ? 'Modifier le régime' : 'Nouveau régime' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/admin-forms.css') }}">
{% endblock %}

{% block content %}
<div class="form-header">
    <h1>
        <span data-icon="salad" data-icon-width="32" data-icon-height="32" class="form-header-icon"></span>
        {{ isEdit ? 'Modifier le régime' : 'Nouveau régime' }}
    </h1>
    <a href="{{ path('app_admin_dietetaries') }}" class="btn-back">
        <span data-icon="arrow-left" data-icon-width="16" data-icon-height="16"></span>
        Retour à la liste
    </a>
</div>

{% for message in app.flashes('success') %}
    <div class="flash-success-inline">{{ message }}</div>
{% endfor %}

<div class="form-card">
    {{ form_start(form) }}
    <div class="form-section">
        <div class="section-header">
            <span data-icon="info" data-icon-width="20" data-icon-height="20" class="section-header-icon"></span>
            <h3 class="section-title">Informations du régime</h3>
        </div>
        <div class="section-body">
            {% if isEdit and dietetary.recipes|length > 0 %}
                <div class="alert-info-custom">
                    <span data-icon="info" data-icon-width="20" data-icon-height="20" class="alert-info-custom-icon"></span>
                    <div><strong>Information :</strong> Ce régime est utilisé par {{ dietetary.recipes|length }} recette(s).</div>
                </div>
            {% endif %}
            <div>{{ form_row(form.name) }}</div>
        </div>
    </div>
    <div class="form-actions">
        <a href="{{ path('app_admin_dietetaries') }}" class="btn-cancel">
            <span data-icon="x" data-icon-width="16" data-icon-height="16"></span>
            Annuler
        </a>
        <button type="submit" class="btn-submit">
            <span data-icon="check" data-icon-width="16" data-icon-height="16"></span>
            {{ isEdit ? 'Enregistrer les modifications' : 'Créer le régime' }}
        </button>
    </div>
    {{ form_end(form) }}
</div>

{% if isEdit %}
    <div class="info-box"><strong>ID du régime :</strong> {{ dietetary.id }}</div>
{% endif %}
{% endblock %}
