{% extends 'base.html.twig' %}

{% block title %}Mes adresses - Vite & Gourmand{% endblock %}

{% block body %}

<div style="padding: 3rem 0;">
    {# Messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# En-tête #}
    <div style="margin-bottom: 25px;">
        <div style="flex: 0 0 100%; max-width: 100%; padding: 0 0.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <a href="{{ path('app_account') }}" style="text-decoration: none; color: #95a5a6; margin-bottom: 0.5rem; display: inline-block;">
                        <i data-feather="arrow-left" width="16"></i> Retour au compte
                    </a>
                    <h1 style="font-size: 2rem; font-weight: bold; margin-bottom: 0.25rem; color: var(--primary);">
                        <i data-feather="map-pin" width="32" style="margin-right: 0.5rem;"></i>
                        Mes adresses
                    </h1>
                    <p style="margin: 0;">Gérez vos adresses de livraison</p>
                </div>
                <div>
                    <a href="{{ path('app_account_address_new') }}" class="btn btn-primary">
                        <i data-feather="plus" width="18" style="margin-right: 0.5rem;"></i>
                        Nouvelle adresse
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Liste des adresses #}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        {% if addresses is empty %}
            <div style="grid-column: 1 / -1;">
                <div class="account-card">
                    <div style="text-align: center; padding: 3rem 1.25rem;">
                        <i data-feather="map-pin" width="64" style="color: var(--primary); opacity: 0.3; margin-bottom: 1rem;"></i>
                        <h5 style="margin-bottom: 1rem;">Aucune adresse enregistrée</h5>
                        <p style="margin-bottom: 25px;">Ajoutez une adresse pour faciliter vos futures commandes</p>
                        <a href="{{ path('app_account_address_new') }}" class="btn btn-primary">
                            <i data-feather="plus" width="18" style="margin-right: 0.5rem;"></i>
                            Ajouter ma première adresse
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            {% for address in addresses %}
                <div>
                    <div style="height: 100%; {% if address.isDefault %}border-color: var(--primary);{% endif %}">
                        <div class="card-body">
                            {# Badge par défaut #}
                            {% if address.isDefault %}
                                <div style="margin-bottom: 1rem;">
                                    <span class="badge badge-primary">
                                        <i data-feather="star" width="14"></i>
                                        Adresse par défaut
                                    </span>
                                </div>
                            {% endif %}

                            {# Label #}
                            {% if address.label %}
                                <h5 style="margin-bottom: 20px;">
                                    <i data-feather="tag" width="18" style="margin-right: 0.25rem;"></i>
                                    {{ address.label }}
                                </h5>
                            {% else %}
                                <h5 style="margin-bottom: 1rem; color: #95a5a6;">
                                    <i data-feather="map-pin" width="18" style="margin-right: 0.25rem;"></i>
                                    Adresse #{{ address.id }}
                                </h5>
                            {% endif %}

                            {# Adresse complète #}
                            <div style="margin-bottom: 1rem;">
                                <p style="margin-bottom: 0.25rem; color: #6c757d; font-size: 0.875rem; font-weight: 600;">
                                    <i data-feather="map" width="16" style="margin-right: 0.25rem;"></i>
                                    Adresse
                                </p>
                                <p style="margin-bottom: 0;">{{ address.street }}</p>
                                <p style="margin-bottom: 0;">{{ address.postalCode }} {{ address.city }}</p>
                            </div>

                            {# Téléphone #}
                            <div style="margin-bottom: 1rem;">
                                <p style="margin-bottom: 0.25rem; color: #6c757d; font-size: 0.875rem; font-weight: 600;">
                                    <i data-feather="phone" width="16" style="margin-right: 0.25rem;"></i>
                                    Téléphone
                                </p>
                                <p style="margin-bottom: 0;">{{ address.phone }}</p>
                            </div>

                            {# Actions #}
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                <a href="{{ path('app_account_address_edit', {id: address.id}) }}"
                                   style="flex: 1;">
                                    <i data-feather="edit-2" width="14" style="margin-right: 0.25rem;"></i>
                                    Modifier
                                </a>

                                {% if not address.isDefault %}
                                    <form method="post"
                                          action="{{ path('app_account_address_set_default', {id: address.id}) }}"
                                          style="flex: 1;"
                                          onsubmit="return confirm('Définir cette adresse comme adresse par défaut ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('set-default-' ~ address.id) }}">
                                        <button type="submit" style="width: 100%; background-color: #27ae60; color: white;">
                                            <i data-feather="star" width="14" style="margin-right: 0.25rem;"></i>
                                            Par défaut
                                        </button>
                                    </form>
                                {% endif %}

                                <form method="post"
                                      action="{{ path('app_account_address_delete', {id: address.id}) }}"
                                      style="flex: 1;"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette adresse ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-address-' ~ address.id) }}">
                                    <button type="submit" style="width: 100%; background-color: #e74c3c; color: white;">
                                        <i data-feather="trash-2" width="14" style="margin-right: 0.25rem;"></i>
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

{% endblock %}