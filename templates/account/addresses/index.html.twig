{% extends 'base.html.twig' %}

{% block title %}Mes adresses{% endblock %}

{% block body %}
{# ========================================
   HEADER SECTION - Figma Design
   ======================================== #}
<section class="addresses-page-section">
    <div class="container">

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                <span data-icon="check-circle" data-icon-width="24" data-icon-height="24" class="flash-message-icon"></span>
                <div class="flash-message-content">
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                <span data-icon="alert-circle" data-icon-width="24" data-icon-height="24" class="flash-message-icon"></span>
                <div class="flash-message-content">
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" class="breadcrumb">
            <ol class="breadcrumb-list">
                <li>
                    <a href="{{ path('app_home') }}" class="breadcrumb-link">
                        Accueil
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li>
                    <a href="{{ path('app_account') }}" class="breadcrumb-link">
                        Mon compte
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li class="breadcrumb-current">
                    Mes adresses
                </li>
            </ol>
        </nav>

        {# En-tête avec titre et bouton #}
        <div class="addresses-page-header">
            <div class="addresses-page-title-block">
                <h1>Mes adresses de livraison</h1>
                <div class="addresses-page-title-divider"></div>
                <p class="addresses-page-subtitle">
                    Gérez vos adresses de livraison pour vos futures commandes
                </p>
            </div>
            <a href="{{ path('app_account_address_new') }}" class="btn btn-primary">
                <span data-icon="plus" data-icon-width="18" data-icon-height="18"></span>
                Nouvelle adresse
            </a>
        </div>

        {# Liste des adresses #}
        {% if addresses is empty %}
            <div class="addresses-empty-state">
                <span data-icon="map-pin" data-icon-width="64" data-icon-height="64" class="addresses-empty-icon"></span>
                <h2 class="addresses-empty-title">
                    Aucune adresse enregistrée
                </h2>
                <p class="addresses-empty-text">
                    Ajoutez une adresse pour faciliter vos futures commandes
                </p>
                <a href="{{ path('app_account_address_new') }}" class="btn btn-primary">
                    <span data-icon="plus" data-icon-width="20" data-icon-height="20"></span>
                    Ajouter ma première adresse
                </a>
            </div>
        {% else %}
            <div class="addresses-cards-grid">
                {% for address in addresses %}
                    <div class="address-card-item {{ address.isDefault ? 'is-default' : '' }}">

                        {# Badge par défaut #}
                        {% if address.isDefault %}
                            <div class="address-default-badge">
                                <span data-icon="star" data-icon-width="12" data-icon-height="12"></span>
                                Défaut
                            </div>
                        {% endif %}

                        {# Label #}
                        <h3 class="address-card-title {{ address.isDefault ? 'with-badge' : '' }}">
                            {% if address.label %}
                                <span data-icon="tag" data-icon-width="18" data-icon-height="18"></span>
                                {{ address.label }}
                            {% else %}
                                <span data-icon="map-pin" data-icon-width="18" data-icon-height="18"></span>
                                Adresse #{{ address.id }}
                            {% endif %}
                        </h3>

                        {# Adresse complète #}
                        <div class="address-card-body">
                            <p class="address-card-field-label">
                                <span data-icon="map" data-icon-width="14" data-icon-height="14"></span>
                                Adresse
                            </p>
                            <p class="address-card-field-value">{{ address.street }}</p>
                            <p class="address-card-field-value-last">{{ address.postalCode }} {{ address.city }}</p>

                            <p class="address-card-field-label">
                                <span data-icon="phone" data-icon-width="14" data-icon-height="14"></span>
                                Téléphone
                            </p>
                            <p class="address-card-field-value">{{ address.phone }}</p>
                        </div>

                        {# Actions #}
                        <div class="address-card-actions">
                            <a href="{{ path('app_account_address_edit', {id: address.id}) }}" class="address-btn-edit">
                                <span data-icon="edit-2" data-icon-width="14" data-icon-height="14"></span>
                                Modifier
                            </a>

                            {% if not address.isDefault %}
                                <form method="post" action="{{ path('app_account_address_set_default', {id: address.id}) }}" class="address-action-form" onsubmit="return confirm('Définir cette adresse comme adresse par défaut ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('set-default-' ~ address.id) }}">
                                    <button type="submit" class="address-btn-set-default">
                                        <span data-icon="star" data-icon-width="14" data-icon-height="14"></span>
                                        Par défaut
                                    </button>
                                </form>
                            {% endif %}

                            <form method="post" action="{{ path('app_account_address_delete', {id: address.id}) }}" class="address-action-form" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette adresse ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-address-' ~ address.id) }}">
                                <button type="submit" class="address-btn-delete">
                                    <span data-icon="trash-2" data-icon-width="14" data-icon-height="14"></span>
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
