{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouvelle' }} adresse{% endblock %}

{% block body %}
{# ========================================
   HEADER SECTION - Figma Design
   ======================================== #}
<section class="address-form-section">
    <div class="container">

        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" class="breadcrumb">
            <ol class="breadcrumb-list">
                <li>
                    <a href="{{ path('app_home') }}" class="breadcrumb-link">
                        Accueil
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li>
                    <a href="{{ path('app_account_addresses') }}" class="breadcrumb-link">
                        Mes adresses
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li class="breadcrumb-current">
                    {{ isEdit ? 'Modifier l\'adresse' : 'Nouvelle adresse' }}
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div class="address-form-header">
            <h1>
                {% if isEdit %}
                    <span data-icon="edit-2" data-icon-width="32" data-icon-height="32"></span>
                    Modifier l'adresse
                {% else %}
                    <span data-icon="plus" data-icon-width="32" data-icon-height="32"></span>
                    Nouvelle adresse
                {% endif %}
            </h1>
            <div class="address-form-title-divider"></div>
            <p class="address-form-description">
                {% if isEdit %}
                    Modifiez les informations de votre adresse
                {% else %}
                    Ajoutez une nouvelle adresse de livraison
                {% endif %}
            </p>
        </div>

        {# Formulaire #}
        <div class="address-form-wrapper">
            <div class="address-form-card">

                {{ form_start(form) }}

                {# Label (optionnel) #}
                <div class="address-form-group">
                    {{ form_label(form.label, null, {'label_attr': {'class': 'address-form-label'}}) }}
                    {{ form_widget(form.label, {'attr': {'class': 'address-form-input', 'placeholder': 'Ex: Maison, Travail, Domicile...'}}) }}
                    <small class="address-form-help">{{ form_help(form.label) }}</small>
                    {{ form_errors(form.label) }}
                </div>

                {# Adresse #}
                <div class="address-form-group">
                    {{ form_label(form.street, null, {'label_attr': {'class': 'address-form-label'}}) }}
                    <span class="address-form-required">*</span>
                    {{ form_widget(form.street, {'attr': {'class': 'address-form-input', 'placeholder': '25 Rue des Chartrons'}}) }}
                    {{ form_errors(form.street) }}
                </div>

                {# Code postal et Ville #}
                <div class="address-form-row">
                    <div>
                        {{ form_label(form.postalCode, null, {'label_attr': {'class': 'address-form-label'}}) }}
                        <span class="address-form-required">*</span>
                        {{ form_widget(form.postalCode, {'attr': {'class': 'address-form-input', 'placeholder': '33000'}}) }}
                        {{ form_errors(form.postalCode) }}
                    </div>

                    <div>
                        {{ form_label(form.city, null, {'label_attr': {'class': 'address-form-label'}}) }}
                        <span class="address-form-required">*</span>
                        {{ form_widget(form.city, {'attr': {'class': 'address-form-input', 'placeholder': 'Bordeaux'}}) }}
                        {{ form_errors(form.city) }}
                    </div>
                </div>

                {# Téléphone #}
                <div class="address-form-group">
                    {{ form_label(form.phone, null, {'label_attr': {'class': 'address-form-label'}}) }}
                    <span class="address-form-required">*</span>
                    {{ form_widget(form.phone, {'attr': {'class': 'address-form-input', 'placeholder': '05 56 12 34 56'}}) }}
                    <small class="address-form-help">{{ form_help(form.phone) }}</small>
                    {{ form_errors(form.phone) }}
                </div>

                {# Adresse par défaut #}
                <div class="address-form-checkbox-wrapper">
                    <label class="address-form-checkbox-label">
                        {{ form_widget(form.isDefault, {'attr': {'class': 'address-form-checkbox-input'}}) }}
                        <div class="address-form-checkbox-text">
                            <span class="address-form-checkbox-title">{{ form.isDefault.vars.label }}</span>
                            <p class="address-form-checkbox-description">
                                {{ form_help(form.isDefault) }}
                            </p>
                        </div>
                    </label>
                    {{ form_errors(form.isDefault) }}
                </div>

                {# Info Bordeaux #}
                <div class="address-form-info-box">
                    <span data-icon="info" data-icon-width="20" data-icon-height="20" class="address-form-info-icon"></span>
                    <div class="address-form-info-content">
                        <p class="address-form-info-title">Frais de livraison</p>
                        <ul class="address-form-info-list">
                            <li>Bordeaux : 5€</li>
                            <li>Hors Bordeaux : 5€ + 0,59€/km parcouru</li>
                        </ul>
                    </div>
                </div>

                {# Boutons d'action #}
                <div class="address-form-actions">
                    <a href="{{ path('app_account_addresses') }}" class="address-btn-cancel">
                        <span data-icon="x" data-icon-width="18" data-icon-height="18"></span>
                        Annuler
                    </a>
                    <button type="submit" class="address-btn-submit">
                        <span data-icon="{% if isEdit %}save{% else %}plus{% endif %}" data-icon-width="18" data-icon-height="18"></span>
                        {{ isEdit ? 'Enregistrer les modifications' : 'Ajouter l\'adresse' }}
                    </button>
                </div>

                {{ form_end(form) }}

                {# Note sur les champs obligatoires #}
                <div class="address-form-footer">
                    <small class="address-form-footer-note">
                        <span class="address-form-required">*</span> Champs obligatoires
                    </small>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const postalCodeInput = document.querySelector('#address_postalCode');
    const cityInput = document.querySelector('#address_city');
    const cityContainer = cityInput ? cityInput.parentElement : null;

    if (!postalCodeInput || !cityInput || !cityContainer) {
        return; // Les champs n'existent pas sur la page
    }

    let fetchTimeout = null;
    let originalCityValue = cityInput.value; // Sauvegarder la valeur initiale (en cas de modification)
    let citySelectElement = null;

    // Fonction pour transformer l'input en select
    function convertToSelect(cities) {
        // Créer un élément select
        const select = document.createElement('select');
        select.id = 'address_city';
        select.name = 'address[city]';
        select.className = 'address-form-input';
        select.required = cityInput.required;

        // Ajouter une option par défaut
        const defaultOption = document.createElement('option');
        defaultOption.value = '';
        defaultOption.textContent = 'Sélectionnez une ville';
        select.appendChild(defaultOption);

        // Ajouter les villes
        cities.forEach(city => {
            const option = document.createElement('option');
            option.value = city;
            option.textContent = city;

            // Sélectionner automatiquement si c'est la seule ville ou si elle correspond à la valeur actuelle
            if (cities.length === 1 || city === originalCityValue) {
                option.selected = true;
            }

            select.appendChild(option);
        });

        // Remplacer l'input par le select
        cityInput.replaceWith(select);
        citySelectElement = select;

        // Animer pour indiquer le changement (bordure verte temporaire)
        select.classList.add('city-select-valid');
        setTimeout(() => {
            select.classList.remove('city-select-valid');
        }, 2000);
    }

    // Fonction pour revenir à un input text
    function convertToInput() {
        if (!citySelectElement) return;

        const input = document.createElement('input');
        input.type = 'text';
        input.id = 'address_city';
        input.name = 'address[city]';
        input.className = 'address-form-input';
        input.required = citySelectElement.required;
        input.placeholder = 'Bordeaux';
        input.value = citySelectElement.value || originalCityValue;

        citySelectElement.replaceWith(input);
        citySelectElement = null;
    }

    // Fonction pour récupérer les villes depuis le code postal
    async function fetchCitiesFromPostalCode(postalCode) {
        // Validation basique : le code postal doit avoir exactement 5 chiffres
        if (!/^[0-9]{5}$/.test(postalCode)) {
            // Si le code postal est incomplet, revenir à un input
            convertToInput();
            return;
        }

        try {
            const response = await fetch(`{{ path('app_address_get_city_from_postal_code', {postalCode: '__POSTAL_CODE__'}) }}`.replace('__POSTAL_CODE__', postalCode));
            const data = await response.json();

            if (data.success && data.cities && data.cities.length > 0) {
                // Transformer en select avec toutes les villes
                convertToSelect(data.cities);
            } else {
                // Pas de ville trouvée, revenir à un input
                convertToInput();
            }
        } catch (error) {
            console.error('Erreur lors de la récupération des villes:', error);
            // En cas d'erreur, revenir à un input
            convertToInput();
        }
    }

    // Écouter les changements du code postal
    postalCodeInput.addEventListener('input', function() {
        const postalCode = this.value.trim();

        // Annuler la requête précédente si elle existe
        if (fetchTimeout) {
            clearTimeout(fetchTimeout);
        }

        // Attendre 500ms après que l'utilisateur a fini de taper
        fetchTimeout = setTimeout(() => {
            fetchCitiesFromPostalCode(postalCode);
        }, 500);
    });

    // Aussi déclencher la recherche lorsque le champ perd le focus
    postalCodeInput.addEventListener('blur', function() {
        const postalCode = this.value.trim();

        if (fetchTimeout) {
            clearTimeout(fetchTimeout);
        }

        fetchCitiesFromPostalCode(postalCode);
    });

    // Si le code postal est déjà rempli au chargement, charger les villes
    if (postalCodeInput.value && postalCodeInput.value.length === 5) {
        fetchCitiesFromPostalCode(postalCodeInput.value);
    }
});
</script>

{% endblock %}
