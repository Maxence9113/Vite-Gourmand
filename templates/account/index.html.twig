    background: transparent;
    color: var(--dark-text);
    font-family: var(--font-body);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.account-tab[data-tab]:hover {
    background: rgba(139, 0, 0, 0.05);
}

.account-tab[data-tab].active {
    background: var(--bordeaux);
    color: white;
    box-shadow: var(--shadow-sm);
}

/* Bouton Administration (lien) - ne pas modifier le hover */
.account-tab:not([data-tab]):hover {
