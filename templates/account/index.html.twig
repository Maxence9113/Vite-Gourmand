{% extends 'base.html.twig' %}

{% block title %}Mon Compte - Vite & Gourmand{% endblock %}

{% block body %}

{# ========================================
   USER ACCOUNT PAGE - Figma Design
   ======================================== #}
<section style="background-color: var(--beige); padding: 1.5rem 0 3rem;">
    <div style="max-width: 80rem; margin: 0 auto; padding: 0 1rem;">

        {# ========== Header avec info utilisateur ========== #}
        <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.5rem; margin-bottom: 1.5rem;">
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 1rem; flex: 1; min-width: 0;">
                    <div style="width: 4rem; height: 4rem; border-radius: 50%; background-color: var(--bordeaux); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <span data-icon="user" data-icon-width="32" data-icon-height="32" style="color: white;"></span>
                    </div>
                    <div style="min-width: 0; flex: 1;">
                        <h1 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin: 0 0 0.25rem; font-weight: 400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            {{ app.user.firstname }} {{ app.user.lastname }}
                        </h1>
                        <p style="font-family: var(--font-body); color: var(--dark-text); font-size: 0.875rem; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            {{ app.user.email }}
                        </p>
                    </div>
                </div>
                <a href="{{ path('app_logout') }}" style="width: 100%; padding: 0.625rem 1rem; border-radius: var(--radius-sm); border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; font-family: var(--font-body); text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: all 0.3s ease; font-size: 0.875rem;">
                    <span data-icon="log-out" data-icon-width="16" data-icon-height="16"></span>
                    Déconnexion
                </a>
            </div>
        </div>

        {# ========== Grille principale: Mobile (1 col) / Desktop (sidebar gauche + contenu) ========== #}
        <div class="account-layout">

            {# ========== Sidebar Navigation (gauche sur desktop) ========== #}
            <div class="account-sidebar">
                <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 0.75rem;">
                    <div id="accountTabs" class="account-tabs-grid">
                        {% if is_granted('ROLE_EMPLOYEE') %}
                        <a href="{{ path('app_admin_dashboard') }}" style="text-decoration: none; background: var(--gold); color: var(--dark-text); font-weight: 600;">
                            <span data-icon="shield" data-icon-width="16" data-icon-height="16"></span>
                            <span class="tab-text">Administration</span>
                        </a>
                        {% endif %}

                        <button class="account-tab active" data-tab="orders">
                            <span data-icon="shopping-bag" data-icon-width="16" data-icon-height="16"></span>
                            <span class="tab-text">Mes commandes</span>
                        </button>

                        <button class="account-tab" data-tab="addresses">
                            <span data-icon="map-pin" data-icon-width="16" data-icon-height="16"></span>
                            <span class="tab-text">Mes adresses</span>
                        </button>

                        <button class="account-tab" data-tab="profile">
                            <span data-icon="user" data-icon-width="16" data-icon-height="16"></span>
                            <span class="tab-text">Mes informations</span>
                        </button>

                        <button class="account-tab" data-tab="settings">
                            <span data-icon="settings" data-icon-width="16" data-icon-height="16"></span>
                            <span class="tab-text">Paramètres</span>
                        </button>
                    </div>
                </div>
            </div>

            {# ========== Contenu principal (droite sur desktop) ========== #}
            <div class="account-content">

                {# ========== Onglet Commandes ========== #}
                <div id="tab-orders" class="tab-content active">
                    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1rem;">
                        <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin: 0 0 1.5rem; font-weight: 400;">
                            Mes commandes
                        </h2>

                        {% if recentOrders is empty %}
                            <div style="text-align: center; padding: 3rem 1rem;">
                                <span data-icon="shopping-bag" data-icon-width="48" data-icon-height="48" style="display: block; margin: 0 auto 1rem; color: var(--gold); opacity: 0.3;"></span>
                                <h5 style="margin-bottom: 0.5rem; font-family: var(--font-heading); color: var(--bordeaux);">Aucune commande</h5>
                                <p style="margin: 0 0 1rem; color: var(--dark-text);">Vous n'avez pas encore passé de commande</p>
                                <a href="{{ path('app_menu_catalog') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: var(--bordeaux); color: white; border-radius: var(--radius-sm); text-decoration: none; font-family: var(--font-body); transition: all 0.3s ease;">
                                    <span data-icon="book-open" data-icon-width="16" data-icon-height="16"></span>
                                    Découvrir nos menus
                                </a>
                            </div>
                        {% else %}
                            <div style="display: flex; flex-direction: column; gap: 1rem;">
                                {% for order in recentOrders %}
                                    <div style="border: 1px solid var(--beige); border-radius: var(--radius-lg); padding: 1rem; transition: box-shadow 0.3s ease;" onmouseover="this.style.boxShadow='var(--shadow-md)'" onmouseout="this.style.boxShadow='none'">
                                        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1rem;">
                                            <div style="flex: 1; min-width: 0;">
                                                <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.5rem;">
                                                    <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.25rem; margin: 0; font-weight: 400; overflow: hidden; text-overflow: ellipsis;">
                                                        {{ order.menuName }}
                                                    </h3>
                                                    <span style="padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: 0.75rem; color: white; background-color: {{ order.status.badgeClass == 'success' ? 'var(--green)' : (order.status.badgeClass == 'warning' ? '#FFD700' : 'var(--bordeaux)') }}; align-self: flex-start;">
                                                        {{ order.status.label }}
                                                    </span>
                                                </div>
                                                <p style="font-size: 0.75rem; margin-bottom: 0.25rem; color: var(--dark-text);">
                                                    Commande #{{ order.orderNumber }} - Passée le {{ order.createdAt|date('d M Y') }}
                                                </p>
                                            </div>
                                            <div style="text-align: left;">
                                                <p style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.875rem; margin: 0;">
                                                    {{ (order.totalPrice / 100)|number_format(0, ',', ' ') }}€
                                                </p>
                                            </div>
                                        </div>

                                        <div style="background: var(--beige); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1rem; display: grid; grid-template-columns: 1fr; gap: 0.75rem;">
                                            <div>
                                                <p style="font-size: 0.75rem; margin-bottom: 0.25rem; color: var(--dark-text);">
                                                    <strong>Date de livraison:</strong>
                                                </p>
                                                <p style="font-size: 0.875rem; color: var(--dark-text); margin: 0;">
                                                    {{ order.deliveryDateTime|date('d/m/Y à H:i') }}
                                                </p>
                                            </div>
                                            <div>
                                                <p style="font-size: 0.75rem; margin-bottom: 0.25rem; color: var(--dark-text);">
                                                    <strong>Nombre de personnes:</strong>
                                                </p>
                                                <p style="font-size: 0.875rem; color: var(--dark-text); margin: 0;">
                                                    {{ order.numberOfPersons }} personnes
                                                </p>
                                            </div>
                                            <div>
                                                <p style="font-size: 0.75rem; margin-bottom: 0.25rem; color: var(--dark-text);">
                                                    <strong>Adresse de livraison:</strong>
                                                </p>
                                                <p style="font-size: 0.875rem; color: var(--dark-text); margin: 0;">
                                                    {{ order.deliveryAddress }}
                                                </p>
                                            </div>
                                        </div>

                                        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                            <a href="{{ path('app_order_show', {id: order.id}) }}" style="padding: 0.5rem 1rem; border-radius: var(--radius-sm); background: var(--bordeaux); color: white; text-decoration: none; font-family: var(--font-body); transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.875rem;">
                                                <span data-icon="eye" data-icon-width="16" data-icon-height="16"></span>
                                                Voir le détail
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            {% if totalOrders > recentOrders|length %}
                                <div style="margin-top: 1rem; text-align: center;">
                                    <a href="{{ path('app_account_orders') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; border-radius: var(--radius-sm); text-decoration: none; font-family: var(--font-body); transition: all 0.3s ease;">
                                        Voir toutes mes commandes ({{ totalOrders }})
                                    </a>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                {# ========== Onglet Adresses ========== #}
                <div id="tab-addresses" style="display: none;">
                    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
                            <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin: 0; font-weight: 400;">
                                Mes adresses de livraison
                            </h2>
                            <a href="{{ path('app_account_address_new') }}" style="padding: 0.5rem 1rem; border-radius: var(--radius-sm); background: var(--bordeaux); color: white; text-decoration: none; font-family: var(--font-body); display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem;">
                                <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
                                Ajouter une adresse
                            </a>
                        </div>

                        {% if app.user.addresses is empty %}
                            <div style="text-align: center; padding: 3rem 1rem;">
                                <span data-icon="map-pin" data-icon-width="48" data-icon-height="48" style="display: block; margin: 0 auto 1rem; color: var(--gold); opacity: 0.3;"></span>
                                <h5 style="margin-bottom: 0.5rem; font-family: var(--font-heading); color: var(--bordeaux);">Aucune adresse</h5>
                                <p style="margin: 0; color: var(--dark-text);">Vous n'avez pas encore enregistré d'adresse</p>
                            </div>
                        {% else %}
                            <div style="display: flex; flex-direction: column; gap: 1rem;">
                                {% for address in app.user.addresses %}
                                    <div style="border: {{ address.isDefault ? '2px solid var(--gold)' : '1px solid var(--beige)' }}; border-radius: var(--radius-lg); padding: 1.5rem; position: relative;">
                                        {% if address.isDefault %}
                                            <div style="position: absolute; top: 1rem; right: 1rem; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: 0.625rem; color: white; background: var(--gold); display: flex; align-items: center; gap: 0.25rem;">
                                                <span data-icon="check-circle" data-icon-width="12" data-icon-height="12"></span>
                                                Adresse par défaut
                                            </div>
                                        {% endif %}

                                        <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.25rem; margin: 0 0 0.75rem; font-weight: 400;">
                                            {{ address.label }}
                                        </h3>

                                        <div style="margin-bottom: 1rem; color: var(--dark-text); font-size: 0.875rem;">
                                            <p style="margin: 0 0 0.25rem;">{{ address.street }}</p>
                                            <p style="margin: 0 0 0.5rem;">{{ address.postalCode }} {{ address.city }}</p>
                                            <p style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                                                <span data-icon="phone" data-icon-width="14" data-icon-height="14" style="color: var(--gold);"></span>
                                                {{ address.phone }}
                                            </p>
                                        </div>

                                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                            <a href="{{ path('app_account_address_edit', {id: address.id}) }}" style="padding: 0.5rem 1rem; border-radius: var(--radius-sm); border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; text-decoration: none; font-family: var(--font-body); display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem;">
                                                <span data-icon="edit" data-icon-width="14" data-icon-height="14"></span>
                                                Modifier
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# ========== Onglet Profil ========== #}
                <div id="tab-profile" style="display: none;">
                    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
                            <div>
                                <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin: 0 0 0.5rem; font-weight: 400;">
                                    Mes informations personnelles
                                </h2>
                                <p style="margin: 0; color: var(--dark-text); font-size: 0.875rem;">
                                    Gérez vos informations de compte
                                </p>
                            </div>
                            <a href="{{ path('app_account_edit') }}" style="padding: 0.5rem 1rem; border-radius: var(--radius-sm); background: var(--bordeaux); color: white; text-decoration: none; font-family: var(--font-body); display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem;">
                                <span data-icon="edit" data-icon-width="16" data-icon-height="16"></span>
                                Modifier
                            </a>
                        </div>

                        <div style="display: grid; gap: 1.5rem;">
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
                                <div>
                                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                                        Prénom
                                    </label>
                                    <div style="padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 2px solid var(--bordeaux); background: var(--beige); color: var(--dark-text); font-family: var(--font-body); font-size: 0.875rem;">
                                        {{ app.user.firstname }}
                                    </div>
                                </div>

                                <div>
                                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                                        Nom
                                    </label>
                                    <div style="padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 2px solid var(--bordeaux); background: var(--beige); color: var(--dark-text); font-family: var(--font-body); font-size: 0.875rem;">
                                        {{ app.user.lastname }}
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                                    Email
                                </label>
                                <div style="padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 2px solid var(--bordeaux); background: var(--beige); color: var(--dark-text); font-family: var(--font-body); font-size: 0.875rem;">
                                    {{ app.user.email }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ========== Onglet Paramètres ========== #}
                <div id="tab-settings" style="display: none;">
                    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1rem;">
                        <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin: 0 0 1.5rem; font-weight: 400;">
                            Paramètres du compte
                        </h2>

                        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                            {# Mot de passe #}
                            <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--beige);">
                                <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.125rem; margin: 0 0 1rem; font-weight: 400;">
                                    Mot de passe
                                </h3>
                                <p style="margin: 0 0 1rem; color: var(--dark-text); font-size: 0.875rem;">
                                    Sécurisez votre compte en modifiant régulièrement votre mot de passe
                                </p>
                                <a href="{{ path('app_account_pwd_modify') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: var(--bordeaux); color: white; border-radius: var(--radius-sm); text-decoration: none; font-family: var(--font-body); font-size: 0.875rem; transition: all 0.3s ease;">
                                    Modifier le mot de passe
                                </a>
                            </div>


                            {# Moyens de paiement #}
                            <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--beige);">
                                <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.125rem; margin: 0 0 1rem; font-weight: 400; display: flex; align-items: center; gap: 0.5rem;">
                                    <span data-icon="credit-card" data-icon-width="20" data-icon-height="20"></span>
                                    Moyens de paiement
                                </h3>
                                <p style="margin: 0 0 1rem; color: var(--dark-text); font-size: 0.875rem;">
                                    Aucun moyen de paiement enregistré
                                </p>
                                <button style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 0.875rem; cursor: pointer; transition: all 0.3s ease;">
                                    <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
                                    Ajouter une carte bancaire
                                </button>
                            </div>

                            {# Zone de danger #}
                            <div>
                                <h3 style="font-family: var(--font-heading); color: #d4183d; font-size: 1.125rem; margin: 0 0 1rem; font-weight: 400;">
                                    Zone de danger
                                </h3>
                                <p style="margin: 0 0 1rem; color: var(--dark-text); font-size: 0.875rem;">
                                    La suppression de votre compte est irréversible. Toutes vos données seront définitivement supprimées.
                                </p>
                                <button style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border: 2px solid #d4183d; color: #d4183d; background: white; border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 0.875rem; cursor: pointer; transition: all 0.3s ease;">
                                    Supprimer mon compte
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script>
// Gestion des onglets
document.addEventListener('DOMContentLoaded', function() {
    // Sélectionner uniquement les boutons d'onglets (pas le lien Administration)
    const tabs = document.querySelectorAll('.account-tab[data-tab]');
    const contents = document.querySelectorAll('.tab-content');

    function activateTab(tabName) {
        // Retirer la classe active de tous les onglets
        tabs.forEach(t => {
            t.style.background = 'transparent';
            t.style.color = 'var(--dark-text)';
            t.classList.remove('active');
        });

        // Masquer tous les contenus
        contents.forEach(content => {
            content.style.display = 'none';
        });

        // Activer l'onglet demandé
        const targetTab = document.querySelector(`.account-tab[data-tab="${tabName}"]`);
        const targetContent = document.getElementById('tab-' + tabName);

        if (targetTab && targetContent) {
            targetTab.style.background = 'var(--bordeaux)';
            targetTab.style.color = 'white';
            targetTab.classList.add('active');
            targetContent.style.display = 'block';

            // Réinitialiser les icônes du contenu affiché
            if (window.ViteGourmand && window.ViteGourmand.initIcons) {
                window.ViteGourmand.initIcons();
            }
        }
    }

    // Gérer le clic sur les onglets
    tabs.forEach(tab => {
        tab.addEventListener('click', function() {
            const targetTab = this.getAttribute('data-tab');
            activateTab(targetTab);
            // Mettre à jour l'URL sans recharger la page
            window.location.hash = targetTab;
        });
    });

    // Activer l'onglet en fonction de l'ancre dans l'URL
    const hash = window.location.hash.substring(1); // Enlever le #
    if (hash && document.querySelector(`.account-tab[data-tab="${hash}"]`)) {
        activateTab(hash);
    }
});
</script>

<style>
/* ========================================
   ACCOUNT PAGE LAYOUT
   ======================================== */

/* Layout principal: Mobile = 1 colonne, Desktop = sidebar + content */
.account-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

/* Sidebar navigation */
.account-sidebar {
    width: 100%;
}

/* Grille des onglets: Mobile = 2 colonnes, Desktop = 1 colonne */
.account-tabs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
}

/* Boutons d'onglet */
.account-tab {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--dark-text);
    font-family: var(--font-body);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.account-tab[data-tab]:hover {
    background: rgba(139, 0, 0, 0.05);
}

.account-tab[data-tab].active {
    background: var(--bordeaux);
    color: white;
    box-shadow: var(--shadow-sm);
}

/* Bouton Administration (lien) - ne pas modifier le hover */
.account-tab:not([data-tab]):hover {
    opacity: 0.9;
}

/* Texte des onglets caché sur mobile */
.tab-text {
    display: none;
}

/* Statistiques cachées sur mobile */
.account-stats {
    display: none;
}

/* Contenu principal */
.account-content {
    width: 100%;
}

/* Contenus des onglets */
.tab-content {
    display: none;
}

.tab-content.active {
    display: block;
}

/* ========================================
   RESPONSIVE: Tablette (768px+)
   ======================================== */
@media (min-width: 768px) {
    /* Header user info horizontal */
    section > div > div:first-of-type > div:first-of-type {
        flex-direction: row !important;
        align-items: center !important;
    }

    section > div > div:first-of-type > div:first-of-type > a {
        width: auto !important;
    }

    section > div > div:first-of-type > div:first-of-type > div:first-of-type {
        width: 5rem !important;
        height: 5rem !important;
    }

    section > div > div:first-of-type > div:first-of-type > div > h1 {
        font-size: 2.25rem !important;
    }

    section > div > div:first-of-type > div:first-of-type > div > p {
        font-size: 1.125rem !important;
    }

    /* Better padding for tab contents */
