        align-items: center !important;
    }

    /* Texte visible sur tablette+ */
    .tab-text {
        display: inline;
    }

    /* Onglets en colonne sur desktop */
    .account-tabs-container {
        grid-template-columns: 1fr !important;
    }

    /* Tabs alignés à gauche */
    .account-tab,
