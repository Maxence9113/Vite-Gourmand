        justify-content: flex-start !important;
    }

    section > div > div:first-of-type > div:first-of-type > a {
        width: auto !important;
    }

    section > div > div:first-of-type > div:first-of-type > div:first-of-type {
        width: 5rem !important;
        height: 5rem !important;
    }

    section > div > div:first-of-type > div:first-of-type > div > h1 {
        font-size: 2.25rem !important;
    }

    section > div > div:first-of-type > div:first-of-type > div > p {
        font-size: 1.125rem !important;
    }

    /* Better padding for tab contents */
    #tab-orders > div,
    #tab-addresses > div,
    #tab-profile > div {
        padding: 1.5rem !important;
    }
}

/* ========================================
   RESPONSIVE: Desktop (1024px+)
   ======================================== */
@media (min-width: 1024px) {
    /* Layout en 2 colonnes: sidebar (280px fixe) + content (reste) */
    .account-layout {
        grid-template-columns: 280px 1fr !important;
        gap: 2rem !important;
    }

    /* Forcer la sidebar à rester en colonne */
    .account-sidebar {
        grid-column: 1;
    }

    /* Forcer le contenu à rester à droite */
    .account-content {
        grid-column: 2;
    }
}

/* ========================================
   RESPONSIVE: Mobile strict (< 768px)
   ======================================== */
@media (max-width: 767px) {
    #tab-orders > div,
    #tab-addresses > div,
    #tab-profile > div {
        padding: 1rem !important;
    }
}
</style>

