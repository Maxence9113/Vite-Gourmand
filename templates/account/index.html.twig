{% extends 'base.html.twig' %}

{% block title %}Mon Compte{% endblock %}

{% block body %}
{# ========================================
   PAGE ACCOUNT - Complètement refactorisée
   CSS externalisé dans assets/styles/pages/account.css
   ======================================== #}
<section class="account-page-section">
    <div class="account-page-container">

        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" class="breadcrumb">
            <ol class="breadcrumb-list">
                <li>
                    <a href="{{ path('app_home') }}" class="breadcrumb-link">
                        Accueil
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li class="breadcrumb-current">
                    Mon compte
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div class="account-page-title-block">
            <h1>Mon compte</h1>
            <div class="account-page-title-divider"></div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                <span data-icon="check-circle" data-icon-width="24" data-icon-height="24" class="flash-message-icon"></span>
                <div class="flash-message-content">
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                <span data-icon="alert-circle" data-icon-width="24" data-icon-height="24" class="flash-message-icon"></span>
                <div class="flash-message-content">
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {# Header utilisateur #}
        <div class="account-user-header">
            <div class="account-header-layout">
                <div class="account-user-info">
                    <div class="account-user-avatar">
                        <span data-icon="user" data-icon-width="28" data-icon-height="28"></span>
                    </div>
                    <div class="account-user-details">
                        <h2 class="account-user-name">
                            {{ app.user.firstname }} {{ app.user.lastname }}
                        </h2>
                        <p class="account-user-email">
                            {{ app.user.email }}
                        </p>
                    </div>
                </div>
                <a href="{{ path('app_logout') }}" class="account-btn-logout">
                    <span data-icon="log-out" data-icon-width="18" data-icon-height="18"></span>
                    Déconnexion
                </a>
            </div>
        </div>

        {# Layout 2 colonnes responsive #}
        <div class="account-layout">

            {# Sidebar Navigation #}
            <div class="account-sidebar">
                <div class="account-sidebar-card">
                    <div class="account-tabs-container">
                        {% if is_granted('ROLE_EMPLOYEE') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="account-tab-link">
                            <span data-icon="shield" data-icon-width="18" data-icon-height="18"></span>
                            <span class="tab-text">Administration</span>
                        </a>
                        {% endif %}

                        <button class="account-tab active" data-tab="orders">
                            <span data-icon="shopping-bag" data-icon-width="18" data-icon-height="18"></span>
                            <span class="tab-text">Mes commandes</span>
                        </button>

                        <button class="account-tab" data-tab="addresses">
                            <span data-icon="map-pin" data-icon-width="18" data-icon-height="18"></span>
                            <span class="tab-text">Mes adresses</span>
                        </button>

                        <button class="account-tab" data-tab="profile">
                            <span data-icon="user" data-icon-width="18" data-icon-height="18"></span>
                            <span class="tab-text">Mes informations</span>
                        </button>
                    </div>
                </div>
            </div>

            {# Contenu principal #}
            <div class="account-content">

                {# ========== Onglet Commandes ========== #}
                <div id="tab-orders" class="tab-content active">
                    <div class="tab-content-card">
                        <h2 class="tab-section-title">
                            Mes commandes récentes
                        </h2>
                        <div class="tab-section-divider"></div>

                        {% if recentOrders is empty %}
                            <div class="orders-empty-state">
                                <span data-icon="shopping-bag" data-icon-width="64" data-icon-height="64" class="orders-empty-icon"></span>
                                <h3 class="orders-empty-title">
                                    Aucune commande
                                </h3>
                                <p class="orders-empty-text">
                                    Vous n'avez pas encore passé de commande
                                </p>
                                <a href="{{ path('app_menu_catalog') }}" class="orders-btn-discover">
                                    <span data-icon="arrow-right" data-icon-width="20" data-icon-height="20"></span>
                                    Découvrir nos menus
                                </a>
                            </div>
                        {% else %}
                            <div class="orders-list">
                                {% for order in recentOrders %}
                                    <div class="order-card">
                                        <div class="order-card-layout">
                                            {# Colonne gauche - Informations principales #}
                                            <div class="order-card-info">
                                                <h3 class="order-card-title">
                                                    {{ order.menuName }}
                                                </h3>
                                                <p class="order-card-meta">
                                                    #{{ order.orderNumber }} · {{ order.createdAt|date('d/m/Y') }}
                                                </p>

                                                {# Détails compacts #}
                                                <div class="order-card-details">
                                                    <div class="order-card-detail-item">
                                                        <span data-icon="calendar" data-icon-width="14" data-icon-height="14" class="order-card-detail-icon"></span>
                                                        {{ order.deliveryDateTime|date('d/m/Y H:i') }}
                                                    </div>
                                                    <div class="order-card-detail-item">
                                                        <span data-icon="users" data-icon-width="14" data-icon-height="14" class="order-card-detail-icon"></span>
                                                        {{ order.numberOfPersons }} pers.
                                                    </div>
                                                </div>
                                            </div>

                                            {# Colonne droite - Status, Prix et Action #}
                                            <div class="order-card-actions">
                                                <span class="order-status-badge status-{{ order.status.badgeClass }}">
                                                    <span data-icon="{{ order.status.icon }}" data-icon-width="12" data-icon-height="12"></span>
                                                    {{ order.status.label }}
                                                </span>

                                                <p class="order-card-price">
                                                    {{ (order.totalPrice / 100)|number_format(2, ',', ' ') }}€
                                                </p>

                                                <a href="{{ path('app_order_show', {id: order.id}) }}" class="order-btn-details">
                                                    <span data-icon="eye" data-icon-width="14" data-icon-height="14"></span>
                                                    Détails
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            {% if totalOrders > recentOrders|length %}
                                <div class="orders-footer">
                                    <a href="{{ path('app_account_orders') }}" class="orders-btn-view-all">
                                        Voir toutes mes commandes ({{ totalOrders }})
                                        <span data-icon="arrow-right" data-icon-width="18" data-icon-height="18"></span>
                                    </a>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                {# ========== Onglet Adresses ========== #}
                <div id="tab-addresses" class="tab-content">
                    <div class="tab-content-card">
                        <div class="addresses-header">
                            <h2 class="tab-section-title-small">
                                Mes adresses de livraison
                            </h2>
                            <a href="{{ path('app_account_address_new') }}" class="addresses-btn-add">
                                <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
                                Ajouter une adresse
                            </a>
                        </div>

                        {% if app.user.addresses is empty %}
                            <div class="addresses-empty">
                                <span data-icon="map-pin" data-icon-width="48" data-icon-height="48" class="addresses-empty-icon"></span>
                                <h5 class="addresses-empty-title">Aucune adresse</h5>
                                <p class="addresses-empty-text">Vous n'avez pas encore enregistré d'adresse</p>
                            </div>
                        {% else %}
                            <div class="addresses-grid">
                                {% for address in app.user.addresses %}
                                    <div class="address-card {{ address.isDefault ? 'is-default' : '' }}">
                                        {% if address.isDefault %}
                                            <div class="address-default-badge">
                                                <span data-icon="check-circle" data-icon-width="10" data-icon-height="10"></span>
                                                Défaut
                                            </div>
                                        {% endif %}

                                        <h3 class="address-card-title {{ address.isDefault ? 'with-badge' : '' }}">
                                            {{ address.label }}
                                        </h3>

                                        <div class="address-card-body">
                                            <p>{{ address.street }}</p>
                                            <p>{{ address.postalCode }} {{ address.city }}</p>
                                            <p class="address-card-phone">
                                                <span data-icon="phone" data-icon-width="12" data-icon-height="12" class="address-card-phone-icon"></span>
                                                {{ address.phone }}
                                            </p>
                                        </div>

                                        <div class="address-card-actions">
                                            <a href="{{ path('app_account_address_edit', {id: address.id}) }}" class="address-btn-edit">
                                                <span data-icon="edit" data-icon-width="12" data-icon-height="12"></span>
                                                Modifier
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# ========== Onglet Profil ========== #}
                <div id="tab-profile" class="tab-content">
                    <div class="tab-content-card">
                        <div class="account-page-title-block">
                            <h2 class="tab-section-title">
                                Mes informations personnelles
                            </h2>
                            <div class="tab-section-divider"></div>
                        </div>

                        <div class="profile-sections">
                            {# Informations principales #}
                            <div class="profile-section-card primary">
                                <h3 class="profile-section-header">
                                    <span data-icon="user" data-icon-width="20" data-icon-height="20"></span>
                                    Informations de base
                                </h3>

                                <div class="profile-fields-grid">
                                    <div class="profile-field">
                                        <label class="profile-field-label">
                                            Prénom
                                        </label>
                                        <div class="profile-field-value">
                                            {{ app.user.firstname }}
                                        </div>
                                    </div>

                                    <div class="profile-field">
                                        <label class="profile-field-label">
                                            Nom
                                        </label>
                                        <div class="profile-field-value">
                                            {{ app.user.lastname }}
                                        </div>
                                    </div>
                                </div>

                                <div class="profile-field">
                                    <label class="profile-field-label">
                                        Adresse email
                                    </label>
                                    <div class="profile-field-value with-icon">
                                        <span data-icon="mail" data-icon-width="16" data-icon-height="16" class="profile-field-icon"></span>
                                        {{ app.user.email }}
                                    </div>
                                </div>

                                <a href="{{ path('app_account_edit') }}" class="profile-btn-edit">
                                    <span data-icon="edit" data-icon-width="18" data-icon-height="18"></span>
                                    Modifier mes informations
                                </a>
                            </div>

                            {# Sécurité #}
                            <div class="profile-section-card secondary">
                                <h3 class="profile-section-header">
                                    <span data-icon="lock" data-icon-width="20" data-icon-height="20"></span>
                                    Sécurité
                                </h3>

                                <div class="profile-security-info">
                                    <span data-icon="shield" data-icon-width="24" data-icon-height="24" class="profile-security-icon"></span>
                                    <div class="profile-security-content">
                                        <p class="profile-security-title">Mot de passe</p>
                                        <p class="profile-security-text">
                                            Modifiez régulièrement votre mot de passe pour protéger votre compte
                                        </p>
                                    </div>
                                </div>

                                <a href="{{ path('app_account_pwd_modify') }}" class="profile-btn-outline">
                                    <span data-icon="key" data-icon-width="18" data-icon-height="18"></span>
                                    Modifier le mot de passe
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script>
// Gestion des onglets
document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.account-tab[data-tab]');
    const contents = document.querySelectorAll('.tab-content');

    function activateTab(tabName) {
        // Retirer la classe active de tous les onglets
        tabs.forEach(t => {
            t.classList.remove('active');
        });

        // Masquer tous les contenus
        contents.forEach(content => {
            content.classList.remove('active');
        });

        // Activer l'onglet demandé
        const targetTab = document.querySelector(`.account-tab[data-tab="${tabName}"]`);
        const targetContent = document.getElementById('tab-' + tabName);

        if (targetTab && targetContent) {
            targetTab.classList.add('active');
            targetContent.classList.add('active');

            // Réinitialiser les icônes du contenu affiché
            if (window.ViteGourmand && window.ViteGourmand.initIcons) {
                window.ViteGourmand.initIcons();
            }
        }
    }

    // Gérer le clic sur les onglets
    tabs.forEach(tab => {
        tab.addEventListener('click', function() {
            const targetTab = this.getAttribute('data-tab');
            activateTab(targetTab);
            // Mettre à jour l'URL sans recharger la page
            window.location.hash = targetTab;
        });
    });

    // Activer l'onglet en fonction de l'ancre dans l'URL
    const hash = window.location.hash.substring(1);
    if (hash && document.querySelector(`.account-tab[data-tab="${hash}"]`)) {
        activateTab(hash);
    }
});
</script>

{% endblock %}
