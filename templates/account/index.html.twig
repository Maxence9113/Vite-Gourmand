{% extends 'base.html.twig' %}

{% block title %}Mon Compte{% endblock %}

{% block body %}
{# ========================================
   HEADER SECTION - Figma Design
   ======================================== #}
<section style="background-color: var(--beige); padding: 2rem 0 3rem;">
    <div style="max-width: 80rem; margin: 0 auto; padding: 0 1rem;">

        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" style="margin-bottom: 1.5rem;">
            <ol style="display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.875rem;">
                <li>
                    <a href="{{ path('app_home') }}" style="color: var(--dark-text); text-decoration: none; transition: color var(--transition-base);"
                       onmouseover="this.style.color='var(--bordeaux)'"
                       onmouseout="this.style.color='var(--dark-text)'">
                        Accueil
                    </a>
                </li>
                <li style="color: var(--dark-text); opacity: 0.5;">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li style="color: var(--bordeaux); font-weight: 600;">
                    Mon compte
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div style="margin-bottom: 2rem;">
            <h1 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 2.25rem; margin-bottom: 0.5rem; font-weight: 400;">
                Mon compte
            </h1>
            <div style="width: 5rem; height: 4px; background-color: var(--gold); border-radius: var(--radius-sm);"></div>
        </div>

        {# Header utilisateur #}
        <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.5rem; margin-bottom: 1.5rem;">
            <div class="account-header-layout" style="display: flex; flex-direction: column; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 1rem; flex: 1; min-width: 0;">
                    <div style="width: 4rem; height: 4rem; border-radius: 50%; background-color: var(--bordeaux); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <span data-icon="user" data-icon-width="28" data-icon-height="28" style="color: white;"></span>
                    </div>
                    <div style="min-width: 0; flex: 1;">
                        <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin: 0 0 0.25rem; font-weight: 400;">
                            {{ app.user.firstname }} {{ app.user.lastname }}
                        </h2>
                        <p style="color: var(--dark-text); font-size: 0.875rem; margin: 0;">
                            {{ app.user.email }}
                        </p>
                    </div>
                </div>
                <a href="{{ path('app_logout') }}" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: background-color var(--transition-base), color var(--transition-base); font-weight: 600;"
                   onmouseover="this.style.backgroundColor='var(--bordeaux)'; this.style.color='white'"
                   onmouseout="this.style.backgroundColor='white'; this.style.color='var(--bordeaux)'">
                    <span data-icon="log-out" data-icon-width="18" data-icon-height="18"></span>
                    Déconnexion
                </a>
            </div>
        </div>

        {# Layout 2 colonnes responsive #}
        <div class="account-layout" style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">

            {# Sidebar Navigation #}
            <div class="account-sidebar">
                <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 0.75rem;">
                    {# Grille 2 colonnes sur mobile, colonne unique sur desktop #}
                    <div class="account-tabs-container" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem;">
                        {% if is_granted('ROLE_EMPLOYEE') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="account-tab-link" style="padding: 0.875rem 1rem; border-radius: var(--radius-sm); background: var(--gold); color: var(--dark-text); text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 600; transition: opacity var(--transition-base);"
                           onmouseover="this.style.opacity='0.9'"
                           onmouseout="this.style.opacity='1'">
                            <span data-icon="shield" data-icon-width="18" data-icon-height="18"></span>
                            <span class="tab-text">Administration</span>
                        </a>
                        {% endif %}

                        <button class="account-tab active" data-tab="orders" style="padding: 0.875rem 1rem; border-radius: var(--radius-sm); border: none; background: var(--bordeaux); color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: background-color var(--transition-base); font-weight: 600;">
                            <span data-icon="shopping-bag" data-icon-width="18" data-icon-height="18"></span>
                            <span class="tab-text">Mes commandes</span>
                        </button>

                        <button class="account-tab" data-tab="addresses" style="padding: 0.875rem 1rem; border-radius: var(--radius-sm); border: none; background: transparent; color: var(--dark-text); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: background-color var(--transition-base); font-weight: 600;">
                            <span data-icon="map-pin" data-icon-width="18" data-icon-height="18"></span>
                            <span class="tab-text">Mes adresses</span>
                        </button>

                        <button class="account-tab" data-tab="profile" style="padding: 0.875rem 1rem; border-radius: var(--radius-sm); border: none; background: transparent; color: var(--dark-text); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: background-color var(--transition-base); font-weight: 600;">
                            <span data-icon="user" data-icon-width="18" data-icon-height="18"></span>
                            <span class="tab-text">Mes informations</span>
                        </button>
                    </div>
                </div>
            </div>

            {# ========== Contenu principal (droite sur desktop) ========== #}
            <div class="account-content">

                {# ========== Onglet Commandes ========== #}
                <div id="tab-orders" class="tab-content active">
                    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.5rem;">
                        <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.75rem; margin-bottom: 0.5rem; font-weight: 400;">
                            Mes commandes récentes
                        </h2>
                        <div style="width: 4rem; height: 3px; background-color: var(--gold); border-radius: var(--radius-sm); margin-bottom: 1.5rem;"></div>

                        {% if recentOrders is empty %}
                            <div style="text-align: center; padding: 3rem 1rem;">
                                <span data-icon="shopping-bag" data-icon-width="64" data-icon-height="64" style="display: block; margin: 0 auto 1.5rem; color: var(--gold);"></span>
                                <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin-bottom: 0.75rem; font-weight: 400;">
                                    Aucune commande
                                </h3>
                                <p style="color: var(--dark-text); opacity: 0.8; margin-bottom: 2rem;">
                                    Vous n'avez pas encore passé de commande
                                </p>
                                <a href="{{ path('app_menu_catalog') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 2rem; background: var(--bordeaux); color: white; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; transition: background-color var(--transition-base);"
                                   onmouseover="this.style.backgroundColor='#8B0000'"
                                   onmouseout="this.style.backgroundColor='var(--bordeaux)'">
                                    <span data-icon="arrow-right" data-icon-width="20" data-icon-height="20"></span>
                                    Découvrir nos menus
                                </a>
                            </div>
                        {% else %}
                            <div style="display: flex; flex-direction: column; gap: 1rem;">
                                {% for order in recentOrders %}
                                    <div style="border: 1px solid var(--beige); border-radius: var(--radius-lg); padding: 1rem; transition: transform var(--transition-base), box-shadow var(--transition-base);"
                                         onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='var(--shadow-lg)'"
                                         onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">

                                        {# Layout 2 colonnes : Info à gauche, Recap à droite #}
                                        <div style="display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; align-items: start;">

                                            {# Colonne gauche - Informations principales #}
                                            <div style="min-width: 0;">
                                                <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.125rem; margin: 0 0 0.375rem; font-weight: 400;">
                                                    {{ order.menuName }}
                                                </h3>
                                                <p style="font-size: 0.8125rem; color: var(--dark-text); opacity: 0.7; margin: 0 0 0.75rem;">
                                                    #{{ order.orderNumber }} · {{ order.createdAt|date('d/m/Y') }}
                                                </p>

                                                {# Détails compacts #}
                                                <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.8125rem;">
                                                    <div style="display: flex; align-items: center; gap: 0.375rem; color: var(--dark-text);">
                                                        <span data-icon="calendar" data-icon-width="14" data-icon-height="14" style="color: var(--gold);"></span>
                                                        {{ order.deliveryDateTime|date('d/m/Y H:i') }}
                                                    </div>
                                                    <div style="display: flex; align-items: center; gap: 0.375rem; color: var(--dark-text);">
                                                        <span data-icon="users" data-icon-width="14" data-icon-height="14" style="color: var(--gold);"></span>
                                                        {{ order.numberOfPersons }} pers.
                                                    </div>
                                                </div>
                                            </div>

                                            {# Colonne droite - Status, Prix et Action #}
                                            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; min-width: 180px;">
                                                <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.25rem 0.625rem; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.75rem; background: #{{ order.status.badgeClass == 'success' ? 'd4edda' : (order.status.badgeClass == 'warning' ? 'fff3cd' : (order.status.badgeClass == 'danger' ? 'f8d7da' : 'e7f1ff')) }}; color: #{{ order.status.badgeClass == 'success' ? '155724' : (order.status.badgeClass == 'warning' ? '856404' : (order.status.badgeClass == 'danger' ? '721c24' : '004085')) }};">
                                                    <span data-icon="{{ order.status.icon }}" data-icon-width="12" data-icon-height="12"></span>
                                                    {{ order.status.label }}
                                                </span>

                                                <p style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.375rem; margin: 0; font-weight: 400;">
                                                    {{ (order.totalPrice / 100)|number_format(2, ',', ' ') }}€
                                                </p>

                                                <a href="{{ path('app_order_show', {id: order.id}) }}" style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; border-radius: var(--radius-sm); background: var(--bordeaux); color: white; text-decoration: none; font-weight: 600; font-size: 0.8125rem; transition: background-color var(--transition-base); margin-top: 0.25rem;"
                                                   onmouseover="this.style.backgroundColor='#8B0000'"
                                                   onmouseout="this.style.backgroundColor='var(--bordeaux)'">
                                                    <span data-icon="eye" data-icon-width="14" data-icon-height="14"></span>
                                                    Détails
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            {% if totalOrders > recentOrders|length %}
                                <div style="margin-top: 1.5rem; text-align: center; padding-top: 1.5rem; border-top: 1px solid var(--beige);">
                                    <a href="{{ path('app_account_orders') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 2rem; border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; transition: background-color var(--transition-base), color var(--transition-base);"
                                       onmouseover="this.style.backgroundColor='var(--bordeaux)'; this.style.color='white'"
                                       onmouseout="this.style.backgroundColor='white'; this.style.color='var(--bordeaux)'">
                                        Voir toutes mes commandes ({{ totalOrders }})
                                        <span data-icon="arrow-right" data-icon-width="18" data-icon-height="18"></span>
                                    </a>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                {# ========== Onglet Adresses ========== #}
                <div id="tab-addresses" class="tab-content" style="display: none;">
                    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
                            <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin: 0; font-weight: 400;">
                                Mes adresses de livraison
                            </h2>
                            <a href="{{ path('app_account_address_new') }}" style="padding: 0.5rem 1rem; border-radius: var(--radius-sm); background: var(--bordeaux); color: white; text-decoration: none; font-family: var(--font-body); display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem;">
                                <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
                                Ajouter une adresse
                            </a>
                        </div>

                        {% if app.user.addresses is empty %}
                            <div style="text-align: center; padding: 3rem 1rem;">
                                <span data-icon="map-pin" data-icon-width="48" data-icon-height="48" style="display: block; margin: 0 auto 1rem; color: var(--gold); opacity: 0.3;"></span>
                                <h5 style="margin-bottom: 0.5rem; font-family: var(--font-heading); color: var(--bordeaux);">Aucune adresse</h5>
                                <p style="margin: 0; color: var(--dark-text);">Vous n'avez pas encore enregistré d'adresse</p>
                            </div>
                        {% else %}
                            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;">
                                {% for address in app.user.addresses %}
                                    <div style="border: {{ address.isDefault ? '2px solid var(--gold)' : '1px solid var(--beige)' }}; border-radius: var(--radius-lg); padding: 1rem; position: relative; display: flex; flex-direction: column;">
                                        {% if address.isDefault %}
                                            <div style="position: absolute; top: 0.75rem; right: 0.75rem; padding: 0.25rem 0.5rem; border-radius: var(--radius-full); font-size: 0.625rem; color: white; background: var(--gold); display: flex; align-items: center; gap: 0.25rem;">
                                                <span data-icon="check-circle" data-icon-width="10" data-icon-height="10"></span>
                                                Défaut
                                            </div>
                                        {% endif %}

                                        <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1rem; margin: 0 0 0.625rem; font-weight: 400; padding-right: {{ address.isDefault ? '4rem' : '0' }};">
                                            {{ address.label }}
                                        </h3>

                                        <div style="margin-bottom: 0.875rem; color: var(--dark-text); font-size: 0.8125rem; flex: 1;">
                                            <p style="margin: 0 0 0.25rem;">{{ address.street }}</p>
                                            <p style="margin: 0 0 0.5rem;">{{ address.postalCode }} {{ address.city }}</p>
                                            <p style="margin: 0; display: flex; align-items: center; gap: 0.375rem; font-size: 0.75rem;">
                                                <span data-icon="phone" data-icon-width="12" data-icon-height="12" style="color: var(--gold);"></span>
                                                {{ address.phone }}
                                            </p>
                                        </div>

                                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                            <a href="{{ path('app_account_address_edit', {id: address.id}) }}" style="padding: 0.5rem 0.875rem; border-radius: var(--radius-sm); border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; text-decoration: none; font-family: var(--font-body); display: flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; transition: background-color var(--transition-base), color var(--transition-base);"
                                               onmouseover="this.style.backgroundColor='var(--bordeaux)'; this.style.color='white'"
                                               onmouseout="this.style.backgroundColor='white'; this.style.color='var(--bordeaux)'">
                                                <span data-icon="edit" data-icon-width="12" data-icon-height="12"></span>
                                                Modifier
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# ========== Onglet Profil ========== #}
                <div id="tab-profile" class="tab-content" style="display: none;">
                    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.5rem;">
                        <div style="margin-bottom: 2rem;">
                            <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.75rem; margin-bottom: 0.5rem; font-weight: 400;">
                                Mes informations personnelles
                            </h2>
                            <div style="width: 4rem; height: 3px; background-color: var(--gold); border-radius: var(--radius-sm);"></div>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 2rem;">
                            {# Informations principales #}
                            <div style="padding: 1.5rem; background: var(--beige); border-radius: var(--radius-lg); border-left: 4px solid var(--gold);">
                                <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.25rem; margin-bottom: 1.5rem; font-weight: 400; display: flex; align-items: center; gap: 0.5rem;">
                                    <span data-icon="user" data-icon-width="20" data-icon-height="20"></span>
                                    Informations de base
                                </h3>

                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
                                    <div>
                                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                                            Prénom
                                        </label>
                                        <div style="padding: 0.75rem 1rem; border-radius: var(--radius-sm); background: white; border: 1px solid rgba(139, 0, 0, 0.2); color: var(--dark-text); font-family: var(--font-body);">
                                            {{ app.user.firstname }}
                                        </div>
                                    </div>

                                    <div>
                                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                                            Nom
                                        </label>
                                        <div style="padding: 0.75rem 1rem; border-radius: var(--radius-sm); background: white; border: 1px solid rgba(139, 0, 0, 0.2); color: var(--dark-text); font-family: var(--font-body);">
                                            {{ app.user.lastname }}
                                        </div>
                                    </div>
                                </div>

                                <div style="margin-bottom: 1.5rem;">
                                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                                        Adresse email
                                    </label>
                                    <div style="padding: 0.75rem 1rem; border-radius: var(--radius-sm); background: white; border: 1px solid rgba(139, 0, 0, 0.2); color: var(--dark-text); font-family: var(--font-body); display: flex; align-items: center; gap: 0.5rem;">
                                        <span data-icon="mail" data-icon-width="16" data-icon-height="16" style="color: var(--gold);"></span>
                                        {{ app.user.email }}
                                    </div>
                                </div>

                                <a href="{{ path('app_account_edit') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: var(--bordeaux); color: white; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; transition: background-color var(--transition-base);"
                                   onmouseover="this.style.backgroundColor='#8B0000'"
                                   onmouseout="this.style.backgroundColor='var(--bordeaux)'">
                                    <span data-icon="edit" data-icon-width="18" data-icon-height="18"></span>
                                    Modifier mes informations
                                </a>
                            </div>

                            {# Sécurité #}
                            <div style="padding: 1.5rem; background: white; border-radius: var(--radius-lg); border: 1px solid var(--beige);">
                                <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.25rem; margin-bottom: 1.5rem; font-weight: 400; display: flex; align-items: center; gap: 0.5rem;">
                                    <span data-icon="lock" data-icon-width="20" data-icon-height="20"></span>
                                    Sécurité
                                </h3>

                                <div style="display: flex; align-items: start; gap: 1rem; margin-bottom: 1.5rem; padding: 1rem; background: var(--beige); border-radius: var(--radius-sm);">
                                    <span data-icon="shield" data-icon-width="24" data-icon-height="24" style="color: var(--gold); flex-shrink: 0;"></span>
                                    <div style="flex: 1;">
                                        <p style="font-weight: 600; color: var(--dark-text); margin: 0 0 0.5rem;">Mot de passe</p>
                                        <p style="font-size: 0.875rem; color: var(--dark-text); margin: 0;">
                                            Modifiez régulièrement votre mot de passe pour protéger votre compte
                                        </p>
                                    </div>
                                </div>

                                <a href="{{ path('app_account_pwd_modify') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; transition: background-color var(--transition-base), color var(--transition-base);"
                                   onmouseover="this.style.backgroundColor='var(--bordeaux)'; this.style.color='white'"
                                   onmouseout="this.style.backgroundColor='white'; this.style.color='var(--bordeaux)'">
                                    <span data-icon="key" data-icon-width="18" data-icon-height="18"></span>
                                    Modifier le mot de passe
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script>
// Gestion des onglets
document.addEventListener('DOMContentLoaded', function() {
    // Sélectionner uniquement les boutons d'onglets (pas le lien Administration)
    const tabs = document.querySelectorAll('.account-tab[data-tab]');
    const contents = document.querySelectorAll('.tab-content');

    function activateTab(tabName) {
        // Retirer la classe active de tous les onglets
        tabs.forEach(t => {
            t.style.background = 'transparent';
            t.style.color = 'var(--dark-text)';
            t.classList.remove('active');
        });

        // Masquer tous les contenus
        contents.forEach(content => {
            content.style.display = 'none';
        });

        // Activer l'onglet demandé
        const targetTab = document.querySelector(`.account-tab[data-tab="${tabName}"]`);
        const targetContent = document.getElementById('tab-' + tabName);

        if (targetTab && targetContent) {
            targetTab.style.background = 'var(--bordeaux)';
            targetTab.style.color = 'white';
            targetTab.classList.add('active');
            targetContent.style.display = 'block';

            // Réinitialiser les icônes du contenu affiché
            if (window.ViteGourmand && window.ViteGourmand.initIcons) {
                window.ViteGourmand.initIcons();
            }
        }
    }

    // Gérer le clic sur les onglets
    tabs.forEach(tab => {
        tab.addEventListener('click', function() {
            const targetTab = this.getAttribute('data-tab');
            activateTab(targetTab);
            // Mettre à jour l'URL sans recharger la page
            window.location.hash = targetTab;
        });
    });

    // Activer l'onglet en fonction de l'ancre dans l'URL
    const hash = window.location.hash.substring(1); // Enlever le #
    if (hash && document.querySelector(`.account-tab[data-tab="${hash}"]`)) {
        activateTab(hash);
    }
});
</script>

<style>
/* ========================================
   ACCOUNT PAGE LAYOUT
   ======================================== */

/* Layout principal: Mobile = 1 colonne, Desktop = sidebar + content */
.account-layout {
