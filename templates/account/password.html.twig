{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe - Vite & Gourmand{% endblock %}

{% block body %}

<div style="padding: 3rem 0;">
    <div style="display: flex; justify-content: center;">
        <div style="max-width: 800px; width: 100%;">

            {# Breadcrumb #}
            <nav aria-label="breadcrumb" style="margin-bottom: 2rem;">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_account') }}" style="color: var(--primary);">
                            <i data-feather="user" width="16" style="margin-right: 0.25rem;"></i>
                            Mon compte
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier mon mot de passe</li>
                </ol>
            </nav>

            {# Card principale #}
            <div class="account-card">
                <div class="card-header-custom">
                    <div style="display: flex; align-items: center;">
                        <div style="margin-right: 1rem;">
                            <i data-feather="lock" width="24"></i>
                        </div>
                        <div>
                            <h4 style="margin: 0;">Modifier mon mot de passe</h4>
                            <small style="color: #6c757d;">Sécurisez votre compte avec un mot de passe fort</small>
                        </div>
                    </div>
                </div>
                <div style="padding: 1.5rem;">

                    {# Alert info #}
                    <div class="alert alert-info" role="alert" style="display: flex; align-items: flex-start; margin-bottom: 1.5rem;">
                        <i data-feather="info" width="20" style="margin-right: 0.5rem; margin-top: 0.25rem;"></i>
                        <div>
                            <strong>Exigences du mot de passe :</strong><br>
                            <small>
                                Minimum 10 caractères avec au moins 1 majuscule, 1 minuscule, 1 chiffre et 1 caractère spécial.
                            </small>
                        </div>
                    </div>

                    {# Formulaire #}
                    {{ form_start(modifyPwd, {'attr': {'class': 'password-form'}}) }}

                        {# Ancien mot de passe #}
                        <div class="form-group">
                            {{ form_widget(modifyPwd.actualPassword, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Ancien mot de passe'
                                }
                            }) }}
                            <label for="{{ modifyPwd.actualPassword.vars.id }}" class="form-label">
                                <i data-feather="lock" width="16" style="margin-right: 0.25rem;"></i>
                                Mot de passe actuel
                            </label>
                            {{ form_errors(modifyPwd.actualPassword) }}
                        </div>

                        {# Nouveau mot de passe #}
                        <div class="form-group">
                            {{ form_widget(modifyPwd.plainPassword.first, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Nouveau mot de passe'
                                }
                            }) }}
                            <label for="{{ modifyPwd.plainPassword.first.vars.id }}" class="form-label">
                                <i data-feather="key" width="16" style="margin-right: 0.25rem;"></i>
                                Nouveau mot de passe
                            </label>
                            {{ form_errors(modifyPwd.plainPassword.first) }}
                        </div>

                        {# Confirmation nouveau mot de passe #}
                        <div class="form-group">
                            {{ form_widget(modifyPwd.plainPassword.second, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Confirmer le nouveau mot de passe'
                                }
                            }) }}
                            <label for="{{ modifyPwd.plainPassword.second.vars.id }}" class="form-label">
                                <i data-feather="check-circle" width="16" style="margin-right: 0.25rem;"></i>
                                Confirmer le nouveau mot de passe
                            </label>
                            {{ form_errors(modifyPwd.plainPassword.second) }}
                        </div>

                        {# Boutons #}
                        <div style="display: flex; gap: 1rem;">
                            <button type="submit" style="padding: 12px 24px;">
                                <i data-feather="save" width="18" style="margin-right: 0.5rem;"></i>
                                Enregistrer le nouveau mot de passe
                            </button>
                            <a href="{{ path('app_account') }}" style="padding: 12px 24px;">
                                <i data-feather="x" width="18" style="margin-right: 0.5rem;"></i>
                                Annuler
                            </a>
                        </div>

                    {{ form_end(modifyPwd) }}

                </div>
            </div>

            {# Conseils de sécurité #}
            <div style="margin-top: 1.5rem;">
                <div class="card-header-custom">
                    <h5 style="margin: 0;">
                        <i data-feather="shield" width="20" style="margin-right: 0.5rem;"></i>
                        Conseils de sécurité
                    </h5>
                </div>
                <div style="padding: 1.5rem;">
                    <ul style="list-style: none; padding: 0; margin: 0;">
                        <li style="margin-bottom: 0.5rem;">
                            <i data-feather="check" width="18" style="margin-right: 0.5rem; color: var(--success);"></i>
                            Utilisez un mot de passe unique pour ce compte
                        </li>
                        <li style="margin-bottom: 0.5rem;">
                            <i data-feather="check" width="18" style="margin-right: 0.5rem; color: var(--success);"></i>
                            Évitez les mots de passe faciles à deviner (date de naissance, nom...)
                        </li>
                        <li style="margin-bottom: 0.5rem;">
                            <i data-feather="check" width="18" style="margin-right: 0.5rem; color: var(--success);"></i>
                            Changez régulièrement votre mot de passe
                        </li>
                        <li style="margin: 0;">
                            <i data-feather="check" width="18" style="margin-right: 0.5rem; color: var(--success);"></i>
                            Ne partagez jamais votre mot de passe
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

{% endblock %}
