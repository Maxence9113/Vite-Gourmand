{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe{% endblock %}

{% block body %}
{# ========================================
   HEADER SECTION - Figma Design
   ======================================== #}
<section style="background-color: var(--beige); padding: 2rem 0 3rem;">
    <div style="max-width: 80rem; margin: 0 auto; padding: 0 1rem;">

        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" style="margin-bottom: 1.5rem;">
            <ol style="display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.875rem;">
                <li>
                    <a href="{{ path('app_home') }}" style="color: var(--dark-text); text-decoration: none; transition: color var(--transition-base);"
                       onmouseover="this.style.color='var(--bordeaux)'"
                       onmouseout="this.style.color='var(--dark-text)'">
                        Accueil
                    </a>
                </li>
                <li style="color: var(--dark-text); opacity: 0.5;">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li>
                    <a href="{{ path('app_account') }}" style="color: var(--dark-text); text-decoration: none; transition: color var(--transition-base);"
                       onmouseover="this.style.color='var(--bordeaux)'"
                       onmouseout="this.style.color='var(--dark-text)'">
                        Mon compte
                    </a>
                </li>
                <li style="color: var(--dark-text); opacity: 0.5;">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li style="color: var(--bordeaux); font-weight: 600;">
                    Modifier mon mot de passe
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div style="margin-bottom: 2rem;">
            <h1 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 2.25rem; margin-bottom: 0.5rem; font-weight: 400;">
                Modifier mon mot de passe
            </h1>
            <div style="width: 5rem; height: 4px; background-color: var(--gold); border-radius: var(--radius-sm);"></div>
        </div>

        {# Layout 2 colonnes responsive #}
        <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
            <style>
                @media (min-width: 1024px) {
                    .password-layout {
                        grid-template-columns: 2fr 1fr;
                    }
                }
            </style>
        </div>
        <div class="password-layout" style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">

            {# ========== COLONNE GAUCHE - Formulaire ========== #}
            <div>
                <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 2rem;">
                    <div style="margin-bottom: 2rem;">
                        <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin-bottom: 0.75rem; font-weight: 400; display: flex; align-items: center; gap: 0.5rem;">
                            <span data-icon="lock" data-icon-width="24" data-icon-height="24"></span>
                            Changer votre mot de passe
                        </h2>
                        <p style="color: var(--dark-text); opacity: 0.8; margin: 0;">
                            Sécurisez votre compte avec un mot de passe fort
                        </p>
                    </div>

                    {# Alert info #}
                    <div style="background: #e7f1ff; border-left: 4px solid #004085; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; align-items: flex-start; gap: 0.75rem;">
                        <span data-icon="info" data-icon-width="20" data-icon-height="20" style="color: #004085; flex-shrink: 0; margin-top: 2px;"></span>
                        <div style="color: #004085;">
                            <p style="font-weight: 600; margin: 0 0 0.5rem;">Exigences du mot de passe</p>
                            <p style="font-size: 0.875rem; margin: 0;">
                                Minimum 10 caractères avec au moins 1 majuscule, 1 minuscule, 1 chiffre et 1 caractère spécial.
                            </p>
                        </div>
                    </div>

                    {# Formulaire #}
                    {{ form_start(modifyPwd) }}

                        {# Ancien mot de passe #}
                        <div style="margin-bottom: 1.5rem;">
                            {{ form_label(modifyPwd.actualPassword, 'Mot de passe actuel', {
                                'label_attr': {
                                    'style': 'display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;'
                                }
                            }) }}
                            {{ form_widget(modifyPwd.actualPassword, {
                                'attr': {
                                    'style': 'width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 1rem;',
                                    'placeholder': 'Votre mot de passe actuel',
                                    'onfocus': "this.style.borderColor='var(--gold)'; this.style.boxShadow='0 0 0 3px rgba(212, 175, 55, 0.1)'",
                                    'onblur': "this.style.borderColor='var(--bordeaux)'; this.style.boxShadow='none'"
                                }
                            }) }}
                            {{ form_errors(modifyPwd.actualPassword) }}
                        </div>

                        {# Nouveau mot de passe #}
                        <div style="margin-bottom: 1.5rem;">
                            {{ form_label(modifyPwd.plainPassword.first, 'Nouveau mot de passe', {
                                'label_attr': {
                                    'style': 'display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;'
                                }
                            }) }}
                            {{ form_widget(modifyPwd.plainPassword.first, {
                                'attr': {
                                    'style': 'width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 1rem;',
                                    'placeholder': 'Votre nouveau mot de passe',
                                    'onfocus': "this.style.borderColor='var(--gold)'; this.style.boxShadow='0 0 0 3px rgba(212, 175, 55, 0.1)'",
                                    'onblur': "this.style.borderColor='var(--bordeaux)'; this.style.boxShadow='none'"
                                }
                            }) }}
                            {{ form_errors(modifyPwd.plainPassword.first) }}
                        </div>

                        {# Confirmation nouveau mot de passe #}
                        <div style="margin-bottom: 2rem;">
                            {{ form_label(modifyPwd.plainPassword.second, 'Confirmer le nouveau mot de passe', {
                                'label_attr': {
                                    'style': 'display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;'
                                }
                            }) }}
                            {{ form_widget(modifyPwd.plainPassword.second, {
                                'attr': {
                                    'style': 'width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 1rem;',
                                    'placeholder': 'Confirmez votre nouveau mot de passe',
                                    'onfocus': "this.style.borderColor='var(--gold)'; this.style.boxShadow='0 0 0 3px rgba(212, 175, 55, 0.1)'",
                                    'onblur': "this.style.borderColor='var(--bordeaux)'; this.style.boxShadow='none'"
                                }
                            }) }}
                            {{ form_errors(modifyPwd.plainPassword.second) }}
                        </div>

                        {# Boutons #}
                        <div style="display: flex; justify-content: flex-end; gap: 1rem; flex-wrap: wrap; padding-top: 1.5rem; border-top: 1px solid var(--beige);">
                            <a href="{{ path('app_account') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border: 2px solid var(--dark-text); color: var(--dark-text); background: white; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; transition: background-color var(--transition-base), color var(--transition-base);"
                               onmouseover="this.style.backgroundColor='#f5f5f5'"
                               onmouseout="this.style.backgroundColor='white'">
                                <span data-icon="arrow-left" data-icon-width="18" data-icon-height="18"></span>
                                Retour
                            </a>
                            <button type="submit" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 2rem; background: var(--bordeaux); color: white; border: none; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; transition: background-color var(--transition-base); box-shadow: var(--shadow-md);"
                                    onmouseover="this.style.backgroundColor='#8B0000'"
                                    onmouseout="this.style.backgroundColor='var(--bordeaux)'">
                                <span data-icon="check" data-icon-width="18" data-icon-height="18"></span>
                                Modifier mon mot de passe
                            </button>
                        </div>

                    {{ form_end(modifyPwd, {'render_rest': false}) }}
                </div>
            </div>

            {# ========== COLONNE DROITE - Conseils de sécurité ========== #}
            <div>
                <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 1.5rem;">
                    <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.25rem; margin-bottom: 1.5rem; font-weight: 400; display: flex; align-items: center; gap: 0.5rem;">
                        <span data-icon="shield" data-icon-width="20" data-icon-height="20"></span>
                        Conseils de sécurité
                    </h3>

                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem;">
                        <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18" style="color: var(--green); flex-shrink: 0; margin-top: 2px;"></span>
                            <span style="color: var(--dark-text);">Utilisez un mot de passe unique pour ce compte</span>
                        </li>
                        <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18" style="color: var(--green); flex-shrink: 0; margin-top: 2px;"></span>
                            <span style="color: var(--dark-text);">Évitez les mots de passe faciles à deviner (date de naissance, nom...)</span>
                        </li>
                        <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18" style="color: var(--green); flex-shrink: 0; margin-top: 2px;"></span>
                            <span style="color: var(--dark-text);">Changez régulièrement votre mot de passe</span>
                        </li>
                        <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18" style="color: var(--green); flex-shrink: 0; margin-top: 2px;"></span>
                            <span style="color: var(--dark-text);">Ne partagez jamais votre mot de passe</span>
                        </li>
                    </ul>
                </div>

                {# Encart aide supplémentaire #}
                <div style="background: var(--beige); border: 2px solid var(--gold); border-radius: var(--radius-lg); padding: 1.5rem; margin-top: 1.5rem; text-align: center;">
                    <span data-icon="help-circle" data-icon-width="48" data-icon-height="48" style="display: block; margin: 0 auto 1rem; color: var(--gold);"></span>
                    <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.75rem; font-weight: 400; color: var(--bordeaux);">
                        Besoin d'aide ?
                    </h3>
                    <p style="font-size: 0.875rem; margin: 0 0 1rem; color: var(--dark-text);">
                        Contactez-nous si vous rencontrez des difficultés
                    </p>
                    <a href="{{ path('app_contact') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: var(--bordeaux); color: white; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; transition: background-color var(--transition-base), transform var(--transition-base);"
                       onmouseover="this.style.backgroundColor='#8B0000'; this.style.transform='translateY(-2px)'"
                       onmouseout="this.style.backgroundColor='var(--bordeaux)'; this.style.transform='translateY(0)'">
                        <span data-icon="mail" data-icon-width="18" data-icon-height="18"></span>
                        Nous contacter
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
