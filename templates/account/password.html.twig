{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe{% endblock %}

{% block body %}
{# ========================================
   PAGE ACCOUNT PASSWORD - Complètement refactorisée
   CSS externalisé dans assets/styles/pages/account-password.css
   ======================================== #}
<section class="account-password-section">
    <div class="account-password-container">

        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" class="breadcrumb">
            <ol class="breadcrumb-list">
                <li>
                    <a href="{{ path('app_home') }}" class="breadcrumb-link">
                        Accueil
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li>
                    <a href="{{ path('app_account') }}" class="breadcrumb-link">
                        Mon compte
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li class="breadcrumb-current">
                    Modifier mon mot de passe
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div class="account-password-header">
            <h1 class="account-password-title">
                Modifier mon mot de passe
            </h1>
            <div class="account-password-title-divider"></div>
        </div>

        {# Layout 2 colonnes responsive #}
        <div class="account-password-layout">

            {# ========== COLONNE GAUCHE - Formulaire ========== #}
            <div>
                <div class="account-password-form-card">
                    <div class="account-password-form-header">
                        <h2 class="account-password-form-title">
                            <span data-icon="lock" data-icon-width="24" data-icon-height="24"></span>
                            Changer votre mot de passe
                        </h2>
                        <p class="account-password-form-subtitle">
                            Sécurisez votre compte avec un mot de passe fort
                        </p>
                    </div>

                    {# Alert info #}
                    <div class="account-password-alert-info">
                        <span data-icon="info" data-icon-width="20" data-icon-height="20" class="account-password-alert-icon"></span>
                        <div class="account-password-alert-content">
                            <p class="account-password-alert-title">Exigences du mot de passe</p>
                            <p class="account-password-alert-text">
                                Minimum 10 caractères avec au moins 1 majuscule, 1 minuscule, 1 chiffre et 1 caractère spécial.
                            </p>
                        </div>
                    </div>

                    {# Formulaire #}
                    {{ form_start(modifyPwd) }}

                        {# Ancien mot de passe #}
                        <div class="account-password-form-group">
                            {{ form_label(modifyPwd.actualPassword, 'Mot de passe actuel', {
                                'label_attr': {
                                    'class': 'account-password-label'
                                }
                            }) }}
                            {{ form_widget(modifyPwd.actualPassword, {
                                'attr': {
                                    'class': 'account-password-input',
                                    'placeholder': 'Votre mot de passe actuel'
                                }
                            }) }}
                            {{ form_errors(modifyPwd.actualPassword) }}
                        </div>

                        {# Nouveau mot de passe #}
                        <div class="account-password-form-group">
                            {{ form_label(modifyPwd.plainPassword.first, 'Nouveau mot de passe', {
                                'label_attr': {
                                    'class': 'account-password-label'
                                }
                            }) }}
                            {{ form_widget(modifyPwd.plainPassword.first, {
                                'attr': {
                                    'class': 'account-password-input',
                                    'placeholder': 'Votre nouveau mot de passe'
                                }
                            }) }}
                            {{ form_errors(modifyPwd.plainPassword.first) }}
                        </div>

                        {# Confirmation nouveau mot de passe #}
                        <div class="account-password-form-group last">
                            {{ form_label(modifyPwd.plainPassword.second, 'Confirmer le nouveau mot de passe', {
                                'label_attr': {
                                    'class': 'account-password-label'
                                }
                            }) }}
                            {{ form_widget(modifyPwd.plainPassword.second, {
                                'attr': {
                                    'class': 'account-password-input',
                                    'placeholder': 'Confirmez votre nouveau mot de passe'
                                }
                            }) }}
                            {{ form_errors(modifyPwd.plainPassword.second) }}
                        </div>

                        {# Boutons #}
                        <div class="account-password-actions">
                            <a href="{{ path('app_account') }}" class="account-password-btn-back">
                                <span data-icon="arrow-left" data-icon-width="18" data-icon-height="18"></span>
                                Retour
                            </a>
                            <button type="submit" class="account-password-btn-submit">
                                <span data-icon="check" data-icon-width="18" data-icon-height="18"></span>
                                Modifier mon mot de passe
                            </button>
                        </div>

                    {{ form_rest(modifyPwd) }}
                    {{ form_end(modifyPwd) }}
                </div>
            </div>

            {# ========== COLONNE DROITE - Conseils de sécurité ========== #}
            <div>
                <div class="account-password-security-card">
                    <h3 class="account-password-security-title">
                        <span data-icon="shield" data-icon-width="20" data-icon-height="20"></span>
                        Conseils de sécurité
                    </h3>

                    <ul class="account-password-security-list">
                        <li class="account-password-security-item">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18" class="account-password-security-icon"></span>
                            <span class="account-password-security-text">Utilisez un mot de passe unique pour ce compte</span>
                        </li>
                        <li class="account-password-security-item">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18" class="account-password-security-icon"></span>
                            <span class="account-password-security-text">Évitez les mots de passe faciles à deviner (date de naissance, nom...)</span>
                        </li>
                        <li class="account-password-security-item">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18" class="account-password-security-icon"></span>
                            <span class="account-password-security-text">Changez régulièrement votre mot de passe</span>
                        </li>
                        <li class="account-password-security-item">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18" class="account-password-security-icon"></span>
                            <span class="account-password-security-text">Ne partagez jamais votre mot de passe</span>
                        </li>
                    </ul>
                </div>

                {# Encart aide supplémentaire #}
                <div class="account-password-help-card">
                    <span data-icon="help-circle" data-icon-width="48" data-icon-height="48" class="account-password-help-icon"></span>
                    <h3 class="account-password-help-title">
                        Besoin d'aide ?
                    </h3>
                    <p class="account-password-help-text">
                        Contactez-nous si vous rencontrez des difficultés
                    </p>
                    <a href="{{ path('app_contact') }}" class="account-password-help-btn">
                        <span data-icon="mail" data-icon-width="18" data-icon-height="18"></span>
                        Nous contacter
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
