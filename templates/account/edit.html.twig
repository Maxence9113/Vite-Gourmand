{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
{# ========================================
   PAGE ACCOUNT EDIT - Complètement refactorisée
   CSS externalisé dans assets/styles/pages/account-edit.css
   ======================================== #}
<section class="account-edit-section">
    <div class="account-edit-container">

        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" class="breadcrumb">
            <ol class="breadcrumb-list">
                <li>
                    <a href="{{ path('app_home') }}" class="breadcrumb-link">
                        Accueil
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li>
                    <a href="{{ path('app_account') }}" class="breadcrumb-link">
                        Mon compte
                    </a>
                </li>
                <li class="breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li class="breadcrumb-current">
                    Modifier mon profil
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div class="account-edit-header">
            <h1 class="account-edit-title">
                Modifier mon profil
            </h1>
            <div class="account-edit-title-divider"></div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success">
                <span data-icon="check-circle" data-icon-width="24" data-icon-height="24" class="flash-message-icon"></span>
                <div class="flash-message-content">
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-message flash-error">
                <span data-icon="alert-circle" data-icon-width="24" data-icon-height="24" class="flash-message-icon"></span>
                <div class="flash-message-content">
                    <p>{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {# Formulaire #}
        <div class="account-edit-form-wrapper">
            <div class="account-edit-form-card">
                <div class="account-edit-section-header">
                    <h2 class="account-edit-section-title">
                        <span data-icon="user" data-icon-width="24" data-icon-height="24"></span>
                        Informations personnelles
                    </h2>
                    <div class="account-edit-section-divider"></div>
                </div>

                <form method="post">
                    <div class="account-edit-form-grid">
                        <div>
                            <label for="firstname" class="account-edit-label">
                                Prénom <span class="account-edit-required">*</span>
                            </label>
                            <input type="text"
                                   id="firstname"
                                   name="firstname"
                                   value="{{ app.user.firstname }}"
                                   required
                                   class="account-edit-input">
                        </div>

                        <div>
                            <label for="lastname" class="account-edit-label">
                                Nom <span class="account-edit-required">*</span>
                            </label>
                            <input type="text"
                                   id="lastname"
                                   name="lastname"
                                   value="{{ app.user.lastname }}"
                                   required
                                   class="account-edit-input">
                        </div>
                    </div>

                    <div class="account-edit-form-group">
                        <label class="account-edit-label">
                            Adresse email
                        </label>
                        <div class="account-edit-email-display">
                            <span data-icon="mail" data-icon-width="18" data-icon-height="18" class="account-edit-email-icon"></span>
                            <span class="account-edit-email-text">{{ app.user.email }}</span>
                            <span class="account-edit-email-badge">Non modifiable</span>
                        </div>
                        <p class="account-edit-email-help">
                            L'email sert d'identifiant de connexion et ne peut pas être modifié ici.
                        </p>
                    </div>

                    <div class="account-edit-actions">
                        <a href="{{ path('app_account') }}" class="account-edit-btn-cancel">
                            <span data-icon="x" data-icon-width="18" data-icon-height="18"></span>
                            Annuler
                        </a>
                        <button type="submit" class="account-edit-btn-submit">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18"></span>
                            Enregistrer les modifications
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}
