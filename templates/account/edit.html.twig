{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
{# ========================================
   HEADER SECTION - Figma Design
   ======================================== #}
<section style="background-color: var(--beige); padding: 2rem 0 3rem;">
    <div style="max-width: 80rem; margin: 0 auto; padding: 0 1rem;">

        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" style="margin-bottom: 1.5rem;">
            <ol style="display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.875rem;">
                <li>
                    <a href="{{ path('app_home') }}" style="color: var(--dark-text); text-decoration: none; transition: color var(--transition-base);"
                       onmouseover="this.style.color='var(--bordeaux)'"
                       onmouseout="this.style.color='var(--dark-text)'">
                        Accueil
                    </a>
                </li>
                <li style="color: var(--dark-text); opacity: 0.5;">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li>
                    <a href="{{ path('app_account') }}" style="color: var(--dark-text); text-decoration: none; transition: color var(--transition-base);"
                       onmouseover="this.style.color='var(--bordeaux)'"
                       onmouseout="this.style.color='var(--dark-text)'">
                        Mon compte
                    </a>
                </li>
                <li style="color: var(--dark-text); opacity: 0.5;">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li style="color: var(--bordeaux); font-weight: 600;">
                    Modifier mon profil
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div style="margin-bottom: 2rem;">
            <h1 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 2.25rem; margin-bottom: 0.5rem; font-weight: 400;">
                Modifier mon profil
            </h1>
            <div style="width: 5rem; height: 4px; background-color: var(--gold); border-radius: var(--radius-sm);"></div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div style="background: #d4edda; border-left: 4px solid #28a745; color: #155724; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                <span data-icon="check-circle" data-icon-width="24" data-icon-height="24" style="color: #28a745;"></span>
                <div>
                    <p style="font-weight: 600; margin: 0;">{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div style="background: #f8d7da; border-left: 4px solid #dc3545; color: #721c24; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                <span data-icon="alert-circle" data-icon-width="24" data-icon-height="24" style="color: #dc3545;"></span>
                <div>
                    <p style="font-weight: 600; margin: 0;">{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        {# Formulaire #}
        <div style="max-width: 50rem; margin: 0 auto;">
            <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 2rem;">
                <div style="margin-bottom: 2rem;">
                    <h2 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.5rem; margin-bottom: 0.5rem; font-weight: 400; display: flex; align-items: center; gap: 0.5rem;">
                        <span data-icon="user" data-icon-width="24" data-icon-height="24"></span>
                        Informations personnelles
                    </h2>
                    <div style="width: 3rem; height: 3px; background-color: var(--gold); border-radius: var(--radius-sm);"></div>
                </div>

                <form method="post">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div>
                            <label for="firstname" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                                Prénom <span style="color: #dc3545;">*</span>
                            </label>
                            <input type="text" id="firstname" name="firstname" value="{{ app.user.firstname }}" required
                                   style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 1rem; transition: border-color var(--transition-base), box-shadow var(--transition-base);"
                                   onfocus="this.style.borderColor='var(--gold)'; this.style.boxShadow='0 0 0 3px rgba(212, 175, 55, 0.1)'"
                                   onblur="this.style.borderColor='var(--bordeaux)'; this.style.boxShadow='none'">
                        </div>

                        <div>
                            <label for="lastname" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                                Nom <span style="color: #dc3545;">*</span>
                            </label>
                            <input type="text" id="lastname" name="lastname" value="{{ app.user.lastname }}" required
                                   style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--bordeaux); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 1rem; transition: border-color var(--transition-base), box-shadow var(--transition-base);"
                                   onfocus="this.style.borderColor='var(--gold)'; this.style.boxShadow='0 0 0 3px rgba(212, 175, 55, 0.1)'"
                                   onblur="this.style.borderColor='var(--bordeaux)'; this.style.boxShadow='none'">
                        </div>
                    </div>

                    <div style="margin-bottom: 2rem;">
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--dark-text); font-size: 0.875rem;">
                            Adresse email
                        </label>
                        <div style="padding: 0.75rem 1rem; border-radius: var(--radius-sm); background: var(--beige); border: 1px solid rgba(139, 0, 0, 0.2); display: flex; align-items: center; gap: 0.75rem;">
                            <span data-icon="mail" data-icon-width="18" data-icon-height="18" style="color: var(--gold);"></span>
                            <span style="flex: 1; color: var(--dark-text);">{{ app.user.email }}</span>
                            <span style="padding: 0.25rem 0.75rem; border-radius: var(--radius-full); background: var(--dark-text); color: white; font-size: 0.75rem; font-weight: 600;">Non modifiable</span>
                        </div>
                        <p style="font-size: 0.875rem; color: var(--dark-text); opacity: 0.7; margin: 0.5rem 0 0;">
                            L'email sert d'identifiant de connexion et ne peut pas être modifié ici.
                        </p>
                    </div>

                    <div style="display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                        <a href="{{ path('app_account') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border: 2px solid var(--bordeaux); color: var(--bordeaux); background: white; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; transition: background-color var(--transition-base), color var(--transition-base);"
                           onmouseover="this.style.backgroundColor='var(--bordeaux)'; this.style.color='white'"
                           onmouseout="this.style.backgroundColor='white'; this.style.color='var(--bordeaux)'">
                            <span data-icon="x" data-icon-width="18" data-icon-height="18"></span>
                            Annuler
                        </a>
                        <button type="submit" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: var(--bordeaux); color: white; border: none; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; transition: background-color var(--transition-base);"
                                onmouseover="this.style.backgroundColor='#8B0000'"
                                onmouseout="this.style.backgroundColor='var(--bordeaux)'">
                            <span data-icon="check" data-icon-width="18" data-icon-height="18"></span>
                            Enregistrer les modifications
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}
