{% extends 'base.html.twig' %}

{% block title %}Accueil - Vite & Gourmand - Traiteur gastronomique à Bordeaux{% endblock %}

{% block body %}

{# ========================================
   HERO SECTION - Maquette Figma
   ======================================== #}
<section class="hero-section">
    <div class="hero-background" style="background-image: url('https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=1920&h=1080&fit=crop');"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="hero-content-inner">
            <h1>L'excellence gastronomique pour vos événements</h1>
            <p>Depuis 25 ans, Julie et José subliment vos moments avec des créations culinaires d'exception</p>
            <a href="{{ path('app_menu_catalog') }}" class="btn btn-secondary btn-hero btn-lg">
                Découvrir nos menus
                <span data-icon="arrow-right" data-icon-width="20" data-icon-height="20"></span>
            </a>
        </div>
    </div>
</section>

{# ========================================
   ABOUT SECTION - Maquette Figma
   ======================================== #}
<section class="about-section">
    <div class="container">
        {# En-tête de section #}
        <div class="section-header">
            <h2>À propos de nous</h2>
            <div class="divider-gold"></div>
        </div>

        {# Grille About #}
        <div class="about-grid">
            {# Texte de présentation #}
            <div class="about-text">
                <h3>Julie & José, passionnés de gastronomie</h3>
                <p>
                    Depuis 1999, notre duo de chefs passionnés met son savoir-faire au service de vos événements.
                    Formés dans les plus grandes maisons bordelaises, nous avons à cœur de sublimer chaque moment
                    avec des créations culinaires d'exception.
                </p>
                <p>
                    Notre engagement : des produits frais et locaux, une présentation soignée et un service
                    irréprochable pour faire de votre événement un moment inoubliable.
                </p>
            </div>

            {# Stats cards #}
            <div class="stats-grid">
                {# 25 ans #}
                <div class="stat-card">
                    <span data-icon="award" data-icon-width="48" data-icon-height="48" class="stat-icon"></span>
                    <div class="stat-number">25 ans</div>
                    <p>D'expérience</p>
                </div>

                {# 500+ événements #}
                <div class="stat-card">
                    <span data-icon="users" data-icon-width="48" data-icon-height="48" class="stat-icon"></span>
                    <div class="stat-number">500+</div>
                    <p>Événements réalisés</p>
                </div>

                {# 100% satisfaits #}
                <div class="stat-card">
                    <span data-icon="heart" data-icon-width="48" data-icon-height="48" class="stat-icon"></span>
                    <div class="stat-number">100%</div>
                    <p>Clients satisfaits</p>
                </div>
            </div>
        </div>
    </div>
</section>

{# ========================================
   TEAM SECTION - Maquette Figma
   ======================================== #}
<section class="team-section">
    <div class="container">
        {# En-tête de section #}
        <div class="section-header">
            <h2>Notre équipe</h2>
            <div class="divider-gold"></div>
        </div>

        {# Grille Team #}
        <div class="team-grid">
            {# Julie Moreau #}
            <div class="team-card">
                <div class="team-card-image-wrapper">
                    <img src="https://images.unsplash.com/photo-1611657365907-1ca5d9799f59?w=600&h=800&fit=crop"
                         alt="Julie Moreau - Chef & Co-fondatrice">
                    <div class="team-image-overlay"></div>
                </div>
                <div class="team-card-content">
                    <h3>Julie Moreau</h3>
                    <p class="team-role">Chef & Co-fondatrice</p>
                    <p>Formée aux Beaux-Arts de la cuisine, Julie apporte créativité et raffinement à chaque plat.</p>
                </div>
            </div>

            {# José Martinez #}
            <div class="team-card">
                <div class="team-card-image-wrapper">
                    <img src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c?w=600&h=800&fit=crop"
                         alt="José Martinez - Chef & Co-fondateur">
                    <div class="team-image-overlay"></div>
                </div>
                <div class="team-card-content">
                    <h3>José Martinez</h3>
                    <p class="team-role">Chef & Co-fondateur</p>
                    <p>Maître cuisinier avec 30 ans d'expérience, José garantit l'excellence de chaque création.</p>
                </div>
            </div>

            {# Équipe #}
            <div class="team-card">
                <div class="team-card-image-wrapper">
                    <img src="https://images.unsplash.com/photo-1578366941741-9e517759c620?w=600&h=800&fit=crop"
                         alt="Notre équipe de professionnels">
                    <div class="team-image-overlay"></div>
                </div>
                <div class="team-card-content">
                    <h3>Notre équipe</h3>
                    <p class="team-role">Professionnels passionnés</p>
                    <p>Une équipe de 12 personnes dévouées à faire de votre événement un moment d'exception.</p>
                </div>
            </div>
        </div>
    </div>
</section>

{# ========================================
   TESTIMONIALS SECTION - Maquette Figma
   ======================================== #}
<section class="testimonials-section">
    <div class="container">
        {# En-tête de section #}
        <div class="section-header">
            <h2>Avis clients validés</h2>
            <div class="divider-gold"></div>
            <p>La satisfaction de nos clients est notre plus belle récompense</p>
        </div>

        {# Grille Testimonials #}
        <div class="testimonials-grid">
            {% if reviews is defined and reviews is not empty %}
                {% for review in reviews %}
                    <div class="testimonial-card">
                        {# Icône quote #}
                        <span data-icon="quote" data-icon-width="32" data-icon-height="32" class="testimonial-quote-icon"></span>

                        {# Étoiles #}
                        <div class="testimonial-stars">
                            {% for i in 1..5 %}
                                <span data-icon="star" data-icon-width="20" data-icon-height="20" class="star-icon"></span>
                            {% endfor %}
                        </div>

                        {# Commentaire #}
                        {% if review.comment %}
                            <p class="testimonial-text">
                                "{{ review.comment|length > 150 ? review.comment|slice(0, 150) ~ '...' : review.comment }}"
                            </p>
                        {% else %}
                            <p class="testimonial-text">Pas de commentaire, juste une note de {{ review.rating }}/5.</p>
                        {% endif %}

                        {# Auteur #}
                        <div class="testimonial-footer">
                            <p class="customer-name">{{ review.customerName }}</p>
                            <p class="event-info">{{ review.createdAt|date('d/m/Y') }}</p>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                {# Avis par défaut si pas de reviews #}
                <div class="testimonial-card">
                    <span data-icon="quote" data-icon-width="32" data-icon-height="32" class="testimonial-quote-icon"></span>
                    <div class="testimonial-stars">
                        {% for i in 1..5 %}
                            <span data-icon="star" data-icon-width="20" data-icon-height="20" class="star-icon"></span>
                        {% endfor %}
                    </div>
                    <p class="testimonial-text">
                        "Un service exceptionnel ! Les plats étaient sublimes et nos invités en parlent encore. Julie et José ont su créer une ambiance gastronomique parfaite pour notre mariage."
                    </p>
                    <div class="testimonial-footer">
                        <p class="customer-name">Marie Dubois</p>
                        <p class="event-info">Mariage - Juin 2023</p>
                    </div>
                </div>

                <div class="testimonial-card">
                    <span data-icon="quote" data-icon-width="32" data-icon-height="32" class="testimonial-quote-icon"></span>
                    <div class="testimonial-stars">
                        {% for i in 1..5 %}
                            <span data-icon="star" data-icon-width="20" data-icon-height="20" class="star-icon"></span>
                        {% endfor %}
                    </div>
                    <p class="testimonial-text">
                        "Professionnalisme et qualité au rendez-vous. Nos 150 convives ont été ravis. La présentation était digne d'un restaurant étoilé. Je recommande vivement !"
                    </p>
                    <div class="testimonial-footer">
                        <p class="customer-name">Pierre Lefèvre</p>
                        <p class="event-info">Événement d'entreprise - Mars 2023</p>
                    </div>
                </div>

                <div class="testimonial-card">
                    <span data-icon="quote" data-icon-width="32" data-icon-height="32" class="testimonial-quote-icon"></span>
                    <div class="testimonial-stars">
                        {% for i in 1..5 %}
                            <span data-icon="star" data-icon-width="20" data-icon-height="20" class="star-icon"></span>
                        {% endfor %}
                    </div>
                    <p class="testimonial-text">
                        "Une cuisine raffinée avec des produits frais et locaux. L'équipe est aux petits soins. Mon anniversaire était parfait grâce à Vite & Gourmand !"
                    </p>
                    <div class="testimonial-footer">
                        <p class="customer-name">Sophie Bernard</p>
                        <p class="event-info">Anniversaire - Décembre 2023</p>
                    </div>
                </div>

                <div class="testimonial-card">
                    <span data-icon="quote" data-icon-width="32" data-icon-height="32" class="testimonial-quote-icon"></span>
                    <div class="testimonial-stars">
                        {% for i in 1..5 %}
                            <span data-icon="star" data-icon-width="20" data-icon-height="20" class="star-icon"></span>
                        {% endfor %}
                    </div>
                    <p class="testimonial-text">
                        "Des saveurs exceptionnelles et une présentation soignée. Le menu végétarien était particulièrement réussi. Service impeccable du début à la fin."
                    </p>
                    <div class="testimonial-footer">
                        <p class="customer-name">Laurent Petit</p>
                        <p class="event-info">Baptême - Avril 2023</p>
                    </div>
                </div>
            {% endif %}
        </div>

        {# Lien vers tous les avis #}
        {% if reviews is defined and reviews is not empty %}
            <div class="testimonials-cta">
                <a href="{{ path('app_review_index') }}" class="btn btn-outline">
                    Voir tous les avis
                </a>
            </div>
        {% endif %}
    </div>
</section>

{% endblock %}
