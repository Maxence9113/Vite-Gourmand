{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.orderNumber }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/order.css') }}">
{% endblock %}

{% block body %}
{# ========================================
   HEADER SECTION - Figma Design
   ======================================== #}
<section class="order-section">
    <div class="container">
        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" class="order-breadcrumb">
            <ol class="order-breadcrumb-list">
                <li>
                    <a href="{{ path('app_home') }}" class="order-breadcrumb-link">
                        Accueil
                    </a>
                </li>
                <li class="order-breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li>
                    <a href="{{ path('app_account_orders') }}" class="order-breadcrumb-link">
                        Mes commandes
                    </a>
                </li>
                <li class="order-breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li class="order-breadcrumb-current">
                    {{ order.orderNumber }}
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div class="order-section-header">
            <h1 class="order-section-title">
                Commande {{ order.orderNumber }}
            </h1>
            <div class="order-section-divider"></div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="order-flash-success">
                <span data-icon="check" data-icon-width="20" data-icon-height="20"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="order-flash-error">
                <span data-icon="alert-circle" data-icon-width="20" data-icon-height="20"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# Layout responsive - 2 colonnes desktop, 1 colonne mobile #}
        <div class="order-detail-grid">
            {# ========== COLONNE GAUCHE - Détails commande ========== #}
            <div>
                {# Statut de la commande #}
                <div class="order-box">
                    <div class="order-box-header">
                        <h2 class="order-box-title">
                            Statut de la commande
                        </h2>
                        <span class="order-status-badge status-{{ order.status.badgeClass }}">
                            <span data-icon="{{ order.status.icon }}" data-icon-width="16" data-icon-height="16"></span>
                            {{ order.status.label }}
                        </span>
                    </div>

                    <p class="order-box-text">
                        Commande passée le <strong>{{ order.createdAt|date('d/m/Y à H:i') }}</strong>
                    </p>

                    {% if order.status.label == 'Annulée' %}
                        <div class="order-cancellation-alert">
                            <p class="order-cancellation-reason-title">Raison de l'annulation</p>
                            <p class="order-cancellation-reason-text">{{ order.cancellationReason ?? 'Non spécifiée' }}</p>
                        </div>
                    {% endif %}

                    {% if order.canBeCancelled %}
                        <button type="button" onclick="document.getElementById('cancelModal').style.display='block'" class="order-cancel-btn">
                            <span data-icon="x-circle" data-icon-width="20" data-icon-height="20"></span>
                            Annuler la commande
                        </button>
                    {% endif %}

                    {% if order.status.canReceiveReview() and not order.review %}
                        <a href="{{ path('app_review_new', {orderId: order.id}) }}" class="order-review-btn">
                            <span data-icon="star" data-icon-width="20" data-icon-height="20"></span>
                            Laisser un avis
                        </a>
                    {% endif %}

                    {% if order.review %}
                        <div class="order-review-submitted">
                            <span data-icon="check-circle" data-icon-width="20" data-icon-height="20"></span>
                            <span>
                                {% if order.review.isValidated %}
                                    Votre avis a été publié. Merci pour votre retour !
                                {% else %}
                                    Votre avis est en cours de modération.
                                {% endif %}
                            </span>
                        </div>
                    {% endif %}
                </div>

                {# Détails du menu #}
                <div class="order-box">
                    <h2 class="order-box-title">
                        Détails du menu
                    </h2>
                    <h3 class="order-box-subtitle">
                        {{ order.menuName }}
                    </h3>
                    <div class="order-menu-details-grid">
                        <div class="order-menu-stat">
                            <span data-icon="users" data-icon-width="24" data-icon-height="24"></span>
                            <div>
                                <p class="order-menu-stat-label">Nombre de personnes</p>
                                <p class="order-menu-stat-value">{{ order.numberOfPersons }}</p>
                            </div>
                        </div>
                        <div class="order-menu-stat">
                            <span data-icon="dollar-sign" data-icon-width="24" data-icon-height="24"></span>
                            <div>
                                <p class="order-menu-stat-label">Prix par personne</p>
                                <p class="order-menu-stat-value">{{ (order.menuPricePerPerson / 100)|number_format(2, ',', ' ') }}€</p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Informations de livraison #}
                <div class="order-box">
                    <h2 class="order-box-title">
                        Informations de livraison
                    </h2>
                    <div class="order-delivery-info-grid">
                        <div>
                            <p class="order-delivery-info-item-label">
                                <span data-icon="calendar" data-icon-width="20" data-icon-height="20"></span>
                                Date et heure
                            </p>
                            <p class="order-delivery-info-item-value">{{ order.deliveryDateTime|date('d/m/Y à H:i') }}</p>
                        </div>
                        <div>
                            <p class="order-delivery-info-item-label">
                                <span data-icon="map-pin" data-icon-width="20" data-icon-height="20"></span>
                                Adresse
                            </p>
                            <p class="order-delivery-info-item-value">{{ order.deliveryAddress }}</p>
                        </div>
                    </div>

                    {% if order.hasMaterialLoan %}
                        <div class="order-material-box">
                            <p class="order-material-title">
                                <span data-icon="package" data-icon-width="20" data-icon-height="20"></span>
                                Emprunt de matériel
                            </p>
                            <p class="order-material-deadline">
                                Date limite de retour: <strong>{{ order.materialReturnDeadline|date('d/m/Y') }}</strong>
                            </p>
                            <p class="order-material-status">
                                {% if order.materialReturned %}
                                    <span class="order-material-status-badge returned">
                                        <span data-icon="check" data-icon-width="14" data-icon-height="14"></span>
                                        Matériel retourné
                                    </span>
                                {% else %}
                                    <span class="order-material-status-badge pending">
                                        <span data-icon="clock" data-icon-width="14" data-icon-height="14"></span>
                                        En attente de retour
                                    </span>
                                {% endif %}
                            </p>
                        </div>
                    {% endif %}
                </div>

            </div>

            {# ========== COLONNE DROITE - Récapitulatif et historique ========== #}
            <div>
                {# Récapitulatif financier #}
                <div class="order-summary-box">
                    <div class="order-summary-header">
                        <h2 class="order-summary-header-title">
                            Récapitulatif financier
                        </h2>
                    </div>
                    <div class="order-summary-body">
                        <div class="order-summary-line">
                            <span>Sous-total menu</span>
                            <strong>{{ (order.menuSubtotal / 100)|number_format(2, ',', ' ') }}€</strong>
                        </div>

                        {% if order.discountAmount %}
                            <div class="order-summary-discount">
                                <span>Réduction (10%)</span>
                                <strong>- {{ (order.discountAmount / 100)|number_format(2, ',', ' ') }}€</strong>
                            </div>
                        {% endif %}

                        <div class="order-summary-line">
                            <span>Frais de livraison</span>
                            <strong>{{ (order.deliveryCost / 100)|number_format(2, ',', ' ') }}€</strong>
                        </div>

                        {% if order.deliveryDistanceKm %}
                            <div class="order-summary-delivery-note">
                                <small>
                                    <span data-icon="map-pin" data-icon-width="14" data-icon-height="14" class="order-summary-delivery-note-icon"></span>
                                    Distance: {{ order.deliveryDistanceKm }} km
                                </small>
                            </div>
                        {% endif %}

                        <hr class="order-summary-divider">

                        <div class="order-summary-total">
                            <span class="order-summary-total-label">Total</span>
                            <strong class="order-summary-total-value">{{ (order.totalPrice / 100)|number_format(2, ',', ' ') }}€</strong>
                        </div>
                    </div>
                </div>

                {# Historique des statuts #}
                <div class="order-history-box">
                    <h2 class="order-box-title">
                        Historique
                    </h2>
                    <div class="order-history-timeline">
                        {# Ligne verticale #}
                        <div class="order-history-timeline-line"></div>

                        <ul class="order-history-list">
                            {% for entry in order.statusHistory %}
                                <li class="order-history-item">
                                    {# Point sur la timeline #}
                                    <div class="order-history-item-point"></div>

                                    <div>
                                        <small class="order-history-item-date">
                                            {{ entry.changed_at }}
                                        </small>
                                        <span class="order-history-item-label">
                                            {{ entry.label }}
                                        </span>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


{# ========================================
   MODAL D'ANNULATION - Sans Bootstrap
   ======================================== #}
<div id="cancelModal" class="order-cancel-modal">
    <div class="order-cancel-modal-content">
        {# Header #}
        <div class="order-cancel-modal-header">
            <h2 class="order-cancel-modal-title">
                Annuler la commande
            </h2>
            <button type="button" onclick="document.getElementById('cancelModal').style.display='none'" class="order-cancel-modal-close">
                <span data-icon="x" data-icon-width="24" data-icon-height="24"></span>
            </button>
        </div>

        {# Body #}
        <form method="post" action="{{ path('app_order_cancel', {id: order.id}) }}">
            <div class="order-cancel-modal-body">
                <p class="order-cancel-modal-text">
                    Êtes-vous sûr de vouloir annuler cette commande ?
                </p>
                <div class="order-cancel-modal-form-group">
                    <label for="reason" class="order-cancel-modal-label">
                        Raison (optionnel)
                    </label>
                    <textarea id="reason" name="reason" rows="3" class="order-cancel-modal-textarea" placeholder="Indiquez la raison de l'annulation..."></textarea>
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('cancel-order-' ~ order.id) }}">
            </div>

            {# Footer #}
            <div class="order-cancel-modal-footer">
                <button type="button" onclick="document.getElementById('cancelModal').style.display='none'" class="order-cancel-modal-btn-secondary">
                    Fermer
                </button>
                <button type="submit" class="order-cancel-modal-btn-danger">
                    Confirmer l'annulation
                </button>
            </div>
        </form>
    </div>
</div>

<script>
// Fermer le modal en cliquant en dehors
document.getElementById('cancelModal').addEventListener('click', function(e) {
    if (e.target === this) {
        this.style.display = 'none';
    }
});

// Fermer avec la touche Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.getElementById('cancelModal').style.display = 'none';
    }
});
</script>
{% endblock %}
