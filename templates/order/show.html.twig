{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.orderNumber }}{% endblock %}

{% block body %}
<div style="margin: 30px 0;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1>Commande {{ order.orderNumber }}</h1>
        <a href="{{ path('app_account_orders') }}" class="btn btn-secondary">
            <i data-feather="arrow-left"></i> Retour à mes commandes
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
        <div style="grid-column: span 2;">
            <div style="margin-bottom: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h5 style="margin: 0;">Statut de la commande</h5>
                    <span class="badge bg-{{ order.status.badgeClass }} fs-6">
                        <i data-feather="{{ order.status.icon }}"></i>
                        {{ order.status.label }}
                    </span>
                </div>
                <div class="card-body">
                    <p style="margin-bottom: 10px;">
                        Commande passée le {{ order.createdAt|date('d/m/Y à H:i') }}
                    </p>

                    {% if order.status.label == 'Annulée' %}
                        <div class="alert alert-warning">
                            <strong>Raison de l'annulation:</strong>
                            {{ order.cancellationReason ?? 'Non spécifiée' }}
                        </div>
                    {% endif %}

                    {% if order.canBeCancelled %}
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i data-feather="x-circle"></i> Annuler la commande
                        </button>
                    {% endif %}
                </div>
            </div>

            <div style="margin-bottom: 25px;">
                <div class="card-header">
                    <h5 style="margin: 0;">Détails du menu</h5>
                </div>
                <div class="card-body">
                    <h4>{{ order.menuName }}</h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 20px;">
                        <div style="grid-column: span 1;">
                            <ul style="list-style: none; padding: 0;">
                                <li style="margin-bottom: 10px;">
                                    <i data-feather="users" style="color: #95a5a6;"></i>
                                    <strong>Nombre de personnes:</strong> {{ order.numberOfPersons }}
                                </li>
                                <li style="margin-bottom: 10px;">
                                    <i data-feather="dollar-sign" style="color: #95a5a6;"></i>
                                    <strong>Prix par personne:</strong> {{ (order.menuPricePerPerson / 100)|number_format(2, ',', ' ') }}€
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div style="margin-bottom: 25px;">
                <div class="card-header">
                    <h5 style="margin: 0;">Informations de livraison</h5>
                </div>
                <div class="card-body">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                        <div style="grid-column: span 1;">
                            <p style="margin-bottom: 10px;"><strong>Date et heure:</strong></p>
                            <p>{{ order.deliveryDateTime|date('d/m/Y à H:i') }}</p>
                        </div>
                        <div style="grid-column: span 1;">
                            <p style="margin-bottom: 10px;"><strong>Adresse:</strong></p>
                            <p>{{ order.deliveryAddress }}</p>
                        </div>
                    </div>

                    {% if order.hasMaterialLoan %}
                        <div style="margin-top: 20px;">
                            <i data-feather="package"></i>
                            <strong>Emprunt de matériel</strong>
                            <p style="margin: 0;">
                                Date limite de retour: {{ order.materialReturnDeadline|date('d/m/Y') }}
                                {% if order.materialReturned %}
                                    <span class="badge badge-success">Matériel retourné</span>
                                {% else %}
                                    <span class="badge badge-warning">En attente de retour</span>
                                {% endif %}
                            </p>
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if order.canReceiveReview %}
                <div style="margin-bottom: 25px;">
                    <div class="card-header">
                        <h5 style="margin: 0;">Laisser un avis</h5>
                    </div>
                    <div class="card-body">
                        <p>Votre commande a été livrée. Qu'en avez-vous pensé ?</p>
                        <a href="#" class="btn btn-primary">
                            <i data-feather="star"></i> Écrire un avis
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>

        <div style="grid-column: span 1;">
            <div class="card">
                <div class="card-header badge-primary text-white">
                    <h5 style="margin: 0;">Récapitulatif financier</h5>
                </div>
                <div class="card-body">
                    <div style="margin-bottom: 10px;">
                        <span>Sous-total menu:</span>
                        <strong>{{ (order.menuSubtotal / 100)|number_format(2, ',', ' ') }}€</strong>
                    </div>

                    {% if order.discountAmount %}
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #27ae60;">
                            <span>Réduction (10%):</span>
                            <strong>- {{ (order.discountAmount / 100)|number_format(2, ',', ' ') }}€</strong>
                        </div>
                    {% endif %}

                    <div style="margin-bottom: 10px;">
                        <span>Frais de livraison:</span>
                        <strong>{{ (order.deliveryCost / 100)|number_format(2, ',', ' ') }}€</strong>
                    </div>

                    {% if order.deliveryDistanceKm %}
                        <small style="margin-bottom: 10px;">
                            Distance: {{ order.deliveryDistanceKm }} km
                        </small>
                    {% endif %}

                    <hr>

                    <div style="display: flex; justify-content: space-between;">
                        <span style="font-size: 1.1rem;">Total:</span>
                        <strong style="font-size: 1.25rem; color: var(--bordeaux);">{{ (order.totalPrice / 100)|number_format(2, ',', ' ') }}€</strong>
                    </div>
                </div>
            </div>

            <div style="margin-top: 25px;">
                <div class="card-header">
                    <h5 style="margin: 0;">Historique</h5>
                </div>
                <div class="card-body">
                    <ul style="list-style: none; padding: 0;">
                        {% for entry in order.statusHistory %}
                            <li style="margin-bottom: 10px;">
                                <small style="color: #95a5a6;">{{ entry.changed_at }}</small>
                                <div>
                                    <span style="background: #95a5a6; color: white;">{{ entry.label }}</span>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

{# Modal d'annulation #}
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelModalLabel">Annuler la commande</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="{{ path('app_order_cancel', {id: order.id}) }}">
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir annuler cette commande ?</p>
                    <div style="margin-bottom: 20px;">
                        <label for="reason" class="form-label">Raison (optionnel)</label>
                        <textarea class="form-control" id="reason" name="reason" rows="3"></textarea>
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel-order-' ~ order.id) }}">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                    <button type="submit" class="btn btn-danger">Confirmer l'annulation</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}