{% extends 'base.html.twig' %}

{% block title %}Nouvelle commande - {{ menu.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/order.css') }}">
{% endblock %}

{% block body %}

{# ========================================
   NOUVELLE COMMANDE - Design sans Bootstrap
   ======================================== #}
<section class="order-section">
    <div class="container">

        {# Titre de la page #}
        <h1 class="order-section-title">
            Passer une commande
        </h1>
        <div class="order-section-divider"></div>

        {# Messages d'erreur #}
        {% for message in app.flashes('error') %}
            <div class="order-flash-error">
                {{ message }}
            </div>
        {% endfor %}

        {# Layout 2 colonnes #}
        <div class="order-new-grid">

            {# COLONNE PRINCIPALE - Formulaire #}
            <div>
                {# Menu sélectionné #}
                <div class="order-selected-menu-box">
                    <h2 class="order-selected-menu-title">
                        Menu sélectionné
                    </h2>
                    <h3 class="order-selected-menu-name">
                        {{ menu.name }}
                    </h3>
                    <p class="order-selected-menu-description">
                        {{ menu.description }}
                    </p>

                    {# Badges #}
                    <div class="order-selected-menu-badges">
                        <span class="order-badge order-badge-price">
                            {{ (menu.pricePerPerson / 100)|number_format(2, ',', ' ') }}€ / personne
                        </span>
                        <span class="order-badge order-badge-min">
                            Minimum {{ menu.nbPersonMin }} personnes
                        </span>
                        {% if menu.stock is not null %}
                            {% if menu.stock > 0 %}
                                {% if menu.stock <= 5 %}
                                    <span class="order-badge order-badge-stock-limited">
                                        <span data-icon="alert-triangle" data-icon-width="16" data-icon-height="16"></span>
                                        Stock limité : {{ menu.stock }} disponible{{ menu.stock > 1 ? 's' : '' }}
                                    </span>
                                {% else %}
                                    <span class="order-badge order-badge-stock-available">
                                        <span data-icon="check-circle" data-icon-width="16" data-icon-height="16"></span>
                                        En stock : {{ menu.stock }} disponible{{ menu.stock > 1 ? 's' : '' }}
                                    </span>
                                {% endif %}
                            {% endif %}
                        {% else %}
                            <span class="order-badge order-badge-stock-unlimited">
                                Stock illimité
                            </span>
                        {% endif %}
                    </div>
                </div>

                {# Formulaire #}
                {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}

                {# Détails de la commande #}
                <div class="order-form-box">
                    <h2 class="order-form-title">
                        Détails de la commande
                    </h2>

                    {# Menu ID (caché) #}
                    <div style="display: none;">
                        {{ form_row(form.menu, {
                            'value': menu.id,
                            'attr': {'data-menu-id': menu.id, 'data-menu-price': menu.pricePerPerson, 'data-menu-min': menu.nbPersonMin}
                        }) }}
                    </div>

                    {# Nombre de personnes #}
                    <div class="order-form-group">
                        {{ form_row(form.numberOfPersons) }}
                        <small class="order-form-note">
                            Minimum pour ce menu: {{ menu.nbPersonMin }} personnes
                        </small>
                    </div>

                    {# Date et heure de livraison #}
                    <div class="order-form-group">
                        {{ form_row(form.deliveryDateTime) }}
                        <small class="order-form-note">
                            Minimum 48h à l'avance - Uniquement pendant nos horaires d'ouverture
                        </small>
                        <div class="order-form-info-box">
                            <div class="order-form-info-header">
                                <span data-icon="clock" data-icon-width="20" data-icon-height="20"></span>
                                <strong>Horaires d'ouverture :</strong>
                            </div>
                            <div class="order-form-info-content">
                                {% for schedule in opening_schedules %}
                                    <div class="order-form-schedule-line">
                                        {{ schedule.label }} :
                                        {% if schedule.isOpen %}
                                            {{ schedule.openingTime }} - {{ schedule.closingTime }}
                                        {% else %}
                                            <span class="order-form-schedule-closed">Fermé</span>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    {# Adresse de livraison #}
                    <div class="order-form-group">
                        <label class="order-form-address-label">
                            Adresse de livraison
                        </label>
                        {{ form_widget(form.deliveryAddress, {'attr': {'class': 'order-form-address-input'}}) }}
                        {{ form_errors(form.deliveryAddress) }}
                        <div class="order-form-address-help">
                            <small>
                                💡 Vous pouvez gérer vos adresses dans votre compte
                            </small>
                            <a href="{{ path('app_account_address_new') }}" target="_blank">
                                <span data-icon="plus" data-icon-width="16" data-icon-height="16"></span>
                                Ajouter une nouvelle adresse
                            </a>
                        </div>
                    </div>

                    {# Prêt de matériel #}
                    <div style="margin-bottom: 0;">
                        <div class="order-form-material-box">
                            <div class="order-form-material-checkbox">
                                {{ form_widget(form.hasMaterialLoan) }}
                            </div>
                            <div class="order-form-material-content">
                                <label for="{{ form.hasMaterialLoan.vars.id }}" class="order-form-material-label">
                                    Je souhaite emprunter du matériel (vaisselle, couverts, etc.)
                                </label>
                                <small class="order-form-material-note">
                                    <span data-icon="info" data-icon-width="16" data-icon-height="16"></span>
                                    Le matériel devra être retourné dans un délai de 10 jours
                                </small>
                            </div>
                        </div>
                        {{ form_errors(form.hasMaterialLoan) }}
                    </div>
                </div>

                {# Boutons d'action #}
                <div class="order-form-actions">
                    <a href="{{ path('app_menu_catalog') }}" class="btn btn-outline">
                        <span data-icon="arrow-left" data-icon-width="20" data-icon-height="20"></span>
                        Retour aux menus
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <span data-icon="check-circle" data-icon-width="20" data-icon-height="20"></span>
                        Confirmer la commande
                    </button>
                </div>

                {{ form_end(form) }}
            </div>

            {# COLONNE RÉCAPITULATIF - Sticky #}
            <div class="order-summary-column">
                <div class="order-summary-sticky">
                    <div class="order-summary-box-new">
                        {# Header #}
                        <div class="order-summary-header-new">
                            <h2 class="order-summary-header-title-new">
                                Récapitulatif
                            </h2>
                        </div>

                        {# Body #}
                        <div class="order-summary-body-new" id="order-summary">
                            <div class="order-summary-row">
                                <span class="order-summary-row-label">Menu :</span>
                                <strong class="order-summary-row-value">{{ menu.name }}</strong>
                            </div>

                            <div class="order-summary-simple-row">
                                <span class="order-summary-row-label">Prix par personne :</span>
                                <strong class="order-summary-row-value">{{ (menu.pricePerPerson / 100)|number_format(2, ',', ' ') }}€</strong>
                            </div>

                            <div class="order-summary-row">
                                <span class="order-summary-row-label">Nombre de personnes :</span>
                                <strong class="order-summary-row-value"><span id="persons-display">{{ menu.nbPersonMin }}</span></strong>
                            </div>

                            <div class="order-summary-simple-row">
                                <span class="order-summary-row-label">Sous-total menu :</span>
                                <strong class="order-summary-row-value"><span id="subtotal-display">{{ (menu.pricePerPerson * menu.nbPersonMin / 100)|number_format(2, ',', ' ') }}</span>€</strong>
                            </div>

                            <div class="order-summary-simple-row">
                                <span class="order-summary-row-label">Frais de livraison :</span>
                                <strong class="order-summary-row-value"><span id="delivery-display">5,00</span>€</strong>
                            </div>

                            <div id="discount-row" class="order-summary-discount-row">
                                <span>Réduction (10%) :</span>
                                <strong>- <span id="discount-display">0,00</span>€</strong>
                            </div>

                            <div id="discount-message" class="order-summary-discount-message"></div>

                            <div class="order-summary-total-wrapper">
                                <div class="order-summary-total-row">
                                    <span class="order-summary-total-label-new">Total :</span>
                                    <strong class="order-summary-total-value-new">
                                        <span id="total-display">{{ ((menu.pricePerPerson * menu.nbPersonMin + 500) / 100)|number_format(2, ',', ' ') }}</span>€
                                    </strong>
                                </div>
                            </div>

                            <div class="order-summary-delivery-info">
                                <small>
                                    <span data-icon="info" data-icon-width="16" data-icon-height="16"></span>
                                    <span>Les frais de livraison définitifs seront calculés selon votre adresse.</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
// Calcul dynamique du récapitulatif
document.addEventListener('DOMContentLoaded', function() {
    const personsInput = document.querySelector('#order_numberOfPersons');
    const addressSelect = document.querySelector('#order_deliveryAddress');
    const menuPrice = {{ menu.pricePerPerson }};
    const menuMin = {{ menu.nbPersonMin }};

    let currentDeliveryCost = 500; // 5€ par défaut
    let isCalculatingDelivery = false;

    async function fetchDeliveryCost(addressId) {
        if (!addressId || isCalculatingDelivery) return;

        isCalculatingDelivery = true;
        const deliveryDisplay = document.getElementById('delivery-display');
        const originalText = deliveryDisplay.textContent;
        deliveryDisplay.textContent = 'Calcul...';

        try {
            const response = await fetch(`{{ path('app_order_calculate_delivery_cost', {addressId: '__ADDRESS_ID__'}) }}`.replace('__ADDRESS_ID__', addressId));

            if (!response.ok) {
                throw new Error('Erreur lors du calcul des frais de livraison');
            }

            const data = await response.json();

            if (data.success) {
                currentDeliveryCost = data.deliveryCost;
                updateSummary();
            }
        } catch (error) {
            console.error('Erreur:', error);
            deliveryDisplay.textContent = originalText;
        } finally {
            isCalculatingDelivery = false;
        }
    }

    function updateSummary() {
        const persons = parseInt(personsInput.value) || menuMin;

        // Sous-total
        const subtotal = menuPrice * persons;
        document.getElementById('subtotal-display').textContent = (subtotal / 100).toFixed(2).replace('.', ',');

        // Réduction de 10% si 5 personnes de plus que le minimum
        const extraPersons = persons - menuMin;
        let discount = 0;
        const discountRow = document.getElementById('discount-row');

        if (extraPersons >= 5) {
            discount = subtotal * 0.10;
            if (discountRow) {
                discountRow.style.display = 'flex';
            }
            document.getElementById('discount-display').textContent = (discount / 100).toFixed(2).replace('.', ',');
        } else {
            if (discountRow) {
                discountRow.style.display = 'none';
            }
            document.getElementById('discount-display').textContent = '0,00';
        }

        // Livraison
        document.getElementById('delivery-display').textContent = (currentDeliveryCost / 100).toFixed(2).replace('.', ',');

        // Total
        const total = subtotal + currentDeliveryCost - discount;
        document.getElementById('total-display').textContent = (total / 100).toFixed(2).replace('.', ',');

        // Nombre de personnes
        document.getElementById('persons-display').textContent = persons;

        // Message de réduction
        const discountMessage = document.getElementById('discount-message');
        if (discountMessage) {
            if (extraPersons >= 5) {
                discountMessage.style.display = 'block';
                discountMessage.style.backgroundColor = 'rgba(34, 139, 34, 0.1)';
                discountMessage.style.borderLeft = '3px solid var(--green)';
                discountMessage.style.color = 'var(--dark-text)';
                discountMessage.innerHTML = '<strong style="color: var(--green);">✓ Réduction de 10% appliquée !</strong>';
            } else {
                const remaining = 5 - extraPersons;
                if (remaining > 0 && persons >= menuMin) {
                    discountMessage.style.display = 'block';
                    discountMessage.style.backgroundColor = 'rgba(255, 215, 0, 0.1)';
                    discountMessage.style.borderLeft = '3px solid var(--gold)';
                    discountMessage.style.color = 'var(--dark-text)';
                    discountMessage.innerHTML = 'Ajoutez encore <strong>' + remaining + ' personne' + (remaining > 1 ? 's' : '') + '</strong> pour bénéficier de 10% de réduction !';
                } else {
                    discountMessage.style.display = 'none';
                }
            }
        }
    }

    if (personsInput) {
        personsInput.addEventListener('input', updateSummary);
        personsInput.addEventListener('change', updateSummary);
        updateSummary();
    }

    if (addressSelect) {
        addressSelect.addEventListener('change', async function() {
            const addressId = this.value;
            if (addressId) {
                await fetchDeliveryCost(addressId);
            }
        });

        if (addressSelect.value) {
            fetchDeliveryCost(addressSelect.value);
        }
    }
});
</script>
{% endblock %}
