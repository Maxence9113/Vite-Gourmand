{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<div style="margin: 30px 0;">
    <h1 style="margin-bottom: 25px;">Mes commandes</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% if orders is empty %}
        <div class="alert alert-info">
            <i data-feather="info"></i>
            Vous n'avez pas encore passé de commande.
            <a href="{{ path('app_menu_catalog') }}" class="alert-link">Découvrir nos menus</a>
        </div>
    {% else %}
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
            {% for order in orders %}
                <div style="margin-bottom: 25px;">
                    <div class="card h-100">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 600;">{{ order.orderNumber }}</span>
                            <span class="badge bg-{{ order.status.badgeClass }}">
                                {{ order.status.label }}
                            </span>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">{{ order.menuName }}</h5>
                            <ul style="margin-bottom: 20px;">
                                <li>
                                    <i data-feather="users" style="color: #95a5a6;"></i>
                                    {{ order.numberOfPersons }} personne{{ order.numberOfPersons > 1 ? 's' : '' }}
                                </li>
                                <li>
                                    <i data-feather="calendar" style="color: #95a5a6;"></i>
                                    {{ order.deliveryDateTime|date('d/m/Y à H:i') }}
                                </li>
                                <li>
                                    <i data-feather="map-pin" style="color: #95a5a6;"></i>
                                    {{ order.deliveryAddress|slice(0, 50) }}{{ order.deliveryAddress|length > 50 ? '...' : '' }}
                                </li>
                            </ul>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <strong style="margin: 0;">
                                    {{ (order.totalPrice / 100)|number_format(2, ',', ' ') }}€
                                </strong>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="{{ path('app_order_show', {id: order.id}) }}" class="btn btn-sm btn-primary style="width: 100%;">
                                <i data-feather="eye"></i> Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}