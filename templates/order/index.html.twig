{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
{# ========================================
   HEADER SECTION - Figma Design
   ======================================== #}
<section style="background-color: var(--beige); padding: 2rem 0 3rem;">
    <div style="max-width: 80rem; margin: 0 auto; padding: 0 1rem;">
        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" style="margin-bottom: 1.5rem;">
            <ol style="display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.875rem;">
                <li>
                    <a href="{{ path('app_home') }}" style="color: var(--dark-text); text-decoration: none; transition: color var(--transition-base);"
                       onmouseover="this.style.color='var(--bordeaux)'"
                       onmouseout="this.style.color='var(--dark-text)'">
                        Accueil
                    </a>
                </li>
                <li style="color: var(--dark-text); opacity: 0.5;">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li style="color: var(--bordeaux); font-weight: 600;">
                    Mes commandes
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div style="margin-bottom: 2rem;">
            <h1 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 2.25rem; margin-bottom: 0.5rem; font-weight: 400;">
                Mes commandes
            </h1>
            <div style="width: 5rem; height: 4px; background-color: var(--gold); border-radius: var(--radius-sm);"></div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div style="background: #d4edda; border-left: 4px solid #28a745; color: #155724; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                <span data-icon="check" data-icon-width="20" data-icon-height="20" style="color: #28a745;"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# État vide #}
        {% if orders is empty %}
            <div style="background: white; border-radius: var(--radius-lg); padding: 3rem 2rem; box-shadow: var(--shadow-md); text-align: center;">
                <span data-icon="shopping-bag" data-icon-width="64" data-icon-height="64" style="display: block; margin: 0 auto 1.5rem; color: var(--gold);"></span>
                <h2 style="font-family: var(--font-heading); color: var(--dark-text); font-size: 1.5rem; margin-bottom: 0.75rem; font-weight: 400;">
                    Aucune commande pour le moment
                </h2>
                <p style="color: var(--dark-text); opacity: 0.8; margin-bottom: 2rem;">
                    Vous n'avez pas encore passé de commande.
                </p>
                <a href="{{ path('app_menu_catalog') }}" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--bordeaux); color: white; border: none; padding: 0.875rem 2rem; border-radius: var(--radius-sm); font-weight: 600; text-decoration: none; transition: background-color var(--transition-base);"
                   onmouseover="this.style.backgroundColor='#8B0000'"
                   onmouseout="this.style.backgroundColor='var(--bordeaux)'">
                    <span data-icon="arrow-right" data-icon-width="20" data-icon-height="20"></span>
                    Découvrir nos menus
                </a>
            </div>
        {% else %}
            {# Grille de commandes #}
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 350px), 1fr)); gap: 1.5rem;">
                {% for order in orders %}
                    <div style="background: white; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); display: flex; flex-direction: column; transition: transform var(--transition-base), box-shadow var(--transition-base);"
                         onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-lg)'"
                         onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-md)'">

                        {# Header de la carte #}
                        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--beige); display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
                            <span style="font-weight: 600; color: var(--dark-text); font-family: var(--font-body);">{{ order.orderNumber }}</span>
                            <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.375rem 0.75rem; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.8125rem; background: #{{ order.status.badgeClass == 'success' ? 'd4edda' : (order.status.badgeClass == 'warning' ? 'fff3cd' : (order.status.badgeClass == 'danger' ? 'f8d7da' : (order.status.badgeClass == 'info' ? 'e7f1ff' : 'f8f9fa'))) }}; color: #{{ order.status.badgeClass == 'success' ? '155724' : (order.status.badgeClass == 'warning' ? '856404' : (order.status.badgeClass == 'danger' ? '721c24' : (order.status.badgeClass == 'info' ? '004085' : '495057'))) }};">
                                <span data-icon="{{ order.status.icon }}" data-icon-width="14" data-icon-height="14"></span>
                                {{ order.status.label }}
                            </span>
                        </div>

                        {# Body de la carte #}
                        <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
                            <h3 style="font-family: var(--font-heading); color: var(--bordeaux); font-size: 1.25rem; margin-bottom: 1.25rem; font-weight: 400;">
                                {{ order.menuName }}
                            </h3>

                            <div style="display: flex; flex-direction: column; gap: 0.875rem; margin-bottom: 1.5rem;">
                                <div style="display: flex; align-items: center; gap: 0.75rem; color: var(--dark-text);">
                                    <span data-icon="users" data-icon-width="18" data-icon-height="18" style="color: var(--gold); flex-shrink: 0;"></span>
                                    <span style="font-size: 0.9375rem;">{{ order.numberOfPersons }} personne{{ order.numberOfPersons > 1 ? 's' : '' }}</span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 0.75rem; color: var(--dark-text);">
                                    <span data-icon="calendar" data-icon-width="18" data-icon-height="18" style="color: var(--gold); flex-shrink: 0;"></span>
                                    <span style="font-size: 0.9375rem;">{{ order.deliveryDateTime|date('d/m/Y à H:i') }}</span>
                                </div>
                                <div style="display: flex; align-items: flex-start; gap: 0.75rem; color: var(--dark-text);">
                                    <span data-icon="map-pin" data-icon-width="18" data-icon-height="18" style="color: var(--gold); flex-shrink: 0; margin-top: 2px;"></span>
                                    <span style="font-size: 0.9375rem; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">{{ order.deliveryAddress }}</span>
                                </div>
                            </div>

                            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--beige); display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <p style="font-size: 0.75rem; color: var(--dark-text); opacity: 0.7; margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.05em;">Total</p>
                                    <p style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--bordeaux); margin: 0; font-weight: 400;">
                                        {{ (order.totalPrice / 100)|number_format(2, ',', ' ') }}€
                                    </p>
                                </div>
                            </div>
                        </div>

                        {# Footer de la carte #}
                        <div style="padding: 1rem 1.5rem; background: #f9f9f9; border-top: 1px solid var(--beige);">
                            <a href="{{ path('app_order_show', {id: order.id}) }}" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; background: var(--bordeaux); color: white; border: none; padding: 0.75rem 1rem; border-radius: var(--radius-sm); font-weight: 600; text-decoration: none; transition: background-color var(--transition-base);"
                               onmouseover="this.style.backgroundColor='#8B0000'"
                               onmouseout="this.style.backgroundColor='var(--bordeaux)'">
                                <span data-icon="eye" data-icon-width="18" data-icon-height="18"></span>
                                Voir les détails
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

<style>
    @media (min-width: 768px) {
        .order-grid {
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        }
    }
</style>
{% endblock %}