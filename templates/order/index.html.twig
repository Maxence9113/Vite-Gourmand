{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/order.css') }}">
{% endblock %}

{% block body %}
{# ========================================
   HEADER SECTION - Figma Design
   ======================================== #}
<section class="order-section">
    <div class="container">
        {# Fil d'ariane #}
        <nav aria-label="Fil d'ariane" class="order-breadcrumb">
            <ol class="order-breadcrumb-list">
                <li>
                    <a href="{{ path('app_home') }}" class="order-breadcrumb-link">
                        Accueil
                    </a>
                </li>
                <li class="order-breadcrumb-separator">
                    <span data-icon="chevron-right" data-icon-width="16" data-icon-height="16"></span>
                </li>
                <li class="order-breadcrumb-current">
                    Mes commandes
                </li>
            </ol>
        </nav>

        {# Titre #}
        <div class="order-section-header">
            <h1 class="order-section-title">
                Mes commandes
            </h1>
            <div class="order-section-divider"></div>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="order-flash-success">
                <span data-icon="check" data-icon-width="20" data-icon-height="20"></span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {# État vide #}
        {% if orders is empty %}
            <div class="order-empty-state">
                <span data-icon="shopping-bag" data-icon-width="64" data-icon-height="64" class="order-empty-icon"></span>
                <h2 class="order-empty-title">
                    Aucune commande pour le moment
                </h2>
                <p class="order-empty-text">
                    Vous n'avez pas encore passé de commande.
                </p>
                <a href="{{ path('app_menu_catalog') }}" class="order-empty-cta">
                    <span data-icon="arrow-right" data-icon-width="20" data-icon-height="20"></span>
                    Découvrir nos menus
                </a>
            </div>
        {% else %}
            {# Grille de commandes #}
            <div class="order-grid">
                {% for order in orders %}
                    <div class="order-card">

                        {# Header de la carte #}
                        <div class="order-card-header">
                            <span class="order-card-number">{{ order.orderNumber }}</span>
                            <span class="order-card-status status-{{ order.status.badgeClass }}">
                                <span data-icon="{{ order.status.icon }}" data-icon-width="14" data-icon-height="14"></span>
                                {{ order.status.label }}
                            </span>
                        </div>

                        {# Body de la carte #}
                        <div class="order-card-body">
                            <h3 class="order-card-menu-name">
                                {{ order.menuName }}
                            </h3>

                            <div class="order-card-details">
                                <div class="order-card-detail-item">
                                    <span data-icon="users" data-icon-width="18" data-icon-height="18"></span>
                                    <span class="order-card-detail-text">{{ order.numberOfPersons }} personne{{ order.numberOfPersons > 1 ? 's' : '' }}</span>
                                </div>
                                <div class="order-card-detail-item">
                                    <span data-icon="calendar" data-icon-width="18" data-icon-height="18"></span>
                                    <span class="order-card-detail-text">{{ order.deliveryDateTime|date('d/m/Y à H:i') }}</span>
                                </div>
                                <div class="order-card-detail-item">
                                    <span data-icon="map-pin" data-icon-width="18" data-icon-height="18"></span>
                                    <span class="order-card-detail-address">{{ order.deliveryAddress }}</span>
                                </div>
                            </div>

                            <div class="order-card-footer-wrapper">
                                <div>
                                    <p class="order-card-total-label">Total</p>
                                    <p class="order-card-total-value">
                                        {{ (order.totalPrice / 100)|number_format(2, ',', ' ') }}€
                                    </p>
                                </div>
                            </div>
                        </div>

                        {# Footer de la carte #}
                        <div class="order-card-footer">
                            <a href="{{ path('app_order_show', {id: order.id}) }}" class="order-card-view-btn">
                                <span data-icon="eye" data-icon-width="18" data-icon-height="18"></span>
                                Voir les détails
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
