{% extends 'emails/base_email.html.twig' %}
{% import 'emails/_email_styles.html.twig' as styles %}

{% block title %}Votre compte employé a été créé{% endblock %}

{% block header_title %}Bienvenue dans l'équipe !{% endblock %}

{% block content %}
    <p style="{{ styles.style_paragraph }}">Bonjour,</p>

    <p style="{{ styles.style_paragraph }}">Un compte employé a été créé pour vous sur la plateforme Vite & Gourmand.</p>

    <div style="{{ styles.style_info_box }}">
        <p style="margin: 0 0 15px 0;"><strong>Informations de connexion</strong></p>

        <div style="display: flex; justify-content: space-between; padding: 10px; margin: 5px 0; background-color: #ffffff; border-radius: 4px;">
            <span style="font-weight: bold; color: #495057;">Nom d'utilisateur :</span>
            <span><strong>{{ username }}</strong></span>
        </div>

        <div style="display: flex; justify-content: space-between; padding: 10px; margin: 5px 0; background-color: #ffffff; border-radius: 4px;">
            <span style="font-weight: bold; color: #495057;">Mot de passe :</span>
            <span style="color: #dc3545;">À demander à l'administrateur</span>
        </div>
    </div>

    <div style="{{ styles.style_warning_box }}">
        <p style="margin: 0;"><strong>⚠️ Sécurité :</strong>
        Pour des raisons de sécurité, votre mot de passe n'est pas communiqué par email.
        Veuillez contacter l'administrateur pour l'obtenir.</p>
    </div>

    <p style="{{ styles.style_paragraph }}"><strong>Avec votre compte employé, vous pourrez :</strong></p>
    <ul style="margin: 10px 0; padding-left: 20px;">
        <li style="margin-bottom: 8px;">Gérer les menus et les plats</li>
        <li style="margin-bottom: 8px;">Consulter et gérer les commandes</li>
        <li style="margin-bottom: 8px;">Modifier les horaires d'ouverture</li>
        <li style="margin-bottom: 8px;">Valider ou refuser les avis clients</li>
        <li style="margin-bottom: 8px;">Mettre à jour les statuts des commandes</li>
    </ul>

    <p style="text-align: center;">
        <a href="{{ url('app_login') }}" style="{{ styles.style_button }}">Se connecter</a>
    </p>

    <p style="{{ styles.style_paragraph }}"><strong>Prochaines étapes :</strong></p>
    <ol style="margin: 10px 0; padding-left: 20px;">
        <li style="margin-bottom: 8px;">Contactez l'administrateur pour obtenir votre mot de passe</li>
        <li style="margin-bottom: 8px;">Connectez-vous à la plateforme avec vos identifiants</li>
        <li style="margin-bottom: 8px;">Changez votre mot de passe lors de votre première connexion</li>
    </ol>

    <p style="{{ styles.style_paragraph }}">Si vous avez des questions, n'hésitez pas à contacter l'administrateur.</p>

    <p style="{{ styles.style_paragraph }}">
        Bienvenue dans l'équipe !<br>
        <strong>Vite & Gourmand</strong>
    </p>
{% endblock %}

{% block footer %}
    <p style="margin: 5px 0;">Vite & Gourmand - Traiteur à Bordeaux</p>
    <p style="margin: 5px 0;">Cet email a été généré automatiquement suite à la création de votre compte employé.</p>
{% endblock %}
