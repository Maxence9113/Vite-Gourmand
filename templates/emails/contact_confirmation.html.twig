{% extends 'emails/base_email.html.twig' %}
{% import 'emails/_email_styles.html.twig' as styles %}

{% block title %}Confirmation de votre message{% endblock %}

{% block header_title %}Message bien reçu !{% endblock %}

{% block content %}
    <p style="{{ styles.style_paragraph }}">Bonjour {{ senderName }},</p>

    <p style="{{ styles.style_paragraph }}">Nous avons bien reçu votre message et nous vous en remercions.</p>

    <div style="{{ styles.style_highlight_box }}">
        <div style="margin: 10px 0;">
            <strong style="color: #d4183d;">Sujet :</strong> {{ subject }}
        </div>
    </div>

    <p style="{{ styles.style_paragraph }}">Notre équipe va étudier votre demande et vous répondra dans les <strong>plus brefs délais</strong>, généralement sous 48 heures ouvrées.</p>

    <p style="{{ styles.style_paragraph }}">Si votre demande est urgente, n'hésitez pas à nous contacter directement par téléphone.</p>

    <p style="{{ styles.style_paragraph }}">
        Cordialement,<br>
        <strong>L'équipe Vite & Gourmand</strong>
    </p>
{% endblock %}
