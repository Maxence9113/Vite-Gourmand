{% extends 'emails/base_email.html.twig' %}
{% import 'emails/_email_styles.html.twig' as styles %}

{% block title %}Confirmation de commande {{ orderNumber }}{% endblock %}

{% block header_color %}#27ae60{% endblock %}
{% block header_text_color %}#27ae60{% endblock %}

{% block header %}
    <h1 style="color: #27ae60; margin: 0; font-size: 24px; font-family: 'Playfair Display', Georgia, serif;">
        Commande confirmée !
    </h1>
    <div style="{{ styles.style_success_badge }}">Commande {{ orderNumber }}</div>
{% endblock %}

{% block content %}
    <p style="{{ styles.style_paragraph }}">Bonjour {{ firstname }} {{ lastname }},</p>

    <p style="{{ styles.style_paragraph }}">Nous avons bien reçu votre commande. Merci de votre confiance !</p>

    <div style="{{ styles.style_order_details }}">
        <h3 style="{{ styles.style_h3 }}; margin-top: 0;">Détails de votre commande</h3>

        <div style="{{ styles.style_detail_row }}">
            <span style="{{ styles.style_detail_label }}">Numéro de commande :</span>
            <span style="{{ styles.style_detail_value }}">{{ orderNumber }}</span>
        </div>

        <div style="{{ styles.style_detail_row }}">
            <span style="{{ styles.style_detail_label }}">Menu :</span>
            <span style="{{ styles.style_detail_value }}">{{ menuName }}</span>
        </div>

        <div style="{{ styles.style_detail_row }}">
            <span style="{{ styles.style_detail_label }}">Nombre de personnes :</span>
            <span style="{{ styles.style_detail_value }}">{{ numberOfPersons }}</span>
        </div>

        <div style="{{ styles.style_detail_row }}">
            <span style="{{ styles.style_detail_label }}">Date de livraison :</span>
            <span style="{{ styles.style_detail_value }}">{{ deliveryDateTime|date('d/m/Y') }}</span>
        </div>

        <div style="{{ styles.style_detail_row }}">
            <span style="{{ styles.style_detail_label }}">Heure de livraison :</span>
            <span style="{{ styles.style_detail_value }}">{{ deliveryDateTime|date('H:i') }}</span>
        </div>

        <div style="{{ styles.style_detail_row }}">
            <span style="{{ styles.style_detail_label }}">Adresse de livraison :</span>
            <span style="{{ styles.style_detail_value }}">{{ deliveryAddress }}</span>
        </div>

        <h3 style="color: #d4183d; margin-top: 20px; margin-bottom: 10px; font-size: 16px;">Détail du montant</h3>

        <div style="{{ styles.style_detail_row }}">
            <span style="{{ styles.style_detail_label }}">Sous-total menu :</span>
            <span style="{{ styles.style_detail_value }}">{{ menuSubtotal|number_format(2, ',', ' ') }} €</span>
        </div>

        <div style="{{ styles.style_detail_row }}">
            <span style="{{ styles.style_detail_label }}">Frais de livraison {% if deliveryDistanceKm %}({{ deliveryDistanceKm }} km){% endif %} :</span>
            <span style="{{ styles.style_detail_value }}">{{ deliveryCost|number_format(2, ',', ' ') }} €</span>
        </div>

        {% if discountAmount %}
        <div style="{{ styles.style_detail_row }}; color: #27ae60;">
            <span style="{{ styles.style_detail_label }}">Réduction (10%) :</span>
            <span style="{{ styles.style_detail_value }}">- {{ discountAmount|number_format(2, ',', ' ') }} €</span>
        </div>
        {% endif %}

        <div style="{{ styles.style_total_row }}">
            <span>Total :</span>
            <span>{{ totalPrice|number_format(2, ',', ' ') }} €</span>
        </div>
    </div>

    <div style="{{ styles.style_info_box }}">
        <strong>Prochaines étapes :</strong>
        <ol style="margin: 10px 0; padding-left: 20px;">
            <li style="margin-bottom: 8px;">Notre équipe va valider votre commande</li>
            <li style="margin-bottom: 8px;">Vous pourrez suivre l'état de votre commande depuis votre espace client</li>
            <li style="margin-bottom: 8px;">Nous vous notifierons à chaque étape de la préparation</li>
        </ol>
    </div>

    <p style="text-align: center;">
        <a href="{{ url('app_account_orders') }}" style="{{ styles.style_button }}">Suivre ma commande</a>
    </p>

    <p style="{{ styles.style_paragraph }}">Pour toute question concernant votre commande, n'hésitez pas à nous contacter en précisant votre numéro de commande.</p>

    <p style="{{ styles.style_paragraph }}">
        À très bientôt,<br>
        <strong>L'équipe Vite & Gourmand</strong>
    </p>
{% endblock %}

{% block footer %}
    <p style="margin: 5px 0;">Vite & Gourmand - Traiteur à Bordeaux</p>
    <p style="margin: 5px 0;">Email : <a href="mailto:contact@maxencedupuis.com" style="{{ styles.style_link }}">contact@maxencedupuis.com</a></p>
{% endblock %}
