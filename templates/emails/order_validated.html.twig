{% extends 'emails/base_email.html.twig' %}
{% import 'emails/_email_styles.html.twig' as styles %}

{% block title %}Commande validée{% endblock %}

{% block header_color %}#27ae60{% endblock %}
{% block header_text_color %}#27ae60{% endblock %}

{% block header %}
    <div style="font-size: 48px; color: #27ae60; margin: 10px 0;">✓</div>
    <h1 style="color: #27ae60; margin: 0; font-size: 24px; font-family: 'Playfair Display', Georgia, serif;">
        Commande validée !
    </h1>
{% endblock %}

{% block content %}
    <p style="{{ styles.style_paragraph }}">Bonjour {{ firstname }},</p>

    <p style="{{ styles.style_paragraph }}">Excellente nouvelle ! Votre commande <strong>{{ orderNumber }}</strong> a été validée par notre équipe.</p>

    <div style="{{ styles.style_success_box }}">
        <p><strong>Date de livraison prévue :</strong></p>
        <p style="font-size: 18px; margin: 10px 0;">
            {{ deliveryDateTime|date('d/m/Y') }} à {{ deliveryDateTime|date('H:i') }}
        </p>
    </div>

    <p style="{{ styles.style_paragraph }}"><strong>Que se passe-t-il maintenant ?</strong></p>
    <ol style="margin: 10px 0; padding-left: 20px;">
        <li style="margin-bottom: 8px;">Notre équipe cuisine prépare votre commande avec soin</li>
        <li style="margin-bottom: 8px;">Vous recevrez une notification à chaque étape (préparation, livraison)</li>
        <li style="margin-bottom: 8px;">Votre commande sera livrée à la date et l'heure prévues</li>
    </ol>

    <p style="text-align: center;">
        <a href="{{ url('app_account_orders') }}" style="{{ styles.style_button }}">Suivre ma commande</a>
    </p>

    <p style="{{ styles.style_paragraph }}">Nous mettons tout en œuvre pour que votre événement soit une réussite !</p>

    <p style="{{ styles.style_paragraph }}">
        À très bientôt,<br>
        <strong>L'équipe Vite & Gourmand</strong>
    </p>
{% endblock %}
