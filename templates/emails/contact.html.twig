{% extends 'emails/base_email.html.twig' %}
{% import 'emails/_email_styles.html.twig' as styles %}

{% block title %}{{ subject }}{% endblock %}

{% block header_title %}Nouveau message de contact{% endblock %}

{% block content %}
    <div style="{{ styles.style_info_row }}">
        <strong>De :</strong> {{ senderName }}
    </div>

    <div style="{{ styles.style_info_row }}">
        <strong>Email :</strong>
        <a href="mailto:{{ senderEmail }}" style="{{ styles.style_link }}">{{ senderEmail }}</a>
    </div>

    <div style="{{ styles.style_info_row }}">
        <strong>Sujet :</strong> {{ subject }}
    </div>

    <div style="{{ styles.style_highlight_box }}; margin-top: 30px;">
        <strong>Message :</strong>
        <p style="margin: 10px 0 0 0;">{{ message|nl2br }}</p>
    </div>
{% endblock %}

{% block footer %}
    <p style="margin: 5px 0;">Cet email a été envoyé depuis le formulaire de contact de Vite & Gourmand</p>
    <p style="margin: 5px 0;">Pour répondre, utilisez directement l'adresse : {{ senderEmail }}</p>
{% endblock %}
