{% extends 'emails/base_email.html.twig' %}
{% import 'emails/_email_styles.html.twig' as styles %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}

{% block header_title %}Réinitialisation de mot de passe{% endblock %}

{% block content %}
    <p style="{{ styles.style_paragraph }}">Bonjour {{ firstname }},</p>

    <p style="{{ styles.style_paragraph }}">Vous avez demandé à réinitialiser votre mot de passe.</p>

    <p style="{{ styles.style_paragraph }}">Cliquez sur le bouton ci-dessous pour créer un nouveau mot de passe :</p>

    <p style="text-align: center;">
        <a href="{{ resetUrl }}" style="{{ styles.style_button }}">Réinitialiser mon mot de passe</a>
    </p>

    <div style="{{ styles.style_warning_box }}">
        <strong>Important :</strong>
        <ul style="margin: 10px 0; padding-left: 20px;">
            <li style="margin-bottom: 8px;">Ce lien est valable pendant 1 heure</li>
            <li style="margin-bottom: 8px;">Si vous n'avez pas demandé cette réinitialisation, ignorez cet email</li>
            <li style="margin-bottom: 8px;">Ne partagez jamais ce lien avec qui que ce soit</li>
        </ul>
    </div>

    <p style="font-size: 12px; color: #6c757d;">
        Si le bouton ne fonctionne pas, copiez et collez ce lien dans votre navigateur :<br>
        <a href="{{ resetUrl }}" style="{{ styles.style_link }}">{{ resetUrl }}</a>
    </p>

    <p style="{{ styles.style_paragraph }}">
        À bientôt,<br>
        <strong>L'équipe Vite & Gourmand</strong>
    </p>
{% endblock %}

{% block footer %}
    <p style="margin: 5px 0;">Vite & Gourmand - Traiteur à Bordeaux</p>
    <p style="margin: 5px 0;">Cet email a été envoyé car une réinitialisation de mot de passe a été demandée pour votre compte.</p>
{% endblock %}
