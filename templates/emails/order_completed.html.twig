{% extends 'emails/base_email.html.twig' %}
{% import 'emails/_email_styles.html.twig' as styles %}

{% block title %}Votre commande est terminée{% endblock %}

{% block header_color %}#27ae60{% endblock %}
{% block header_text_color %}#27ae60{% endblock %}

{% block header_title %}Votre commande est terminée !{% endblock %}

{% block content %}
    <p style="{{ styles.style_paragraph }}">Bonjour {{ firstname }},</p>

    <p style="{{ styles.style_paragraph }}">Nous espérons que vous avez apprécié notre prestation pour votre commande <strong>{{ orderNumber }}</strong>.</p>

    <div style="{{ styles.style_success_box }}; text-align: center;">
        <p style="font-size: 18px; margin: 0 0 10px 0;">
            <strong>Votre avis nous intéresse !</strong>
        </p>
        <div style="font-size: 32px; color: #ffc107; margin: 10px 0;">★ ★ ★ ★ ★</div>
        <p style="margin: 10px 0;">
            Prenez quelques instants pour partager votre expérience.<br>
            Votre retour nous aide à améliorer nos services.
        </p>
        <p style="text-align: center;">
            <a href="{{ reviewUrl }}" style="{{ styles.style_button_secondary }}; background-color: #27ae60;">Laisser un avis</a>
        </p>
    </div>

    <p style="{{ styles.style_paragraph }}">Votre satisfaction est notre priorité. Si vous avez des remarques ou suggestions, n'hésitez pas à nous en faire part.</p>

    <p style="{{ styles.style_paragraph }}">Nous serions ravis de vous accueillir à nouveau pour vos prochains événements !</p>

    <p style="{{ styles.style_paragraph }}">
        Cordialement,<br>
        <strong>L'équipe Vite & Gourmand</strong>
    </p>
{% endblock %}
