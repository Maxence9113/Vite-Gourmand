{% extends 'emails/base_email.html.twig' %}
{% import 'emails/_email_styles.html.twig' as styles %}

{% block title %}Rappel : Retour de matériel{% endblock %}

{% block header_color %}#ffc107{% endblock %}
{% block header_text_color %}#ffc107{% endblock %}

{% block header_title %}Rappel : Retour de matériel{% endblock %}

{% block content %}
    <p style="{{ styles.style_paragraph }}">Bonjour {{ firstname }},</p>

    <p style="{{ styles.style_paragraph }}">Nous espérons que votre événement s'est bien déroulé !</p>

    <p style="{{ styles.style_paragraph }}">Nous vous contactons concernant le matériel que nous avons mis à votre disposition pour la commande <strong>{{ orderNumber }}</strong>.</p>

    <div style="{{ styles.style_warning_box }}">
        <p style="margin: 0 0 10px 0; font-size: 16px;"><strong>⚠️ Informations importantes</strong></p>

        <div style="display: flex; justify-content: space-between; padding: 10px; margin: 5px 0; background-color: #ffffff; border-radius: 4px;">
            <span style="font-weight: bold;">Commande :</span>
            <span>{{ orderNumber }}</span>
        </div>

        <div style="display: flex; justify-content: space-between; padding: 10px; margin: 5px 0; background-color: #ffffff; border-radius: 4px;">
            <span style="font-weight: bold;">Date limite de retour :</span>
            <span><strong>{{ deadline|date('d/m/Y') }}</strong></span>
        </div>

        <p style="margin-top: 15px; margin-bottom: 0;">
            Le matériel doit être restitué avant cette date limite.
        </p>
    </div>

    <div style="{{ styles.style_danger_box }}">
        <p style="margin: 0; font-size: 14px;">
            <strong>⚠️ Attention :</strong> Conformément à nos conditions générales de vente,
            si le matériel n'est pas restitué dans les <strong>10 jours ouvrés</strong> suivant la livraison,
            des frais de <strong>{{ penaltyAmount }} €</strong> seront facturés.
        </p>
    </div>

    <p style="{{ styles.style_paragraph }}"><strong>Pour organiser le retour du matériel :</strong></p>
    <ul style="margin: 10px 0; padding-left: 20px;">
        <li style="margin-bottom: 8px;">Contactez-nous par téléphone ou par email</li>
        <li style="margin-bottom: 8px;">Nous conviendrons ensemble d'un créneau pour la récupération</li>
        <li style="margin-bottom: 8px;">Assurez-vous que le matériel soit propre et en bon état</li>
    </ul>

    <p style="text-align: center;">
        <a href="mailto:contact@maxencedupuis.com?subject=Retour de matériel - {{ orderNumber }}" style="{{ styles.style_button }}">
            Nous contacter
        </a>
    </p>

    <p style="{{ styles.style_paragraph }}">Nous restons à votre disposition pour toute question.</p>

    <p style="{{ styles.style_paragraph }}">
        Cordialement,<br>
        <strong>L'équipe Vite & Gourmand</strong>
    </p>
{% endblock %}

{% block footer %}
    <p style="margin: 5px 0;">Vite & Gourmand - Traiteur à Bordeaux</p>
    <p style="margin: 5px 0;">Email : <a href="mailto:contact@maxencedupuis.com" style="{{ styles.style_link }}">contact@maxencedupuis.com</a></p>
    <p style="margin: 5px 0;">Ce rappel concerne la commande {{ orderNumber }}</p>
{% endblock %}
