{# templates/forms/custom_form_theme.html.twig #}
{# Thème personnalisé pour les formulaires #}

{% use "form_div_layout.html.twig" %}

{# Personnalisation des groupes de formulaire #}
{% block form_row -%}
    <div class="form-group{% if errors|length > 0 %} has-error{% endif %}">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row %}

{# Personnalisation des labels #}
{% block form_label -%}
    {% if label is not same as(false) -%}
        {% if required -%}
            {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' required')|trim}) %}
        {%- endif -%}
        {% if label is empty -%}
            {%- if label_format is not empty -%}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {%- else -%}
                {% set label = name|humanize %}
            {%- endif -%}
        {%- endif -%}
        <label{% if label_attr %} {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' form-label')|trim}) %}{% endif %}{% for attrname, attrvalue in label_attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}>
            {{ translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain) }}
            {% if required %}<span class="required">*</span>{% endif %}
        </label>
    {%- endif -%}
{%- endblock form_label %}

{# Personnalisation du texte d'aide #}
{% block form_help -%}
    {%- if help is not empty -%}
        <small class="form-text">{{ help|trans(help_translation_parameters, translation_domain) }}</small>
    {%- endif -%}
{%- endblock form_help %}

{# Personnalisation des erreurs #}
{% block form_errors -%}
    {%- if errors|length > 0 -%}
        <div class="form-errors">
            {%- for error in errors -%}
                <div class="form-error">{{ error.message }}</div>
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endblock form_errors %}

{# Personnalisation des checkboxes #}
{% block checkbox_row -%}
    <div class="form-check">
        {{- form_widget(form) -}}
        {{- form_label(form, null, {label_attr: {class: 'form-check-label'}}) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row %}

{# Personnalisation des radios #}
{% block radio_row -%}
    <div class="form-check">
        {{- form_widget(form) -}}
        {{- form_label(form, null, {label_attr: {class: 'form-check-label'}}) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock radio_row %}

{# Groupe de checkboxes/radios multiples #}
{% block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="form-check-group">
        {%- for child in form %}
            <div class="form-check">
                {{- form_widget(child) -}}
                {{- form_label(child, null, {
                    translation_domain: choice_translation_domain,
                    label_attr: {class: 'form-check-label'}
                }) -}}
            </div>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded %}
