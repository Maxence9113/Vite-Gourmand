{% extends 'base.html.twig' %}

{% block title %}Avis clients - Bordeaux Gourmant{% endblock %}

{% block body %}

<section style="padding: 3rem 0; background-color: var(--beige);">
    <div class="container" style="padding: 3rem 0;">
        <div style="text-align: center; margin-bottom: 3rem;">
            <span style="margin-bottom: 20px;">Témoignages</span>
            <h1 style="margin-bottom: 20px;; color: var(--primary);">
                Avis de nos clients
            </h1>
            <p style="color: #95a5a6;">
                Découvrez ce que nos clients pensent de nos services
            </p>

            {% if app.user %}
                <div style="margin-top: 25px;">
                    <a href="{{ path('app_review_new') }}" class="btn btn-primary btn-lg">
                        <i data-feather="edit-3" width="20" style="margin-right: 0.5rem;"></i>
                        Laisser un avis
                    </a>
                </div>
            {% else %}
                <div class="alert alert-info" style="margin-top: 1.5rem; display: inline-block;">
                    <i data-feather="info" width="18" style="margin-right: 0.5rem;"></i>
                    <a href="{{ path('app_login') }}" class="alert-link">Connectez-vous</a> pour laisser un avis
                </div>
            {% endif %}
        </div>

        {% if reviews is empty %}
            <div style="text-align: center; padding: 3rem 0;">
                <i data-feather="message-circle" width="64" style="margin-bottom: 20px;"></i>
                <p style="color: #95a5a6;">Aucun avis pour le moment. Soyez le premier à partager votre expérience !</p>
            </div>
        {% else %}
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                {% for review in reviews %}
                    <div style="margin-bottom: 25px;">
                        <div class="review-card h-100">
                            <div style="margin-bottom: 20px;">
                                {% for i in 1..5 %}
                                    {% if i <= review.rating %}
                                        <i data-feather="star" width="20" class="star-filled"></i>
                                    {% else %}
                                        <i data-feather="star" width="20" class="star-empty"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            {% if review.comment %}
                                <p style="margin-bottom: 25px;">
                                    "{{ review.comment }}"
                                </p>
                            {% endif %}

                            <div style="display: flex; align-items: center; margin-top: auto;">
                                <div class="review-avatar" style="margin-right: 1rem;">
                                    <i data-feather="user" width="24"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 style="font-weight: 600;">{{ review.customerName }}</h6>
                                    <small style="color: #95a5a6;">{{ review.createdAt|date('d/m/Y') }}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .review-card {
            background: white;
            border-radius: 0.75rem;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .review-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        }

        .review-stars {
            display: flex;
            gap: 0.25rem;
        }

        .review-stars .star-filled {
            color: #ffc107;
            fill: #ffc107;
        }

        .review-stars .star-empty {
            color: #e9ecef;
            fill: #e9ecef;
        }

        .review-text {
            font-style: italic;
            color: #6c757d;
            line-height: 1.6;
        }

        .review-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }
    </style>
{% endblock %}