{% extends 'base.html.twig' %}

{% block title %}Avis clients{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/review.css') }}">
{% endblock %}

{% block body %}
{# ========================================
   REVIEWS PAGE - Figma Design
   ======================================== #}
<section class="review-section">
    <div class="review-container">

        {# En-tête #}
        <div class="review-header">
            <h1 class="review-header-title">
                Avis de nos clients
            </h1>
            <p class="review-header-subtitle">
                Découvrez ce que nos clients pensent de nos services
            </p>

            {% if app.user %}
                <a href="{{ path('app_review_new') }}" class="review-btn-new">
                    <span data-icon="edit-3" data-icon-width="18" data-icon-height="18"></span>
                    Laisser un avis
                </a>
            {% else %}
                <div class="review-login-notice">
                    <span data-icon="info" data-icon-width="18" data-icon-height="18"></span>
                    <span>
                        <a href="{{ path('app_login') }}" class="review-login-link">Connectez-vous</a> pour laisser un avis
                    </span>
                </div>
            {% endif %}
        </div>

        {% if reviews is empty %}
            {# État vide #}
            <div class="review-empty-state">
                <div class="review-empty-icon-circle">
                    <span data-icon="message-circle" data-icon-width="32" data-icon-height="32" class="icon"></span>
                </div>
                <h3 class="review-empty-title">
                    Aucun avis pour le moment
                </h3>
                <p class="review-empty-text">
                    Soyez le premier à partager votre expérience !
                </p>
            </div>
        {% else %}
            {# Grille des avis #}
            <div class="review-grid">
                {% for review in reviews %}
                    <div class="review-item-card">

                        {# Étoiles #}
                        <div class="review-item-stars">
                            {% for i in 1..5 %}
                                <span data-icon="star" data-icon-width="20" data-icon-height="20"
                                      class="{% if i <= review.rating %}review-item-star-icon{% else %}review-item-star-icon-empty{% endif %}"></span>
                            {% endfor %}
                        </div>

                        {# Commentaire #}
                        {% if review.comment %}
                            <p class="review-item-comment">
                                "{{ review.comment }}"
                            </p>
                        {% endif %}

                        {# Informations client #}
                        <div class="review-item-author-section">
                            <div class="review-item-avatar">
                                <span data-icon="user" data-icon-width="24" data-icon-height="24" class="text-white"></span>
                            </div>
                            <div>
                                <h6 class="review-item-author-name">
                                    {{ review.customerName }}
                                </h6>
                                <small class="review-item-date">
                                    {{ review.createdAt|date('d/m/Y') }}
                                </small>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}