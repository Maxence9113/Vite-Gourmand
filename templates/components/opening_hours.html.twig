{#
    Component réutilisable pour afficher les horaires d'ouverture

    Usage :
    {% include 'components/opening_hours.html.twig' with {
        'schedules': schedules,
        'show_title': true
    } %}
#}

{% set show_title = show_title|default(true) %}

<div class="opening-hours">
    {% if show_title %}
        <h3 style="margin-bottom: 20px;">Horaires d'ouverture</h3>
    {% endif %}

    {% if schedules is defined and schedules|length > 0 %}
        <div class="list-group list-group-flush">
            {% for item in schedules %}
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0;">
                    <span style="font-weight: 500;">{{ item.label }}</span>
                    <span>
                        {% if item.isOpen and item.openingTime and item.closingTime %}
                            <span style="color: #27ae60;">{{ item.openingTime }} - {{ item.closingTime }}</span>
                        {% else %}
                            <span style="color: #95a5a6;">Fermé</span>
                        {% endif %}
                    </span>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p style="color: #95a5a6;">Horaires non disponibles pour le moment.</p>
    {% endif %}
</div>
