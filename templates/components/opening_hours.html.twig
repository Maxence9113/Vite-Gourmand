{#
    Component réutilisable pour afficher les horaires d'ouverture

    Usage :
    {% include 'components/opening_hours.html.twig' with {
        'schedules': schedules,
        'show_title': true
    } %}
#}

{% set show_title = show_title|default(true) %}

<div class="opening-hours">
    {% if show_title %}
        <h3 class="opening-hours-title">Horaires d'ouverture</h3>
    {% endif %}

    {% if schedules is defined and schedules|length > 0 %}
        <div class="opening-hours-list">
            {% for item in schedules %}
                <div class="opening-hours-item">
                    <span class="opening-hours-day">{{ item.label }}</span>
                    <span>
                        {% if item.isOpen and item.openingTime and item.closingTime %}
                            <span class="opening-hours-time opening-hours-time-open">{{ item.openingTime }} - {{ item.closingTime }}</span>
                        {% else %}
                            <span class="opening-hours-time opening-hours-time-closed">Fermé</span>
                        {% endif %}
                    </span>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p class="opening-hours-empty">Horaires non disponibles pour le moment.</p>
    {% endif %}
</div>
